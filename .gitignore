# ---- .NET ----
bin/
obj/
[Dd]ebug/
[Rr]elease/
*.user
*.suo
*.userosscache
*.sln.docstates
project.lock.json
project.fragment.lock.json
# Only the repository root's publish output: an unanchored `artifacts/` also swallows source directories
# that happen to be named that (F-016's src/Server/Artifacts, src/Worker/Artifacts, tests/**/Artifacts), and a
# commit would then silently drop them. The runtime store is under App_Data/, which is ignored on its own.
/artifacts/

# ---- Test / coverage ----
TestResults/
[Cc]overage*/
*.coverage
*.trx

# ---- IDE / OS ----
.vs/
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---- Zenkins runtime data (never commit) ----
**/App_Data/
*.db
*.db-shm
*.db-wal
**/work/
**/artifacts_upload/
logs/
*.log

# ---- Local secrets / config overrides ----
appsettings.Local.json
appsettings.Development.json
.env
.env.*
!.env.example
*.pfx
*.pem
*.key
