<Project>

  <!--
    B-009: the NativeAOT compiler (Microsoft.DotNet.ILCompiler) must be the runtime band's own patch.

    Nothing in the solution references it directly: with `PublishAot` the SDK injects it as an
    *implicit* PackageReference at restore time, taking its version from the installed SDK's
    `KnownILCompilerPack` item, and the AOT runtime pack it compiles against comes from the same band
    (`KnownFrameworkReference`'s `LatestRuntimeFrameworkVersion`). The two are **one number**: ILC
    refuses to publish when the AOT pack's `System.Private.CoreLib.dll` is older than the runtime
    pack's (`Overriding System.Private.CoreLib.dll with a newer version is not supported`), so a
    compiler version that disagrees with the runtime band is not a setting, it is a broken build.

    That is exactly what treating the version as a hard-coded constant broke: pinning 10.0.14 fixed
    the machine that shipped 10.0.11, then failed every CI runner whose band is 10.0.15, in the
    `PublishAot` segment only. The value is therefore **derived** (Directory.Build.targets takes it
    from the SDK's own runtime band) and a manual override is only accepted when it equals that band
    - the guard below is what makes the rule a build error instead of a memory test.

    What is genuinely the repository's decision is the **floor**: `ZenkinsILCompilerMinimumVersion`.
    GHSA-p3jp-9v83-76w9 (high, the Brotli decoder) covers `Microsoft.DotNet.ILCompiler
    >= 10.0.0, < 10.0.14`, and 10.0.14 is the first patched release of the 10.0 line. An SDK whose
    band is older than the floor cannot produce a safe worker, so the build stops with a message that
    says which SDK to install - never with a suppressed audit, and never with `-p:NuGetAudit=false`.
  -->
  <PropertyGroup>
    <ZenkinsILCompilerMinimumVersion>10.0.14</ZenkinsILCompilerMinimumVersion>
  </PropertyGroup>

  <!--
    Settings shared by every project in the solution. Keep this file boring:
    only build-wide defaults that all later cards should inherit.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <!--
      P-001: the single source of the product version. The SDK writes this into every assembly's
      AssemblyInformationalVersion (plus the source revision: "1.0.0+<sha>"), so Server and Worker
      are stamped at build time from this one line. Operators read the stamp through the binaries'
      version flag and the shell footer's version line; Zenkins.Shared.ProductVersion is the
      reader. Bump here, and only here, for the next release.
    -->
    <Version>1.0.0</Version>
  </PropertyGroup>

</Project>
