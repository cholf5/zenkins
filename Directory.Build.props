<Project>

  <!--
    B-009: the NativeAOT compiler (Microsoft.DotNet.ILCompiler), pinned by the repository.

    Nothing in the solution references it directly. With PublishAot the SDK injects it at restore
    time, and its version is whatever `ILCompilerPackVersion` the *installed SDK's*
    Microsoft.NETCoreSdk.BundledVersions.props carries - a function of the machine, not of this
    repository, since global.json accepts any 10.0.x band. Two machines therefore compiled the
    shipped Worker with two compilers: a fresh Windows box resolved 10.0.11, which
    GHSA-p3jp-9v83-76w9 (high, the Brotli decoder) covers for the whole `>= 10.0.0, < 10.0.14`
    range - so NuGet audit's NU1903, fatal under the `TreatWarningsAsErrors` below, turned into a
    restore that could not finish - while macOS resolved 10.0.14 and built clean.

    10.0.14 is the first release of the 10.0 line outside that advisory's range and the version the
    current SDK band ships, so the pin changes nothing on a machine already there while pulling a
    10.0.11 machine onto the patched compiler. Deliberately not 10.0.15 (the band EF Core and the
    hosting packages are on): the AOT compiler is paired with the SDK's own runtime band, so a pin
    that outruns the SDK is the same drift pointing the other way.

    This is a *version*, not an exemption, and it cannot be a PackageVersion: the reference is
    SDK-implicit and central package management refuses a PackageVersion for those (NU1009).
    Directory.Build.targets therefore rewrites the SDK's own KnownILCompilerPack item. Bumping it is
    a one-line change here, made when a new advisory or runtime band says so - never by whichever
    machine happens to build.
  -->
  <PropertyGroup>
    <ZenkinsILCompilerVersion>10.0.14</ZenkinsILCompilerVersion>
  </PropertyGroup>

  <!--
    Settings shared by every project in the solution. Keep this file boring:
    only build-wide defaults that all later cards should inherit.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <!--
      P-001: the single source of the product version. The SDK writes this into every assembly's
      AssemblyInformationalVersion (plus the source revision: "1.0.0+<sha>"), so Server and Worker
      are stamped at build time from this one line. Operators read the stamp through the binaries'
      version flag and the shell footer's version line; Zenkins.Shared.ProductVersion is the
      reader. Bump here, and only here, for the next release.
    -->
    <Version>1.0.0</Version>
  </PropertyGroup>

</Project>
