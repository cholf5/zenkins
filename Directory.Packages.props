<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!--
    Every PackageReference in the solution is versionless; the version lives here.
    Add new packages in this file only.
  -->
  <ItemGroup>
    <!--
      EF Core is pinned to 10.0.15, not 10.0.2: 10.0.2 resolves SQLitePCLRaw.lib.e_sqlite3 2.1.11,
      which GHSA-2m69-gcr7-jv3q flags as high severity and which fails the build through NuGet audit
      (NU1903) because warnings are errors here. 10.0.15 resolves SQLitePCLRaw 2.1.13.
      Npgsql.EntityFrameworkCore.PostgreSQL stays on its own 10.0.0 release; it accepts EF Core
      [10.0.0, 11.0.0), so the two versions are intentionally not aligned.
    -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

</Project>
