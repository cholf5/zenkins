<Solution>
  <Folder Name="/src/">
    <Project Path="src/Server/Zenkins.Server.csproj" />
    <Project Path="src/Shared/Zenkins.Shared.csproj" />
    <Project Path="src/Worker/Zenkins.Worker.csproj" />
  </Folder>
  <Folder Name="/tests/">
    <Project Path="tests/Zenkins.Tests/Zenkins.Tests.csproj" />
    <!-- F-007: the E2E's ArgvEcho asset must be a solution project, not only a ProjectReference.
         A solution build assigns configurations only to its own projects; a referenced-but-unsolved
         project is built with the solution's default configuration (Debug), so `dotnet build -c
         Release` produced bin/Debug output the WorkerRuntime E2E (which needs bin/Release) never
         saw - the CI gate failed on all three OSes for exactly this. -->
    <Project Path="tests/Zenkins.Tests/TestAssets/ArgvEcho/ArgvEcho.csproj" />
    <!-- B-004: the compiled recording shim, for the Windows half of the F-013 Git facts. Same rule as
         ArgvEcho above: a build-only ProjectReference still has to be a solution project so a
         configuration-specific `dotnet build`/`dotnet test` output is the one the tests locate. -->
    <Project Path="tests/Zenkins.Tests/TestAssets/RecordingShim/RecordingShim.csproj" />
  </Folder>
</Solution>
