@inject IHttpContextAccessor HttpContextAccessor
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

<!DOCTYPE html>
<html lang="@DocumentLanguage" class="@(ThemePreference.IsDark(HttpContextAccessor.HttpContext) ? "dark" : null)">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @* The language the document was rendered in. The interactive circuit reads nothing from the DOM,
       but this stays for diagnostics and for a client that wants the shell's language without the cookie. *@
    <meta name="zenkins-language" content="@DocumentLanguage" />
    <base href="/" />

    @* F-002: the request token for the plain-HTML POST forms in the shell and organization pages.
       Rendering it once per page here (static SSR, where HttpContext exists) keeps it out of the
       interactive circuit, which has no HttpContext; js/antiforgery.js copies it into each form on
       submit. GetAndStoreTokens also sets the antiforgery cookie. *@
    @if (HttpContext is not null)
    {
        <meta name="request-verification-token" content="@Antiforgery.GetAndStoreTokens(HttpContext).RequestToken" />
    }

    <!-- Project theme tokens load before the package so they can override its defaults. -->
    <link rel="stylesheet" href="styles/theme.css" />
    <!-- Pre-built BlazorBlueprint CSS shipped as a static web asset by the NuGet package. -->
    <link rel="stylesheet" href="_content/BlazorBlueprint.Components/blazorblueprint.css" />
    <!-- The `bb:` utilities the app uses that the purged package sheet does not ship. Extends the
         line above rather than the theme, so it sits next to it; UtilityCoverageTests holds the two
         files to one list. -->
    <link rel="stylesheet" href="styles/utilities.css" />
    <!-- The base/primary color palettes (D-007): keyed off the data-base-color / data-primary-color
         attributes ThemeService writes on <html>. Not part of blazorblueprint.css; without this
         stylesheet an accent picked in the theme switcher would never render. Unlayered with
         compound .dark[data-base-color=...] selectors, so dark mode survives an attribute. -->
    <link rel="stylesheet" href="_content/BlazorBlueprint.Components/css/themes.css" />
    <!-- Light-mode surfaces for slate/gray/neutral/stone. The palette above paints every light
         canvas pure white, so a base color picked in light mode was invisible; this sheet tints
         only --background/--card/--popover/--sidebar, and only in light mode (the palette's
         .dark[data-base-color=...] rules outrank it there). Loaded after the palette on purpose:
         the tie on specificity is broken by document order. -->
    <link rel="stylesheet" href="styles/base-color-light.css" />
    <link rel="stylesheet" href="app.css" />

    <!-- Classic, blocking: resolves and persists the theme before the first paint. The cookie
         name is emitted from ThemePreference.CookieName so C# and JS cannot drift apart. -->
    <script src="js/theme-persistence.js" data-theme-cookie="@ThemePreference.CookieName"></script>
    <!-- The package's pre-paint restore (also classic, blocking): after the bridge has agreed
         cookie → storage, it replays the saved accent, radius and design attributes onto <html>
         so the first paint already shows them. Runs second on purpose — it reads the bb-theme
         entry the bridge just repaired or seeded. data-default-dark is derived from the cookie
         so a cookie-dark browser with localStorage blocked cannot be flipped to the OS light
         preference by this script's own fallback. -->
    <script src="_content/BlazorBlueprint.Components/js/theme-init.js"
            data-default-dark="@(ThemePreference.IsDark(HttpContextAccessor.HttpContext) ? "true" : "false")"></script>

    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />
    <script src="js/antiforgery.js"></script>
    <script src="js/project-kind.js"></script>
    <!-- The list + inspector frame the step and parameter editors use; both scripts read through it. -->
    <script src="js/split-list.js"></script>
    <script src="js/freestyle-steps.js"></script>
    <script src="js/parameter-rows.js"></script>
    <script src="js/run-stages.js"></script>
    <script src="js/snippets.js"></script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    /// <summary>
    /// The document's language, resolved exactly as the scoped <c>LanguageContext</c> will resolve it
    /// for this request, so <c>&lt;html lang&gt;</c> cannot disagree with the rendered copy.
    /// </summary>
    private string DocumentLanguage =>
        HttpContextAccessor.HttpContext is { } http ? AppLanguage.Resolve(http.Request) : AppLanguage.English;

    /// <summary>
    /// Interactive server for normal app pages, static SSR (null) for pages that declare
    /// <c>[ExcludeFromInteractiveRouting]</c> - the account pages. A form posted from an
    /// interactive circuit cannot set the authentication cookie, so those pages must be rendered
    /// statically; every other page keeps the interactive shell.
    /// </summary>
    private IComponentRenderMode? PageRenderMode =>
        HttpContext?.AcceptsInteractiveRouting() == true ? InteractiveServer : null;
}
