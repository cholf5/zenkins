@inherits LayoutComponentBase
@inject UserSession UserSession

<BbPortalHost />

@* HeightClass is appended verbatim to the provider's own utility classes, which are all prefixed
   with the package's `bb:` variant, and the package CSS ships only the prefixed `h-full` utility.
   The unprefixed `h-full` would therefore resolve to no rule at all. *@
<BbSidebarProvider HeightClass="bb:h-full" CookieKey="zenkins-sidebar-state">
    <BbSidebar Collapsible="true">
        <BbSidebarHeader>
            <a href="/" class="bb:flex bb:items-center bb:gap-2 bb:rounded-md bb:px-2 bb:py-2 bb:font-semibold bb:tracking-tight bb:focus-visible:outline-none bb:focus-visible:ring-2 bb:focus-visible:ring-ring bb:focus-visible:ring-offset-2">
                <span class="bb:flex bb:h-8 bb:w-8 bb:items-center bb:justify-center bb:rounded-md bb:bg-primary bb:text-primary-foreground">
                    <LucideIcon Name="zap" Class="bb:h-4 bb:w-4" />
                </span>
                <span class="bb:group-data-[collapsible=icon]:hidden">Zenkins</span>
            </a>
        </BbSidebarHeader>

        <BbSidebarContent>
            <NavMenu />
        </BbSidebarContent>

        <BbSidebarFooter>
            <div class="bb:px-2 bb:py-1 bb:text-xs bb:text-muted-foreground bb:group-data-[collapsible=icon]:hidden">
                CI server · shell preview
            </div>
        </BbSidebarFooter>

        <BbSidebarRail />
    </BbSidebar>

    <BbSidebarInset>
        <BbAppBar Sticky="false" SafeArea="false">
            <LeadingContent>
                <BbSidebarTrigger aria-label="Toggle navigation" />
            </LeadingContent>

            <TitleContent>
                <div class="bb:flex bb:min-w-0 bb:items-center bb:gap-2">
                    <a href="/" class="bb:truncate bb:rounded-md bb:font-semibold bb:tracking-tight bb:focus-visible:outline-none bb:focus-visible:ring-2 bb:focus-visible:ring-ring bb:focus-visible:ring-offset-2">Zenkins</a>

                    <BbSeparator Orientation="SeparatorOrientation.Vertical" Class="bb:h-6" />

                    @* F-001 shows the current organization; F-002 turns this into the real switcher. *@
                    <BbDropdownMenu>
                        <BbDropdownMenuTrigger AsChild>
                            <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" Class="bb:gap-2">
                                <BbAvatar Size="AvatarSize.Small">
                                    <BbAvatarFallback>
                                        <LucideIcon Name="building-2" Class="bb:h-4 bb:w-4" />
                                    </BbAvatarFallback>
                                </BbAvatar>
                                <span class="bb:max-w-60 bb:truncate">@OrganizationLabel</span>
                                <LucideIcon Name="chevrons-up-down" Class="bb:h-4 bb:w-4 bb:opacity-60" />
                            </BbButton>
                        </BbDropdownMenuTrigger>
                        <BbDropdownMenuContent>
                            <BbDropdownMenuLabel>Organization</BbDropdownMenuLabel>
                            @if (_session?.Organization is { } organization)
                            {
                                <BbDropdownMenuItem Disabled="true">
                                    <span class="bb:font-medium">@organization.Name</span>
                                    <span class="bb:ml-2 bb:text-xs bb:text-muted-foreground">@organization.Role</span>
                                </BbDropdownMenuItem>
                                <BbDropdownMenuSeparator />
                                <BbDropdownMenuItem Disabled="true">Switching organizations arrives with the next release</BbDropdownMenuItem>
                            }
                            else
                            {
                                <BbDropdownMenuItem Disabled="true">No organization selected</BbDropdownMenuItem>
                                <BbDropdownMenuSeparator />
                                <BbDropdownMenuItem Href="/no-organization">What to do next</BbDropdownMenuItem>
                            }
                        </BbDropdownMenuContent>
                    </BbDropdownMenu>
                </div>
            </TitleContent>

            <Actions>
                <BbDarkModeToggle />
                <BbDropdownMenu>
                    <BbDropdownMenuTrigger AsChild>
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" aria-label="@UserMenuLabel">
                            <BbAvatar Size="AvatarSize.Small">
                                <BbAvatarFallback>
                                    <LucideIcon Name="user" Class="bb:h-4 bb:w-4" />
                                </BbAvatarFallback>
                            </BbAvatar>
                        </BbButton>
                    </BbDropdownMenuTrigger>
                    <BbDropdownMenuContent>
                        @if (_session is null)
                        {
                            <BbDropdownMenuLabel>Not signed in</BbDropdownMenuLabel>
                            <BbDropdownMenuItem Href="/account/login">Sign in</BbDropdownMenuItem>
                        }
                        else
                        {
                            <BbDropdownMenuLabel>@(_session.Email ?? "Signed in")</BbDropdownMenuLabel>
                            <BbDropdownMenuItem Disabled="true">@(_session.Organization is null ? "No organization" : _session.Organization.Role.ToString())</BbDropdownMenuItem>
                            <BbDropdownMenuSeparator />
                            @* A normal link to the static-SSR sign-out page; the cookie is cleared by a
                               POST form there, not by this navigation. *@
                            <BbDropdownMenuItem Href="/account/logout">Sign out</BbDropdownMenuItem>
                        }
                    </BbDropdownMenuContent>
                </BbDropdownMenu>
            </Actions>
        </BbAppBar>

        <BbScrollArea FillContainer="true"
                      Orientation="ScrollAreaOrientation.Vertical"
                      Type="ScrollAreaType.Auto"
                      ViewportClass="bb:p-4">
            @if (_session is { HasOrganization: false })
            {
                <div class="bb:mb-4">
                    <NoOrganizationNotice />
                </div>
            }
            @Body
        </BbScrollArea>
    </BbSidebarInset>
</BbSidebarProvider>

@code {
    private UserSessionInfo? _session;

    private string OrganizationLabel => _session?.Organization?.Name ?? "No organization";

    // Also what the HTTP smoke test asserts to prove the shell knows who is signed in: the user
    // menu itself is icon-only and its content only renders once the (interactive) menu opens.
    private string UserMenuLabel => _session?.Email is { } email
        ? $"Open user menu for {email}"
        : "Open user menu";

    protected override async Task OnInitializedAsync()
    {
        // Also selects the circuit's tenant (UserSession sets TenantContext), which is how
        // interactive components get a tenant without an HTTP request scope.
        _session = await UserSession.GetAsync();
    }
}
