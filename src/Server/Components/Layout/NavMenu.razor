@using Microsoft.AspNetCore.Components.Routing

<BbSidebarGroup>
    <BbSidebarGroupLabel>Workspace</BbSidebarGroupLabel>
    <BbSidebarGroupContent>
        <BbSidebarMenu>
            <BbSidebarMenuItem>
                <BbSidebarMenuButton Href="/" Match="NavLinkMatch.All" Tooltip="Dashboard">
                    <LucideIcon Name="layout-dashboard" Class="bb:h-4 bb:w-4" />
                    <span>Dashboard</span>
                </BbSidebarMenuButton>
            </BbSidebarMenuItem>
            <BbSidebarMenuItem>
                <BbSidebarMenuButton Href="/projects" Tooltip="Projects">
                    <LucideIcon Name="folder-git-2" Class="bb:h-4 bb:w-4" />
                    <span>Projects</span>
                </BbSidebarMenuButton>
            </BbSidebarMenuItem>
            <BbSidebarMenuItem>
                <BbSidebarMenuButton Href="/workers" Tooltip="Workers">
                    <LucideIcon Name="server" Class="bb:h-4 bb:w-4" />
                    <span>Workers</span>
                </BbSidebarMenuButton>
            </BbSidebarMenuItem>
            <BbSidebarMenuItem>
                <BbSidebarMenuButton Href="/organizations/members" Tooltip="Members">
                    <LucideIcon Name="users" Class="bb:h-4 bb:w-4" />
                    <span>Members</span>
                </BbSidebarMenuButton>
            </BbSidebarMenuItem>
            <BbSidebarMenuItem>
                <BbSidebarMenuButton Href="/secrets" Tooltip="Secrets">
                    <LucideIcon Name="key-round" Class="bb:h-4 bb:w-4" />
                    <span>Secrets</span>
                </BbSidebarMenuButton>
            </BbSidebarMenuItem>
            <BbSidebarMenuItem>
                <BbSidebarMenuButton Href="/snippets" Tooltip="Snippets">
                    <LucideIcon Name="scissors" Class="bb:h-4 bb:w-4" />
                    <span>Snippets</span>
                </BbSidebarMenuButton>
            </BbSidebarMenuItem>
            <BbSidebarMenuItem>
                <BbSidebarMenuButton Href="/api-tokens" Tooltip="API tokens">
                    <LucideIcon Name="key-square" Class="bb:h-4 bb:w-4" />
                    <span>API tokens</span>
                </BbSidebarMenuButton>
            </BbSidebarMenuItem>
        </BbSidebarMenu>
    </BbSidebarGroupContent>
</BbSidebarGroup>
