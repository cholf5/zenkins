@page "/api-tokens"
@attribute [Authorize]
@using Zenkins.Server.Api
@inject UserSession UserSession
@inject ApiTokenService TokenService

<PageTitle>@L10n["API tokens"] · Zenkins</PageTitle>

<div class="bb:mx-auto bb:w-full bb:max-w-4xl bb:space-y-6">
    <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-3">
        <BbCardTitle As="h1" tabindex="-1">@L10n["API tokens"]</BbCardTitle>
        @if (_session?.Organization is { } organization)
        {
            <BbBadge Variant="BadgeVariant.Secondary">@organization.Name</BbBadge>
        }
    </div>

    @if (_session is { HasOrganization: false })
    {
        <NoOrganizationNotice />
    }
    else if (!_canManage)
    {
        @* Owner-only page (F-027, the F-004 rule): a token is a standing authority for the whole
           organization, so a Member must not even learn which labels exist. The endpoints are the
           enforcement; this is the page half of it. *@
        <BbCard>
            <BbCardHeader>
                <BbCardTitle As="h2">@L10n["Owner access required"]</BbCardTitle>
                <BbCardDescription>
                    @L10n["API tokens are managed by organization Owners. Ask an Owner if a script needs one."]
                </BbCardDescription>
            </BbCardHeader>
        </BbCard>
    }
    else
    {
        @if (Notice is { } notice)
        {
            <div role="status" class="bb:rounded-md bb:border bb:border-input bb:bg-muted bb:p-3 bb:text-sm">
                <p>@notice</p>
            </div>
        }

        @if (Error is { } error)
        {
            <div role="alert" class="bb:rounded-md bb:border bb:border-destructive/40 bb:bg-destructive/10 bb:p-3 bb:text-sm bb:text-destructive">
                <p>@error</p>
            </div>
        }

        <BbCard>
            <BbCardHeader>
                <BbCardTitle As="h2">@L10n["New token"]</BbCardTitle>
                <BbCardDescription>
                    @L10n["A bearer token for scripts and other systems:"] <code>Authorization: Bearer &lt;token&gt;</code>
                    @L10n["against"] <code>/api/v1</code>@L10n[". The plaintext is shown once at creation and never stored - only its SHA-256 hash is kept. Each scope opens exactly the routes it names."]
                </BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                <form method="post" action="/api-tokens/create" data-zenkins-antiforgery class="bb:space-y-3">
                    <div class="bb:space-y-2">
                        <label for="api-token-name" class="bb:text-sm bb:font-medium">@L10n["Label"]</label>
                        <input id="api-token-name"
                               name="Name"
                               type="text"
                               required
                               maxlength="@ApiTokenLimits.MaxNameLength"
                               value="@SubmittedName"
                               class="bb:flex bb:h-9 bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-3 bb:py-1 bb:text-sm"
                               autocomplete="off"
                               spellcheck="false"
                               placeholder="deploy pipeline" />
                        <p class="bb:text-xs bb:text-muted-foreground">
                            @L10n["Unique in this organization; it names the token in this list and in the run's cancel reason."]
                        </p>
                    </div>

                    <fieldset class="bb:space-y-1">
                        <legend class="bb:text-sm bb:font-medium">@L10n["Scopes"]</legend>
                        <label class="bb:flex bb:items-center bb:gap-2 bb:text-sm">
                            <input type="checkbox" name="Trigger" value="true" checked />
                            <span><code>trigger</code> @L10n["- queue a run for a project"]</span>
                        </label>
                        <label class="bb:flex bb:items-center bb:gap-2 bb:text-sm">
                            <input type="checkbox" name="Read" value="true" checked />
                            <span><code>read</code> @L10n["- list projects and runs, read a run and its log"]</span>
                        </label>
                        <label class="bb:flex bb:items-center bb:gap-2 bb:text-sm">
                            <input type="checkbox" name="Cancel" value="true" />
                            <span><code>cancel</code> @L10n["- cancel a queued or running run"]</span>
                        </label>
                    </fieldset>

                    <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Default">@L10n["Create token"]</BbButton>
                </form>
            </BbCardContent>
        </BbCard>

        <BbCard>
            <BbCardHeader>
                <BbCardTitle As="h2">@L10n["Tokens"]</BbCardTitle>
                <BbCardDescription>
                    @L10n["Revoking is immediate and permanent; a token that never expires is valid until it is revoked. \"Last used\" moves at most once a minute."]
                </BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                @if (_tokens.Count == 0)
                {
                    <p class="bb:text-sm bb:text-muted-foreground">@L10n["No API tokens yet."]</p>
                }
                else
                {
                    <ul class="bb:divide-y">
                        @foreach (var token in _tokens)
                        {
                            <li class="bb:flex bb:flex-wrap bb:items-center bb:justify-between bb:gap-3 bb:py-3">
                                <div class="bb:min-w-0">
                                    <p class="bb:font-medium">
                                        @token.Name
                                        @if (token.RevokedAt is not null)
                                        {
                                            <BbBadge Variant="BadgeVariant.Destructive">@L10n["Revoked"]</BbBadge>
                                        }
                                        else if (!token.IsActive)
                                        {
                                            <BbBadge Variant="BadgeVariant.Outline">@L10n["Expired"]</BbBadge>
                                        }
                                    </p>
                                    <p class="bb:text-xs bb:text-muted-foreground">
                                        @L10n["Scopes: {0} · Created {1} UTC", string.Join(", ", token.Scopes), token.CreatedAt.ToString("yyyy-MM-dd HH:mm")]
                                    </p>
                                    <p class="bb:text-xs bb:text-muted-foreground">
                                        @(token.LastUsedAt is { } used ? L10n["Last used {0} UTC", used.ToString("yyyy-MM-dd HH:mm")] : L10n["Never used"])
                                    </p>
                                </div>
                                @if (token.RevokedAt is null)
                                {
                                    <form method="post" action="/api-tokens/@token.Id/revoke" data-zenkins-antiforgery>
                                        <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Outline">@L10n["Revoke"]</BbButton>
                                    </form>
                                }
                            </li>
                        }
                    </ul>
                }
            </BbCardContent>
        </BbCard>
    }
</div>

@code {
    private UserSessionInfo? _session;
    private IReadOnlyList<ApiTokenView> _tokens = [];
    private bool _canManage;

    [SupplyParameterFromQuery(Name = "notice")]
    private string? NoticeCode { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    private string? ErrorCode { get; set; }

    [SupplyParameterFromQuery(Name = "name")]
    private string? SubmittedName { get; set; }

    private string? Notice => NoticeCode switch
    {
        "token-revoked" => L10n["The API token was revoked. Requests with it are refused from now on."],
        _ => null,
    };

    private string? Error => ErrorCode switch
    {
        ApiErrorCodes.NameRequired => L10n["A label is required."],
        ApiErrorCodes.NameInvalid => L10n["The label is too long or contains a control character."],
        ApiErrorCodes.NameTaken => L10n["This organization already has a token with that label."],
        ApiErrorCodes.ScopeRequired => L10n["Choose at least one scope."],
        ApiErrorCodes.ScopeInvalid => L10n["One of the chosen scopes is not known."],
        ApiErrorCodes.TokenAlreadyRevoked => L10n["That token is already revoked."],
        _ => null,
    };

    protected override async Task OnInitializedAsync()
    {
        // Resolving the session selects the circuit's tenant before any tenant-owned row is read.
        _session = await UserSession.GetAsync();
        if (_session?.HasOrganization != true)
        {
            return;
        }

        _canManage = _session.CanManageActiveOrganization;
        if (_canManage)
        {
            _tokens = await TokenService.GetTokensAsync(_session.UserId);
        }
    }
}
