@page "/error"

<PageTitle>Something went wrong · Zenkins</PageTitle>

<div class="bb:mx-auto bb:w-full bb:max-w-2xl">
    <BbCard>
        <BbCardHeader>
            <BbCardTitle As="h1">Something went wrong</BbCardTitle>
            <BbCardDescription>
                The server could not finish rendering this page. Reload to try again.
            </BbCardDescription>
        </BbCardHeader>
        <BbCardContent>
            <BbButton Href="/" Variant="ButtonVariant.Default">Back to dashboard</BbButton>
        </BbCardContent>
    </BbCard>
</div>
