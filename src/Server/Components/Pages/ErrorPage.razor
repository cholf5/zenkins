@page "/error"

<PageTitle>@L10n["Something went wrong"] · Zenkins</PageTitle>

<div class="bb:mx-auto bb:w-full bb:max-w-2xl">
    <BbCard>
        <BbCardHeader>
            <BbCardTitle As="h1" tabindex="-1">@L10n["Something went wrong"]</BbCardTitle>
            <BbCardDescription>
                @L10n["The server could not finish rendering this page. Reload to try again."]
            </BbCardDescription>
        </BbCardHeader>
        <BbCardContent>
            <BbButton Href="/" Variant="ButtonVariant.Default">@L10n["Back to dashboard"]</BbButton>
        </BbCardContent>
    </BbCard>
</div>
