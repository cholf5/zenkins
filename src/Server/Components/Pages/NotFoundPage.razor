@page "/not-found"

<PageTitle>Page not found · Zenkins</PageTitle>

<div class="bb:mx-auto bb:w-full bb:max-w-2xl">
    <BbCard>
        <BbCardHeader>
            <BbCardTitle As="h1">Page not found</BbCardTitle>
            <BbCardDescription>
                The page you asked for does not exist. Use the navigation to pick a workspace section.
            </BbCardDescription>
        </BbCardHeader>
        <BbCardContent>
            <BbButton Href="/" Variant="ButtonVariant.Default">Back to dashboard</BbButton>
        </BbCardContent>
    </BbCard>
</div>
