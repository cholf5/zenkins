@page "/not-found"

<PageTitle>@L10n["Page not found"] · Zenkins</PageTitle>

<div class="bb:mx-auto bb:w-full bb:max-w-2xl">
    <BbCard>
        <BbCardHeader>
            <BbCardTitle As="h1" tabindex="-1">@L10n["Page not found"]</BbCardTitle>
            <BbCardDescription>
                @L10n["The page you asked for does not exist. Use the navigation to pick a workspace section."]
            </BbCardDescription>
        </BbCardHeader>
        <BbCardContent>
            <BbButton Href="/" Variant="ButtonVariant.Default">@L10n["Back to dashboard"]</BbButton>
        </BbCardContent>
    </BbCard>
</div>
