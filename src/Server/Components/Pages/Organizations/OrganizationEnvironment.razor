@page "/organizations/environment"
@attribute [Authorize]
@using Zenkins.Server.Environments
@using Zenkins.Shared.Pipelines
@inject UserSession UserSession
@inject OrganizationEnvironmentService Variables

<PageTitle>@L10n["Environment"] · Zenkins</PageTitle>

<div class="bb:mx-auto bb:w-full bb:max-w-4xl bb:space-y-6">
    <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-3">
        <BbCardTitle As="h1" tabindex="-1">@L10n["Organization environment"]</BbCardTitle>
        @if (_session?.Organization is { } organization)
        {
            <BbBadge Variant="BadgeVariant.Secondary">@organization.Name</BbBadge>
            <BbBadge Variant="BadgeVariant.Outline">@L10n["Your role: {0}", DisplayText.Role(organization.Role, L10n)]</BbBadge>
        }
    </div>

    @if (_session is { HasOrganization: false })
    {
        <NoOrganizationNotice />
    }
    else
    {
        @* AC1: the values are configuration, not credentials. Saying so next to the form is the point -
           anything sensitive belongs in Secrets, which are Owner-only and write-only. *@
        <BbCard>
            <BbCardHeader>
                <BbCardTitle As="h2">@L10n["Configuration, not secrets"]</BbCardTitle>
                <BbCardDescription>
                    @L10n["Every project's steps receive these variables, frozen onto each run when it is queued. The values are plain configuration: they are shown here, on the run page and in any log a step echoes them into. Anything sensitive belongs in"]
                    <a href="/secrets" class="bb:font-medium bb:underline bb:underline-offset-4">@L10n["Secrets"]</a>@L10n[", which are encrypted and write-only."]
                </BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                <p class="bb:text-sm bb:text-muted-foreground">
                    @L10n["Precedence, lowest first:"] <code>ZENKINS_*</code> @L10n["run metadata"] → @L10n["organization variables"] → @L10n["build parameters"] → @L10n["pipeline"] <code>env</code> → @L10n["step"] <code>env</code>. @L10n["Names beginning with"] <code>@string.Join(", ", ServerEnvironmentNames.ReservedPrefixes)</code> @L10n["are reserved for the server's own metadata and cannot be used here."]
                </p>
            </BbCardContent>
        </BbCard>

        @if (Notice is { } notice)
        {
            <div role="status" class="bb:rounded-md bb:border bb:border-input bb:bg-muted bb:p-3 bb:text-sm">
                <p>@notice</p>
            </div>
        }

        @if (Error is { } error)
        {
            <div role="alert" class="bb:rounded-md bb:border bb:border-destructive/40 bb:bg-destructive/10 bb:p-3 bb:text-sm bb:text-destructive">
                <p>@error</p>
            </div>
        }

        @if (_canManage)
        {
            <BbCard>
                <BbCardHeader>
                    <BbCardTitle As="h2">@L10n["New variable"]</BbCardTitle>
                    <BbCardDescription>
                        @L10n["The name must be usable as an environment variable (letters, digits and underscores) and unique in this organization. An organization holds at most {0} variables of at most {1} characters each.", OrganizationEnvironmentValidation.MaxVariables, OrganizationEnvironmentValidation.MaxValueLength]
                    </BbCardDescription>
                </BbCardHeader>
                <BbCardContent>
                    <form method="post" action="/organizations/environment/create" data-zenkins-antiforgery data-field-row class="bb:flex bb:flex-col bb:gap-3 bb:sm:flex-row">
                        <div class="bb:flex-1 bb:space-y-2">
                            <label for="environment-name" class="bb:text-sm bb:font-medium">@L10n["Name"]</label>
                            <input id="environment-name"
                                   name="Name"
                                   type="text"
                                   required
                                   maxlength="@OrganizationEnvironmentValidation.MaxNameLength"
                                   pattern="[A-Za-z_][A-Za-z0-9_]*"
                                   value="@SubmittedName"
                                   class="bb:flex bb:h-10 bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-3 bb:py-1 bb:text-sm"
                                   autocomplete="off"
                                   spellcheck="false"
                                   placeholder="REGISTRY_HOST" />
                        </div>
                        <div class="bb:flex-1 bb:space-y-2">
                            <label for="environment-value" class="bb:text-sm bb:font-medium">@L10n["Value"]</label>
                            <input id="environment-value"
                                   name="Value"
                                   type="text"
                                   required
                                   class="bb:flex bb:h-10 bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-3 bb:py-1 bb:text-sm"
                                   autocomplete="off"
                                   spellcheck="false"
                                   placeholder="registry.internal" />
                        </div>
                        <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Default">@L10n["Add variable"]</BbButton>
                    </form>
                </BbCardContent>
            </BbCard>
        }

        <BbCard>
            <BbCardHeader>
                <BbCardTitle As="h2">@L10n["Variables of this organization"]</BbCardTitle>
                <BbCardDescription>
                    @(_canManage
                        ? L10n["Edits and deletes change future runs only: a queued or finished run keeps the snapshot it was created with."]
                        : L10n["Read-only: only an organization Owner can add, edit or delete these. Every project's steps receive them."])
                </BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                @if (_variables.Count == 0)
                {
                    <BbEmpty Title="@L10n["No variables configured"]"
                             Description="@L10n["Add a variable above to make it available to every project's steps."]">
                        <Icon>
                            <LucideIcon Name="variable" Class="bb:h-12 bb:w-12" />
                        </Icon>
                    </BbEmpty>
                }
                else
                {
                    <div class="bb:overflow-x-auto">
                        <table class="bb:w-full bb:text-sm">
                            <thead>
                                <tr class="bb:border-b bb:text-start bb:text-muted-foreground">
                                    <th class="bb:py-2 bb:pe-4 bb:font-medium">@L10n["Name"]</th>
                                    <th class="bb:py-2 bb:pe-4 bb:font-medium">@L10n["Value"]</th>
                                    <th class="bb:py-2 bb:pe-4 bb:font-medium">@L10n["Updated"]</th>
                                    @if (_canManage)
                                    {
                                        <th class="bb:py-2 bb:font-medium">@L10n["Manage"]</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var variable in _variables)
                                {
                                    <tr class="bb:border-b bb:align-top">
                                        <td class="bb:py-3 bb:pe-4 bb:font-medium bb:font-mono">@variable.Name</td>
                                        <td id="@($"environment-value-{variable.Name}")"
                                            class="bb:py-3 bb:pe-4 bb:whitespace-pre-wrap bb:break-all bb:font-mono">@variable.Value</td>
                                        <td class="bb:py-3 bb:pe-4">@L10n["{0} UTC", variable.UpdatedAt.ToString("yyyy-MM-dd HH:mm")]</td>
                                        @if (_canManage)
                                        {
                                            <td class="bb:py-3">
                                                <div class="bb:flex bb:flex-col bb:gap-2">
                                                    <details class="bb:inline-block">
                                                        <summary class="bb:cursor-pointer bb:rounded-md bb:border bb:border-input bb:px-2 bb:py-1 bb:text-xs">
                                                            @L10n["Edit…"]
                                                        </summary>
                                                        <form method="post" action="/organizations/environment/@variable.Id/update" data-zenkins-antiforgery class="bb:mt-2 bb:flex bb:flex-col bb:gap-2">
                                                            <label for="edit-name-@variable.Id" class="bb:sr-only">Name</label>
                                                            <input id="edit-name-@variable.Id"
                                                                   name="Name"
                                                                   value="@variable.Name"
                                                                   required
                                                                   maxlength="@OrganizationEnvironmentValidation.MaxNameLength"
                                                                   pattern="[A-Za-z_][A-Za-z0-9_]*"
                                                                   class="bb:h-8 bb:w-56 bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-2 bb:py-1 bb:text-xs bb:font-mono"
                                                                   autocomplete="off"
                                                                   spellcheck="false" />
                                                            <label for="edit-value-@variable.Id" class="bb:sr-only">Value</label>
                                                            <input id="edit-value-@variable.Id"
                                                                   name="Value"
                                                                   value="@variable.Value"
                                                                   required
                                                                   class="bb:h-8 bb:w-56 bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-2 bb:py-1 bb:text-xs bb:font-mono"
                                                                   autocomplete="off"
                                                                   spellcheck="false" />
                                                            <button type="submit"
                                                                    class="bb:self-start bb:rounded-md bb:border bb:border-input bb:px-2 bb:py-1 bb:text-xs bb:hover:bg-accent">
                                                                @L10n["Save"]
                                                            </button>
                                                        </form>
                                                    </details>

                                                    <details class="bb:inline-block">
                                                        <summary class="bb:cursor-pointer bb:rounded-md bb:border bb:border-destructive/40 bb:px-2 bb:py-1 bb:text-xs bb:text-destructive">
                                                            @L10n["Delete…"]
                                                        </summary>
                                                        <form method="post" action="/organizations/environment/@variable.Id/delete" data-zenkins-antiforgery class="bb:mt-2 bb:flex bb:flex-col bb:gap-2">
                                                            <span class="bb:text-xs bb:text-muted-foreground">
                                                                @L10n["Delete {0}? Runs already queued keep the snapshot they were created with.", variable.Name]
                                                            </span>
                                                            <button type="submit"
                                                                    class="bb:self-start bb:rounded-md bb:border bb:border-destructive/40 bb:px-2 bb:py-1 bb:text-xs bb:text-destructive bb:hover:bg-destructive/10">
                                                                @L10n["Confirm delete"]
                                                            </button>
                                                        </form>
                                                    </details>
                                                </div>
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </BbCardContent>
        </BbCard>
    }
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private UserSessionInfo? _session;
    private IReadOnlyList<OrganizationEnvironmentView> _variables = [];
    private bool _canManage;

    [SupplyParameterFromQuery(Name = "notice")]
    private string? NoticeCode { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    private string? ErrorCode { get; set; }

    [SupplyParameterFromQuery(Name = "name")]
    private string? SubmittedName { get; set; }

    private string? Notice => NoticeCode switch
    {
        "created" => L10n["The variable was added."],
        "updated" => L10n["The variable was saved. Runs already queued keep their own snapshot."],
        "deleted" => L10n["The variable was deleted. Runs already queued keep their own snapshot."],
        _ => null,
    };

    // The value never travels in a query, so a form-level refusal carries no field name to echo.
    private string? Error => OrganizationEnvironmentErrorCodes.MessageFor(ErrorCode, L10n);

    protected override async Task OnInitializedAsync()
    {
        // The session first: it establishes the circuit tenant before any tenant-filtered row is read.
        _session = await UserSession.GetAsync();
        _canManage = _session?.CanManageActiveOrganization == true;

        if (_session?.HasOrganization != true)
        {
            return;
        }

        // A Member reads the list (the values reach every step they can see); the mutations stay
        // Owner-only, enforced in the service and in the endpoints.
        var list = await Variables.GetVariablesAsync(_session.UserId);
        if (list.Status == OrganizationEnvironmentStatus.Forbidden)
        {
            _variables = [];
            return;
        }

        _variables = list.Variables;
    }
}
