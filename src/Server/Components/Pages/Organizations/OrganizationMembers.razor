@page "/organizations/members"
@attribute [Authorize]
@inject UserSession UserSession
@inject OrganizationManagementService Management

<PageTitle>@L10n["Members"] · Zenkins</PageTitle>

<div class="bb:mx-auto bb:w-full bb:max-w-4xl bb:space-y-6">
    <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-3">
        <BbCardTitle As="h1" tabindex="-1">@L10n["Members"]</BbCardTitle>
        @if (_session?.Organization is { } organization)
        {
            <BbBadge Variant="BadgeVariant.Secondary">@organization.Name</BbBadge>
            <BbBadge Variant="BadgeVariant.Outline">@L10n["Your role: {0}", DisplayText.Role(organization.Role, L10n)]</BbBadge>
        }
    </div>

    @if (_session is { HasOrganization: false })
    {
        <NoOrganizationNotice />
    }
    else
    {
        @if (Notice is { } notice)
        {
            <div role="status" class="bb:rounded-md bb:border bb:border-input bb:bg-muted bb:p-3 bb:text-sm">
                <p>@notice</p>
            </div>
        }

        @if (Error is { } error)
        {
            <div role="alert" class="bb:rounded-md bb:border bb:border-destructive/40 bb:bg-destructive/10 bb:p-3 bb:text-sm bb:text-destructive">
                <p>@error</p>
            </div>
        }

        @if (_canManage)
        {
            <BbCard>
                <BbCardHeader>
                    <BbCardTitle As="h2">@L10n["Invite a member"]</BbCardTitle>
                    <BbCardDescription>
                        @L10n["Invitations in v0.1 attach an existing account by email; no email is sent. The new member joins this organization with the Member role."]
                    </BbCardDescription>
                </BbCardHeader>
                <BbCardContent>
                    <form method="post" action="/organizations/members/invite" data-zenkins-antiforgery data-field-row class="bb:flex bb:flex-col bb:gap-3 bb:sm:flex-row">
                        <div class="bb:flex-1 bb:space-y-2">
                            <label for="invite-email" class="bb:text-sm bb:font-medium">@L10n["Email address"]</label>
                            <input id="invite-email"
                                   name="Email"
                                   type="email"
                                   required
                                   class="bb:flex bb:h-10 bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-3 bb:py-1 bb:text-sm"
                                   autocomplete="off"
                                   placeholder="teammate@example.com" />
                        </div>
                        <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Default">@L10n["Invite"]</BbButton>
                    </form>
                </BbCardContent>
            </BbCard>
        }

        <BbCard>
            <BbCardHeader>
                <BbCardTitle As="h2">@L10n["Members of this organization"]</BbCardTitle>
                <BbCardDescription>
                    @L10n["Name, email, role and joined date. Owners manage roles and removal; Members see the list only."]
                </BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                @if (_members.Count == 0)
                {
                    <BbEmpty Title="@L10n["No members"]"
                             Description="@L10n["This organization has no members yet."]">
                        <Icon>
                            <LucideIcon Name="users" Class="bb:h-12 bb:w-12" />
                        </Icon>
                    </BbEmpty>
                }
                else
                {
                    <div class="bb:overflow-x-auto">
                        <table class="bb:w-full bb:text-sm">
                            <thead>
                                <tr class="bb:border-b bb:text-start bb:text-muted-foreground">
                                    <th class="bb:py-2 bb:pe-4 bb:font-medium">@L10n["Name"]</th>
                                    <th class="bb:py-2 bb:pe-4 bb:font-medium">@L10n["Email"]</th>
                                    <th class="bb:py-2 bb:pe-4 bb:font-medium">@L10n["Role"]</th>
                                    <th class="bb:py-2 bb:pe-4 bb:font-medium">@L10n["Joined"]</th>
                                    @if (_canManage)
                                    {
                                        <th class="bb:py-2 bb:font-medium">@L10n["Manage"]</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var member in _members)
                                {
                                    <tr class="bb:border-b bb:align-middle">
                                        <td class="bb:py-3 bb:pe-4">@member.Name</td>
                                        <td class="bb:py-3 bb:pe-4">@member.Email</td>
                                        <td class="bb:py-3 bb:pe-4">
                                            <BbBadge Variant="@(member.Role == OrganizationRole.Owner ? BadgeVariant.Default : BadgeVariant.Secondary)">
                                                @DisplayText.Role(member.Role, L10n)
                                            </BbBadge>
                                            @if (_ownerCount == 1 && member.Role == OrganizationRole.Owner)
                                            {
                                                <span class="bb:ms-2 bb:text-xs bb:text-muted-foreground">@L10n["last owner"]</span>
                                            }
                                        </td>
                                        <td class="bb:py-3 bb:pe-4">@member.JoinedAt.ToString("yyyy-MM-dd")</td>
                                        @if (_canManage)
                                        {
                                            <td class="bb:py-3">
                                                <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-2">
                                                    <form method="post" action="/organizations/members/role" data-zenkins-antiforgery class="bb:flex bb:items-center bb:gap-2">
                                                        <input type="hidden" name="MembershipId" value="@member.MembershipId" />
                                                        <input type="hidden" name="Role" value="@(member.Role == OrganizationRole.Owner ? nameof(OrganizationRole.Member) : nameof(OrganizationRole.Owner))" />
                                                        <button type="submit"
                                                                class="bb:rounded-md bb:border bb:border-input bb:px-2 bb:py-1 bb:text-xs bb:hover:bg-accent">
                                                            @(member.Role == OrganizationRole.Owner ? L10n["Make Member"] : L10n["Make Owner"])
                                                        </button>
                                                    </form>

                                                    <form method="post" action="/organizations/members/remove" data-zenkins-antiforgery>
                                                        <input type="hidden" name="MembershipId" value="@member.MembershipId" />
                                                        <button type="submit"
                                                                class="bb:rounded-md bb:border bb:border-destructive/40 bb:px-2 bb:py-1 bb:text-xs bb:text-destructive bb:hover:bg-destructive/10">
                                                            @L10n["Remove"]
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </BbCardContent>
        </BbCard>

        @if (_canManage)
        {
            <p class="bb:text-sm bb:text-muted-foreground">
                <a href="/organizations/settings" class="bb:font-medium bb:underline bb:underline-offset-4">@L10n["Organization settings"]</a>
                · @L10n["The last Owner cannot be demoted or removed; promote another member to Owner first."]
            </p>
        }
    }
</div>

@code {
    private UserSessionInfo? _session;
    private IReadOnlyList<OrganizationMemberView> _members = [];
    private bool _canManage;
    private int _ownerCount;

    [SupplyParameterFromQuery(Name = "notice")]
    private string? NoticeCode { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    private string? ErrorCode { get; set; }

    private string? Notice => NoticeCode switch
    {
        "invited" => L10n["The account was added to this organization."],
        "role-changed" => L10n["The member's role was updated."],
        "member-removed" => L10n["The member was removed from this organization."],
        _ => null,
    };

    private string? Error => ErrorCode switch
    {
        "last-owner" => L10n["The last Owner cannot be demoted or removed. Make another member an Owner first."],
        "unknown-email" => L10n["No account exists with that email address. Invitations in v0.1 attach existing accounts only."],
        "already-member" => L10n["That account is already a member of this organization."],
        "invalid-email" => L10n["Enter the email address of an existing account."],
        "invalid-role" => L10n["Choose either Owner or Member."],
        "member-not-found" => L10n["That member no longer exists in this organization."],
        "forbidden" => L10n["Only an organization Owner can manage members."],
        null => null,
        _ => L10n["The change was not applied."],
    };

    protected override async Task OnInitializedAsync()
    {
        // Resolving the session first establishes the circuit tenant (F-003 hazard); only then may
        // the member list be read through the tenant-filtered context.
        _session = await UserSession.GetAsync();
        _canManage = _session?.CanManageActiveOrganization == true;

        if (_session?.HasOrganization == true)
        {
            _members = await Management.GetMembersAsync();
            _ownerCount = _members.Count(member => member.Role == OrganizationRole.Owner);
        }
    }
}
