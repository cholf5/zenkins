@page "/organizations/settings"
@attribute [Authorize]
@inject UserSession UserSession

<PageTitle>Organization settings · Zenkins</PageTitle>

<div class="bb:mx-auto bb:w-full bb:max-w-2xl bb:space-y-6">
    <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-3">
        <BbCardTitle As="h1" tabindex="-1">Organization settings</BbCardTitle>
        @if (_session?.Organization is { } organization)
        {
            <BbBadge Variant="BadgeVariant.Secondary">@organization.Name</BbBadge>
        }
    </div>

    @if (_session is { HasOrganization: false })
    {
        <NoOrganizationNotice />
    }
    else if (_session is not null && !_session.CanManageActiveOrganization)
    {
        @* A Member gets no management control here; the POST endpoint enforces the same rule. *@
        <BbCard>
            <BbCardHeader>
                <BbCardTitle As="h2">Owner access required</BbCardTitle>
                <BbCardDescription>
                    Organization settings, member management, Workers, Secrets and Projects are Owner-only
                    (PRD §3.1.2). Your role in this organization is Member.
                </BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                <BbButton Href="/organizations/members" Variant="ButtonVariant.Outline">View members</BbButton>
            </BbCardContent>
        </BbCard>
    }
    else if (_session is { HasOrganization: true, CanManageActiveOrganization: true })
    {
        @if (Notice is { } notice)
        {
            <div role="status" class="bb:rounded-md bb:border bb:border-input bb:bg-muted bb:p-3 bb:text-sm">
                <p>@notice</p>
            </div>
        }

        @if (Error is { } error)
        {
            <div role="alert" class="bb:rounded-md bb:border bb:border-destructive/40 bb:bg-destructive/10 bb:p-3 bb:text-sm bb:text-destructive">
                <p>@error</p>
            </div>
        }

        <BbCard>
            <BbCardHeader>
                <BbCardTitle As="h2">Rename organization</BbCardTitle>
                <BbCardDescription>
                    The name appears in the shell switcher for every member. The change is validated
                    again on the server; a Member's POST is rejected with 403.
                </BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                <form method="post" action="/organizations/settings" data-zenkins-antiforgery class="bb:space-y-4">
                    <div class="bb:space-y-2">
                        <label for="organization-name" class="bb:text-sm bb:font-medium">Organization name</label>
                        <input id="organization-name"
                               name="Name"
                               value="@_session!.Organization!.Name"
                               required
                               maxlength="200"
                               class="bb:flex bb:h-9 bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-3 bb:py-1 bb:text-sm"
                               autocomplete="off" />
                    </div>
                    <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Default">Save name</BbButton>
                </form>
            </BbCardContent>
        </BbCard>

        <BbCard>
            <BbCardHeader>
                <BbCardTitle As="h2">Members</BbCardTitle>
                <BbCardDescription>
                    Invite existing accounts, change roles and remove members from the members page.
                </BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                <BbButton Href="/organizations/members" Variant="ButtonVariant.Outline">Manage members</BbButton>
            </BbCardContent>
        </BbCard>
    }
</div>

@code {
    private UserSessionInfo? _session;

    [SupplyParameterFromQuery(Name = "notice")]
    private string? NoticeCode { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    private string? ErrorCode { get; set; }

    private string? Notice => NoticeCode switch
    {
        "renamed" => "The organization name was updated.",
        _ => null,
    };

    private string? Error => ErrorCode switch
    {
        "last-owner" => "The last Owner cannot be demoted or removed. Make another member an Owner first.",
        "invalid-name" => "Enter an organization name of at most 200 characters.",
        "forbidden" => "Only an organization Owner can change these settings.",
        "organization-not-found" => "This organization no longer exists.",
        null => null,
        _ => "The change was not applied.",
    };

    protected override async Task OnInitializedAsync()
    {
        // Also establishes the circuit tenant before any tenant-owned data is read.
        _session = await UserSession.GetAsync();
    }
}
