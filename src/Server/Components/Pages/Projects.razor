@page "/projects"
@attribute [Authorize]

<PageTitle>Projects · Zenkins</PageTitle>

<div class="bb:mx-auto bb:w-full bb:max-w-4xl bb:space-y-6">
    <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-3">
        <BbCardTitle As="h1" tabindex="-1">Projects</BbCardTitle>
        <BbBadge Variant="BadgeVariant.Secondary">Shell preview</BbBadge>
    </div>

    <BbCard>
        <BbCardHeader>
            <BbCardTitle As="h2">Repositories</BbCardTitle>
            <BbCardDescription>
                Each project pairs a Git repository with a default branch and a pipeline file.
            </BbCardDescription>
        </BbCardHeader>
        <BbCardContent>
            <BbEmpty Title="No projects yet"
                     Description="Project creation arrives in a later card. This page is a navigation target for the shell.">
                <Icon>
                    <LucideIcon Name="folder-git-2" Class="bb:h-12 bb:w-12" />
                </Icon>
            </BbEmpty>
        </BbCardContent>
    </BbCard>
</div>
