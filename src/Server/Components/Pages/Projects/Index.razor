@page "/projects"
@attribute [Authorize]
@inject UserSession UserSession
@inject FolderService Folders

<PageTitle>Projects · Zenkins</PageTitle>

<div class="bb:mx-auto bb:w-full bb:max-w-4xl bb:space-y-6">
    <div class="bb:flex bb:flex-wrap bb:items-center bb:justify-between bb:gap-3">
        <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-3">
            <BbCardTitle As="h1" tabindex="-1">Projects</BbCardTitle>
            @if (_session?.Organization is { } organization)
            {
                <BbBadge Variant="BadgeVariant.Secondary">@organization.Name</BbBadge>
            }
        </div>
        @if (_session is { HasOrganization: true })
        {
            <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-2">
                <BbButton Href="/folders/new" Variant="ButtonVariant.Outline">New folder</BbButton>
                <BbButton Href="/projects/new" Variant="ButtonVariant.Default">New project</BbButton>
            </div>
        }
    </div>

    @if (_session is { HasOrganization: false })
    {
        <NoOrganizationNotice />
    }
    else if (_listing is not null)
    {
        @if (Notice is { } notice)
        {
            <div role="status" class="bb:rounded-md bb:border bb:border-input bb:bg-muted bb:p-3 bb:text-sm">
                <p>@notice</p>
            </div>
        }

        @if (Error is { } error)
        {
            <div role="alert" class="bb:rounded-md bb:border bb:border-destructive/40 bb:bg-destructive/10 bb:p-3 bb:text-sm bb:text-destructive">
                <p>@error</p>
            </div>
        }

        <BbCard>
            <BbCardHeader>
                <BbCardTitle As="h2">This organization's projects</BbCardTitle>
                <BbCardDescription>
                    Folders group projects; a project's name is unique inside its folder, and its URL
                    stays <code>/projects/{id}</code> wherever it sits. Members may create and edit;
                    deleting a project is reserved to Owners (PRD §3.1.2).
                </BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                <FolderListing Listing="@_listing" FolderOptions="@_options" SearchPath="/projects" />
            </BbCardContent>
        </BbCard>
    }
</div>

@code {
    private UserSessionInfo? _session;
    private ProjectListing? _listing;
    private IReadOnlyList<FolderOption> _options = [];

    [SupplyParameterFromQuery(Name = "notice")]
    private string? NoticeCode { get; set; }

    [SupplyParameterFromQuery(Name = "q")]
    private string? Query { get; set; }

    /// <summary>F-042 AC-6: <c>all</c> searches the whole organization, anything else this subtree.</summary>
    [SupplyParameterFromQuery(Name = "scope")]
    private string? Scope { get; set; }

    /// <summary>
    /// The root listing also carries a project-move refusal: the move form lives on the listing, and the
    /// endpoint redirects back here with the stable code (and the existing project's name).
    /// </summary>
    [SupplyParameterFromQuery(Name = "error")]
    private string? ErrorCode { get; set; }

    [SupplyParameterFromQuery(Name = "conflict")]
    private string? ConflictName { get; set; }

    private bool Everywhere => string.Equals(Scope, "all", StringComparison.OrdinalIgnoreCase);

    private string? Notice => NoticeCode switch
    {
        "created" => "The project was created.",
        "updated" => "The project was updated.",
        "deleted" => "The project was deleted.",
        "folder-deleted" => "The folder was deleted.",
        "project-moved" => "The project was moved. Open its folder to see it in place.",
        _ => null,
    };

    private string? Error =>
        (FolderErrorCodes.MessageFor(ErrorCode) ?? ProjectErrorCodes.MessageFor(ErrorCode)) is { } message
            ? ConflictName is { Length: > 0 } conflict
                ? $"{message} The project already in that folder is '{conflict}' - nothing was renamed."
                : message
            : null;

    protected override async Task OnInitializedAsync()
    {
        // F-003 hazard: resolving the session selects the circuit's tenant before any tenant-owned
        // row is read. Never rely on the layout having done it first.
        _session = await UserSession.GetAsync();
        if (_session?.HasOrganization != true)
        {
            return;
        }

        _listing = await Folders.GetListingAsync(folderId: null, Query, Everywhere);
        _options = await Folders.GetOptionsAsync();
    }
}
