@page "/projects/{ProjectId:guid}/branches"
@attribute [Authorize]
@using Zenkins.Server.Branches
@using Zenkins.Shared.Projects
@inject UserSession UserSession
@inject ProjectService ProjectsService
@inject BranchService BranchesService

@* F-023: the Branches tab. Each row is a branch job: the branch's own runs, its own last status, and
   the pipeline verdict a worker actually observed. A branch seen and never built is a first-class row
   (state "no pipeline"), not a missing run - and an upstream-deleted branch stays listed, marked
   orphaned, with its history intact. *@
<PageTitle>@L10n["Branches"] · @(_project?.Name ?? L10n["Project"]) · Zenkins</PageTitle>

<div class="bb:mx-auto bb:w-full bb:max-w-4xl bb:space-y-6">
    @if (_project is null)
    {
        @* Foreign tenant id == missing id: the service reads through the tenant filter and the
           response is a real 404 (the same pattern as the other project tabs). *@
        <NotFoundPage />
    }
    else
    {
        <div class="bb:flex bb:flex-wrap bb:items-center bb:justify-between bb:gap-3">
            <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-3">
                <BbCardTitle As="h1" tabindex="-1">@L10n["Branches"] · @_project.Name</BbCardTitle>
                @if (BranchDiscoveryModes.IsMultibranch(_project.BranchDiscovery))
                {
                    <BbBadge Variant="BadgeVariant.Secondary">@L10n["Multibranch"]</BbBadge>
                }
                else
                {
                    <BbBadge Variant="BadgeVariant.Outline">@L10n["Single branch"]</BbBadge>
                }
                @if (_project.Disabled)
                {
                    <BbBadge Variant="BadgeVariant.Destructive">@L10n["Disabled"]</BbBadge>
                }
            </div>
        </div>

        <ProjectTabs ProjectId="@_project.Id" Active="branches" Kind="@_project.Kind"
                     BranchDiscovery="@_project.BranchDiscovery" />

        @if (!BranchDiscoveryModes.IsMultibranch(_project.BranchDiscovery))
        {
            <BbCard>
                <BbCardHeader>
                    <BbCardTitle As="h2">@L10n["Branch discovery is off"]</BbCardTitle>
                    <BbCardDescription>
                        @L10n["This project builds one branch (its default branch) - today's behaviour. Switch it to"]
                        <strong>@L10n["Every branch"]</strong> @L10n["on the edit page to turn each branch of the repository into its own branch job."]
                    </BbCardDescription>
                </BbCardHeader>
                <BbCardContent>
                    <BbButton Href="@($"/projects/{_project.Id}/edit")" Variant="ButtonVariant.Outline">@L10n["Edit project"]</BbButton>
                </BbCardContent>
            </BbCard>
        }
        else
        {
            <BbCard>
                <BbCardHeader>
                    <BbCardTitle As="h2">@L10n["Branch jobs"]</BbCardTitle>
                    <BbCardDescription>
                        @L10n["One job per branch, with its own runs and its own last status: a push to one branch only ever touches that branch's history. Settings, credentials and parameters stay defined once on the project."]
                    </BbCardDescription>
                </BbCardHeader>
                <BbCardContent>
                    @if (_branches.Count == 0)
                    {
                        <BbEmpty Title="@L10n["No branches seen yet"]"
                                 Description="@L10n["A push to a branch the webhook selects registers it here, and a branch with the pipeline file builds under its own name."]">
                            <Icon>
                                <LucideIcon Name="git-branch" Class="bb:h-12 bb:w-12" />
                            </Icon>
                        </BbEmpty>
                    }
                    else
                    {
                        <ul class="bb:divide-y">
                            @foreach (var branch in _branches)
                            {
                                <li class="bb:flex bb:flex-wrap bb:items-center bb:justify-between bb:gap-3 bb:py-3">
                                    <div class="bb:min-w-0 bb:space-y-1">
                                        <p class="bb:flex bb:flex-wrap bb:items-center bb:gap-2">
                                            <a href="@RunsHref(branch.Branch)"
                                               class="bb:font-medium bb:underline bb:underline-offset-4 bb:break-all">@branch.Branch</a>
                                            @if (branch.IsNoPipeline)
                                            {
                                                <BbBadge Variant="BadgeVariant.Secondary">@L10n["No pipeline"]</BbBadge>
                                            }
                                            else if (branch.PipelineState == BranchPipelineStates.HasPipeline)
                                            {
                                                <BbBadge Variant="BadgeVariant.Outline">@L10n["Pipeline"]</BbBadge>
                                            }
                                            else
                                            {
                                                <BbBadge Variant="BadgeVariant.Outline">@L10n["Not observed"]</BbBadge>
                                            }
                                            @if (branch.PendingCommit is { } pendingCommit)
                                            {
                                                @* The push was accepted but no Worker has read this head yet,
                                                   so nothing was built - the page says exactly that instead
                                                   of leaving the row looking like a missing run. *@
                                                @* D1: the retry count is part of the fact, not a detail - a read
                                                   that nobody answered five times is not the same state as a
                                                   request just sent. Both render here so the page cannot make
                                                   "never tried" look like "tried and failed". *@
                                                <BbBadge Variant="BadgeVariant.Outline"
                                                         title="@PendingTitle(branch, pendingCommit)">
                                                    @L10n["Awaiting tree read"]@(branch.ObservationAttempts > 0 ? " " + L10n["(retry {0})", branch.ObservationAttempts] : string.Empty)
                                                </BbBadge>
                                            }
                                            @if (branch.IsOrphaned)
                                            {
                                                <BbBadge Variant="BadgeVariant.Destructive"
                                                         title="@OrphanTitle(branch)">@L10n["Orphaned"]</BbBadge>
                                            }
                                        </p>
                                        <p class="bb:text-xs bb:text-muted-foreground">
                                            @if (branch.LastRun is { } lastRun)
                                            {
                                                <span>@L10n["Last run #{0}", lastRun.Number]</span>
                                                @if (lastRun.GitCommit is { } commit)
                                                {
                                                    <span> · <code title="@commit">@ShortCommit(commit)</code></span>
                                                }
                                                <span> · @lastRun.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC</span>
                                            }
                                            else if (branch.PendingCommit is not null)
                                            {
                                                <span>@L10n["No runs yet - a tree read is owed before this branch can be built"]@(branch.PendingSince is { } since ? L10n["; last requested {0} UTC", since.ToString("yyyy-MM-dd HH:mm")] : string.Empty).</span>
                                            }
                                            else if (branch.IsNoPipeline)
                                            {
                                                <span>@L10n["No runs yet"] - @L10n["this branch has no pipeline file, so it is not built."]</span>
                                            }
                                            else
                                            {
                                                <span>@(L10n["No runs yet"]).</span>
                                            }
                                            @if (branch.LastCommit is { } lastCommit && branch.LastRun?.GitCommit != lastCommit)
                                            {
                                                <span> · head <code title="@lastCommit">@ShortCommit(lastCommit)</code></span>
                                            }
                                        </p>
                                    </div>
                                    <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-2 bb:text-xs bb:text-muted-foreground">
                                        @if (branch.LastRun is { } run)
                                        {
                                            <RunStatusBadge Status="@run.Status" />
                                        }
                                        <BbButton Href="@RunsHref(branch.Branch)" Variant="ButtonVariant.Outline">
                                            @L10n["Runs on this branch"]
                                        </BbButton>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </BbCardContent>
            </BbCard>

            @* D2: what discovery actually does right now, stated from the project's own probe record
               (I-005 writes LastProbeOutcome/LastProbeAt). The interval scan needs a probe-capable
               Worker; without one the page says push-only instead of claiming a scan that never ran. *@
            <div id="branch-discovery-status" class="bb:rounded-md bb:border bb:border-input bb:bg-muted bb:p-3 bb:text-sm">
                <p class="bb:font-medium">@L10n["Remote discovery"]</p>
                @if (_project.LastProbeAt is null)
                {
                    <p id="branch-discovery-never" class="bb:mt-1">
                        @L10n["No remote scan has run yet. Interval discovery needs a probe-capable Worker (I-005); until one answers, a push registers this project's branches, and a definition-only observation (no run, no build slot) reads a branch's tree to decide whether it can build."]
                    </p>
                }
                else if (_project.LastProbeOutcome == Zenkins.Shared.Probes.GitProbeOutcomes.Refs)
                {
                    <p id="branch-discovery-active" class="bb:mt-1">
                        @L10n["Last remote scan:"] <strong>@L10n["heads read"]</strong> @L10n["at {0} UTC.", _project.LastProbeAt.Value.ToString("yyyy-MM-dd HH:mm")]
                        <span>@L10n["Interval discovery is running: branches are registered from the repository's heads, including ones created without a push."]</span>
                    </p>
                }
                else
                {
                    <p id="branch-discovery-degraded" class="bb:mt-1">
                        @L10n["Last remote scan:"] <strong>@_project.LastProbeOutcome</strong> @L10n["at {0} UTC -", _project.LastProbeAt.Value.ToString("yyyy-MM-dd HH:mm")]
                        <span>@L10n["no heads were read, so only pushes register branches until a probe-capable Worker answers. A failed probe never marks a branch deleted."]</span>
                    </p>
                }
                <p class="bb:mt-1 bb:text-xs bb:text-muted-foreground">
                    @L10n["A branch without the pipeline file is listed as"] <strong>@L10n["no pipeline"]</strong> @L10n["and is never queued. A branch deleted upstream keeps its history and is marked orphaned - nothing is deleted implicitly."]
                </p>
            </div>
        }
    }
</div>

@code {
    [Parameter]
    public Guid ProjectId { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private ProjectView? _project;
    private IReadOnlyList<BranchView> _branches = [];

    protected override async Task OnInitializedAsync()
    {
        // Establishing the circuit's tenant before the tenant-filtered lookup (the F-003 hazard every
        // project tab shares).
        var session = await UserSession.GetAsync();
        if (session?.HasOrganization != true)
        {
            return;
        }

        _project = await ProjectsService.GetProjectAsync(ProjectId);
        if (_project is null)
        {
            SetNotFound();
            return;
        }

        _branches = await BranchesService.GetBranchesAsync(ProjectId);
    }

    private string PendingTitle(BranchView branch, string pendingCommit)
    {
        var since = branch.PendingSince is { } at
            ? " " + L10n["It was last requested at {0} UTC ({1} retry attempt(s)).", at.ToString("yyyy-MM-dd HH:mm"), branch.ObservationAttempts]
            : string.Empty;
        return L10n["Nobody has read this branch at {0} yet, so nothing was built.{1} A Worker observation decides: has-pipeline queues the run at that commit, no-pipeline records it.", pendingCommit, since];
    }

    private string RunsHref(string branch) =>
        $"/projects/{ProjectId}/runs?branch={Uri.EscapeDataString(branch)}";

    private static string ShortCommit(string commit) =>
        commit.Length > 10 ? commit[..10] : commit;

    private string OrphanTitle(BranchView branch) => branch.OrphanedEvidence switch
    {
        BranchOrphanEvidence.PushDelete => L10n["A signed push deleted this branch upstream. Its history is kept."],
        BranchOrphanEvidence.RefsAbsent => L10n["A successful remote check no longer lists this branch. Its history is kept."],
        _ => L10n["This branch is no longer present upstream. Its history is kept."],
    };

    private void SetNotFound()
    {
        if (HttpContext is null)
        {
            return;
        }

        HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
        if (HttpContext.Features.Get<IStatusCodePagesFeature>() is { } statusCodePages)
        {
            statusCodePages.Enabled = false;
        }
    }
}
