@page "/projects/{ProjectId:guid}"
@attribute [Authorize]
@using System.Globalization
@using Zenkins.Server.Git
@using Zenkins.Server.Webhooks
@inject UserSession UserSession
@inject ProjectService ProjectsService
@inject WebhookService WebhookManagement
@inject RunService RunsService
@inject GitCredentialService CredentialService

@* D-003: the Overview tab of the four routed project tabs. It keeps what the single project page
   held (repository facts, the start-run form, the member-delete note) and adds what the card asks
   for: the newest run with its status and link, and the webhook/credential counts. The webhook
   management markup moved to the Settings tab; its endpoints and behaviour are F-017's, unchanged. *@
<PageTitle>@(_project?.Name ?? "Project") · Zenkins</PageTitle>

<div class="bb:mx-auto bb:w-full bb:max-w-3xl bb:space-y-6">
    @if (_project is null)
    {
        @* Foreign tenant id == missing id: the service reads through the tenant filter and the
           response is a real 404 (also for detail pages, as the card requires). *@
        <NotFoundPage />
    }
    else
    {
        <div class="bb:flex bb:flex-wrap bb:items-center bb:justify-between bb:gap-3">
            <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-3">
                <BbCardTitle As="h1" tabindex="-1">@_project.Name</BbCardTitle>
                @if (_session?.Organization is { } organization)
                {
                    <BbBadge Variant="BadgeVariant.Secondary">@organization.Name</BbBadge>
                }
                <BbBadge Variant="BadgeVariant.Outline">@_project.DefaultBranch</BbBadge>
            </div>
            <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-2">
                <BbButton Href="@($"/projects/{_project.Id}/edit")" Variant="ButtonVariant.Outline">Edit</BbButton>
                @if (_canDelete)
                {
                    <BbButton Href="@($"/projects/{_project.Id}/delete/confirm")" Variant="ButtonVariant.Destructive">Delete</BbButton>
                }
            </div>
        </div>

        <ProjectTabs ProjectId="@_project.Id" Active="overview" />

        @if (Notice is { } notice)
        {
            <div role="status" class="bb:rounded-md bb:border bb:border-input bb:bg-muted bb:p-3 bb:text-sm">
                <p>@notice</p>
            </div>
        }

        <BbCard>
            <BbCardHeader>
                <BbCardTitle As="h2">Repository</BbCardTitle>
                <BbCardDescription>
                    Git repository metadata and what this project runs. Credentials are managed on the
                    settings tab by organization Owners.
                </BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                <dl class="bb:grid bb:grid-cols-1 bb:gap-4 bb:text-sm bb:sm:grid-cols-3">
                    <div class="bb:sm:col-span-3">
                        <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">Repository URL</dt>
                        <dd class="bb:break-all">@_project.RepositoryUrl</dd>
                    </div>
                    <div>
                        <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">Default branch</dt>
                        <dd>@_project.DefaultBranch</dd>
                    </div>
                    <div>
                        <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">Pipeline path</dt>
                        <dd>@_project.PipelinePath</dd>
                    </div>
                    <div>
                        <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">Credential</dt>
                        <dd>
                            @if (_project.GitCredentialId is null)
                            {
                                <span class="bb:text-muted-foreground">Not configured</span>
                            }
                            else if (_assignedCredentialName is { } assignedName)
                            {
                                <span>@assignedName</span>
                            }
                            else
                            {
                                <span>Configured</span>
                            }
                        </dd>
                    </div>
                    <div>
                        <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">Webhooks</dt>
                        <dd>@_webhooks.Count</dd>
                    </div>
                    <div>
                        <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">Credentials (organization)</dt>
                        @* D-003: the credential metadata is Owner-visible only (the asymmetry stance the
                           settings tab keeps), so a Member sees that the store exists, not its size. *@
                        <dd>@(CredentialCountText)</dd>
                    </div>
                    <div>
                        <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">Created</dt>
                        <dd>@_project.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC</dd>
                    </div>
                    <div>
                        <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">Updated</dt>
                        <dd>@_project.UpdatedAt.ToString("yyyy-MM-dd HH:mm") UTC</dd>
                    </div>
                </dl>
            </BbCardContent>
        </BbCard>

        <BbCard>
            <BbCardHeader>
                <BbCardTitle As="h2">Latest run</BbCardTitle>
                <BbCardDescription>
                    The most recent execution of this project's pipeline. The Runs tab lists every run.
                </BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                @if (_newestRun is not { } run)
                {
                    <p class="bb:text-sm bb:text-muted-foreground" id="overview-no-runs">
                        No runs yet. Start one below; it waits in the queue until an eligible worker claims it.
                    </p>
                }
                else
                {
                    <div class="bb:flex bb:flex-wrap bb:items-center bb:justify-between bb:gap-3 bb:text-sm">
                        <div class="bb:min-w-0">
                            <p class="bb:font-medium">
                                <a href="/runs/@run.Id" class="bb:underline bb:underline-offset-4">Run @run.Id.ToString("N")[..8]</a>
                                <span class="bb:ml-2 bb:font-normal bb:text-muted-foreground">
                                    @run.GitBranch · @run.PipelinePath
                                </span>
                            </p>
                            <p class="bb:text-xs bb:text-muted-foreground">
                                @(run.TriggerUserEmail ?? run.TriggerType)
                                @if (run.WorkerName is { } workerName)
                                {
                                    <span> · @workerName</span>
                                }
                            </p>
                        </div>
                        @* D-002: the shared display bits - the same badge and duration the dashboard
                           and the runs list render for the same run. *@
                        <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-2 bb:text-xs bb:text-muted-foreground">
                            <RunStatusBadge Status="@run.Status" />
                            <span>@RunDisplay.DurationOrElapsed(run.StartedAt, run.EndedAt, _now)</span>
                            <span>@run.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC</span>
                        </div>
                    </div>
                }
            </BbCardContent>
        </BbCard>

        @if (!_canDelete)
        {
            <p class="bb:text-sm bb:text-muted-foreground">
                Deleting a project is reserved to organization Owners (PRD §3.1.2). Members can create
                and edit projects.
            </p>
        }

        <BbCard>
            <BbCardHeader>
                <BbCardTitle As="h2">Start run</BbCardTitle>
                <BbCardDescription>
                    A run executes this project's pipeline file on the branch you choose. Leave the
                    branch blank to build the default branch. Optional required tags restrict which
                    worker may claim the run: one worker must declare all of them.
                </BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                <form method="post" action="@($"/projects/{_project.Id}/runs/start")" data-zenkins-antiforgery>
                    <div class="bb:space-y-4">
                        @if (RunRequestError is { } runRequestError)
                        {
                            <p id="run-form-error" role="alert" class="bb:text-sm bb:text-destructive">@runRequestError</p>
                        }
                        <div>
                            <label for="run-branch" class="bb:mb-1 bb:block bb:text-sm bb:font-medium">Branch (optional)</label>
                            <input id="run-branch"
                                   name="Branch"
                                   class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:p-2 bb:font-mono bb:text-sm"
                                   placeholder="@_project.DefaultBranch" />
                            @if (BranchError is { } branchError)
                            {
                                <p id="run-branch-error" role="alert" class="bb:mt-1 bb:text-sm bb:text-destructive">@branchError</p>
                            }
                        </div>
                        <div>
                            <label for="run-required-tags" class="bb:mb-1 bb:block bb:text-sm bb:font-medium">Required tags (optional)</label>
                            <input id="run-required-tags"
                                   name="RequiredTags"
                                   class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:p-2 bb:text-sm"
                                   placeholder="linux, dotnet" />
                            @* Q-010: the trigger checks the workers' union (every tag some worker
                               row declares) while claiming needs one worker that covers all of it -
                               union-accept + honest starvation is the documented semantics, so the
                               operator reads it where the asymmetry would surprise. *@
                            <p class="bb:mt-1 bb:text-xs bb:text-muted-foreground">
                                Comma-separated. Every tag must be declared by at least one worker
                                (that is what this form checks), but claiming needs one worker that
                                declares them all: a set split across workers (e.g. linux,cuda on a
                                linux-only worker and a cuda-only worker) is accepted and stays
                                queued until a worker with the full set registers.
                            </p>
                            @if (TagsError is { } tagsError)
                            {
                                <p id="run-required-tags-error" role="alert" class="bb:mt-1 bb:text-sm bb:text-destructive">@tagsError</p>
                            }
                        </div>
                        <div>
                            <label for="run-timeout-minutes" class="bb:mb-1 bb:block bb:text-sm bb:font-medium">Timeout in minutes (optional)</label>
                            <input id="run-timeout-minutes"
                                   name="TimeoutMinutes"
                                   type="number"
                                   min="1"
                                   max="10080"
                                   class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:p-2 bb:text-sm"
                                   placeholder="default (60)" />
                            @if (TimeoutError is { } timeoutError)
                            {
                                <p id="run-timeout-minutes-error" role="alert" class="bb:mt-1 bb:text-sm bb:text-destructive">@timeoutError</p>
                            }
                        </div>
                        <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Default">Start run</BbButton>
                    </div>
                </form>
            </BbCardContent>
        </BbCard>
    }
</div>

@code {
    [Parameter]
    public Guid ProjectId { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private UserSessionInfo? _session;
    private ProjectView? _project;
    private bool _canDelete;
    private IReadOnlyList<WebhookView> _webhooks = [];
    private RunView? _newestRun;
    private int _credentialCount;
    private string? _assignedCredentialName;

    /// <summary>One clock instant per render (the D-002 discipline the dashboard and runs list keep).</summary>
    private DateTimeOffset _now;

    [SupplyParameterFromQuery(Name = "notice")]
    private string? NoticeCode { get; set; }

    [SupplyParameterFromQuery(Name = "runError")]
    private string? RunErrorCode { get; set; }

    private string? Notice => NoticeCode switch
    {
        "created" => "The project was created.",
        "updated" => "The project was updated.",
        _ => null,
    };

    private string CredentialCountText => _canManageCredentials
        ? _credentialCount.ToString(CultureInfo.InvariantCulture)
        : "Owner-managed";

    private bool _canManageCredentials;

    private string? BranchError => RunErrorCode switch
    {
        RunErrorCodes.BranchInvalid => "That is not a valid branch name; leave it blank to build the default branch.",
        _ => null,
    };

    private string? TagsError => RunErrorCode switch
    {
        RunErrorCodes.TagUnknown => "No registered worker in this organization has one of these tags.",
        RunErrorCodes.TagInvalid => "Required tags are comma-separated text, at most 64 characters per tag.",
        _ => null,
    };

    private string? TimeoutError => RunErrorCode switch
    {
        RunErrorCodes.TimeoutInvalid => "The timeout is a whole number of minutes between 1 and 10080; leave it blank for the server default.",
        _ => null,
    };

    /// <summary>
    /// F-019: the trigger body carried no field the form binds (a dropped body, a renamed field), so
    /// no run was started. The refusal is form-level - there is no single field to blame - but it still
    /// has to say something, otherwise the page looks like a no-op.
    /// </summary>
    private string? RunRequestError => RunErrorCode switch
    {
        RunErrorCodes.FieldInvalid => "That request could not be read, so no run was started. Try again.",
        _ => null,
    };

    protected override async Task OnInitializedAsync()
    {
        // Establish the circuit tenant before the tenant-filtered lookup.
        _session = await UserSession.GetAsync();
        _canDelete = _session?.CanManageActiveOrganization == true;
        _canManageCredentials = _canDelete;
        _now = DateTimeOffset.UtcNow;

        if (_session?.HasOrganization != true)
        {
            return;
        }

        _project = await ProjectsService.GetProjectAsync(ProjectId);
        if (_project is null && HttpContext is not null)
        {
            // A real 404 for a foreign or missing id. The status-code-pages middleware must not
            // re-execute /not-found in this same request: the component renderer already owns the
            // NavigationManager, and re-execution fails with "already initialized". The HTTP
            // response is therefore a bodyless 404; NotFoundPage below covers circuit navigation.
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
            if (HttpContext.Features.Get<IStatusCodePagesFeature>() is { } statusCodePages)
            {
                statusCodePages.Enabled = false;
            }

            return;
        }

        if (_project is null || _session is not { HasOrganization: true } session)
        {
            return;
        }

        // The project's webhooks (any member may manage them, F-017): the count here, the cards on
        // the settings tab. The service re-checks membership; a failure just leaves the list empty.
        var webhooks = await WebhookManagement.GetWebhooksAsync(session.UserId, ProjectId);
        _webhooks = webhooks.Webhooks;

        // The newest run, through the same read the Runs tab uses (newest first), so overview and
        // tab can never disagree about which run is newest.
        var runs = await RunsService.GetProjectRunsAsync(ProjectId);
        _newestRun = runs.Count > 0 ? runs[0] : null;

        // Credential metadata is Owner-visible only (the settings tab's asymmetry stance): an Owner
        // gets the count and the assigned credential's name, a Member neither.
        if (_canManageCredentials)
        {
            var credentials = await CredentialService.ListForProjectAsync(session.UserId, ProjectId);
            if (credentials.Status == GitCredentialMutationStatus.Success)
            {
                _credentialCount = credentials.Items.Count;
                _assignedCredentialName = credentials.Items
                    .FirstOrDefault(credential => credential.Id == _project.GitCredentialId)?.Name;
            }
        }
    }
}
