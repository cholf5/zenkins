@page "/projects/{ProjectId:guid}"
@attribute [Authorize]
@using System.Globalization
@using System.Text.Json
@using Zenkins.Shared.Projects
@using Zenkins.Shared.Pipelines
@using Zenkins.Server.Git
@using Zenkins.Server.Webhooks
@inject UserSession UserSession
@inject ProjectService ProjectsService
@inject ProjectLinkService ChainLinkService
@inject WebhookService WebhookManagement
@inject RunService RunsService
@inject GitCredentialService CredentialService

@* D-003: the Overview tab of the four routed project tabs. It keeps what the single project page
   held (repository facts, the start-run form, the member-delete note) and adds what the card asks
   for: the newest run with its status and link, and the webhook/credential counts. The webhook
   management markup moved to the Settings tab; its endpoints and behaviour are F-017's, unchanged. *@
<PageTitle>@(_project?.Name ?? L10n["Project"]) · Zenkins</PageTitle>

<div class="bb:mx-auto bb:w-full bb:max-w-3xl bb:space-y-6">
    @if (_project is null)
    {
        @* Foreign tenant id == missing id: the service reads through the tenant filter and the
           response is a real 404 (also for detail pages, as the card requires). *@
        <NotFoundPage />
    }
    else
    {
        <div class="bb:flex bb:flex-wrap bb:items-center bb:justify-between bb:gap-3">
            <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-3">
                <BbCardTitle As="h1" tabindex="-1">@_project.Name</BbCardTitle>
                @if (_session?.Organization is { } organization)
                {
                    <BbBadge Variant="BadgeVariant.Secondary">@organization.Name</BbBadge>
                }
                @if (_project.Kind == ProjectKinds.Freestyle)
                {
                    <BbBadge Variant="BadgeVariant.Secondary">Freestyle</BbBadge>
                }
                else
                {
                    <BbBadge Variant="BadgeVariant.Outline">@_project.DefaultBranch</BbBadge>
                    @* F-023: discovery is a project setting, so the overview says which one is on -
                       "Multibranch" is the badge the card asks for; a single-branch project keeps the
                       one branch badge it always had. *@
                    @if (BranchDiscoveryModes.IsMultibranch(_project.BranchDiscovery))
                    {
                        <BbBadge Variant="BadgeVariant.Secondary">@L10n["Multibranch"]</BbBadge>
                    }
                }
                @* F-028: the state is stated next to the name, on every tab's shared header, so a
                   "nothing builds" question answers itself without opening the settings tab. *@
                @if (_project.Disabled)
                {
                    <BbBadge Variant="BadgeVariant.Destructive">@L10n["Disabled"]</BbBadge>
                }
            </div>
            <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-2">
                <BbButton Href="@($"/projects/{_project.Id}/edit")" Variant="ButtonVariant.Outline">@L10n["Edit"]</BbButton>
                @if (_canDelete)
                {
                    <BbButton Href="@($"/projects/{_project.Id}/delete/confirm")" Variant="ButtonVariant.Destructive">@L10n["Delete"]</BbButton>
                }
            </div>
        </div>

        <ProjectTabs ProjectId="@_project.Id" Active="overview" Kind="@_project.Kind"
                     BranchDiscovery="@_project.BranchDiscovery" />

        @if (Notice is { } notice)
        {
            <div role="status" class="bb:rounded-md bb:border bb:border-input bb:bg-muted bb:p-3 bb:text-sm">
                <p>@notice</p>
            </div>
        }

        @* F-028: a disabled project says so (with the operator's reason and the attribution) above
           everything else - the history and artifacts below stay readable, only the triggers stop. *@
        @if (_project.Disabled)
        {
            <div id="project-disabled-notice" role="alert"
                 class="bb:rounded-md bb:border bb:border-destructive/40 bb:bg-destructive/10 bb:p-3 bb:text-sm">
                <p class="bb:font-medium bb:text-destructive">@L10n["This project is disabled."]</p>
                <p class="bb:mt-1" id="project-disabled-reason">
                    @(_project.DisabledReason ?? L10n["No reason was recorded."])
                </p>
                <p class="bb:mt-1 bb:text-xs bb:text-muted-foreground">
                    @L10n["Nothing is queued for it - the form, webhooks and every other trigger are refused - and runs that were still waiting were canceled. Its history and artifacts stay readable. Enable it on the settings tab to build again."]
                    @if (_project.DisabledAt is { } disabledAt)
                    {
                        <span>@L10n["Disabled {0} UTC", disabledAt.ToString("yyyy-MM-dd HH:mm")]</span>
                        @if (_project.DisabledByEmail is { } disabledBy)
                        {
                            <span> @L10n["by {0}.", disabledBy]</span>
                        }
                        else
                        {
                            <span>.</span>
                        }
                    }
                </p>
            </div>
        }

        @if (_project.Kind == ProjectKinds.Pipeline && _project.PipelineSource == ProjectSources.Inline)
        {
            @* F-022: an inline Pipeline's overview - no repository, no branch; the script is the
               project's definition and is edited (and validated) on the Pipelines tab. *@
            <BbCard>
                <BbCardHeader>
                    <BbCardTitle As="h2">@L10n["Inline Pipeline project"]</BbCardTitle>
                    <BbCardDescription>
                        @L10n["No repository is cloned: the pipeline script is stored on the server (the Pipelines tab) and every run carries the snapshot it was triggered with."]
                    </BbCardDescription>
                </BbCardHeader>
                <BbCardContent>
                    <dl class="bb:grid bb:grid-cols-1 bb:gap-4 bb:text-sm bb:sm:grid-cols-3">
                        <div>
                            <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">@L10n["Script"]</dt>
                            <dd>@(_project.InlineScript is { Length: > 0 } ? L10n["Saved on the server"] : L10n["Not saved yet"])</dd>
                        </div>
                        <div>
                            <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">@L10n["Webhooks"]</dt>
                            <dd>@L10n["Not available without a repository"]</dd>
                        </div>
                        <div>
                            <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">@L10n["Created"]</dt>
                            <dd>@_project.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC</dd>
                        </div>
                    </dl>
                </BbCardContent>
            </BbCard>
        }

        @if (_project.Kind == ProjectKinds.Freestyle)
        {
            @* F-020: a Freestyle project's overview - there is no repository, so the card says what
               the project runs and where its steps are edited instead. *@
            <BbCard>
                <BbCardHeader>
                    <BbCardTitle As="h2">@L10n["Freestyle project"]</BbCardTitle>
                    <BbCardDescription>
                        @L10n["No repository is cloned: the steps are configured on the server (the Steps tab) and every run carries the snapshot it was triggered with."]
                    </BbCardDescription>
                </BbCardHeader>
                <BbCardContent>
                    <dl class="bb:grid bb:grid-cols-1 bb:gap-4 bb:text-sm bb:sm:grid-cols-3">
                        <div>
                            <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">@L10n["Steps"]</dt>
                            <dd>@(_savedStepCount is { } count ? L10n["{0} saved", count.ToString(CultureInfo.InvariantCulture)] : L10n["Not saved yet"])</dd>
                        </div>
                        <div>
                            <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">@L10n["Webhooks"]</dt>
                            <dd>@L10n["Not available for this kind"]</dd>
                        </div>
                        <div>
                            <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">@L10n["Created"]</dt>
                            <dd>@_project.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC</dd>
                        </div>
                        <div>
                            <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">@L10n["Updated"]</dt>
                            <dd>@_project.UpdatedAt.ToString("yyyy-MM-dd HH:mm") UTC</dd>
                        </div>
                    </dl>
                </BbCardContent>
            </BbCard>
        }
        else
        {
            <BbCard>
                <BbCardHeader>
                    <BbCardTitle As="h2">@L10n["Repository"]</BbCardTitle>
                    <BbCardDescription>
                        @L10n["Git repository metadata and what this project runs. Credentials are managed on the settings tab by organization Owners."]
                    </BbCardDescription>
                </BbCardHeader>
                <BbCardContent>
                    <dl class="bb:grid bb:grid-cols-1 bb:gap-4 bb:text-sm bb:sm:grid-cols-3">
                        <div class="bb:sm:col-span-3">
                            <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">@L10n["Repository URL"]</dt>
                            <dd class="bb:break-all">@_project.RepositoryUrl</dd>
                        </div>
                        <div>
                            <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">@L10n["Default branch"]</dt>
                            <dd>@_project.DefaultBranch</dd>
                        </div>
                        <div>
                            <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">@L10n["Pipeline path"]</dt>
                            <dd>@_project.PipelinePath</dd>
                        </div>
                        <div>
                            <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">@L10n["Branch discovery"]</dt>
                            <dd>
                                @if (BranchDiscoveryModes.IsMultibranch(_project.BranchDiscovery))
                                {
                                    <a href="@($"/projects/{_project.Id}/branches")"
                                       class="bb:font-medium bb:underline bb:underline-offset-4">@L10n["Every branch"]</a>
                                }
                                else
                                {
                                    <span>@L10n["Single branch"]</span>
                                }
                            </dd>
                        </div>
                        <div>
                            <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">@L10n["Credential"]</dt>
                            <dd>
                                @if (_project.GitCredentialId is null)
                                {
                                    <span class="bb:text-muted-foreground">@L10n["Not configured"]</span>
                                }
                                else if (_assignedCredentialName is { } assignedName)
                                {
                                    <span>@assignedName</span>
                                }
                                else
                                {
                                    <span>@L10n["Configured"]</span>
                                }
                            </dd>
                        </div>
                        <div>
                            <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">@L10n["Webhooks"]</dt>
                            <dd>@_webhooks.Count</dd>
                        </div>
                        <div>
                            <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">@L10n["Credentials (organization)"]</dt>
                            @* D-003: the credential metadata is Owner-visible only (the asymmetry stance the
                               settings tab keeps), so a Member sees that the store exists, not its size. *@
                            <dd>@(CredentialCountText)</dd>
                        </div>
                        <div>
                            <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">@L10n["Created"]</dt>
                            <dd>@_project.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC</dd>
                        </div>
                        <div>
                            <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">@L10n["Updated"]</dt>
                            <dd>@_project.UpdatedAt.ToString("yyyy-MM-dd HH:mm") UTC</dd>
                        </div>
                        <div class="bb:sm:col-span-3" id="project-last-probe">
                            <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">@L10n["Last remote probe"]</dt>
                            <dd>
                                @* I-005: a probe is not a run, so it has no history page of its own - the
                                   project states its most recent outcome here. "Never probed" and a recorded
                                   failure must never read the same, and a failure must never look like
                                   "no new commits". *@
                                @if (_project.LastProbeOutcome is null)
                                {
                                    <span class="bb:text-muted-foreground">@L10n["Never probed."]</span>
                                }
                                else
                                {
                                    <span class="bb:font-medium" id="project-last-probe-outcome">@_project.LastProbeOutcome</span>
                                    @if (_project.LastProbeAt is { } probedAt)
                                    {
                                        <span class="bb:ms-2 bb:text-xs bb:text-muted-foreground">@probedAt.ToString("yyyy-MM-dd HH:mm") UTC</span>
                                    }
                                    @if (_project.LastProbeMessage is { } probeMessage)
                                    {
                                        <span class="bb:mt-1 bb:block bb:text-xs bb:text-muted-foreground">@probeMessage</span>
                                    }
                                }
                            </dd>
                        </div>
                    </dl>
                </BbCardContent>
            </BbCard>
        }

        <BbCard>
            <BbCardHeader>
                <BbCardTitle As="h2">@L10n["Latest run"]</BbCardTitle>
                <BbCardDescription>
                    @L10n["The most recent execution of this project's pipeline. The Runs tab lists every run."]
                </BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                @if (_newestRun is not { } run)
                {
                    <p class="bb:text-sm bb:text-muted-foreground" id="overview-no-runs">
                        @L10n["No runs yet. Start one below; it waits in the queue until an eligible worker claims it."]
                    </p>
                }
                else
                {
                    <div class="bb:flex bb:flex-wrap bb:items-center bb:justify-between bb:gap-3 bb:text-sm">
                        <div class="bb:min-w-0">
                            <p class="bb:font-medium">
                                <a href="/projects/@run.ProjectId/runs/@run.Number" class="bb:underline bb:underline-offset-4">@L10n["Run #{0}", run.Number]</a>
                                <span class="bb:ms-2 bb:font-normal bb:text-muted-foreground">
                                    @run.GitBranch · @run.PipelinePath
                                </span>
                            </p>
                            <p class="bb:text-xs bb:text-muted-foreground">
                                @(run.TriggerUserEmail ?? run.TriggerType)
                                @if (run.WorkerName is { } workerName)
                                {
                                    <span> · @workerName</span>
                                }
                            </p>
                        </div>
                        @* D-002: the shared display bits - the same badge and duration the dashboard
                           and the runs list render for the same run. *@
                        <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-2 bb:text-xs bb:text-muted-foreground">
                            <RunStatusBadge Status="@run.Status" />
                            <span>@RunDisplay.DurationOrElapsed(run.StartedAt, run.EndedAt, _now, L10n)</span>
                            <span>@run.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC</span>
                        </div>
                    </div>
                }
            </BbCardContent>
        </BbCard>

        @* Card F-026, AC-1's "visible on the overview": a project's place in a chain is something a reader of
           this page needs to know before they press Start run - "this also queues three other jobs" changes the
           decision. The lists and the declaring form stay on the settings tab; this card answers only "is this
           project part of a chain, and on which ends?". *@
        @if (_upstreamLinks.Count > 0 || _downstreamLinks.Count > 0)
        {
            <BbCard>
                <BbCardHeader>
                    <BbCardTitle As="h2">@L10n["Chain"]</BbCardTitle>
                    <BbCardDescription>
                        @L10n["This project runs as part of a chain. The links are declared, and can be changed, on the settings tab."]
                    </BbCardDescription>
                </BbCardHeader>
                <BbCardContent>
                    <dl id="project-chain-summary" class="bb:grid bb:grid-cols-1 bb:gap-4 bb:text-sm bb:sm:grid-cols-2">
                        <div>
                            <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">@L10n["Triggered by (upstream)"]</dt>
                            <dd class="bb:break-all">
                                @if (_upstreamLinks.Count == 0)
                                {
                                    <span class="bb:text-muted-foreground">@L10n["Nothing: no project's run queues this one."]</span>
                                }
                                else
                                {
                                    @for (var index = 0; index < _upstreamLinks.Count; index++)
                                    {
                                        if (index > 0)
                                        {
                                            <span>, </span>
                                        }
                                        <span data-chain-summary-upstream="@_upstreamLinks[index].UpstreamProjectId">@_upstreamLinks[index].UpstreamProjectName</span>
                                    }
                                }
                            </dd>
                        </div>
                        <div>
                            <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">@L10n["Triggers (downstream)"]</dt>
                            <dd class="bb:break-all">
                                @if (_downstreamLinks.Count == 0)
                                {
                                    <span class="bb:text-muted-foreground">@L10n["Nothing: this project's runs trigger nothing."]</span>
                                }
                                else
                                {
                                    @for (var index = 0; index < _downstreamLinks.Count; index++)
                                    {
                                        if (index > 0)
                                        {
                                            <span>, </span>
                                        }
                                        <span data-chain-summary-downstream="@_downstreamLinks[index].DownstreamProjectId">@_downstreamLinks[index].DownstreamProjectName</span>
                                    }
                                }
                            </dd>
                        </div>
                    </dl>
                    <div class="bb:mt-4">
                        <BbButton Href="@($"/projects/{_project.Id}/settings")" Variant="ButtonVariant.Outline">@L10n["Manage chain links…"]</BbButton>
                    </div>
                </BbCardContent>
            </BbCard>
        }

        @if (!_canDelete)
        {
            <p class="bb:text-sm bb:text-muted-foreground">
                @L10n["Deleting a project is reserved to organization Owners (PRD §3.1.2). Members can create and edit projects."]
            </p>
        }

        <BbCard>
            <BbCardHeader>
                <BbCardTitle As="h2">@L10n["Start run"]</BbCardTitle>
                @if (!ProjectSources.HasRepository(_project.Kind, _project.PipelineSource))
                {
                    <BbCardDescription>
                        @L10n["A run executes this project's saved definition (the snapshot taken when the run is queued; for an inline Pipeline that snapshot is its script). Optional required tags restrict which worker may claim the run: one worker must declare all of them."]
                    </BbCardDescription>
                }
                else
                {
                    <BbCardDescription>
                        @L10n["A run executes this project's pipeline file on the branch you choose. Leave the branch blank to build the default branch. Optional required tags restrict which worker may claim the run: one worker must declare all of them."]
                    </BbCardDescription>
                }
            </BbCardHeader>
            <BbCardContent>
                @if (_project.Disabled)
                {
                    @* F-028: the form is not offered at all - a form that always refuses wastes the
                       caller's attention. The server still refuses a forged POST; this is the page
                       half of it. *@
                    <p id="run-form-disabled" class="bb:text-sm">
                        @L10n["This project is disabled, so no run can be started. Enable it on the settings tab; the reason and the moment it was disabled are on the overview."]
                    </p>
                }
                else
                {
                @* F-041: always multipart, because a project may declare a file parameter and the browser has
                   one form; a multipart body that carries no file binds exactly like the old urlencoded one, and
                   the antiforgery token still travels as a form field. *@
                <form method="post" enctype="multipart/form-data" action="@($"/projects/{_project.Id}/runs/start")" data-zenkins-antiforgery>
                    <div class="bb:space-y-4">
                        @if (RunRequestError is { } runRequestError)
                        {
                            <p id="run-form-error" role="alert" class="bb:text-sm bb:text-destructive">@runRequestError</p>
                        }
                        @if (ProjectSources.HasRepository(_project.Kind, _project.PipelineSource))
                        {
                            <div>
                                <label for="run-branch" class="bb:mb-1 bb:block bb:text-sm bb:font-medium">@L10n["Branch (optional)"]</label>
                                <input id="run-branch"
                                       name="Branch"
                                       class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:p-2 bb:font-mono bb:text-sm"
                                       placeholder="@_project.DefaultBranch" />
                                @if (BranchError is { } branchError)
                                {
                                    <p id="run-branch-error" role="alert" class="bb:mt-1 bb:text-sm bb:text-destructive">@branchError</p>
                                }
                            </div>
                        }
                        else if (RunErrorCode == RunErrorCodes.StepsMissing)
                        {
                            <p id="run-form-error" role="alert" class="bb:text-sm bb:text-destructive">
                                @L10n["This project has no saved steps yet - save them on the Steps tab first."]
                            </p>
                        }
                        @* F-021: the project's parameter definitions render the trigger's inputs.
                           Each field posts Parameters[NAME]; the service resolves missing entries to
                           the definitions' defaults and refuses unknown names or mistyped values. *@
                        @foreach (var parameter in _parameterDefinitions)
                        {
                            <div>
                                <label for="run-param-@(parameter.Name)" class="bb:mb-1 bb:block bb:text-sm bb:font-medium">
                                    @parameter.Name
                                    @if (parameter.Description is { } description)
                                    {
                                        <span class="bb:ms-2 bb:font-normal bb:text-xs bb:text-muted-foreground">@description</span>
                                    }
                                </label>
                                @if (parameter.Type == ProjectParameterTypes.Boolean)
                                {
                                    @* A radio pair, not a checkbox: an unchecked checkbox posts nothing at
                                       all, which is indistinguishable from "the form did not render this
                                       parameter" - and would silently resolve to a true default. A radio
                                       group always posts exactly one of the two values. *@
                                    <div id="run-param-@(parameter.Name)" class="bb:flex bb:items-center bb:gap-4">
                                        <label class="bb:flex bb:items-center bb:gap-1">
                                            <input type="radio"
                                                   name="@($"Parameters[{parameter.Name}]")"
                                                   value="true"
                                                   checked="@(parameter.DefaultValue == "true")" />
                                            <span>true</span>
                                        </label>
                                        <label class="bb:flex bb:items-center bb:gap-1">
                                            <input type="radio"
                                                   name="@($"Parameters[{parameter.Name}]")"
                                                   value="false"
                                                   checked="@(parameter.DefaultValue != "true")" />
                                            <span>false</span>
                                        </label>
                                    </div>
                                }
                                else if (parameter.Type == ProjectParameterTypes.Choice)
                                {
                                    <select id="run-param-@(parameter.Name)"
                                            name="@($"Parameters[{parameter.Name}]")"
                                            class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:p-2 bb:text-sm">
                                        @foreach (var choice in parameter.Choices ?? [])
                                        {
                                            <option value="@choice" selected="@(parameter.DefaultValue == choice)">@choice</option>
                                        }
                                    </select>
                                }
                                else if (parameter.Type == ProjectParameterTypes.Text)
                                {
                                    <textarea id="run-param-@(parameter.Name)"
                                              name="@($"Parameters[{parameter.Name}]")"
                                              rows="4"
                                              spellcheck="false"
                                              class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:p-2 bb:font-mono bb:text-sm">@parameter.DefaultValue</textarea>
                                }
                                else if (parameter.Type == ProjectParameterTypes.Password)
                                {
                                    @* F-041: a per-run input, not a stored Secret - any member may trigger a
                                       deploy with one, and nothing about it survives the run on the page. *@
                                    <input id="run-param-@(parameter.Name)"
                                           name="@($"Parameters[{parameter.Name}]")"
                                           type="password"
                                           autocomplete="new-password"
                                           spellcheck="false"
                                           class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:p-2 bb:font-mono bb:text-sm" />
                                    <p class="bb:mt-1 bb:text-xs bb:text-muted-foreground">
                                        @L10n["Typed per run: the run page and every list show ***, a step that echoes it logs ***, and no API returns it. Not a stored Secret - it is an input to this one run, so triggering does not need Owner rights. Leaving it empty passes an empty value."]
                                    </p>
                                }
                                else if (parameter.Type == ProjectParameterTypes.Run)
                                {
                                    @* F-041: one of this project's runs, as "#N status branch". The selected
                                       run's number is the value; the step also reads NAME_RUN_ID and NAME_COMMIT. *@
                                    <select id="run-param-@(parameter.Name)"
                                            name="@($"Parameters[{parameter.Name}]")"
                                            class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:p-2 bb:text-sm">
                                        @foreach (var candidate in RunParameterOptions(parameter))
                                        {
                                            <option value="@candidate.Number"
                                                    selected="@(candidate.Number?.ToString(CultureInfo.InvariantCulture) == RunParameterPrefill(parameter))">
                                                @RunParameterLabel(candidate)
                                            </option>
                                        }
                                    </select>
                                    <p class="bb:mt-1 bb:text-xs bb:text-muted-foreground">
                                        @L10n["The step reads the run's number, plus {0} and {1}.", $"{parameter.Name}_RUN_ID", $"{parameter.Name}_COMMIT"]
                                        @if (_parameterRuns.Count == 0)
                                        {
                                            <span>@L10n["This project has no run to select yet, so a run parameter refuses the trigger."]</span>
                                        }
                                        else
                                        {
                                            <span>@L10n["The newest successful run is preselected."]</span>
                                        }
                                    </p>
                                }
                                else if (parameter.Type == ProjectParameterTypes.File)
                                {
                                    @* F-041: the upload. The step reads a path, not the bytes, and the run page
                                       never offers a download - the file may be a secret. *@
                                    <input id="run-param-@(parameter.Name)"
                                           name="@($"Parameters[{parameter.Name}]")"
                                           type="file"
                                           class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:p-2 bb:text-sm" />
                                    <p class="bb:mt-1 bb:text-xs bb:text-muted-foreground">
                                        @L10n["At most {0} KiB. The step reads a", ProjectParameterLimits.MaxFileBytes / 1024]
                                        <b>@L10n["path"]</b>
                                        @L10n["inside the run's own directory; the bytes are never shown on this page and cannot be downloaded from it. Uploading nothing passes an empty value."]
                                    </p>
                                }
                                else if (parameter.Type == ProjectParameterTypes.GitRef)
                                {
                                    <input id="run-param-@(parameter.Name)"
                                           name="@($"Parameters[{parameter.Name}]")"
                                           value="@parameter.DefaultValue"
                                           autocomplete="off"
                                           spellcheck="false"
                                           placeholder="v1.2.3"
                                           class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:p-2 bb:font-mono bb:text-sm" />
                                    <p class="bb:mt-1 bb:text-xs bb:text-muted-foreground">
                                        @L10n["No whitespace, no leading dash. This is what the"]
                                        <b>@L10n["step"]</b>
                                        @L10n["reads: when the trigger pins a commit (a webhook push, a rebuild) that commit is what gets checked out, whatever this ref says."]
                                    </p>
                                }
                                else
                                {
                                    <input id="run-param-@(parameter.Name)"
                                           name="@($"Parameters[{parameter.Name}]")"
                                           value="@parameter.DefaultValue"
                                           autocomplete="off"
                                           class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:p-2 bb:text-sm" />
                                }
                            </div>
                        }
                        <div>
                            <label for="run-required-tags" class="bb:mb-1 bb:block bb:text-sm bb:font-medium">@L10n["Required tags (optional)"]</label>
                            <input id="run-required-tags"
                                   name="RequiredTags"
                                   class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:p-2 bb:text-sm"
                                   placeholder="linux, dotnet" />
                            @* Q-010: the trigger checks the workers' union (every tag some worker
                               row declares) while claiming needs one worker that covers all of it -
                               union-accept + honest starvation is the documented semantics, so the
                               operator reads it where the asymmetry would surprise. *@
                            <p class="bb:mt-1 bb:text-xs bb:text-muted-foreground">
                                @L10n["Comma-separated. Every tag must be declared by at least one worker (that is what this form checks), but claiming needs one worker that declares them all: a set split across workers (e.g. linux,cuda on a linux-only worker and a cuda-only worker) is accepted and stays queued until a worker with the full set registers."]
                            </p>
                            @if (TagsError is { } tagsError)
                            {
                                <p id="run-required-tags-error" role="alert" class="bb:mt-1 bb:text-sm bb:text-destructive">@tagsError</p>
                            }
                        </div>
                        <div>
                            <label for="run-timeout-minutes" class="bb:mb-1 bb:block bb:text-sm bb:font-medium">@L10n["Timeout in minutes (optional)"]</label>
                            <input id="run-timeout-minutes"
                                   name="TimeoutMinutes"
                                   type="number"
                                   min="1"
                                   max="10080"
                                   class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:p-2 bb:text-sm"
                                   placeholder="@L10n["default (60)"]" />
                            @if (TimeoutError is { } timeoutError)
                            {
                                <p id="run-timeout-minutes-error" role="alert" class="bb:mt-1 bb:text-sm bb:text-destructive">@timeoutError</p>
                            }
                        </div>
                        <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Default">@L10n["Start run"]</BbButton>
                    </div>
                </form>
                }
            </BbCardContent>
        </BbCard>
    }
</div>

@code {
    [Parameter]
    public Guid ProjectId { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private UserSessionInfo? _session;
    private ProjectView? _project;
    private bool _canDelete;
    private IReadOnlyList<WebhookView> _webhooks = [];
    private RunView? _newestRun;

    /// <summary>Card F-026: the edges that name this project, split by direction for the overview's summary.</summary>
    private IReadOnlyList<ProjectLinkView> _upstreamLinks = [];

    private IReadOnlyList<ProjectLinkView> _downstreamLinks = [];
    private int? _savedStepCount;
    private ProjectParameter[] _parameterDefinitions = [];

    /// <summary>
    /// Card F-041: the runs a <c>run</c> parameter may select, newest first and bounded - the same read the Runs
    /// tab uses, so the form and the tab cannot disagree about what exists. Loaded only when the project declares
    /// a run parameter, because every other page render has no use for it.
    /// </summary>
    private IReadOnlyList<RunView> _parameterRuns = [];
    private int _credentialCount;
    private string? _assignedCredentialName;

    /// <summary>F-029: the project's queued-run count, read only when the trigger was refused at the cap.</summary>
    private int _queuedRunCount;

    /// <summary>One clock instant per render (the D-002 discipline the dashboard and runs list keep).</summary>
    private DateTimeOffset _now;

    [SupplyParameterFromQuery(Name = "notice")]
    private string? NoticeCode { get; set; }

    [SupplyParameterFromQuery(Name = "runError")]
    private string? RunErrorCode { get; set; }

    private string? Notice => NoticeCode switch
    {
        "created" => L10n["The project was created."],
        "updated" => L10n["The project was updated."],
        _ => null,
    };

    private string CredentialCountText => _canManageCredentials
        ? _credentialCount.ToString(CultureInfo.InvariantCulture)
        : L10n["Owner-managed"];

    private bool _canManageCredentials;

    private string? BranchError => RunErrorCode switch
    {
        RunErrorCodes.BranchInvalid => L10n["That is not a valid branch name; leave it blank to build the default branch."],
        _ => null,
    };

    private string? TagsError => RunErrorCode switch
    {
        RunErrorCodes.TagUnknown => L10n["No registered worker in this organization has one of these tags."],
        RunErrorCodes.TagInvalid => L10n["Required tags are comma-separated text, at most 64 characters per tag."],
        _ => null,
    };

    private string? TimeoutError => RunErrorCode switch
    {
        RunErrorCodes.TimeoutInvalid => L10n["The timeout is a whole number of minutes between 1 and 10080; leave it blank for the server default."],
        _ => null,
    };

    /// <summary>
    /// F-019: the trigger body carried no field the form binds (a dropped body, a renamed field), so
    /// no run was started. The refusal is form-level - there is no single field to blame - but it still
    /// has to say something, otherwise the page looks like a no-op.
    /// </summary>
    private string? RunRequestError => RunErrorCode switch
    {
        RunErrorCodes.FieldInvalid => L10n["That request could not be read, so no run was started. Try again."],
        RunErrorCodes.ParameterUnknown => L10n["One of the supplied parameter names is not defined on this project."],
        RunErrorCodes.ParameterInvalid => L10n["One of the supplied parameter values does not fit its type."],
        RunErrorCodes.ParameterNoRun =>
            L10n["A run parameter asked for the project's previous run, and this project has no successful run yet."],
        RunErrorCodes.ParameterFileTooLarge =>
            L10n["An uploaded file parameter is over the {0} KiB bound, so no run was queued.", ProjectParameterLimits.MaxFileBytes / 1024],

        // Cards F-028 + F-029: the project itself refused the trigger. The code is all the redirect can
        // carry; the numbers (if any) are re-read here, so the message quotes what is true now.
        ProjectTriggerRefusals.ProjectDisabled =>
            ProjectTriggerGuard.DisabledMessage(_project?.DisabledReason, L10n),
        ProjectTriggerRefusals.QueueFull => _project?.MaxQueuedRuns is { } cap
            ? ProjectTriggerGuard.QueueFullMessage(_queuedRunCount, cap, L10n)
            : L10n["The project's queue is full, so no run was queued."],
        _ => null,
    };

    /// <summary>
    /// The runs a <c>run</c> parameter offers (card F-041): the project's own runs, newest first, so the number
    /// in the value is one the trigger path will resolve. Empty for a project with no runs - the trigger then
    /// refuses with <see cref="RunErrorCodes.ParameterNoRun"/> rather than queueing a run with no selection.
    /// </summary>
    private IEnumerable<RunView> RunParameterOptions(ProjectParameter parameter) => _parameterRuns;

    /// <summary>
    /// The preselected run: the newest <b>successful</b> one, which is also what the server resolves a headless
    /// trigger to - the form's prefill and the schedule's default are one rule, not two.
    /// </summary>
    private string? RunParameterPrefill(ProjectParameter parameter)
    {
        var successful = _parameterRuns.FirstOrDefault(run => run.Status == BuildRunStatus.Success);
        return (successful ?? _parameterRuns.FirstOrDefault())?.Number?.ToString(CultureInfo.InvariantCulture);
    }

    /// <summary>One option's label: <c>#N status branch</c>, the shape the card asks for.</summary>
    private static string RunParameterLabel(RunView run) =>
        $"#{(run.Number?.ToString(CultureInfo.InvariantCulture) ?? "?")} {run.Status} {run.GitBranch}";

    protected override async Task OnInitializedAsync()
    {
        // Establish the circuit tenant before the tenant-filtered lookup.
        _session = await UserSession.GetAsync();
        _canDelete = _session?.CanManageActiveOrganization == true;
        _canManageCredentials = _canDelete;
        _now = DateTimeOffset.UtcNow;

        if (_session?.HasOrganization != true)
        {
            return;
        }

        _project = await ProjectsService.GetProjectAsync(ProjectId);
        if (_project is null && HttpContext is not null)
        {
            // A real 404 for a foreign or missing id. The status-code-pages middleware must not
            // re-execute /not-found in this same request: the component renderer already owns the
            // NavigationManager, and re-execution fails with "already initialized". The HTTP
            // response is therefore a bodyless 404; NotFoundPage below covers circuit navigation.
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
            if (HttpContext.Features.Get<IStatusCodePagesFeature>() is { } statusCodePages)
            {
                statusCodePages.Enabled = false;
            }

            return;
        }

        if (_project is null || _session is not { HasOrganization: true } session)
        {
            return;
        }

        // F-026: the chain summary. Two filtered reads of the same list, because the card answers two questions
        // - "what queues me" and "what do I queue" - and an operator reading the overview cares about both.
        var chainLinks = await ChainLinkService.GetForProjectAsync(ProjectId);
        _upstreamLinks = [.. chainLinks.Where(link => link.DownstreamProjectId == ProjectId)];
        _downstreamLinks = [.. chainLinks.Where(link => link.UpstreamProjectId == ProjectId)];

        // F-021: the trigger form renders the project's parameter definitions (both kinds). The
        // stored JSON was validated at save; a parse here only fails on a corrupted row, and the
        // form then renders none rather than guessing.
        if (_project.ParametersJson is { } savedParameters)
        {
            try
            {
                _parameterDefinitions = JsonSerializer.Deserialize(
                    savedParameters,
                    ProjectParameterJsonContext.Default.ProjectParameterArray) ?? [];
            }
            catch (JsonException)
            {
                _parameterDefinitions = [];
            }
        }

        // F-020: the Freestyle overview shows whether steps are saved (and how many). The saved JSON
        // is envelope-checked, so a count is only derived from a spec the server accepted.
        if (_project.Kind == ProjectKinds.Freestyle
            && _project.FreestyleSpecJson is { } savedSpec
            && PipelineSpecJson.TryRead(savedSpec, out var saved, out _)
            && saved is not null)
        {
            _savedStepCount = saved.Steps.Length;
        }

        // The project's webhooks (any member may manage them, F-017): the count here, the cards on
        // the settings tab. The service re-checks membership; a failure just leaves the list empty.
        var webhooks = await WebhookManagement.GetWebhooksAsync(session.UserId, ProjectId);
        _webhooks = webhooks.Webhooks;

        // The newest run, through the same read the Runs tab uses (newest first), so overview and
        // tab can never disagree about which run is newest.
        var runs = await RunsService.GetProjectRunsAsync(ProjectId);
        _newestRun = runs.Count > 0 ? runs[0] : null;

        // F-041: the trigger form's run-parameter choices. Bounded like the runs list, newest first.
        _parameterRuns = _parameterDefinitions.Any(definition => ProjectParameterTypes.IsRunSelection(definition.Type))
            ? [.. runs.Take(20)]
            : [];

        // F-029: the queue-cap refusal quotes the observed numbers, so read the count only for that
        // refusal - every other render of this page needs no count.
        if (RunErrorCode == ProjectTriggerRefusals.QueueFull)
        {
            _queuedRunCount = await RunsService.GetProjectQueuedRunCountAsync(ProjectId);
        }

        // Credential metadata is Owner-visible only (the settings tab's asymmetry stance): an Owner
        // gets the count and the assigned credential's name, a Member neither.
        if (_canManageCredentials)
        {
            var credentials = await CredentialService.ListForProjectAsync(session.UserId, ProjectId);
            if (credentials.Status == GitCredentialMutationStatus.Success)
            {
                _credentialCount = credentials.Items.Count;
                _assignedCredentialName = credentials.Items
                    .FirstOrDefault(credential => credential.Id == _project.GitCredentialId)?.Name;
            }
        }
    }
}
