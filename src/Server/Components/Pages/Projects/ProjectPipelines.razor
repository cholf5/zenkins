@page "/projects/{ProjectId:guid}/pipelines"
@attribute [Authorize]
@using Zenkins.Shared.Pipelines
@using Zenkins.Shared.Projects
@using Zenkins.Server.Probes
@inject UserSession UserSession
@inject ProjectService ProjectsService
@inject RunService RunsService
@inject Zenkins.Server.Probes.DefinitionValidationService Validations

@* D-003: the definition tab, read-only by decision for a Pipeline project - it answers "what does
   this project actually run": the pipeline file from settings, and - when any run exists - the
   frozen spec of the newest run (F-014) with its step names in order. Editing pipeline content
   belongs to the repository. A Freestyle project (F-020) is the other half: its definition lives on
   the server, so this same route renders the steps editor instead. *@
<PageTitle>@(_project is { } project && project.Kind == ProjectKinds.Freestyle ? "Steps" : "Pipelines") · @(_project?.Name ?? "Project") · Zenkins</PageTitle>

<div class="bb:mx-auto bb:w-full bb:max-w-3xl bb:space-y-6">
    @if (_project is null)
    {
        @* Foreign tenant id == missing id: the service reads through the tenant filter and the
           response is a real 404 (same pattern as the other project tabs). *@
        <NotFoundPage />
    }
    else if (_project.Kind == ProjectKinds.Freestyle)
    {
        <div class="bb:flex bb:flex-wrap bb:items-center bb:justify-between bb:gap-3">
            <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-3">
                <BbCardTitle As="h1" tabindex="-1">Steps · @_project.Name</BbCardTitle>
                <BbBadge Variant="BadgeVariant.Outline">Freestyle</BbBadge>
            </div>
        </div>

        <ProjectTabs ProjectId="@_project.Id" Active="pipelines" Kind="@_project.Kind"
                     BranchDiscovery="@_project.BranchDiscovery" />

        @if (Notice is { } notice)
        {
            <div role="status" class="bb:rounded-md bb:border bb:border-input bb:bg-muted bb:p-3 bb:text-sm">
                <p>@notice</p>
            </div>
        }

        <BbCard>
            <BbCardHeader>
                <BbCardTitle As="h2">Steps</BbCardTitle>
                <BbCardDescription>
                    The steps this project runs, in order. Every step is a script the claiming worker
                    executes in the run's workspace - no repository, no clone. Saving freezes this
                    list onto the project; a run carries the snapshot it was triggered with, so
                    editing here never moves a queued or running run.
                </BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                <FreestyleStepsEditor Action="@($"/projects/{_project.Id}/freestyle/steps")"
                                      Steps="@(_savedSteps ?? [])"
                                      ErrorCode="@ErrorCode" />
            </BbCardContent>
        </BbCard>
    }
    else if (_project.Kind == ProjectKinds.Pipeline && _project.PipelineSource == ProjectSources.Inline)
    {
        <div class="bb:flex bb:flex-wrap bb:items-center bb:justify-between bb:gap-3">
            <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-3">
                <BbCardTitle As="h1" tabindex="-1">Pipelines · @_project.Name</BbCardTitle>
                <BbBadge Variant="BadgeVariant.Outline">Inline</BbBadge>
            </div>
        </div>

        <ProjectTabs ProjectId="@_project.Id" Active="pipelines" Kind="@_project.Kind"
                     BranchDiscovery="@_project.BranchDiscovery" />

        @if (Notice is { } notice)
        {
            <div role="status" class="bb:rounded-md bb:border bb:border-input bb:bg-muted bb:p-3 bb:text-sm">
                <p>@notice</p>
            </div>
        }
        @if (Error is { } error)
        {
            <div role="alert" class="bb:rounded-md bb:border bb:border-destructive/40 bb:bg-destructive/10 bb:p-3 bb:text-sm bb:text-destructive">
                <p>@error</p>
            </div>
        }

        <BbCard>
            <BbCardHeader>
                <BbCardTitle As="h2">Pipeline script</BbCardTitle>
                <BbCardDescription>
                    This project's definition lives here, not in a repository. Every run snapshots the
                    script at trigger time and its worker runs the definition phase against
                    <code>pipeline.lua</code>, so a later edit never moves a queued or running run.
                </BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                <form method="post"
                      action="@($"/projects/{_project.Id}/inline/script")"
                      data-zenkins-antiforgery
                      class="bb:space-y-3">
                    <label for="inline-script" class="bb:text-sm bb:font-medium">Script</label>
                    <textarea id="inline-script"
                              name="Script"
                              rows="18"
                              maxlength="65536"
                              spellcheck="false"
                              autocomplete="off"
                              class="bb:flex bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-3 bb:py-2 bb:font-mono bb:text-sm">@_project.InlineScript</textarea>
                    <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-3">
                        <button type="submit"
                                class="bb:inline-flex bb:h-9 bb:items-center bb:justify-center bb:rounded-md bb:bg-primary bb:px-4 bb:text-sm bb:font-medium bb:text-primary-foreground">
                            Save script
                        </button>
                        @* F-022 (AC-6): Validate runs the definition phase on a worker and shows the
                           step list. It does not save and does not create a run - the button posts the
                           textarea's text to its own endpoint (formaction), which is the honest version
                           of Jenkins' "validate on save". A plain <button> so formaction is guaranteed
                           to render. *@
                        <button type="submit"
                                formaction="@($"/projects/{_project.Id}/inline/validate")"
                                class="bb:inline-flex bb:h-9 bb:items-center bb:justify-center bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-4 bb:text-sm bb:font-medium">
                            Validate
                        </button>
                    </div>
                </form>
            </BbCardContent>
        </BbCard>

        @if (_validation is { } validation)
        {
            <BbCard>
                <BbCardHeader>
                    <BbCardTitle As="h2">Validation result</BbCardTitle>
                    <BbCardDescription>
                        What the definition phase produced for the text that was validated. No step ran and
                        no run was created. Saving the script alone never claims it is valid.
                    </BbCardDescription>
                </BbCardHeader>
                <BbCardContent>
                    @if (validation.NoWorker)
                    {
                        <p id="inline-validation-no-worker" class="bb:text-sm bb:text-muted-foreground">
                            No worker answered the validation before the wait ended. Start a worker and try
                            again; the script was not saved and nothing was queued.
                        </p>
                    }
                    else if (validation.Valid)
                    {
                        <p id="inline-validation-valid" class="bb:text-sm">
                            Valid — the definition declares <span class="bb:font-medium">@validation.StepNames.Count</span> step(s):
                        </p>
                        <ol id="inline-validation-steps" class="bb:mt-2 bb:space-y-2 bb:text-sm">
                            @for (var stepIndex = 0; stepIndex < validation.StepNames.Count; stepIndex++)
                            {
                                <li>
                                    <span class="bb:text-xs bb:text-muted-foreground">@(stepIndex + 1).</span>
                                    <span class="bb:font-medium">@validation.StepNames[stepIndex]</span>
                                </li>
                            }
                        </ol>
                    }
                    else
                    {
                        <p id="inline-validation-invalid" class="bb:text-sm bb:text-destructive">
                            Invalid — @validation.FailureReason
                        </p>
                        <pre id="inline-validation-diagnostic" class="bb:mt-2 bb:overflow-x-auto bb:rounded-md bb:border bb:border-input bb:bg-muted bb:p-3 bb:text-xs">@validation.Diagnostic</pre>
                    }
                </BbCardContent>
            </BbCard>
        }
    }
    else
    {
        <div class="bb:flex bb:flex-wrap bb:items-center bb:justify-between bb:gap-3">
            <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-3">
                <BbCardTitle As="h1" tabindex="-1">Pipelines · @_project.Name</BbCardTitle>
                <BbBadge Variant="BadgeVariant.Outline">@_project.DefaultBranch</BbBadge>
            </div>
        </div>

        <ProjectTabs ProjectId="@_project.Id" Active="pipelines"
                     BranchDiscovery="@_project.BranchDiscovery" />

        <BbCard>
            <BbCardHeader>
                <BbCardTitle As="h2">Pipeline file</BbCardTitle>
                <BbCardDescription>
                    Every run executes this file from the repository. The file's content is the
                    repository's to own; the worker validates it before the first step starts.
                </BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                <dl class="bb:grid bb:grid-cols-1 bb:gap-4 bb:text-sm bb:sm:grid-cols-3">
                    <div>
                        <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">Pipeline path</dt>
                        <dd id="pipelines-path" class="bb:break-all">@_project.PipelinePath</dd>
                    </div>
                    <div>
                        <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">Default branch</dt>
                        <dd>@_project.DefaultBranch</dd>
                    </div>
                </dl>
            </BbCardContent>
        </BbCard>

        @if (_newestRun is not { } run)
        {
            <BbEmpty Title="No runs yet"
                     Description="The frozen spec appears here when the first run has reported its pipeline definition.">
                <Icon>
                    <LucideIcon Name="file-code" Class="bb:h-12 bb:w-12" />
                </Icon>
            </BbEmpty>
        }
        else
        {
            <BbCard>
                <BbCardHeader>
                    <BbCardTitle As="h2">Frozen spec of the newest run</BbCardTitle>
                    <BbCardDescription>
                        The validated pipeline definition the newest run froze before its first step
                        started. A later commit never changes what a run shows.
                    </BbCardDescription>
                </BbCardHeader>
                <BbCardContent>
                    <dl class="bb:grid bb:grid-cols-1 bb:gap-4 bb:text-sm bb:sm:grid-cols-3">
                        <div>
                            <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">Run</dt>
                            <dd>
                                <a href="/projects/@run.ProjectId/runs/@run.Number" class="bb:underline bb:underline-offset-4">Run #@run.Number</a>
                            </dd>
                        </div>
                        <div>
                            <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">Branch</dt>
                            <dd id="pipelines-branch" class="bb:break-all">@run.GitBranch</dd>
                        </div>
                        <div>
                            <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">Commit</dt>
                            <dd id="pipelines-commit" class="bb:break-all">@(run.GitCommit ?? "-")</dd>
                        </div>
                    </dl>

                    @if (run.Pipeline is { } pipeline)
                    {
                        @* The spec's validated shape: schema version, pipeline name and the step
                           names in declaration order (the order the executor runs them in). *@
                        <p class="bb:mt-4 bb:text-sm">
                            <span class="bb:font-medium">Pipeline:</span>
                            <span id="pipelines-name">@pipeline.Name</span>
                            @* The explicit expression matters: "v@..." after a letter is an
                               email-style literal in Razor, never code. *@
                            <span class="bb:text-muted-foreground">
                                (schema v@(pipeline.Version), @pipeline.Steps.Length step(s))
                            </span>
                        </p>
                        <ol id="pipelines-steps" class="bb:mt-2 bb:space-y-2 bb:text-sm">
                            @for (var stepIndex = 0; stepIndex < pipeline.Steps.Length; stepIndex++)
                            {
                                var step = pipeline.Steps[stepIndex];
                                <li id="@($"pipelines-step-{step.Name}")" class="bb:break-all">
                                    <span class="bb:text-xs bb:text-muted-foreground">@(stepIndex + 1).</span>
                                    <span class="bb:font-medium">@step.Name</span>
                                    <code class="bb:ml-2 bb:text-xs bb:text-muted-foreground">@string.Join(' ', step.Argv)</code>
                                </li>
                            }
                        </ol>
                    }
                    else
                    {
                        <p id="pipelines-spec-pending" class="bb:mt-4 bb:text-sm bb:text-muted-foreground">
                            No pipeline definition was reported for this run.
                        </p>
                    }
                </BbCardContent>
            </BbCard>
        }
    }
</div>

@code {
    [Parameter]
    public Guid ProjectId { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    private string? ErrorCode { get; set; }

    /// <summary>The steps save's PRG outcome (F-020), on the route that owns the editor.</summary>
    [SupplyParameterFromQuery(Name = "notice")]
    private string? NoticeCode { get; set; }

    /// <summary>F-022: the script save's / validation's notice.</summary>
    [SupplyParameterFromQuery(Name = "validated")]
    private string? ValidatedId { get; set; }

    /// <summary>The specific settled validation the PRG redirect named; a malformed/forged id is null.</summary>
    private Guid? RequestedValidationId => Guid.TryParse(ValidatedId, out var id) ? id : null;

    private string? Notice => NoticeCode switch
    {
        "steps-saved" => "The steps were saved; the next run carries this snapshot.",
        "script-saved" => "The script was saved; the next run carries this snapshot. Saving does not prove it valid - use Validate.",
        _ => null,
    };

    private string? Error => ProjectErrorCodes.MessageFor(ErrorCode);

    private ProjectView? _project;
    private RunView? _newestRun;
    private IReadOnlyList<PipelineStep>? _savedSteps;
    private DefinitionValidationView? _validation;

    protected override async Task OnInitializedAsync()
    {
        // F-003 hazard: resolving the session selects the circuit's tenant before any tenant-owned
        // row is read. Never rely on the layout having done it first.
        var session = await UserSession.GetAsync();
        if (session?.HasOrganization != true)
        {
            return;
        }

        _project = await ProjectsService.GetProjectAsync(ProjectId);
        if (_project is null)
        {
            SetNotFound();
            return;
        }

        // F-020: a Freestyle project's saved steps render as the editor's starting rows. The saved
        // JSON is the envelope-checked spec, so the parse here only fails on a corrupted row - the
        // editor then renders empty rather than guessing.
        if (_project.Kind == ProjectKinds.Freestyle)
        {
            _savedSteps = LoadSavedSteps(_project.FreestyleSpecJson);
        }

        // F-022: the last settled validation for this project, so the PRG redirect can show its step
        // list. It is deliberately a GET-time read of an in-memory result, not a run or a stored row.
        if (_project.Kind == ProjectKinds.Pipeline && _project.PipelineSource == ProjectSources.Inline)
        {
            _validation = Validations.LastValidation(ProjectId, RequestedValidationId);
        }

        // The same read the Runs tab uses (newest first), so "newest" means the same run everywhere.
        var runs = await RunsService.GetProjectRunsAsync(ProjectId);
        _newestRun = runs.Count > 0 ? runs[0] : null;
    }

    private static IReadOnlyList<PipelineStep> LoadSavedSteps(string? specJson)
    {
        if (specJson is not { } saved
            || !PipelineSpecJson.TryRead(saved, out var spec, out _)
            || spec is null)
        {
            return [];
        }

        return spec.Steps;
    }

    private void SetNotFound()
    {
        if (HttpContext is null)
        {
            return;
        }

        // A real 404 for a foreign or missing id. The status-code-pages middleware must not
        // re-execute /not-found in this same request: the component renderer already owns the
        // NavigationManager, and re-execution fails with "already initialized" (F-003 bug B1).
        HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
        if (HttpContext.Features.Get<IStatusCodePagesFeature>() is { } statusCodePages)
        {
            statusCodePages.Enabled = false;
        }
    }
}
