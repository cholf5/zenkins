@page "/projects/{ProjectId:guid}/pipelines"
@attribute [Authorize]
@using System.Text.Json
@using Zenkins.Shared.Pipelines
@using Zenkins.Shared.Projects
@using Zenkins.Shared.Snippets
@using Zenkins.Server.Probes
@using Zenkins.Server.Snippets
@inject UserSession UserSession
@inject ProjectService ProjectsService
@inject RunService RunsService
@inject StepSnippetService SnippetsService
@inject Zenkins.Server.Probes.DefinitionValidationService Validations

@* D-003: the definition tab, read-only by decision for a Pipeline project - it answers "what does
   this project actually run": the pipeline file from settings, and - when any run exists - the
   frozen spec of the newest run (F-014) with its step names in order. Editing pipeline content
   belongs to the repository. A Freestyle project (F-020) is the other half: its definition lives on
   the server, so this same route renders the steps editor instead. *@
<PageTitle>@(_project is { } project && project.Kind == ProjectKinds.Freestyle ? L10n["Steps"] : L10n["Pipelines"]) · @(_project?.Name ?? L10n["Project"]) · Zenkins</PageTitle>

<div class="bb:mx-auto bb:w-full bb:max-w-3xl bb:space-y-6">
    @if (_project is null)
    {
        @* Foreign tenant id == missing id: the service reads through the tenant filter and the
           response is a real 404 (same pattern as the other project tabs). *@
        <NotFoundPage />
    }
    else if (_project.Kind == ProjectKinds.Freestyle)
    {
        <div class="bb:flex bb:flex-wrap bb:items-center bb:justify-between bb:gap-3">
            <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-3">
                <BbCardTitle As="h1" tabindex="-1">@L10n["Steps"] · @_project.Name</BbCardTitle>
                <BbBadge Variant="BadgeVariant.Outline">Freestyle</BbBadge>
            </div>
        </div>

        <ProjectTabs ProjectId="@_project.Id" Active="pipelines" Kind="@_project.Kind"
                     BranchDiscovery="@_project.BranchDiscovery" />

        @if (Notice is { } notice)
        {
            <div role="status" class="bb:rounded-md bb:border bb:border-input bb:bg-muted bb:p-3 bb:text-sm">
                <p>@notice</p>
            </div>
        }

        <BbCard>
            <BbCardHeader>
                <BbCardTitle As="h2">@L10n["Steps"]</BbCardTitle>
                <BbCardDescription>
                    @L10n["The steps this project runs, in order. Every step is a script the claiming worker executes in the run's workspace - no repository, no clone. Saving freezes this list onto the project; a run carries the snapshot it was triggered with, so editing here never moves a queued or running run."]
                </BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                @SnippetDataScript()
                <FreestyleStepsEditor Action="@($"/projects/{_project.Id}/freestyle/steps")"
                                      Steps="@(_savedSteps ?? [])"
                                      PostAlways="@(_savedPost?.Always ?? [])"
                                      PostSuccess="@(_savedPost?.Success ?? [])"
                                      PostFailure="@(_savedPost?.Failure ?? [])"
                                      Snippets="@ScriptStepSnippets"
                                      ErrorCode="@ErrorCode" />
            </BbCardContent>
        </BbCard>
    }
    else if (_project.Kind == ProjectKinds.Pipeline && _project.PipelineSource == ProjectSources.Inline)
    {
        <div class="bb:flex bb:flex-wrap bb:items-center bb:justify-between bb:gap-3">
            <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-3">
                <BbCardTitle As="h1" tabindex="-1">@L10n["Pipelines"] · @_project.Name</BbCardTitle>
                <BbBadge Variant="BadgeVariant.Outline">@L10n["Inline"]</BbBadge>
            </div>
        </div>

        @SnippetDataScript()

        <ProjectTabs ProjectId="@_project.Id" Active="pipelines" Kind="@_project.Kind"
                     BranchDiscovery="@_project.BranchDiscovery" />

        @if (Notice is { } notice)
        {
            <div role="status" class="bb:rounded-md bb:border bb:border-input bb:bg-muted bb:p-3 bb:text-sm">
                <p>@notice</p>
            </div>
        }
        @if (Error is { } error)
        {
            <div role="alert" class="bb:rounded-md bb:border bb:border-destructive/40 bb:bg-destructive/10 bb:p-3 bb:text-sm bb:text-destructive">
                <p>@error</p>
            </div>
        }

        <BbCard>
            <BbCardHeader>
                <BbCardTitle As="h2">@L10n["Pipeline script"]</BbCardTitle>
                <BbCardDescription>
                    @L10n["This project's definition lives here, not in a repository. Every run snapshots the script at trigger time and its worker runs the definition phase against"]
                    <code>pipeline.lua</code>@L10n[", so a later edit never moves a queued or running run."]
                </BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                <form method="post"
                      action="@($"/projects/{_project.Id}/inline/script")"
                      data-zenkins-antiforgery
                      class="bb:space-y-3">
                    <label for="inline-script" class="bb:text-sm bb:font-medium">@L10n["Script"]</label>
                    <textarea id="inline-script"
                              name="Script"
                              rows="18"
                              maxlength="65536"
                              spellcheck="false"
                              autocomplete="off"
                              class="bb:flex bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-3 bb:py-2 bb:font-mono bb:text-sm">@_project.InlineScript</textarea>
                    @* F-035: insert a Lua fragment at the caret. The text is copied into the editor and saved
                       like typed text - the snippet is never referenced by the project or a run. *@
                    @if (FragmentSnippets.Count > 0)
                    {
                        <div id="inline-snippets" class="bb:rounded-md bb:border bb:border-input bb:p-3 bb:text-sm">
                            <label for="inline-snippet-select" class="bb:mb-1 bb:block bb:text-xs bb:font-medium">
                                @L10n["Insert a snippet"]
                            </label>
                            <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-2">
                                <select id="inline-snippet-select"
                                        data-snippet-select="luaFragment"
                                        class="bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-2 bb:py-1 bb:text-xs">
                                    @foreach (var snippet in FragmentSnippets)
                                    {
                                        <option value="@snippet.Id">@snippet.Name</option>
                                    }
                                </select>
                                <button type="button"
                                        data-snippet-insert
                                        data-snippet-target="#inline-script"
                                        data-snippet-list="luaFragment"
                                        class="bb:rounded-md bb:border bb:border-input bb:px-3 bb:py-1 bb:text-xs">
                                    @L10n["Insert at caret"]
                                </button>
                                <span data-snippet-status class="bb:text-xs bb:text-muted-foreground"></span>
                            </div>
                        </div>
                    }
                    <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-3">
                        <button type="submit"
                                class="bb:inline-flex bb:h-9 bb:items-center bb:justify-center bb:rounded-md bb:bg-primary bb:px-4 bb:text-sm bb:font-medium bb:text-primary-foreground">
                            @L10n["Save script"]
                        </button>
                        @* F-022 (AC-6): Validate runs the definition phase on a worker and shows the
                           step list. It does not save and does not create a run - the button posts the
                           textarea's text to its own endpoint (formaction), which is the honest version
                           of Jenkins' "validate on save". A plain <button> so formaction is guaranteed
                           to render. *@
                        <button type="submit"
                                formaction="@($"/projects/{_project.Id}/inline/validate")"
                                class="bb:inline-flex bb:h-9 bb:items-center bb:justify-center bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-4 bb:text-sm bb:font-medium">
                            @L10n["Validate"]
                        </button>
                    </div>
                </form>
            </BbCardContent>
        </BbCard>

        @if (_validation is { } validation)
        {
            <BbCard>
                <BbCardHeader>
                    <BbCardTitle As="h2">@L10n["Validation result"]</BbCardTitle>
                    <BbCardDescription>
                        @L10n["What the definition phase produced for the text that was validated. No step ran and no run was created. Saving the script alone never claims it is valid."]
                    </BbCardDescription>
                </BbCardHeader>
                <BbCardContent>
                    @if (validation.NoWorker)
                    {
                        <p id="inline-validation-no-worker" class="bb:text-sm bb:text-muted-foreground">
                            @L10n["No worker answered the validation before the wait ended. Start a worker and try again; the script was not saved and nothing was queued."]
                        </p>
                    }
                    else if (validation.Valid)
                    {
                        <p id="inline-validation-valid" class="bb:text-sm">
                            @L10n["Valid — the definition declares"] <span class="bb:font-medium">@validation.StepNames.Count</span> @L10n["step(s):"]
                        </p>
                        <ol id="inline-validation-steps" class="bb:mt-2 bb:space-y-2 bb:text-sm">
                            @for (var stepIndex = 0; stepIndex < validation.StepNames.Count; stepIndex++)
                            {
                                <li>
                                    <span class="bb:text-xs bb:text-muted-foreground">@(stepIndex + 1).</span>
                                    <span class="bb:font-medium">@validation.StepNames[stepIndex]</span>
                                </li>
                            }
                        </ol>
                    }
                    else
                    {
                        <p id="inline-validation-invalid" class="bb:text-sm bb:text-destructive">
                            @L10n["Invalid —"] @validation.FailureReason
                        </p>
                        <pre id="inline-validation-diagnostic" class="bb:mt-2 bb:overflow-x-auto bb:rounded-md bb:border bb:border-input bb:bg-muted bb:p-3 bb:text-xs">@validation.Diagnostic</pre>
                    }
                </BbCardContent>
            </BbCard>
        }
    }
    else
    {
        @* F-035: the snippet pickers' one data source. The bodies are copied by the browser on insert; the
           product never fetches them at run time, so editing a snippet cannot reach a saved definition. *@
        @SnippetDataScript()

        <div class="bb:flex bb:flex-wrap bb:items-center bb:justify-between bb:gap-3">
            <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-3">
                <BbCardTitle As="h1" tabindex="-1">@L10n["Pipelines"] · @_project.Name</BbCardTitle>
                <BbBadge Variant="BadgeVariant.Outline">@_project.DefaultBranch</BbBadge>
            </div>
        </div>

        <ProjectTabs ProjectId="@_project.Id" Active="pipelines"
                     BranchDiscovery="@_project.BranchDiscovery" />

        <BbCard>
            <BbCardHeader>
                <BbCardTitle As="h2">@L10n["Pipeline file"]</BbCardTitle>
                <BbCardDescription>
                    @L10n["Every run executes this file from the repository. The file's content is the repository's to own; the worker validates it before the first step starts."]
                </BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                <dl class="bb:grid bb:grid-cols-1 bb:gap-4 bb:text-sm bb:sm:grid-cols-3">
                    <div>
                        <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">@L10n["Pipeline path"]</dt>
                        <dd id="pipelines-path" class="bb:break-all">@_project.PipelinePath</dd>
                    </div>
                    <div>
                        <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">@L10n["Default branch"]</dt>
                        <dd>@_project.DefaultBranch</dd>
                    </div>
                </dl>
            </BbCardContent>
        </BbCard>

        @* F-035: the repository half. The product copies the text and never rewrites the repository file, so
           this is a clipboard affordance plus the snippet bodies - paste into pipeline.lua yourself. *@
        @if (FragmentSnippets.Count > 0)
        {
            <BbCard>
                <BbCardHeader>
                    <BbCardTitle As="h2">@L10n["Snippet library"]</BbCardTitle>
                    <BbCardDescription>
                        @L10n["Copy a fragment into"]
                        <code>@_project.PipelinePath</code>
                        @L10n["in your repository. The product never rewrites your repository; the file stays the source of truth, and a snippet edit never changes a committed pipeline."]
                    </BbCardDescription>
                </BbCardHeader>
                <BbCardContent>
                    <div id="pipelines-snippets" class="bb:space-y-3">
                        @foreach (var snippet in FragmentSnippets)
                        {
                            <div class="bb:rounded-md bb:border bb:border-input bb:p-3">
                                <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-2">
                                    <span class="bb:text-sm bb:font-medium">@snippet.Name</span>
                                    <button type="button"
                                            data-snippet-copy="true"
                                            data-snippet-id="@snippet.Id"
                                            data-snippet-list="luaFragment"
                                            class="bb:rounded-md bb:border bb:border-input bb:px-2 bb:py-1 bb:text-xs">
                                        @L10n["Copy"]
                                    </button>
                                    <span data-snippet-status class="bb:text-xs bb:text-muted-foreground"></span>
                                </div>
                                @if (snippet.Description is { Length: > 0 } description)
                                {
                                    <p class="bb:text-xs bb:text-muted-foreground">@description</p>
                                }
                                <pre class="bb:mt-2 bb:max-h-40 bb:overflow-auto bb:rounded-md bb:bg-muted bb:p-2 bb:text-xs">@snippet.Body</pre>
                            </div>
                        }
                    </div>
                </BbCardContent>
            </BbCard>
        }

        @if (_newestRun is not { } run)
        {
            <BbEmpty Title="@L10n["No runs yet"]"
                     Description="@L10n["The frozen spec appears here when the first run has reported its pipeline definition."]">
                <Icon>
                    <LucideIcon Name="file-code" Class="bb:h-12 bb:w-12" />
                </Icon>
            </BbEmpty>
        }
        else
        {
            <BbCard>
                <BbCardHeader>
                    <BbCardTitle As="h2">@L10n["Frozen spec of the newest run"]</BbCardTitle>
                    <BbCardDescription>
                        @L10n["The validated pipeline definition the newest run froze before its first step started. A later commit never changes what a run shows."]
                    </BbCardDescription>
                </BbCardHeader>
                <BbCardContent>
                    <dl class="bb:grid bb:grid-cols-1 bb:gap-4 bb:text-sm bb:sm:grid-cols-3">
                        <div>
                            <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">@L10n["Run"]</dt>
                            <dd>
                                <a href="/projects/@run.ProjectId/runs/@run.Number" class="bb:underline bb:underline-offset-4">@L10n["Run #{0}", run.Number]</a>
                            </dd>
                        </div>
                        <div>
                            <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">@L10n["Branch"]</dt>
                            <dd id="pipelines-branch" class="bb:break-all">@run.GitBranch</dd>
                        </div>
                        <div>
                            <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">@L10n["Commit"]</dt>
                            <dd id="pipelines-commit" class="bb:break-all">@(run.GitCommit ?? "-")</dd>
                        </div>
                    </dl>

                    @if (run.Pipeline is { } pipeline)
                    {
                        @* The spec's validated shape: schema version, pipeline name and the step
                           names in declaration order (the order the executor runs them in). *@
                        <p class="bb:mt-4 bb:text-sm">
                            <span class="bb:font-medium">@L10n["Pipeline:"]</span>
                            <span id="pipelines-name">@pipeline.Name</span>
                            @* The explicit expression matters: "v@..." after a letter is an
                               email-style literal in Razor, never code. *@
                            <span class="bb:text-muted-foreground">
                                @L10n["(schema v{0}, {1} step(s))", pipeline.Version, pipeline.Steps.Length]
                            </span>
                        </p>
                        <ol id="pipelines-steps" class="bb:mt-2 bb:space-y-2 bb:text-sm">
                            @for (var stepIndex = 0; stepIndex < pipeline.Steps.Length; stepIndex++)
                            {
                                var step = pipeline.Steps[stepIndex];
                                <li id="@($"pipelines-step-{step.Name}")" class="bb:break-all">
                                    <span class="bb:text-xs bb:text-muted-foreground">@(stepIndex + 1).</span>
                                    <span class="bb:font-medium">@step.Name</span>
                                    <code class="bb:ms-2 bb:text-xs bb:text-muted-foreground">@string.Join(' ', step.Argv)</code>
                                </li>
                            }
                        </ol>
                    }
                    else
                    {
                        <p id="pipelines-spec-pending" class="bb:mt-4 bb:text-sm bb:text-muted-foreground">
                            @L10n["No pipeline definition was reported for this run."]
                        </p>
                    }
                </BbCardContent>
            </BbCard>
        }
    }
</div>

@code {
    [Parameter]
    public Guid ProjectId { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    private string? ErrorCode { get; set; }

    /// <summary>The steps save's PRG outcome (F-020), on the route that owns the editor.</summary>
    [SupplyParameterFromQuery(Name = "notice")]
    private string? NoticeCode { get; set; }

    /// <summary>F-022: the script save's / validation's notice.</summary>
    [SupplyParameterFromQuery(Name = "validated")]
    private string? ValidatedId { get; set; }

    /// <summary>The specific settled validation the PRG redirect named; a malformed/forged id is null.</summary>
    private Guid? RequestedValidationId => Guid.TryParse(ValidatedId, out var id) ? id : null;

    private string? Notice => NoticeCode switch
    {
        "steps-saved" => L10n["The steps were saved; the next run carries this snapshot."],
        "script-saved" => L10n["The script was saved; the next run carries this snapshot. Saving does not prove it valid - use Validate."],
        _ => null,
    };

    private string? Error => ProjectErrorCodes.MessageFor(ErrorCode, L10n);

    private ProjectView? _project;
    private RunView? _newestRun;
    private IReadOnlyList<PipelineStep>? _savedSteps;

    /// <summary>Card F-035: the organization's snippets, split by the editor that offers them.</summary>
    private IReadOnlyList<StepSnippetView> _snippets = [];

    private IReadOnlyList<StepSnippetView> ScriptStepSnippets =>
        [.. _snippets.Where(snippet => snippet.Kind == StepSnippetKinds.ScriptStep)];

    private IReadOnlyList<StepSnippetView> FragmentSnippets =>
        [.. _snippets.Where(snippet => snippet.Kind == StepSnippetKinds.LuaFragment)];

    /// <summary>Card F-031: the saved spec's post lists, rendered as the editor's three post sections.</summary>
    private PipelinePost? _savedPost;
    private DefinitionValidationView? _validation;

    protected override async Task OnInitializedAsync()
    {
        // F-003 hazard: resolving the session selects the circuit's tenant before any tenant-owned
        // row is read. Never rely on the layout having done it first.
        var session = await UserSession.GetAsync();
        if (session?.HasOrganization != true)
        {
            return;
        }

        _project = await ProjectsService.GetProjectAsync(ProjectId);
        if (_project is null)
        {
            SetNotFound();
            return;
        }

        // F-035: the organization's snippet library - the editors' copy source. It is plain text; loading it
        // here creates no reference from the project or its runs to the snippet row.
        _snippets = await SnippetsService.ListAsync();

        // F-020: a Freestyle project's saved steps render as the editor's starting rows. The saved
        // JSON is the envelope-checked spec, so the parse here only fails on a corrupted row - the
        // editor then renders empty rather than guessing.
        if (_project.Kind == ProjectKinds.Freestyle)
        {
            var savedSpec = LoadSavedSpec(_project.FreestyleSpecJson);
            _savedSteps = savedSpec?.Steps ?? [];
            _savedPost = savedSpec?.Post;
        }

        // F-022: the last settled validation for this project, so the PRG redirect can show its step
        // list. It is deliberately a GET-time read of an in-memory result, not a run or a stored row.
        if (_project.Kind == ProjectKinds.Pipeline && _project.PipelineSource == ProjectSources.Inline)
        {
            _validation = Validations.LastValidation(ProjectId, RequestedValidationId);
        }

        // The same read the Runs tab uses (newest first), so "newest" means the same run everywhere.
        var runs = await RunsService.GetProjectRunsAsync(ProjectId);
        _newestRun = runs.Count > 0 ? runs[0] : null;
    }

    /// <summary>
    /// Card F-035: the one payload the page's snippet affordances read, embedded as JSON. The serializer's
    /// default encoder escapes <c>&lt;</c>, so a body that contains <c>&lt;/script&gt;</c> cannot close the
    /// element; the browser copies the values, the server never resolves them again.
    /// </summary>
    private MarkupString SnippetDataScript()
    {
        if (_snippets.Count == 0)
        {
            // No library, no payload: a project page must not carry an empty script element the pickers
            // would have to special-case.
            return default;
        }

        var payload = new
        {
            scriptStep = ScriptStepSnippets.Select(snippet => new
            {
                id = snippet.Id,
                name = snippet.Name,
                body = snippet.Body,
            }),
            luaFragment = FragmentSnippets.Select(snippet => new
            {
                id = snippet.Id,
                name = snippet.Name,
                body = snippet.Body,
            }),
        };

        return (MarkupString)(
            "<script type=\"application/json\" id=\"snippets-data\">"
            + JsonSerializer.Serialize(payload)
            + "</script>");
    }

    private static PipelineSpec? LoadSavedSpec(string? specJson)
    {
        if (specJson is not { } saved
            || !PipelineSpecJson.TryRead(saved, out var spec, out _)
            || spec is null)
        {
            return null;
        }

        return spec;
    }

    private void SetNotFound()
    {
        if (HttpContext is null)
        {
            return;
        }

        // A real 404 for a foreign or missing id. The status-code-pages middleware must not
        // re-execute /not-found in this same request: the component renderer already owns the
        // NavigationManager, and re-execution fails with "already initialized" (F-003 bug B1).
        HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
        if (HttpContext.Features.Get<IStatusCodePagesFeature>() is { } statusCodePages)
        {
            statusCodePages.Enabled = false;
        }
    }
}
