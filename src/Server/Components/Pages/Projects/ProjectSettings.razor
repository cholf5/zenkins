@page "/projects/{ProjectId:guid}/settings"
@attribute [Authorize]
@using Zenkins.Server.Git
@using Zenkins.Server.Secrets
@using Zenkins.Shared.Projects
@using Zenkins.Server.Webhooks
@using Zenkins.Server.Schedules
@inject UserSession UserSession
@inject ProjectService ProjectsService
@inject WebhookService WebhookManagement
@inject ScheduleService ScheduleManagement
@inject TimeProvider Clock
@inject ScheduleOptions ScheduleConfiguration
@inject GitCredentialService CredentialService
@inject NavigationManager Navigation

@* D-003: the Settings tab - everything that configures the project. The webhook cards moved here
   from the overview unchanged (F-017's endpoints and behaviour are the same), and git credentials
   get their first UI: managed like secrets (Owner-only writes, write-only values), through F-013's
   existing form endpoints. *@
<PageTitle>Settings · @(_project?.Name ?? "Project") · Zenkins</PageTitle>

<div class="bb:mx-auto bb:w-full bb:max-w-3xl bb:space-y-6">
    @if (_project is null)
    {
        @* Foreign tenant id == missing id: the service reads through the tenant filter and the
           response is a real 404 (same pattern as the other project tabs). *@
        <NotFoundPage />
    }
    else
    {
        <div class="bb:flex bb:flex-wrap bb:items-center bb:justify-between bb:gap-3">
            <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-3">
                <BbCardTitle As="h1" tabindex="-1">Settings · @_project.Name</BbCardTitle>
                @if (_session?.Organization is { } organization)
                {
                    <BbBadge Variant="BadgeVariant.Secondary">@organization.Name</BbBadge>
                    <BbBadge Variant="BadgeVariant.Outline">Your role: @organization.Role</BbBadge>
                }
                @* F-028: the state the controls below change, stated in the header the other tabs
                   share too. *@
                @if (_project.Disabled)
                {
                    <BbBadge Variant="BadgeVariant.Destructive">Disabled</BbBadge>
                }
            </div>
        </div>

        <ProjectTabs ProjectId="@_project.Id" Active="settings" Kind="@_project.Kind"
                     BranchDiscovery="@_project.BranchDiscovery" />

        @if (Notice is { } notice)
        {
            <div role="status" class="bb:rounded-md bb:border bb:border-input bb:bg-muted bb:p-3 bb:text-sm">
                <p>@notice</p>
            </div>
        }

        @if (WebhookMessage is { } webhookMessage)
        {
            <div role="alert" class="bb:rounded-md bb:border bb:border-destructive/40 bb:bg-destructive/10 bb:p-3 bb:text-sm bb:text-destructive">
                <p>@webhookMessage</p>
            </div>
        }

        @* Cards F-028 + F-029: a refused disable reason or a mistyped limit, rendered from the
           stable code the endpoint redirected with (the same PRG shape the other forms use). *@
        @if (SettingsMessage is { } settingsMessage)
        {
            <div role="alert" id="settings-error"
                 class="bb:rounded-md bb:border bb:border-destructive/40 bb:bg-destructive/10 bb:p-3 bb:text-sm bb:text-destructive">
                <p>@settingsMessage</p>
            </div>
        }

        @if (CredentialMessage is { } credentialMessage)
        {
            <div role="alert" class="bb:rounded-md bb:border bb:border-destructive/40 bb:bg-destructive/10 bb:p-3 bb:text-sm bb:text-destructive">
                <p>@credentialMessage</p>
            </div>
        }

        <BbCard>
            <BbCardHeader>
                <BbCardTitle As="h2">Project basics</BbCardTitle>
                <BbCardDescription>
                    @if (_project.Kind == ProjectKinds.Freestyle)
                    {
                        @:A Freestyle project: no repository, no branch and no pipeline file - its steps live on the server (the Steps tab). Members and Owners may edit a project.
                    }
                    else if (_project.PipelineSource == ProjectSources.Inline)
                    {
                        @:An inline Pipeline project: no repository, no branch and no repository file - its script lives on the server (the Pipelines tab). Members and Owners may edit a project.
                    }
                    else
                    {
                        @:The repository, its default branch and the pipeline file. Members and Owners may edit a project.
                    }
                </BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                <dl class="bb:grid bb:grid-cols-1 bb:gap-4 bb:text-sm bb:sm:grid-cols-3">
                    @if (ProjectSources.HasRepository(_project.Kind, _project.PipelineSource))
                    {
                        <div class="bb:sm:col-span-3">
                            <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">Repository URL</dt>
                            <dd class="bb:break-all">@_project.RepositoryUrl</dd>
                        </div>
                    }
                    <div>
                        <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">Name</dt>
                        <dd>@_project.Name</dd>
                    </div>
                    @if (ProjectSources.HasRepository(_project.Kind, _project.PipelineSource))
                    {
                        @* F-023: the discovery mode is stated here and changed on the edit page, like
                           the rest of the project's fields - it is a setting, not a second job kind. *@
                        <div>
                            <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">Branch discovery</dt>
                            <dd>@(BranchDiscoveryModes.IsMultibranch(_project.BranchDiscovery) ? "Every branch" : "Single branch")</dd>
                        </div>
                    }
                    @if (_project.Kind == ProjectKinds.Freestyle)
                    {
                        @* F-020: the three repository fields do not exist for this kind, so the card
                           states the kind instead of rendering empty rows. *@
                        <div class="bb:sm:col-span-2">
                            <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">Kind</dt>
                            <dd>Freestyle (steps configured on the server)</dd>
                        </div>
                    }
                    else if (_project.PipelineSource == ProjectSources.Inline)
                    {
                        <div class="bb:sm:col-span-2">
                            <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">Kind</dt>
                            <dd>Pipeline (inline script on the server)</dd>
                        </div>
                    }
                    else
                    {
                        <div>
                            <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">Default branch</dt>
                            <dd>@_project.DefaultBranch</dd>
                        </div>
                        <div>
                            <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">Pipeline path</dt>
                            <dd class="bb:break-all">@_project.PipelinePath</dd>
                        </div>
                    }
                </dl>
                <div class="bb:mt-4">
                    @* The edit form keeps its own route, so basics editing works exactly as before. *@
                    <BbButton Href="@($"/projects/{_project.Id}/edit")" Variant="ButtonVariant.Outline">Edit project basics</BbButton>
                </div>
            </BbCardContent>
        </BbCard>

        @* Card F-028: the reversible trigger brake. Members and Owners may both use it (the server
           re-checks membership); disabling keeps every history row and only stops the triggers. *@
        <BbCard>
            <BbCardHeader>
                <BbCardTitle As="h2">Triggers</BbCardTitle>
                <BbCardDescription>
                    Disabling stops <em>every</em> trigger for this project - the start form, webhooks and
                    any future schedule - while its history, artifacts and settings stay readable. Runs
                    still waiting in the queue are canceled; a run already executing continues. Enabling
                    restores the triggers exactly as they were: nothing is replayed, and canceled runs
                    stay canceled.
                </BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                @if (_project.Disabled)
                {
                    <div id="trigger-state-disabled" class="bb:space-y-3">
                        <p class="bb:text-sm">
                            <span class="bb:font-medium">This project is disabled.</span>
                            @(_project.DisabledReason ?? "No reason was recorded.")
                        </p>
                        <p class="bb:text-xs bb:text-muted-foreground">
                            @if (_project.DisabledAt is { } disabledAt)
                            {
                                <span>Disabled @disabledAt.ToString("yyyy-MM-dd HH:mm") UTC</span>
                                @if (_project.DisabledByEmail is { } disabledBy)
                                {
                                    <span> by @disabledBy</span>
                                }
                                <span>. </span>
                            }
                            Nothing is queued for it until it is enabled again.
                        </p>
                        <form method="post" action="@($"/projects/{_project.Id}/enable")" data-zenkins-antiforgery>
                            <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Default">Enable project</BbButton>
                        </form>
                    </div>
                }
                else
                {
                    <form id="project-disable-form" method="post" action="@($"/projects/{_project.Id}/disable")" data-zenkins-antiforgery>
                        <div class="bb:space-y-3">
                            <div>
                                <label for="project-disabled-reason" class="bb:mb-1 bb:block bb:text-sm bb:font-medium">Reason</label>
                                <input id="project-disabled-reason"
                                       name="Reason"
                                       required
                                       maxlength="@ProjectValidation.MaxDisabledReasonLength"
                                       class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:p-2 bb:text-sm"
                                       placeholder="Repository is mid-migration" />
                                <p class="bb:mt-1 bb:text-xs bb:text-muted-foreground">
                                    Required: the person whose trigger is refused reads it.
                                </p>
                            </div>
                            <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Outline">Disable project</BbButton>
                        </div>
                    </form>
                }
            </BbCardContent>
        </BbCard>

        @* Card F-029: how much of the queue and how many workers one project may occupy. Blank means
           the default (unlimited / zero) - exactly how every project behaved before this card. *@
        <BbCard>
            <BbCardHeader>
                <BbCardTitle As="h2">Limits</BbCardTitle>
                <BbCardDescription>
                    Bounds on this project's own queue and concurrency, so one busy repository cannot
                    swamp the workers. The claim applies them in this order: quiet period, then the
                    concurrency limit, then the queue cap decides whether a trigger is accepted at all.
                </BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                <form id="project-limits-form" method="post" action="@($"/projects/{_project.Id}/limits")" data-zenkins-antiforgery>
                    <div class="bb:grid bb:grid-cols-1 bb:gap-4 bb:sm:grid-cols-3">
                        <div>
                            <label for="limits-max-concurrent" class="bb:mb-1 bb:block bb:text-sm bb:font-medium">Concurrent runs</label>
                            <input id="limits-max-concurrent"
                                   name="MaxConcurrentRuns"
                                   value="@_project.MaxConcurrentRuns"
                                   inputmode="numeric"
                                   autocomplete="off"
                                   class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:p-2 bb:text-sm"
                                   placeholder="unlimited" />
                            <p class="bb:mt-1 bb:text-xs bb:text-muted-foreground">
                                At most this many of the project's runs are running (or claimed and not yet
                                started) at once. Blank means unlimited.
                            </p>
                        </div>
                        <div>
                            <label for="limits-quiet-period" class="bb:mb-1 bb:block bb:text-sm bb:font-medium">Quiet period (seconds)</label>
                            <input id="limits-quiet-period"
                                   name="QuietPeriodSeconds"
                                   value="@_project.QuietPeriodSeconds"
                                   inputmode="numeric"
                                   autocomplete="off"
                                   class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:p-2 bb:text-sm"
                                   placeholder="0" />
                            <p class="bb:mt-1 bb:text-xs bb:text-muted-foreground">
                                Seconds after a trigger before its run may be claimed. A trigger inside the
                                period is an ordinary queued run - nothing is merged. 0 means claimable at once.
                            </p>
                        </div>
                        <div>
                            <label for="limits-max-queued" class="bb:mb-1 bb:block bb:text-sm bb:font-medium">Queue cap</label>
                            <input id="limits-max-queued"
                                   name="MaxQueuedRuns"
                                   value="@_project.MaxQueuedRuns"
                                   inputmode="numeric"
                                   autocomplete="off"
                                   class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:p-2 bb:text-sm"
                                   placeholder="unlimited" />
                            <p class="bb:mt-1 bb:text-xs bb:text-muted-foreground">
                                The most runs that may wait in this project's queue. A trigger at the cap is
                                refused before any run is created. Blank means unlimited.
                            </p>
                        </div>
                    </div>
                    <div class="bb:mt-4">
                        <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Default">Save limits</BbButton>
                    </div>
                </form>
            </BbCardContent>
        </BbCard>

        @* Card F-024: the cron schedules. Both kinds carry them (a Freestyle project has no repository
           file to declare one in, and the clock is the Server's), so the card sits outside the
           Pipeline-only section below. Every decision a due time makes is listed under it: queued,
           skipped (with the reason) or missed - the page never silently drops a due time. *@
        <BbCard>
            <BbCardHeader>
                <BbCardTitle As="h2">Schedules</BbCardTitle>
                <BbCardDescription>
                    A cron expression in an IANA time zone queues one run with the definition's defaults
                    at every due time. Five fields: minute hour day-of-month month day-of-week.
                    A due time that arrives while a run of this project is already queued or running is
                    <span class="bb:font-medium">skipped</span> unless the schedule says otherwise, and a due
                    time the Server was not running for is recorded as missed - never replayed.
                </BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                @if (_schedulePreview is { } preview)
                {
                    <div id="schedule-preview" class="bb:mb-4 bb:rounded-md bb:border bb:border-input bb:p-3">
                        <p class="bb:text-sm bb:font-medium">Next runs for @(PreviewCron) in @(PreviewZone)</p>
                        @if (preview.IsValid)
                        {
                            <ul class="bb:mt-2 bb:list-disc bb:space-y-1 bb:pl-5 bb:text-sm">
                                @foreach (var due in preview.DueTimes)
                                {
                                    <li>
                                        <span class="bb:font-mono">@due.ToString("yyyy-MM-dd HH:mm")</span> UTC
                                        <span class="bb:text-muted-foreground">(@LocalTime(due, PreviewZone))</span>
                                    </li>
                                }
                            </ul>
                            <p class="bb:mt-2 bb:text-xs bb:text-muted-foreground">
                                Nothing is saved by a preview. Adjust the expression above and save when it looks right.
                            </p>
                        }
                        else
                        {
                            <p id="schedule-preview-error" role="alert" class="bb:mt-2 bb:text-sm bb:text-destructive">
                                @preview.Message
                            </p>
                        }
                    </div>
                }

                @if (_schedules.Count == 0)
                {
                    <p id="schedules-empty" class="bb:mb-4 bb:text-sm bb:text-muted-foreground">
                        No schedule yet. A project can carry up to
                        @ScheduleErrorCodes.MaxSchedulesPerProject schedules.
                    </p>
                }
                else
                {
                    <ul id="schedule-list" class="bb:mb-6 bb:space-y-4">
                        @foreach (var schedule in _schedules)
                        {
                            <li id="schedule-@schedule.Id" class="bb:rounded-md bb:border bb:border-input bb:p-3">
                                <div class="bb:flex bb:flex-wrap bb:items-center bb:justify-between bb:gap-2">
                                    <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-2">
                                        <code class="bb:text-sm">@schedule.Cron</code>
                                        <BbBadge Variant="BadgeVariant.Outline">@schedule.TimeZone</BbBadge>
                                        @if (schedule.Enabled)
                                        {
                                            <BbBadge Variant="BadgeVariant.Secondary">Enabled</BbBadge>
                                        }
                                        else
                                        {
                                            <BbBadge Variant="BadgeVariant.Destructive">Disabled</BbBadge>
                                        }
                                        <BbBadge Variant="BadgeVariant.Outline">
                                            @(schedule.QueueAnyway ? "Queues anyway" : "Skips when busy")
                                        </BbBadge>
                                    </div>
                                    <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-2">
                                        <form method="post"
                                              action="@($"/projects/{_project.Id}/schedules/{schedule.Id}/toggle")"
                                              data-zenkins-antiforgery>
                                            <input type="hidden" name="Flag" value="@ScheduleEndpoints.FlagEnabled" />
                                            <input type="hidden" name="Value" value="@(schedule.Enabled ? "false" : "true")" />
                                            <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Outline">
                                                @(schedule.Enabled ? "Disable" : "Enable")
                                            </BbButton>
                                        </form>
                                        <form method="post"
                                              action="@($"/projects/{_project.Id}/schedules/{schedule.Id}/toggle")"
                                              data-zenkins-antiforgery>
                                            <input type="hidden" name="Flag" value="@ScheduleEndpoints.FlagQueueAnyway" />
                                            <input type="hidden" name="Value" value="@(schedule.QueueAnyway ? "false" : "true")" />
                                            <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Outline">
                                                @(schedule.QueueAnyway ? "Skip when busy" : "Queue anyway")
                                            </BbButton>
                                        </form>
                                        <form method="post"
                                              action="@($"/projects/{_project.Id}/schedules/{schedule.Id}/delete")"
                                              data-zenkins-antiforgery>
                                            <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Destructive">Delete</BbButton>
                                        </form>
                                    </div>
                                </div>
                                <dl class="bb:mt-3 bb:grid bb:grid-cols-1 bb:gap-2 bb:text-sm bb:sm:grid-cols-2">
                                    <div>
                                        <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">Next runs</dt>
                                        <dd>
                                            @if (schedule.HasNextDue)
                                            {
                                                <ul class="bb:space-y-0.5">
                                                    @foreach (var due in schedule.NextDueTimes)
                                                    {
                                                        <li>
                                                            <span class="bb:font-mono">@due.ToString("yyyy-MM-dd HH:mm")</span> UTC
                                                            <span class="bb:text-muted-foreground">(@LocalTime(due, schedule.TimeZone))</span>
                                                        </li>
                                                    }
                                                </ul>
                                            }
                                            else
                                            {
                                                <span class="bb:text-destructive">The expression never fires.</span>
                                            }
                                        </dd>
                                    </div>
                                    <div>
                                        <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">Last evaluated</dt>
                                        <dd>
                                            @if (schedule.LastEvaluatedAt is { } evaluatedAt)
                                            {
                                                <span>@evaluatedAt.ToString("yyyy-MM-dd HH:mm:ss") UTC</span>
                                            }
                                            else
                                            {
                                                <span class="bb:text-muted-foreground">Not yet</span>
                                            }
                                        </dd>
                                    </div>
                                </dl>
                                @if (schedule.LastMissedCount > 0)
                                {
                                    @* The count is exact even when the list is not: it is the last evaluation's own
                                       number, kept on the schedule so the ledger's retention cannot shrink it. When the
                                       evaluation's window was capped (review L1) the sentence says so - the number is
                                       the newest window's, not the whole outage's, and a reader must not be left to
                                       infer that from a row the list never shows. *@
                                    <p id="schedule-missed-@schedule.Id" class="bb:mt-3 bb:text-sm">
                                        <span class="bb:font-medium">@schedule.LastMissedCount due time(s)</span>
                                        recorded as missed - the Server was not evaluating this schedule then.
                                        @if (schedule.LastMissedWindowTruncated)
                                        {
                                            <span>
                                                Only the newest @((int)ScheduleConfiguration.MissWindow.TotalHours)
                                                hours are counted; earlier missed due times are not listed.
                                            </span>
                                        }
                                    </p>
                                }
                                <div class="bb:mt-3">
                                    <p class="bb:text-xs bb:font-medium bb:text-muted-foreground">Last outcomes</p>
                                    @if (schedule.RecentOutcomes.Count == 0)
                                    {
                                        <p class="bb:mt-1 bb:text-sm bb:text-muted-foreground">
                                            Nothing yet - the first due time has not arrived.
                                        </p>
                                    }
                                    else
                                    {
                                        <ul id="schedule-outcomes-@schedule.Id" class="bb:mt-1 bb:space-y-1 bb:text-sm">
                                            @foreach (var outcome in schedule.RecentOutcomes)
                                            {
                                                <li class="bb:flex bb:flex-wrap bb:items-baseline bb:gap-2">
                                                    <span class="bb:font-mono bb:text-xs">@outcome.DueAt.ToString("yyyy-MM-dd HH:mm")</span>
                                                    <BbBadge Variant="@OutcomeVariant(outcome.Outcome)">@outcome.Outcome</BbBadge>
                                                    <span>@outcome.Description</span>
                                                </li>
                                            }
                                        </ul>
                                    }
                                </div>
                            </li>
                        }
                    </ul>
                }

                <form id="schedule-create-form"
                      method="post"
                      action="@($"/projects/{_project.Id}/schedules/create")"
                      data-zenkins-antiforgery>
                    <div class="bb:space-y-4">
                        <div class="bb:grid bb:grid-cols-1 bb:gap-4 bb:sm:grid-cols-2">
                            <div>
                                <label for="schedule-cron" class="bb:mb-1 bb:block bb:text-sm bb:font-medium">Cron expression</label>
                                <input id="schedule-cron"
                                       name="Cron"
                                       required
                                       maxlength="@Zenkins.Server.Schedules.ScheduleCron.MaxLength"
                                       value="@SubmittedCron"
                                       class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:p-2 bb:font-mono bb:text-sm"
                                       placeholder="0 3 * * *" />
                                <p class="bb:mt-1 bb:text-xs bb:text-muted-foreground">
                                    <code>minute hour day-of-month month day-of-week</code>. Ranges, lists and steps
                                    work (<code>*/15 9-17 * * MON-FRI</code>); named macros such as
                                    <code>@@daily</code> and a seconds field are refused.
                                </p>
                            </div>
                            <div>
                                <label for="schedule-timezone" class="bb:mb-1 bb:block bb:text-sm bb:font-medium">Time zone</label>
                                <input id="schedule-timezone"
                                       name="TimeZone"
                                       required
                                       maxlength="@ScheduleErrorCodes.MaxTimeZoneLength"
                                       value="@SubmittedTimeZone"
                                       class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:p-2 bb:font-mono bb:text-sm"
                                       placeholder="Europe/Berlin" />
                                <p class="bb:mt-1 bb:text-xs bb:text-muted-foreground">
                                    An IANA id (<code>Europe/Berlin</code>, <code>America/New_York</code>,
                                    <code>Asia/Tokyo</code>, <code>UTC</code>). Daylight saving is the zone's own:
                                    a clock time the zone skips is recorded, not run.
                                </p>
                            </div>
                        </div>
                        <div class="bb:space-y-2">
                            <label for="schedule-queue-anyway" class="bb:flex bb:items-center bb:gap-2 bb:text-sm">
                                <input id="schedule-queue-anyway" type="checkbox" name="QueueAnyway" value="true" />
                                <input type="hidden" name="QueueAnyway" value="false" />
                                <span>
                                    Queue anyway: if a run of this project is still queued or running at a due time,
                                    queue another (the project's queue cap still applies).
                                </span>
                            </label>
                            <label for="schedule-enabled" class="bb:flex bb:items-center bb:gap-2 bb:text-sm">
                                <input id="schedule-enabled" type="checkbox" name="Enabled" value="true" checked />
                                <input type="hidden" name="Enabled" value="false" />
                                <span>Enabled: evaluate this schedule (a disabled one records every due time as skipped).</span>
                            </label>
                        </div>
                        <div class="bb:flex bb:flex-wrap bb:gap-2">
                            <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Default">Add schedule</BbButton>
                            @* One form, two submits: the preview button names itself, so the same field values the
                               save would post answer "when would this run?" without storing anything. *@
                            <button type="submit"
                                    name="Action"
                                    value="preview"
                                    class="bb:h-9 bb:rounded-md bb:border bb:border-input bb:px-4 bb:text-sm bb:font-medium bb:hover:bg-accent">
                                Preview next runs
                            </button>
                        </div>
                    </div>
                </form>
            </BbCardContent>
        </BbCard>

        @* F-020/F-022: webhooks and git credentials both exist only for a project with a repository
           - a webhook triggers on git pushes and a credential materializes a clone, and a Freestyle
           or inline project has neither. The whole section is hidden, and the endpoints refuse with
           the same shared predicate. *@
        @if (ProjectSources.HasRepository(_project.Kind, _project.PipelineSource))
        {
        @* F-017: the webhook configuration, moved verbatim from the overview. Create and rotate
           answer with a standalone show-once document (the plaintext has to be copied into the git
           host), so no plaintext is ever rendered here. *@
        <BbCard>
            <BbCardHeader>
                <BbCardTitle As="h2">Webhooks</BbCardTitle>
                <BbCardDescription>
                    A signed <code>git push</code> to a matching branch starts a run for the pushed commit.
                    The secret is shown once, when the webhook is created or rotated: copy it into the git
                    host then, because it cannot be read again.
                </BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                @if (_webhooks.Count == 0)
                {
                    <p class="bb:mb-4 bb:text-sm bb:text-muted-foreground">No webhooks yet.</p>
                }
                else
                {
                    <ul class="bb:mb-6 bb:space-y-3">
                        @foreach (var webhook in _webhooks)
                        {
                            <li class="bb:rounded-md bb:border bb:border-input bb:p-3" data-webhook-id="@webhook.Id">
                                <div class="bb:flex bb:flex-wrap bb:items-center bb:justify-between bb:gap-2">
                                    <div>
                                        <p class="bb:font-medium">@webhook.Name</p>
                                        <p class="bb:text-xs bb:text-muted-foreground">
                                            @(webhook.Enabled ? "Enabled" : "Disabled")
                                        </p>
                                    </div>
                                    <div class="bb:flex bb:flex-wrap bb:gap-2">
                                        <form method="post" action="@($"/projects/{_project.Id}/webhooks/{webhook.Id}/rotate")" data-zenkins-antiforgery>
                                            <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Outline">Rotate secret</BbButton>
                                        </form>
                                        <form method="post" action="@($"/projects/{_project.Id}/webhooks/{webhook.Id}/{(webhook.Enabled ? "disable" : "enable")}")" data-zenkins-antiforgery>
                                            <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Outline">
                                                @(webhook.Enabled ? "Disable" : "Enable")
                                            </BbButton>
                                        </form>
                                        <form method="post" action="@($"/projects/{_project.Id}/webhooks/{webhook.Id}/delete")" data-zenkins-antiforgery>
                                            <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Destructive">Delete</BbButton>
                                        </form>
                                    </div>
                                </div>
                                <dl class="bb:mt-3 bb:grid bb:grid-cols-1 bb:gap-2 bb:text-sm bb:sm:grid-cols-2">
                                    <div class="bb:sm:col-span-2">
                                        <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">Endpoint URL</dt>
                                        <dd class="bb:break-all"><code>@EndpointUrl(webhook)</code></dd>
                                    </div>
                                    <div>
                                        <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">Branches</dt>
                                        <dd>@BranchLabel(webhook)</dd>
                                    </div>
                                    <div>
                                        <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">Required tags</dt>
                                        <dd>@(string.IsNullOrWhiteSpace(webhook.RequiredTags) ? "Any worker" : webhook.RequiredTags)</dd>
                                    </div>
                                    <div>
                                        <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">Secret</dt>
                                        <dd>
                                            Configured
                                            @if (webhook.SecretRotatedAt is { } rotatedAt)
                                            {
                                                <span>(rotated @rotatedAt.ToString("yyyy-MM-dd HH:mm") UTC)</span>
                                            }
                                        </dd>
                                    </div>
                                    <div>
                                        <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">Last delivery</dt>
                                        <dd>
                                            @if (webhook.LastDeliveryAt is { } deliveredAt)
                                            {
                                                <span>@deliveredAt.ToString("yyyy-MM-dd HH:mm") UTC · @(webhook.LastDeliveryOutcome ?? "-")</span>
                                            }
                                            else
                                            {
                                                <span class="bb:text-muted-foreground">None yet</span>
                                            }
                                        </dd>
                                    </div>
                                </dl>
                            </li>
                        }
                    </ul>
                }

                <form method="post" action="@($"/projects/{_project.Id}/webhooks/create")" data-zenkins-antiforgery>
                    <div class="bb:space-y-4">
                        <div>
                            <label for="webhook-name" class="bb:mb-1 bb:block bb:text-sm bb:font-medium">Name</label>
                            <input id="webhook-name"
                                   name="Name"
                                   required
                                   maxlength="100"
                                   class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:p-2 bb:text-sm"
                                   placeholder="github-main" />
                        </div>
                        <div>
                            <label for="webhook-branch-filter" class="bb:mb-1 bb:block bb:text-sm bb:font-medium">Branches (optional)</label>
                            <input id="webhook-branch-filter"
                                   name="BranchFilter"
                                   class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:p-2 bb:font-mono bb:text-sm"
                                   placeholder="@_project.DefaultBranch" />
                            <p class="bb:mt-1 bb:text-xs bb:text-muted-foreground">
                                Comma-separated names; a trailing <code>*</code> is the only wildcard
                                (<code>main, release/*</code>). Leave it blank to follow the project's default
                                branch. Other branches are accepted and ignored.
                            </p>
                        </div>
                        <div>
                            <label for="webhook-required-tags" class="bb:mb-1 bb:block bb:text-sm bb:font-medium">Required tags (optional)</label>
                            <input id="webhook-required-tags"
                                   name="RequiredTags"
                                   class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:p-2 bb:text-sm"
                                   placeholder="linux, dotnet" />
                        </div>
                        <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Default">Create webhook</BbButton>
                    </div>
                </form>
            </BbCardContent>
        </BbCard>

        @if (!_canManageCredentials)
        {
            @* Git credentials are managed like secrets (card D-003): Owner-only writes, and a Member
               does not learn which credential names exist. The write endpoints are the enforcement;
               this is the page half of it. *@
            <BbCard>
                <BbCardHeader>
                    <BbCardTitle As="h2">Git credentials</BbCardTitle>
                    <BbCardDescription>
                        Credentials are managed by organization Owners; Members cannot list or change
                        them. Ask an Owner of this organization if this project's repository needs one.
                    </BbCardDescription>
                </BbCardHeader>
            </BbCard>
        }
        else
        {
            <BbCard>
                <BbCardHeader>
                    <BbCardTitle As="h2">Git credentials</BbCardTitle>
                    <BbCardDescription>
                        The material a worker uses to clone this project's repository. The value is
                        encrypted before it is stored and is never shown again - the list below is
                        names, kinds and timestamps only, and no route returns a value. To change a
                        credential, rotate it; the worker fetches it only while it executes a run of
                        a project that references it.
                    </BbCardDescription>
                </BbCardHeader>
                <BbCardContent>
                    @* Card F-018: the assignment itself. Until this card the column existed and nothing
                       wrote it, so every project cloned with whatever credential the worker host held.
                       The block states the current assignment (which credential, by whom, when) or that
                       there is none - and "none" is a product statement, not an omission: a run then
                       clones without a credential instead of borrowing the host's. *@
                    <div id="credential-assignment"
                         class="bb:mb-6 bb:rounded-md bb:border bb:border-input bb:p-3">
                        @if (_assignment is { } assignment)
                        {
                            <p class="bb:text-sm bb:font-medium">Attached to this project</p>
                            <dl id="credential-assignment-current"
                                class="bb:mt-2 bb:grid bb:grid-cols-1 bb:gap-3 bb:text-sm bb:sm:grid-cols-4">
                                <div>
                                    <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">Credential</dt>
                                    <dd id="credential-assignment-name" class="bb:break-all">@assignment.Name</dd>
                                </div>
                                <div>
                                    <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">Kind</dt>
                                    <dd>@assignment.Kind</dd>
                                </div>
                                <div>
                                    <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">Attached by</dt>
                                    <dd id="credential-assignment-by" class="bb:break-all">@(assignment.AssignedBy ?? "Not recorded")</dd>
                                </div>
                                <div>
                                    <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">Attached</dt>
                                    <dd id="credential-assignment-at">@FormatAssignedAt(assignment)</dd>
                                </div>
                            </dl>
                            <p class="bb:mt-2 bb:text-xs bb:text-muted-foreground">
                                Runs of this project fetch this credential from the server at clone time;
                                the worker never uses a credential stored on its own host.
                            </p>
                            <form method="post"
                                  action="@($"/projects/{_project.Id}/git-credential/detach")"
                                  data-zenkins-antiforgery
                                  class="bb:mt-3">
                                <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Outline">Detach credential</BbButton>
                            </form>
                        }
                        else
                        {
                            <p id="credential-assignment-none" class="bb:text-sm">
                                <span class="bb:font-medium">No credential is attached to this project.</span>
                                Its runs clone without one and will <span class="bb:font-medium">not</span>
                                fall back to a credential stored on the worker host, so a private
                                repository fails until a credential is attached here.
                            </p>
                            @if (_project.GitCredentialId is not null)
                            {
                                @* The column names a row the organization no longer has. Say so rather
                                   than rendering an empty assignment as if none were configured. *@
                                <p id="credential-assignment-missing" role="alert"
                                   class="bb:mt-2 bb:text-sm bb:text-destructive">
                                    This project still points at a credential that no longer exists.
                                    Its runs fail until a credential is attached again.
                                </p>
                            }

                            @if (_credentials.Count == 0)
                            {
                                <p class="bb:mt-3 bb:text-xs bb:text-muted-foreground">
                                    Create a credential below first, then attach it here.
                                </p>
                            }
                            else
                            {
                                <form method="post"
                                      action="@($"/projects/{_project.Id}/git-credential/attach")"
                                      data-zenkins-antiforgery
                                      class="bb:mt-3 bb:flex bb:flex-wrap bb:items-end bb:gap-2">
                                    <div class="bb:flex-1">
                                        <label for="credential-assignment-select"
                                               class="bb:mb-1 bb:block bb:text-sm bb:font-medium">Attach a credential</label>
                                        <select id="credential-assignment-select"
                                                name="GitCredentialId"
                                                class="bb:flex bb:h-9 bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-3 bb:py-1 bb:text-sm">
                                            @foreach (var credential in _credentials)
                                            {
                                                <option value="@credential.Id">@credential.Name (@credential.Kind)</option>
                                            }
                                        </select>
                                    </div>
                                    <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Default">Attach</BbButton>
                                </form>
                            }
                        }
                    </div>

                    <form method="post" action="/git-credentials/create" data-zenkins-antiforgery>
                        <div class="bb:space-y-4">
                            <input type="hidden" name="ProjectId" value="@_project.Id" />
                            <div class="bb:grid bb:grid-cols-1 bb:gap-4 bb:sm:grid-cols-2">
                                <div>
                                    <label for="credential-name" class="bb:mb-1 bb:block bb:text-sm bb:font-medium">Name</label>
                                    <input id="credential-name"
                                           name="Name"
                                           type="text"
                                           required
                                           maxlength="@SecretValidation.MaxNameLength"
                                           pattern="[A-Za-z_][A-Za-z0-9_]*"
                                           value="@SubmittedCredentialName"
                                           class="bb:flex bb:h-9 bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-3 bb:py-1 bb:text-sm"
                                           autocomplete="off"
                                           spellcheck="false"
                                           placeholder="DEPLOY_TOKEN" />
                                </div>
                                <div>
                                    <label for="credential-kind" class="bb:mb-1 bb:block bb:text-sm bb:font-medium">Kind</label>
                                    <select id="credential-kind"
                                            name="Kind"
                                            class="bb:flex bb:h-9 bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-3 bb:py-1 bb:text-sm">
                                        @* On a validation redirect the submitted kind is echoed back, so
                                           the fix happens in the kind the operator actually chose. *@
                                        <option value="@GitCredentialKindTexts.HttpsToken"
                                                selected="@(SubmittedCredentialKind == GitCredentialKindTexts.HttpsToken)">HTTPS token</option>
                                        <option value="@GitCredentialKindTexts.SshKey"
                                                selected="@(SubmittedCredentialKind == GitCredentialKindTexts.SshKey)">SSH key</option>
                                    </select>
                                </div>
                                <div>
                                    <label for="credential-value" class="bb:mb-1 bb:block bb:text-sm bb:font-medium">Value</label>
                                    <input id="credential-value"
                                           name="Value"
                                           type="password"
                                           required
                                           class="bb:flex bb:h-9 bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-3 bb:py-1 bb:text-sm"
                                           autocomplete="new-password"
                                           spellcheck="false" />
                                </div>
                                <div>
                                    <label for="credential-user-name" class="bb:mb-1 bb:block bb:text-sm bb:font-medium">User name (HTTPS tokens, optional)</label>
                                    <input id="credential-user-name"
                                           name="UserName"
                                           type="text"
                                           class="bb:flex bb:h-9 bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-3 bb:py-1 bb:text-sm"
                                           autocomplete="off"
                                           spellcheck="false"
                                           placeholder="x-access-token" />
                                </div>
                            </div>
                            <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Default">Create credential</BbButton>
                        </div>
                    </form>

                    @if (_credentials.Count == 0)
                    {
                        <BbEmpty Title="No credentials configured"
                                 Description="Create a credential above, then reference it from the projects that need it for cloning.">
                            <Icon>
                                <LucideIcon Name="key-square" Class="bb:h-12 bb:w-12" />
                            </Icon>
                        </BbEmpty>
                    }
                    else
                    {
                        <div class="bb:mt-6 bb:overflow-x-auto">
                            <table class="bb:w-full bb:text-sm">
                                <thead>
                                    <tr class="bb:border-b bb:text-left bb:text-muted-foreground">
                                        <th class="bb:py-2 bb:pr-4 bb:font-medium">Name</th>
                                        <th class="bb:py-2 bb:pr-4 bb:font-medium">Kind</th>
                                        <th class="bb:py-2 bb:pr-4 bb:font-medium">Created</th>
                                        <th class="bb:py-2 bb:pr-4 bb:font-medium">Rotated</th>
                                        <th class="bb:py-2 bb:pr-4 bb:font-medium">Updated</th>
                                        <th class="bb:py-2 bb:pr-4 bb:font-medium">Used by</th>
                                        <th class="bb:py-2 bb:font-medium">Manage</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var credential in _credentials)
                                    {
                                        <tr class="bb:border-b bb:align-middle" data-credential-id="@credential.Id">
                                            <td class="bb:py-3 bb:pr-4 bb:font-medium">@credential.Name</td>
                                            <td class="bb:py-3 bb:pr-4">@credential.Kind</td>
                                            <td class="bb:py-3 bb:pr-4">@credential.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC</td>
                                            <td class="bb:py-3 bb:pr-4">
                                                @(credential.RotatedAt is { } rotatedAt
                                                    ? rotatedAt.ToString("yyyy-MM-dd HH:mm") + " UTC"
                                                    : "Never")
                                            </td>
                                            <td class="bb:py-3 bb:pr-4">@credential.UpdatedAt.ToString("yyyy-MM-dd HH:mm") UTC</td>
                                            <td class="bb:py-3 bb:pr-4" data-credential-used-by="@credential.Id">
                                                @if (UsedBy(credential) is { Count: > 0 } users)
                                                {
                                                    <span class="bb:break-all">@string.Join(", ", users.Select(project => project.Name))</span>
                                                }
                                                else
                                                {
                                                    <span class="bb:text-muted-foreground">No project</span>
                                                }
                                            </td>
                                            <td class="bb:py-3">
                                                <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-2">
                                                    <form method="post" action="/git-credentials/@credential.Id/rotate" data-zenkins-antiforgery class="bb:flex bb:flex-wrap bb:items-center bb:gap-2">
                                                        <input type="hidden" name="ProjectId" value="@_project.Id" />
                                                        <label for="rotate-kind-@credential.Id" class="bb:sr-only">New kind for @credential.Name</label>
                                                        <select id="rotate-kind-@credential.Id"
                                                                name="Kind"
                                                                class="bb:h-8 bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-2 bb:text-xs">
                                                            <option value="@GitCredentialKindTexts.HttpsToken" selected="@(credential.Kind == GitCredentialKindTexts.HttpsToken)">HTTPS token</option>
                                                            <option value="@GitCredentialKindTexts.SshKey" selected="@(credential.Kind == GitCredentialKindTexts.SshKey)">SSH key</option>
                                                        </select>
                                                        <label for="rotate-value-@credential.Id" class="bb:sr-only">New value for @credential.Name</label>
                                                        <input id="rotate-value-@credential.Id"
                                                               name="Value"
                                                               type="password"
                                                               required
                                                               class="bb:h-8 bb:w-40 bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-2 bb:py-1 bb:text-xs"
                                                               autocomplete="new-password"
                                                               spellcheck="false"
                                                               placeholder="New value" />
                                                        <label for="rotate-user-@credential.Id" class="bb:sr-only">New user name for @credential.Name</label>
                                                        <input id="rotate-user-@credential.Id"
                                                               name="UserName"
                                                               type="text"
                                                               class="bb:h-8 bb:w-28 bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-2 bb:py-1 bb:text-xs"
                                                               autocomplete="off"
                                                               spellcheck="false"
                                                               placeholder="User name" />
                                                        <button type="submit"
                                                                class="bb:rounded-md bb:border bb:border-input bb:px-2 bb:py-1 bb:text-xs bb:hover:bg-accent">
                                                            Rotate
                                                        </button>
                                                    </form>

                                                    <details class="bb:inline-block">
                                                        <summary class="bb:cursor-pointer bb:rounded-md bb:border bb:border-destructive/40 bb:px-2 bb:py-1 bb:text-xs bb:text-destructive">
                                                            Delete…
                                                        </summary>
                                                        <form method="post" action="/git-credentials/@credential.Id/delete" data-zenkins-antiforgery class="bb:mt-2 bb:flex bb:flex-col bb:items-start bb:gap-1">
                                                            <input type="hidden" name="ProjectId" value="@_project.Id" />
                                                            <input type="hidden" name="Name" value="@credential.Name" />
                                                            <input type="hidden" name="ConfirmCredentialId" value="@credential.Id" />
                                                            @* Card F-018, the D-006 shape: a credential projects still
                                                               clone with is not deleted by a plain request. The
                                                               referencing projects are named here, and the delete only
                                                               goes through with the explicit confirmation. *@
                                                            @if (UsedBy(credential) is { Count: > 0 } referencing)
                                                            {
                                                                <span class="bb:text-xs bb:text-destructive">
                                                                    Still used by @UsedByLabel(referencing). Deleting it anyway leaves
                                                                    those projects with no credential.
                                                                </span>
                                                                <label class="bb:flex bb:items-center bb:gap-1 bb:text-xs">
                                                                    <input type="checkbox" name="ConfirmReferenced" value="true" />
                                                                    Delete anyway
                                                                </label>
                                                            }
                                                            <span class="bb:text-xs bb:text-muted-foreground">
                                                                Delete @credential.Name permanently?
                                                            </span>
                                                            <button type="submit"
                                                                    class="bb:rounded-md bb:border bb:border-destructive/40 bb:px-2 bb:py-1 bb:text-xs bb:text-destructive bb:hover:bg-destructive/10">
                                                                Confirm delete
                                                            </button>
                                                        </form>
                                                    </details>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </BbCardContent>
            </BbCard>
        }
        }

        @if (_canDelete)
        {
            <BbCard>
                <BbCardHeader>
                    <BbCardTitle As="h2">Danger zone</BbCardTitle>
                    <BbCardDescription>
                        Deleting removes the project and its runs and webhooks. It requires the
                        confirmation step and cannot be undone.
                    </BbCardDescription>
                </BbCardHeader>
                <BbCardContent>
                    <BbButton Href="@($"/projects/{_project.Id}/delete/confirm")" Variant="ButtonVariant.Destructive">Delete project…</BbButton>
                </BbCardContent>
            </BbCard>
        }
    }
</div>

@code {
    [Parameter]
    public Guid ProjectId { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private UserSessionInfo? _session;
    private ProjectView? _project;
    private bool _canDelete;
    private bool _canManageCredentials;
    private IReadOnlyList<WebhookView> _webhooks = [];
    private IReadOnlyList<GitCredentialListItem> _credentials = [];

    /// <summary>Card F-018: the project's current assignment (which credential, by whom, when), or null.</summary>
    private GitCredentialAssignmentView? _assignment;

    /// <summary>Card F-018: per credential, the projects that clone with it (the delete's reference list).</summary>
    private IReadOnlyDictionary<Guid, IReadOnlyList<GitCredentialReferencingProject>> _usedByProjects =
        new Dictionary<Guid, IReadOnlyList<GitCredentialReferencingProject>>();

    [SupplyParameterFromQuery(Name = "notice")]
    private string? NoticeCode { get; set; }

    [SupplyParameterFromQuery(Name = "webhookError")]
    private string? WebhookErrorCode { get; set; }

    [SupplyParameterFromQuery(Name = "credentialError")]
    private string? CredentialErrorCode { get; set; }

    /// <summary>Cards F-028 + F-029: the stable code a refused disable reason or limits save redirected with.</summary>
    [SupplyParameterFromQuery(Name = "error")]
    private string? SettingsErrorCode { get; set; }

    /// <summary>Card F-024: the project's schedules, with their next due times and their last outcomes.</summary>
    private IReadOnlyList<ScheduleView> _schedules = [];

    /// <summary>Card F-024: the preview computed from the echoed expression and zone (null when none was asked).</summary>
    private SchedulePreview? _schedulePreview;

    /// <summary>Card F-024: the expression and zone the create form echoes back after a preview or a refusal.</summary>
    [SupplyParameterFromQuery(Name = "previewCron")]
    private string? PreviewCron { get; set; }

    [SupplyParameterFromQuery(Name = "previewZone")]
    private string? PreviewZone { get; set; }

    /// <summary>Card F-024: the values the create form shows (a preview keeps the operator's input).</summary>
    private string? SubmittedCron => PreviewCron;

    private string? SubmittedTimeZone => PreviewZone;

    [SupplyParameterFromQuery(Name = "credentialName")]
    private string? SubmittedCredentialName { get; set; }

    [SupplyParameterFromQuery(Name = "credentialKind")]
    private string? SubmittedCredentialKind { get; set; }

    private string? Notice => NoticeCode switch
    {
        // F-017's webhook outcomes (the endpoints PRG here since the form moved to this tab).
        "webhook-enabled" => "The webhook is enabled.",
        "webhook-disabled" => "The webhook is disabled; its URL now answers like an unknown one.",
        "webhook-deleted" => "The webhook was deleted.",
        // F-028's trigger brake and F-029's limits.
        "project-disabled" =>
            "The project is disabled: every trigger is refused and the runs that were still waiting were canceled.",
        "project-enabled" =>
            "The project is enabled. Triggers queue runs again; canceled runs stay canceled and nothing was replayed.",
        "limits-saved" => "The project's limits were saved.",
        // F-024's schedules.
        ScheduleEndpoints.NoticeCreated =>
            "The schedule was saved. Its first due time is the next one the expression names.",
        ScheduleEndpoints.NoticeDeleted => "The schedule was deleted; the runs it already queued stay.",
        ScheduleEndpoints.NoticeEnabled => "The schedule is enabled again.",
        ScheduleEndpoints.NoticeDisabled =>
            "The schedule is paused: every due time it passes is recorded as skipped, and nothing is queued.",
        ScheduleEndpoints.NoticeQueueAnyway =>
            "The schedule now queues anyway when a run of this project is still in flight (the queue cap still applies).",
        ScheduleEndpoints.NoticeSkipOverlap =>
            "The schedule skips a due time while a run of this project is still queued or running.",
        // D-003's credential outcomes.
        GitCredentialEndpoints.NoticeCreated => "The Git credential was created.",
        GitCredentialEndpoints.NoticeRotated => "The Git credential was rotated; the previous value is no longer stored.",
        GitCredentialEndpoints.NoticeDeleted => "The Git credential was deleted.",
        // F-018's assignment outcomes.
        GitCredentialEndpoints.NoticeAttached =>
            "The credential is attached. Runs of this project now clone with it, fetched from the server.",
        GitCredentialEndpoints.NoticeDetached =>
            "The credential is detached. Runs of this project now clone without one.",
        _ => null,
    };

    /// <summary>The field-level error the webhook create form redirected back with (F-017).</summary>
    private string? WebhookMessage => WebhookErrorCodes.MessageFor(WebhookErrorCode);

    /// <summary>
    /// Cards F-028 + F-029: the refusal a disable or limits save redirected back with. The code is the
    /// request's only echo, so an unknown code still says something rather than rendering as a no-op.
    /// </summary>
    private string? SettingsMessage =>
        SettingsErrorCode is null
            ? null
            : ProjectErrorCodes.MessageFor(SettingsErrorCode)
                ?? ScheduleErrorCodes.MessageFor(SettingsErrorCode)
                ?? "The change was not accepted.";

    /// <summary>
    /// The field-level error a credential form redirected back with. The value never travels in a
    /// query, so the only echo this page can render is the name and the kind.
    /// </summary>
    private string? CredentialMessage =>
        GitCredentialErrorCodes.MessageFor(CredentialErrorCode)
        ?? (CredentialErrorCode is null ? null : "The credential was not accepted.");

    /// <summary>
    /// The delivery URL as the operator has to paste it. Absolute when the request carried a base URI, so
    /// a copy from the page is usable; a relative path if the host could not resolve one.
    /// </summary>
    private string EndpointUrl(WebhookView webhook) =>
        Navigation.BaseUri is { Length: > 0 } baseUri
            ? baseUri.TrimEnd('/') + webhook.EndpointPath
            : webhook.EndpointPath;

    /// <summary>The branch patterns, spelling out the default when the filter is empty.</summary>
    private string BranchLabel(WebhookView webhook) =>
        webhook.BranchPatterns.Count == 0
            ? $"project default ({_project?.DefaultBranch ?? "-"})"
            : string.Join(", ", webhook.BranchPatterns);

    protected override async Task OnInitializedAsync()
    {
        // Establish the circuit tenant before the tenant-filtered lookup.
        _session = await UserSession.GetAsync();
        _canDelete = _session?.CanManageActiveOrganization == true;
        _canManageCredentials = _canDelete;

        if (_session?.HasOrganization != true)
        {
            return;
        }

        _project = await ProjectsService.GetProjectAsync(ProjectId);
        if (_project is null)
        {
            SetNotFound();
            return;
        }

        // F-017: the project's webhooks (any member of the organization may manage them). The
        // service re-checks membership; a failure here just leaves the list empty.
        if (_session is { HasOrganization: true } session)
        {
            var webhooks = await WebhookManagement.GetWebhooksAsync(session.UserId, ProjectId);
            _webhooks = webhooks.Webhooks;
        }

        // F-024: the schedules card. Any member of the organization may read and manage them (like the
        // webhooks above); the preview is computed here from the values a preview/refusal echoed back, so it
        // reads like the save that follows rather than like a client-side guess.
        if (_session is { HasOrganization: true } scheduler)
        {
            var schedules = await ScheduleManagement.ListAsync(scheduler.UserId, ProjectId);
            _schedules = schedules.Schedules;
        }

        if (!string.IsNullOrWhiteSpace(PreviewCron) || !string.IsNullOrWhiteSpace(PreviewZone))
        {
            _schedulePreview = SchedulePreview.Compute(PreviewCron, PreviewZone, Clock.GetUtcNow());
        }

        // D-003: credentials are listed only for an Owner. The page gate above is the first half,
        // the service's Owner check the second; a Member's list answer is the Forbidden result and
        // the page renders no names (the same asymmetry stance the secrets page keeps).
        if (_canManageCredentials && _session is { HasOrganization: true } owner)
        {
            var credentials = await CredentialService.ListForProjectAsync(owner.UserId, ProjectId);
            if (credentials.Status == GitCredentialMutationStatus.Success)
            {
                _credentials = credentials.Items;
                _assignment = credentials.Assignment;
                _usedByProjects = credentials.UsedByProjects
                    ?? new Dictionary<Guid, IReadOnlyList<GitCredentialReferencingProject>>();
            }
        }
    }

    /// <summary>Card F-018: the projects that clone with <paramref name="credential"/> (empty when none).</summary>
    private IReadOnlyList<GitCredentialReferencingProject> UsedBy(GitCredentialListItem credential) =>
        _usedByProjects.TryGetValue(credential.Id, out var projects) ? projects : [];

    /// <summary>The referencing projects as prose: names, or "N projects" past a readable handful.</summary>
    private static string UsedByLabel(IReadOnlyList<GitCredentialReferencingProject> projects)
    {
        const int shown = 5;
        var names = string.Join(", ", projects.Take(shown).Select(project => project.Name));
        return projects.Count > shown ? $"{names} and {projects.Count - shown} more project(s)" : names;
    }

    /// <summary>
    /// When the assignment was made, in the page's UTC format - or the honest "not recorded" for an
    /// assignment that predates the attribution columns (a database seeded before F-018).
    /// </summary>
    private static string FormatAssignedAt(GitCredentialAssignmentView assignment) =>
        assignment.AssignedAt is { } assignedAt
            ? assignedAt.ToString("yyyy-MM-dd HH:mm") + " UTC"
            : "Not recorded";

    /// <summary>
    /// Card F-024: one UTC due instant in the schedule's own zone, so an operator can check the expression
    /// against the wall clock they configured it for. An unknown zone (a row written out of band) shows the UTC
    /// time alone rather than inventing a local one.
    /// </summary>
    private static string LocalTime(DateTimeOffset utc, string? timeZone) =>
        ScheduleEvaluator.TryResolveZone(timeZone, out var zone)
            ? $"{TimeZoneInfo.ConvertTime(utc, zone):yyyy-MM-dd HH:mm} {timeZone}"
            : "local time unknown";

    /// <summary>Card F-024: the badge colour an outcome reads with: queued is good, a skip is neutral, a miss warns.</summary>
    private static BadgeVariant OutcomeVariant(string outcome) => outcome switch
    {
        ScheduleOutcomes.Queued => BadgeVariant.Default,
        ScheduleOutcomes.Missed => BadgeVariant.Destructive,
        _ => BadgeVariant.Secondary,
    };

    /// <summary>
    /// A real 404 for a foreign or missing id. The status-code-pages middleware must not re-execute
    /// /not-found in this same request: the component renderer already owns the NavigationManager,
    /// and re-execution fails with "already initialized" (F-003 bug B1). The HTTP response is
    /// therefore a bodyless 404; NotFoundPage above covers circuit navigation.
    /// </summary>
    private void SetNotFound()
    {
        if (HttpContext is null)
        {
            return;
        }

        HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
        if (HttpContext.Features.Get<IStatusCodePagesFeature>() is { } statusCodePages)
        {
            statusCodePages.Enabled = false;
        }
    }
}
