@page "/projects/{ProjectId:guid}/settings"
@attribute [Authorize]
@using System.Globalization
@using Zenkins.Server.Git
@using Zenkins.Server.Secrets
@using Zenkins.Shared.Projects
@using Zenkins.Server.Webhooks
@using Zenkins.Server.Notifications
@using Zenkins.Shared.Notifications
@using Zenkins.Server.Schedules
@inject UserSession UserSession
@inject ProjectService ProjectsService
@inject WebhookService WebhookManagement
@inject ScheduleService ScheduleManagement
@inject TimeProvider Clock
@inject ScheduleOptions ScheduleConfiguration
@inject GitCredentialService CredentialService
@inject ProjectLinkService LinkService
@inject RetentionService RetentionGate
@inject NotificationService Notifications
@inject NavigationManager Navigation

@* D-003: the Settings tab - everything that configures the project. The webhook cards moved here
   from the overview unchanged (F-017's endpoints and behaviour are the same), and git credentials
   get their first UI: managed like secrets (Owner-only writes, write-only values), through F-013's
   existing form endpoints. *@
<PageTitle>@L10n["Settings"] · @(_project?.Name ?? L10n["Project"]) · Zenkins</PageTitle>

<div class="bb:mx-auto bb:w-full bb:max-w-3xl bb:space-y-6">
    @if (_project is null)
    {
        @* Foreign tenant id == missing id: the service reads through the tenant filter and the
           response is a real 404 (same pattern as the other project tabs). *@
        <NotFoundPage />
    }
    else
    {
        <div class="bb:flex bb:flex-wrap bb:items-center bb:justify-between bb:gap-3">
            <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-3">
                <BbCardTitle As="h1" tabindex="-1">@L10n["Settings"] · @_project.Name</BbCardTitle>
                @if (_session?.Organization is { } organization)
                {
                    <BbBadge Variant="BadgeVariant.Secondary">@organization.Name</BbBadge>
                    <BbBadge Variant="BadgeVariant.Outline">@L10n["Your role: {0}", organization.Role]</BbBadge>
                }
                @* F-028: the state the controls below change, stated in the header the other tabs
                   share too. *@
                @if (_project.Disabled)
                {
                    <BbBadge Variant="BadgeVariant.Destructive">@L10n["Disabled"]</BbBadge>
                }
            </div>
        </div>

        <ProjectTabs ProjectId="@_project.Id" Active="settings" Kind="@_project.Kind"
                     BranchDiscovery="@_project.BranchDiscovery" />

        @if (Notice is { } notice)
        {
            <div role="status" class="bb:rounded-md bb:border bb:border-input bb:bg-muted bb:p-3 bb:text-sm">
                <p>@notice</p>
            </div>
        }

        @if (ChainNotice is { } chainNotice)
        {
            <div role="status" id="project-chain-notice"
                 class="bb:rounded-md bb:border bb:border-input bb:bg-muted bb:p-3 bb:text-sm">
                <p>@chainNotice</p>
            </div>
        }

        @if (WebhookMessage is { } webhookMessage)
        {
            <div role="alert" class="bb:rounded-md bb:border bb:border-destructive/40 bb:bg-destructive/10 bb:p-3 bb:text-sm bb:text-destructive">
                <p>@webhookMessage</p>
            </div>
        }

        @* Cards F-028 + F-029: a refused disable reason or a mistyped limit, rendered from the
           stable code the endpoint redirected with (the same PRG shape the other forms use). *@
        @if (SettingsMessage is { } settingsMessage)
        {
            <div role="alert" id="settings-error"
                 class="bb:rounded-md bb:border bb:border-destructive/40 bb:bg-destructive/10 bb:p-3 bb:text-sm bb:text-destructive">
                <p>@settingsMessage</p>
            </div>
        }

        @if (CredentialMessage is { } credentialMessage)
        {
            <div role="alert" class="bb:rounded-md bb:border bb:border-destructive/40 bb:bg-destructive/10 bb:p-3 bb:text-sm bb:text-destructive">
                <p>@credentialMessage</p>
            </div>
        }

        <BbCard>
            <BbCardHeader>
                <BbCardTitle As="h2">@L10n["Project basics"]</BbCardTitle>
                <BbCardDescription>
                    @(_project.Kind == ProjectKinds.Freestyle
                        ? L10n["A Freestyle project: no repository, no branch and no pipeline file - its steps live on the server (the Steps tab). Members and Owners may edit a project."]
                        : _project.PipelineSource == ProjectSources.Inline
                            ? L10n["An inline Pipeline project: no repository, no branch and no repository file - its script lives on the server (the Pipelines tab). Members and Owners may edit a project."]
                            : L10n["The repository, its default branch and the pipeline file. Members and Owners may edit a project."])
                </BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                <dl class="bb:grid bb:grid-cols-1 bb:gap-4 bb:text-sm bb:sm:grid-cols-3">
                    @if (ProjectSources.HasRepository(_project.Kind, _project.PipelineSource))
                    {
                        <div class="bb:sm:col-span-3">
                            <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">@L10n["Repository URL"]</dt>
                            <dd class="bb:break-all">@_project.RepositoryUrl</dd>
                        </div>
                    }
                    <div>
                        <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">@L10n["Name"]</dt>
                        <dd>@_project.Name</dd>
                    </div>
                    @if (ProjectSources.HasRepository(_project.Kind, _project.PipelineSource))
                    {
                        @* F-023: the discovery mode is stated here and changed on the edit page, like
                           the rest of the project's fields - it is a setting, not a second job kind. *@
                        <div>
                            <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">@L10n["Branch discovery"]</dt>
                            <dd>@(BranchDiscoveryModes.IsMultibranch(_project.BranchDiscovery) ? L10n["Every branch"] : L10n["Single branch"])</dd>
                        </div>
                    }
                    @if (_project.Kind == ProjectKinds.Freestyle)
                    {
                        @* F-020: the three repository fields do not exist for this kind, so the card
                           states the kind instead of rendering empty rows. *@
                        <div class="bb:sm:col-span-2">
                            <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">@L10n["Kind"]</dt>
                            <dd>@L10n["Freestyle (steps configured on the server)"]</dd>
                        </div>
                    }
                    else if (_project.PipelineSource == ProjectSources.Inline)
                    {
                        <div class="bb:sm:col-span-2">
                            <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">@L10n["Kind"]</dt>
                            <dd>@L10n["Pipeline (inline script on the server)"]</dd>
                        </div>
                    }
                    else
                    {
                        <div>
                            <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">@L10n["Default branch"]</dt>
                            <dd>@_project.DefaultBranch</dd>
                        </div>
                        <div>
                            <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">@L10n["Pipeline path"]</dt>
                            <dd class="bb:break-all">@_project.PipelinePath</dd>
                        </div>
                    }
                </dl>
                <div class="bb:mt-4">
                    @* The edit form keeps its own route, so basics editing works exactly as before. *@
                    <BbButton Href="@($"/projects/{_project.Id}/edit")" Variant="ButtonVariant.Outline">@L10n["Edit project basics"]</BbButton>
                </div>
            </BbCardContent>
        </BbCard>

        @* Card F-028: the reversible trigger brake. Members and Owners may both use it (the server
           re-checks membership); disabling keeps every history row and only stops the triggers. *@
        <BbCard>
            <BbCardHeader>
                <BbCardTitle As="h2">@L10n["Triggers"]</BbCardTitle>
                <BbCardDescription>
                    @L10n["Disabling stops"] <em>@L10n["every"]</em> @L10n["trigger for this project - the start form, webhooks and any future schedule - while its history, artifacts and settings stay readable. Runs still waiting in the queue are canceled; a run already executing continues. Enabling restores the triggers exactly as they were: nothing is replayed, and canceled runs stay canceled."]
                </BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                @if (_project.Disabled)
                {
                    <div id="trigger-state-disabled" class="bb:space-y-3">
                        <p class="bb:text-sm">
                            <span class="bb:font-medium">@L10n["This project is disabled."]</span>
                            @(_project.DisabledReason ?? L10n["No reason was recorded."])
                        </p>
                        <p class="bb:text-xs bb:text-muted-foreground">
                            @if (_project.DisabledAt is { } disabledAt)
                            {
                                <span>@L10n["Disabled {0} UTC", disabledAt.ToString("yyyy-MM-dd HH:mm")]</span>
                                @if (_project.DisabledByEmail is { } disabledBy)
                                {
                                    <span> @L10n["by {0}.", disabledBy]</span>
                                }
                                else
                                {
                                    <span>.</span>
                                }
                            }
                            @L10n["Nothing is queued for it until it is enabled again."]
                        </p>
                        <form method="post" action="@($"/projects/{_project.Id}/enable")" data-zenkins-antiforgery>
                            <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Default">@L10n["Enable project"]</BbButton>
                        </form>
                    </div>
                }
                else
                {
                    <form id="project-disable-form" method="post" action="@($"/projects/{_project.Id}/disable")" data-zenkins-antiforgery>
                        <div class="bb:space-y-3">
                            <div>
                                <label for="project-disabled-reason" class="bb:mb-1 bb:block bb:text-sm bb:font-medium">@L10n["Reason"]</label>
                                <input id="project-disabled-reason"
                                       name="Reason"
                                       required
                                       maxlength="@ProjectValidation.MaxDisabledReasonLength"
                                       class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:p-2 bb:text-sm"
                                       placeholder="@L10n["Repository is mid-migration"]" />
                                <p class="bb:mt-1 bb:text-xs bb:text-muted-foreground">
                                    @L10n["Required: the person whose trigger is refused reads it."]
                                </p>
                            </div>
                            <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Outline">@L10n["Disable project"]</BbButton>
                        </div>
                    </form>
                }
            </BbCardContent>
        </BbCard>

        @* Card F-031: the explicit "a failed post step fails the run" switch. The default keeps a green
           build green; this is the project that wants the stricter reading, and the run page says which
           reading produced its result. *@
        <BbCard>
            <BbCardHeader>
                <BbCardTitle As="h2">@L10n["Post steps"]</BbCardTitle>
                <BbCardDescription>
                    @L10n["Post steps"] (<code>success</code>, <code>failure</code>, <code>always</code>) @L10n["run after the main step list. By default a post step that fails is recorded as its own failed step and the run's result stays what the main steps decided - cleanup cannot silently turn a green build red, and it cannot be swallowed either. Turn this on to make a failed post step fail the run."]
                </BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                <form id="project-post-failure-form" method="post"
                      action="@($"/projects/{_project.Id}/post-failure")" data-zenkins-antiforgery>
                    <label class="bb:flex bb:items-start bb:gap-2">
                        <input type="checkbox"
                               id="project-post-failure-fails-run"
                               name="Enabled"
                               value="true"
                               checked="@_project.PostFailureFailsRun" />
                        <span class="bb:text-sm">@L10n["Fail the run when a post step fails."]</span>
                    </label>
                    <p class="bb:mt-2 bb:text-xs bb:text-muted-foreground">
                        @L10n["A canceled run keeps"] <code>Canceled</code> @L10n["either way: a cleanup failure cannot rewrite why the run stopped."]
                    </p>
                    <div class="bb:mt-3">
                        <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Outline">@L10n["Save post-step setting"]</BbButton>
                    </div>
                </form>
            </BbCardContent>
        </BbCard>

        @* Card F-026: the chain edges are declared here and nowhere else. Two lists and one form, because an
           edge always has a direction: each list is titled with what it means for this project ("runs after"
           / "queues a run of") rather than with the column name, and every row states the two rules the edge
           carries - whether a failed upstream still triggers, and which branch the downstream builds. *@
        <BbCard>
            <BbCardHeader>
                <BbCardTitle As="h2">@L10n["Upstream and downstream"]</BbCardTitle>
                <BbCardDescription>
                    @L10n["A chain runs projects in order: when an upstream run reaches a terminal state the server queues the downstream exactly once, in the same transaction, and the run page names the run that caused it. A link that would close a cycle is refused below with the path that would close it, whatever branch policy the edges carry. A chain is also bounded in depth: after {0} links it stops with its own recorded reason - the limit that is likewise the only stop left for an edge written past that save-time check.", ProjectLinkService.MaxUpstreamHops]
                </BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                <div id="project-chain" class="bb:space-y-6">
                    @if (ChainMessage is { } chainMessage)
                    {
                        <div id="project-chain-message" role="alert"
                             class="bb:rounded-md bb:border bb:border-destructive/40 bb:bg-destructive/10 bb:p-3 bb:text-sm bb:text-destructive">
                            <p>@chainMessage</p>
                        </div>
                    }

                    <div id="project-chain-upstream">
                        <h3 class="bb:text-sm bb:font-medium">@L10n["Runs after these projects (upstream)"]</h3>
                        <p class="bb:mt-1 bb:text-xs bb:text-muted-foreground">
                            @L10n["A terminal run of one of these projects queues a run of this one."]
                        </p>
                        @if (_upstreamLinks.Count == 0)
                        {
                            <p id="project-chain-upstream-empty" class="bb:mt-2 bb:text-sm bb:text-muted-foreground">
                                @L10n["None: nothing queues a run of this project."]
                            </p>
                        }
                        else
                        {
                            <ul class="bb:mt-2 bb:space-y-2">
                                @foreach (var link in _upstreamLinks)
                                {
                                    <li class="bb:rounded-md bb:border bb:border-input bb:p-3"
                                        data-chain-upstream-id="@link.Id"
                                        data-chain-project-id="@link.UpstreamProjectId">
                                        <div class="bb:flex bb:flex-wrap bb:items-center bb:justify-between bb:gap-2">
                                            <div>
                                                <p class="bb:font-medium">@link.UpstreamProjectName</p>
                                                <p class="bb:text-xs bb:text-muted-foreground">
                                                    @OnlyOnSuccessText(link.OnlyOnSuccess) · @BranchPolicyText(link)
                                                </p>
                                            </div>
                                            <form method="post"
                                                  action="@($"/projects/{_project.Id}/links/{link.Id}/delete")"
                                                  data-zenkins-antiforgery>
                                                <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Destructive">@L10n["Remove"]</BbButton>
                                            </form>
                                        </div>
                                    </li>
                                }
                            </ul>
                        }
                    </div>

                    <div id="project-chain-downstream">
                        <h3 class="bb:text-sm bb:font-medium">@L10n["Queues a run of these projects (downstream)"]</h3>
                        <p class="bb:mt-1 bb:text-xs bb:text-muted-foreground">
                            @L10n["A terminal run of this project queues a run of each of these."]
                        </p>
                        @if (_downstreamLinks.Count == 0)
                        {
                            <p id="project-chain-downstream-empty" class="bb:mt-2 bb:text-sm bb:text-muted-foreground">
                                @L10n["None: this project's runs trigger nothing."]
                            </p>
                        }
                        else
                        {
                            <ul class="bb:mt-2 bb:space-y-2">
                                @foreach (var link in _downstreamLinks)
                                {
                                    <li class="bb:rounded-md bb:border bb:border-input bb:p-3"
                                        data-chain-downstream-id="@link.Id"
                                        data-chain-project-id="@link.DownstreamProjectId">
                                        <div class="bb:flex bb:flex-wrap bb:items-center bb:justify-between bb:gap-2">
                                            <div>
                                                <p class="bb:font-medium">@link.DownstreamProjectName</p>
                                                <p class="bb:text-xs bb:text-muted-foreground">
                                                    @OnlyOnSuccessText(link.OnlyOnSuccess) · @BranchPolicyText(link)
                                                </p>
                                            </div>
                                            <form method="post"
                                                  action="@($"/projects/{_project.Id}/links/{link.Id}/delete")"
                                                  data-zenkins-antiforgery>
                                                <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Destructive">@L10n["Remove"]</BbButton>
                                            </form>
                                        </div>
                                    </li>
                                }
                            </ul>
                        }
                    </div>

                    @if (_chainTargets.Count == 0)
                    {
                        <p id="project-chain-no-targets" class="bb:text-sm bb:text-muted-foreground">
                            @L10n["This is the organization's only project, so there is nothing to link yet."]
                        </p>
                    }
                    else
                    {
                        <form id="project-chain-form"
                              method="post"
                              action="@($"/projects/{_project.Id}/links")"
                              data-zenkins-antiforgery>
                            <div class="bb:grid bb:grid-cols-1 bb:gap-4 bb:sm:grid-cols-2">
                                <div>
                                    <label for="chain-target" class="bb:mb-1 bb:block bb:text-sm bb:font-medium">@L10n["Project"]</label>
                                    <select id="chain-target"
                                            name="TargetProjectId"
                                            required
                                            class="bb:flex bb:h-9 bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-3 bb:py-1 bb:text-sm">
                                        @foreach (var target in _chainTargets)
                                        {
                                            <option value="@target.Id">@target.Name</option>
                                        }
                                    </select>
                                </div>
                                <div>
                                    <label for="chain-direction" class="bb:mb-1 bb:block bb:text-sm bb:font-medium">@L10n["Direction"]</label>
                                    <select id="chain-direction"
                                            name="Direction"
                                            class="bb:flex bb:h-9 bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-3 bb:py-1 bb:text-sm">
                                        <option value="downstream">@L10n["Its run queues a run of that project (downstream)"]</option>
                                        <option value="upstream">@L10n["That project's run queues a run of this one (upstream)"]</option>
                                    </select>
                                </div>
                                <div>
                                    <label for="chain-policy" class="bb:mb-1 bb:block bb:text-sm bb:font-medium">@L10n["Branch"]</label>
                                    <select id="chain-policy"
                                            name="BranchPolicy"
                                            class="bb:flex bb:h-9 bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-3 bb:py-1 bb:text-sm">
                                        <option value="@ProjectLinkBranchPolicies.SameBranch">@L10n["Build the branch the upstream built"]</option>
                                        <option value="@ProjectLinkBranchPolicies.DefaultBranch">@L10n["Build its own default branch"]</option>
                                    </select>
                                    <p class="bb:mt-1 bb:text-xs bb:text-muted-foreground">
                                        @L10n["A branch the downstream cannot build is recorded as a skip on the upstream run, never as a failure."]
                                    </p>
                                </div>
                                <div class="bb:flex bb:items-end">
                                    <label for="chain-only-on-success" class="bb:flex bb:items-center bb:gap-2 bb:text-sm">
                                        <input id="chain-only-on-success" type="checkbox" name="OnlyOnSuccess" value="true" checked />
                                        <input type="hidden" name="OnlyOnSuccess" value="false" />
                                        <span>@L10n["Only when the upstream succeeds"]</span>
                                    </label>
                                </div>
                            </div>
                            <div class="bb:mt-4">
                                <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Default">@L10n["Add link"]</BbButton>
                            </div>
                        </form>
                    }
                </div>
            </BbCardContent>
        </BbCard>

        @* Card F-029: how much of the queue and how many workers one project may occupy. Blank means
           the default (unlimited / zero) - exactly how every project behaved before this card. *@
        <BbCard>
            <BbCardHeader>
                <BbCardTitle As="h2">@L10n["Limits"]</BbCardTitle>
                <BbCardDescription>
                    @L10n["Bounds on this project's own queue and concurrency, so one busy repository cannot swamp the workers. The claim applies them in this order: quiet period, then the concurrency limit, then the queue cap decides whether a trigger is accepted at all."]
                </BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                <form id="project-limits-form" method="post" action="@($"/projects/{_project.Id}/limits")" data-zenkins-antiforgery>
                    <div class="bb:grid bb:grid-cols-1 bb:gap-4 bb:sm:grid-cols-3">
                        <div>
                            <label for="limits-max-concurrent" class="bb:mb-1 bb:block bb:text-sm bb:font-medium">@L10n["Concurrent runs"]</label>
                            <input id="limits-max-concurrent"
                                   name="MaxConcurrentRuns"
                                   value="@_project.MaxConcurrentRuns"
                                   inputmode="numeric"
                                   autocomplete="off"
                                   class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:p-2 bb:text-sm"
                                   placeholder="@L10n["unlimited"]" />
                            <p class="bb:mt-1 bb:text-xs bb:text-muted-foreground">
                                @L10n["At most this many of the project's runs are running (or claimed and not yet started) at once. Blank means unlimited."]
                            </p>
                        </div>
                        <div>
                            <label for="limits-quiet-period" class="bb:mb-1 bb:block bb:text-sm bb:font-medium">@L10n["Quiet period (seconds)"]</label>
                            <input id="limits-quiet-period"
                                   name="QuietPeriodSeconds"
                                   value="@_project.QuietPeriodSeconds"
                                   inputmode="numeric"
                                   autocomplete="off"
                                   class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:p-2 bb:text-sm"
                                   placeholder="0" />
                            <p class="bb:mt-1 bb:text-xs bb:text-muted-foreground">
                                @L10n["Seconds after a trigger before its run may be claimed. A trigger inside the period is an ordinary queued run - nothing is merged. 0 means claimable at once."]
                            </p>
                        </div>
                        <div>
                            <label for="limits-max-queued" class="bb:mb-1 bb:block bb:text-sm bb:font-medium">@L10n["Queue cap"]</label>
                            <input id="limits-max-queued"
                                   name="MaxQueuedRuns"
                                   value="@_project.MaxQueuedRuns"
                                   inputmode="numeric"
                                   autocomplete="off"
                                   class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:p-2 bb:text-sm"
                                   placeholder="@L10n["unlimited"]" />
                            <p class="bb:mt-1 bb:text-xs bb:text-muted-foreground">
                                @L10n["The most runs that may wait in this project's queue. A trigger at the cap is refused before any run is created. Blank means unlimited."]
                            </p>
                        </div>
                    </div>
                    <div class="bb:mt-4">
                        <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Default">@L10n["Save limits"]</BbButton>
                    </div>
                </form>
            </BbCardContent>
        </BbCard>

        @* Card F-038: the retention policy. Two independent rules whose union is what survives - a build is
           deleted only when it is beyond the newest N of its branch AND older than D days - and "both blank"
           keeps everything, which is how the product behaved before this card. The counts beside the form are
           the sweep's own evaluation, and the preview runs that same evaluation against the values in the
           form, so the number the reader sees now is the number the next sweep would delete. *@
        <BbCard>
            <BbCardHeader>
                <BbCardTitle As="h2">@L10n["Retention"]</BbCardTitle>
                <BbCardDescription>
                    @L10n["How much history this project keeps. A build is deleted only when it is"] <em>@L10n["both"]</em> @L10n["beyond the newest N of its branch and older than D days, so a tighter rule never surprises a rule you meant to keep. Pinned builds, builds still queued or running, and the newest build of each branch are never deleted. Deletion removes the run, its steps, logs, artifacts and their bytes."]
                </BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                <div id="project-retention" class="bb:space-y-4">
                    @if (RetentionMessage is { } retentionError)
                    {
                        <div id="project-retention-error" role="alert"
                             class="bb:rounded-md bb:border bb:border-destructive/40 bb:bg-destructive/10 bb:p-3 bb:text-sm bb:text-destructive">
                            <p>@retentionError</p>
                        </div>
                    }

                    @if (_retention is { } current)
                    {
                        <dl id="project-retention-current" class="bb:grid bb:grid-cols-1 bb:gap-3 bb:text-sm bb:sm:grid-cols-4">
                            <div>
                                <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">@L10n["Keeps"]</dt>
                                <dd id="project-retention-keeps">@RetentionRuleText(current.Policy)</dd>
                            </div>
                            <div>
                                <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">@L10n["Builds now"]</dt>
                                <dd id="project-retention-total">@current.TotalRuns</dd>
                            </div>
                            <div>
                                <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">@L10n["Pinned"]</dt>
                                <dd id="project-retention-pinned">@current.PinnedRuns</dd>
                            </div>
                            <div>
                                <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">@L10n["Next sweep deletes"]</dt>
                                <dd id="project-retention-next-sweep">@current.WouldDelete</dd>
                            </div>
                        </dl>
                        <p class="bb:text-xs bb:text-muted-foreground">
                            @L10n["{0} of {1} build(s) would survive; the newest build of each of {2} branch job(s) is always kept", current.Retained, current.TotalRuns, current.NewestPerBranch]
                            @if (current.NonTerminalRuns > 0)
                            {
                                <span>@L10n[", and {0} queued or running build(s) are never touched", current.NonTerminalRuns]</span>
                            }
                            .
                        </p>
                    }

                    @if (_retentionPreview is { } preview)
                    {
                        <div id="project-retention-preview"
                             class="bb:rounded-md bb:border bb:border-input bb:bg-muted bb:p-3 bb:text-sm">
                            <p class="bb:font-medium">
                                @L10n["With {0}, the next sweep would delete {1} of {2} build(s).", RetentionRuleText(preview.Policy), preview.WouldDelete, preview.TotalRuns]
                            </p>
                            @if (preview.Candidates.Count > 0)
                            {
                                <ul class="bb:mt-2 bb:list-disc bb:space-y-1 bb:ps-5 bb:text-xs">
                                    @foreach (var candidate in preview.Candidates.Take(5))
                                    {
                                        <li data-retention-candidate="@candidate.RunId">
                                            #@candidate.Number (@candidate.Branch): @candidate.Reason
                                        </li>
                                    }
                                </ul>
                                @if (preview.Candidates.Count > 5)
                                {
                                    <p class="bb:mt-1 bb:text-xs bb:text-muted-foreground">
                                        @L10n["and {0} more.", preview.Candidates.Count - 5]
                                    </p>
                                }
                            }
                            <p class="bb:mt-2 bb:text-xs bb:text-muted-foreground">
                                @L10n["Nothing was saved. Press Save retention to store these values."]
                            </p>
                        </div>
                    }

                    <form id="project-retention-form" method="post"
                          action="@($"/projects/{_project.Id}/retention")" data-zenkins-antiforgery>
                        <div class="bb:grid bb:grid-cols-1 bb:gap-4 bb:sm:grid-cols-2">
                            <div>
                                <label for="retention-keep" class="bb:mb-1 bb:block bb:text-sm bb:font-medium">@L10n["Keep the newest (per branch)"]</label>
                                <input id="retention-keep"
                                       name="RetentionKeep"
                                       value="@SubmittedKeep"
                                       inputmode="numeric"
                                       autocomplete="off"
                                       class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:p-2 bb:text-sm"
                                       placeholder="@L10n["blank: keep every build"]" />
                                <p class="bb:mt-1 bb:text-xs bb:text-muted-foreground">
                                    @L10n["A count of builds, per branch job: 10 means \"the newest 10 of every branch\". Blank means this rule is not set."]
                                </p>
                            </div>
                            <div>
                                <label for="retention-days" class="bb:mb-1 bb:block bb:text-sm bb:font-medium">@L10n["Keep builds newer than (days)"]</label>
                                <input id="retention-days"
                                       name="RetentionDays"
                                       value="@SubmittedDays"
                                       inputmode="numeric"
                                       autocomplete="off"
                                       class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:p-2 bb:text-sm"
                                       placeholder="@L10n["blank: keep every build"]" />
                                <p class="bb:mt-1 bb:text-xs bb:text-muted-foreground">
                                    @L10n["A day window from the build's own creation time. Blank means this rule is not set; blank in both fields keeps everything."]
                                </p>
                            </div>
                        </div>
                        <div class="bb:mt-4 bb:flex bb:flex-wrap bb:gap-2">
                            <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Default">@L10n["Save retention"]</BbButton>
                            @* One form, two submits - the same shape the schedules card uses: the preview
                               answers "what would this delete?" with the values in the fields and stores
                               nothing. *@
                            <button type="submit"
                                    name="Action"
                                    value="preview"
                                    class="bb:h-9 bb:rounded-md bb:border bb:border-input bb:px-4 bb:text-sm bb:font-medium bb:hover:bg-accent">
                                @L10n["Preview next sweep"]
                            </button>
                        </div>
                    </form>
                </div>
            </BbCardContent>
        </BbCard>

        @* Card F-025: SCM polling, for hosts that cannot reach the Server (or that nobody wants to wire a
           webhook on). Off by default - a fleet-wide default would silently load every repository - and the
           card states every decision the poller made, including the ones that queued nothing. *@
        <BbCard>
            <BbCardHeader>
                <BbCardTitle As="h2">@L10n["Polling"]</BbCardTitle>
                <BbCardDescription>
                    @L10n["Ask the remote for this project's branch heads on an interval and queue a run when one moved. The Server runs no git: the claiming worker does the"] <code>ls-remote</code>@L10n[", so a poll costs one probe per repository per tick and nothing else. A push from a webhook and a poll that see the same commit queue"] <span class="bb:font-medium">@L10n["one"]</span> @L10n["run between them: the dedupe key is the project, the branch and the commit."]
                </BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                <form id="project-polling-form" method="post"
                      action="@($"/projects/{_project.Id}/polling")" data-zenkins-antiforgery>
                    <div class="bb:grid bb:grid-cols-1 bb:gap-4 bb:sm:grid-cols-2">
                        <div>
                            <label class="bb:flex bb:items-center bb:gap-2">
                                <input type="checkbox" id="polling-enabled" name="PollingEnabled" value="true"
                                       checked="@(_project.PollingEnabled)" />
                                <span class="bb:text-sm bb:font-medium">@L10n["Poll this repository"]</span>
                            </label>
                            <p class="bb:mt-1 bb:text-xs bb:text-muted-foreground">
                                @L10n["A moved head queues one run pinned to the commit the probe observed. In multibranch mode every head is polled; otherwise the project's default branch is."]
                            </p>
                        </div>
                        <div>
                            <label for="polling-interval" class="bb:mb-1 bb:block bb:text-sm bb:font-medium">@L10n["Interval (minutes)"]</label>
                            <input id="polling-interval"
                                   name="PollIntervalMinutes"
                                   value="@_project.PollIntervalMinutes"
                                   inputmode="numeric"
                                   autocomplete="off"
                                   class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:p-2 bb:text-sm"
                                   placeholder="@Zenkins.Server.Polling.PollOptions.DefaultIntervalMinutes" />
                            <p class="bb:mt-1 bb:text-xs bb:text-muted-foreground">
                                @L10n["At least {0} minute. After a failed probe the wait doubles (1x, 2x, 4x ...) up to {1} minutes, and one successful probe resets it.", Zenkins.Server.Polling.PollOptions.MinIntervalMinutes, Zenkins.Server.Polling.PollOptions.MaxBackoffMinutes]
                            </p>
                        </div>
                    </div>
                    <div class="bb:mt-4">
                        <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Default">@L10n["Save polling"]</BbButton>
                    </div>
                </form>

                @* Card F-025 AC-7: say what would make polling pointless instead of letting every interval
                   fail silently. *@
                @if (!ProjectSources.HasRepository(_project.Kind, _project.PipelineSource))
                {
                    <p id="polling-no-repository" class="bb:mt-3 bb:text-xs bb:text-muted-foreground">
                        @L10n["This project has no repository (Freestyle or inline Pipeline), so there is nothing to poll and this switch is refused."]
                    </p>
                }
                else if (_project.GitCredentialId is null)
                {
                    <p id="polling-no-credential" class="bb:mt-3 bb:text-xs bb:text-muted-foreground">
                        @L10n["No Git credential is assigned. A public repository polls fine; a private one fails with"] <code>missing-credential</code> @L10n["on every tick until a credential is attached on this tab."]
                    </p>
                }

                @* The last decision, always: "never polled" and "polled, nothing moved" are different facts. *@
                <dl id="polling-state" class="bb:mt-4 bb:grid bb:grid-cols-1 bb:gap-2 bb:text-xs bb:sm:grid-cols-2">
                    <div>
                        <dt class="bb:text-muted-foreground">@L10n["Last poll"]</dt>
                        <dd id="polling-last-at">
                            @(_project.LastPollAt is { } at
                                ? at.ToString("yyyy-MM-dd HH:mm") + " UTC"
                                : L10n["never"])
                        </dd>
                    </div>
                    <div>
                        <dt class="bb:text-muted-foreground">@L10n["Last outcome"]</dt>
                        <dd id="polling-last-outcome">
                            @(PollingOutcomeText(_project.LastPollOutcome) ?? L10n["never polled"])
                        </dd>
                    </div>
                    <div>
                        <dt class="bb:text-muted-foreground">@L10n["Consecutive failures"]</dt>
                        <dd id="polling-backoff">
                            @(_project.PollFailureStreak == 0
                                ? L10n["none"]
                                : L10n["{0} - the next wait is at most {1} minutes", _project.PollFailureStreak, Zenkins.Server.Polling.PollOptions.MaxBackoffMinutes])
                        </dd>
                    </div>
                    @if (_project.LastPollMessage is { } message)
                    {
                        <div>
                            <dt class="bb:text-muted-foreground">@L10n["Diagnostic"]</dt>
                            <dd id="polling-last-message" class="bb:break-all">@message</dd>
                        </div>
                    }
                </dl>
            </BbCardContent>
        </BbCard>

        @* Card F-024: the cron schedules. Both kinds carry them (a Freestyle project has no repository
           file to declare one in, and the clock is the Server's), so the card sits outside the
           Pipeline-only section below. Every decision a due time makes is listed under it: queued,
           skipped (with the reason) or missed - the page never silently drops a due time. *@
        <BbCard>
            <BbCardHeader>
                <BbCardTitle As="h2">@L10n["Schedules"]</BbCardTitle>
                <BbCardDescription>
                    @L10n["A cron expression in an IANA time zone queues one run with the definition's defaults at every due time. Five fields: minute hour day-of-month month day-of-week. A due time that arrives while a run of this project is already queued or running is"] <span class="bb:font-medium">@L10n["skipped"]</span> @L10n["unless the schedule says otherwise, and a due time the Server was not running for is recorded as missed - never replayed."]
                </BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                @if (_schedulePreview is { } preview)
                {
                    <div id="schedule-preview" class="bb:mb-4 bb:rounded-md bb:border bb:border-input bb:p-3">
                        <p class="bb:text-sm bb:font-medium">@L10n["Next runs for {0} in {1}", PreviewCron, PreviewZone]</p>
                        @if (preview.IsValid)
                        {
                            <ul class="bb:mt-2 bb:list-disc bb:space-y-1 bb:ps-5 bb:text-sm">
                                @foreach (var due in preview.DueTimes)
                                {
                                    <li>
                                        <span class="bb:font-mono">@due.ToString("yyyy-MM-dd HH:mm")</span> UTC
                                        <span class="bb:text-muted-foreground">(@LocalTime(due, PreviewZone))</span>
                                    </li>
                                }
                            </ul>
                            <p class="bb:mt-2 bb:text-xs bb:text-muted-foreground">
                                @L10n["Nothing is saved by a preview. Adjust the expression above and save when it looks right."]
                            </p>
                        }
                        else
                        {
                            <p id="schedule-preview-error" role="alert" class="bb:mt-2 bb:text-sm bb:text-destructive">
                                @preview.Message
                            </p>
                        }
                    </div>
                }

                @if (_schedules.Count == 0)
                {
                    <p id="schedules-empty" class="bb:mb-4 bb:text-sm bb:text-muted-foreground">
                        @L10n["No schedule yet. A project can carry up to {0} schedules.", ScheduleErrorCodes.MaxSchedulesPerProject]
                    </p>
                }
                else
                {
                    <ul id="schedule-list" class="bb:mb-6 bb:space-y-4">
                        @foreach (var schedule in _schedules)
                        {
                            <li id="schedule-@schedule.Id" class="bb:rounded-md bb:border bb:border-input bb:p-3">
                                <div class="bb:flex bb:flex-wrap bb:items-center bb:justify-between bb:gap-2">
                                    <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-2">
                                        <code class="bb:text-sm">@schedule.Cron</code>
                                        <BbBadge Variant="BadgeVariant.Outline">@schedule.TimeZone</BbBadge>
                                        @if (schedule.Enabled)
                                        {
                                            <BbBadge Variant="BadgeVariant.Secondary">@L10n["Enabled"]</BbBadge>
                                        }
                                        else
                                        {
                                            <BbBadge Variant="BadgeVariant.Destructive">@L10n["Disabled"]</BbBadge>
                                        }
                                        <BbBadge Variant="BadgeVariant.Outline">
                                            @(schedule.QueueAnyway ? L10n["Queues anyway"] : L10n["Skips when busy"])
                                        </BbBadge>
                                    </div>
                                    <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-2">
                                        <form method="post"
                                              action="@($"/projects/{_project.Id}/schedules/{schedule.Id}/toggle")"
                                              data-zenkins-antiforgery>
                                            <input type="hidden" name="Flag" value="@ScheduleEndpoints.FlagEnabled" />
                                            <input type="hidden" name="Value" value="@(schedule.Enabled ? "false" : "true")" />
                                            <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Outline">
                                                @(schedule.Enabled ? L10n["Disable"] : L10n["Enable"])
                                            </BbButton>
                                        </form>
                                        <form method="post"
                                              action="@($"/projects/{_project.Id}/schedules/{schedule.Id}/toggle")"
                                              data-zenkins-antiforgery>
                                            <input type="hidden" name="Flag" value="@ScheduleEndpoints.FlagQueueAnyway" />
                                            <input type="hidden" name="Value" value="@(schedule.QueueAnyway ? "false" : "true")" />
                                            <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Outline">
                                                @(schedule.QueueAnyway ? L10n["Skip when busy"] : L10n["Queue anyway"])
                                            </BbButton>
                                        </form>
                                        <form method="post"
                                              action="@($"/projects/{_project.Id}/schedules/{schedule.Id}/delete")"
                                              data-zenkins-antiforgery>
                                            <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Destructive">@L10n["Delete"]</BbButton>
                                        </form>
                                    </div>
                                </div>
                                <dl class="bb:mt-3 bb:grid bb:grid-cols-1 bb:gap-2 bb:text-sm bb:sm:grid-cols-2">
                                    <div>
                                        <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">@L10n["Next runs"]</dt>
                                        <dd>
                                            @if (schedule.HasNextDue)
                                            {
                                                <ul class="bb:space-y-0.5">
                                                    @foreach (var due in schedule.NextDueTimes)
                                                    {
                                                        <li>
                                                            <span class="bb:font-mono">@due.ToString("yyyy-MM-dd HH:mm")</span> UTC
                                                            <span class="bb:text-muted-foreground">(@LocalTime(due, schedule.TimeZone))</span>
                                                        </li>
                                                    }
                                                </ul>
                                            }
                                            else
                                            {
                                                <span class="bb:text-destructive">@L10n["The expression never fires."]</span>
                                            }
                                        </dd>
                                    </div>
                                    <div>
                                        <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">@L10n["Last evaluated"]</dt>
                                        <dd>
                                            @if (schedule.LastEvaluatedAt is { } evaluatedAt)
                                            {
                                                <span>@evaluatedAt.ToString("yyyy-MM-dd HH:mm:ss") UTC</span>
                                            }
                                            else
                                            {
                                                <span class="bb:text-muted-foreground">@L10n["Not yet"]</span>
                                            }
                                        </dd>
                                    </div>
                                </dl>
                                @if (schedule.LastMissedCount > 0)
                                {
                                    @* The count is exact even when the list is not: it is the last evaluation's own
                                       number, kept on the schedule so the ledger's retention cannot shrink it. When the
                                       evaluation's window was capped (review L1) the sentence says so - the number is
                                       the newest window's, not the whole outage's, and a reader must not be left to
                                       infer that from a row the list never shows. *@
                                    <p id="schedule-missed-@schedule.Id" class="bb:mt-3 bb:text-sm">
                                        <span class="bb:font-medium">@L10n["{0} due time(s)", schedule.LastMissedCount]</span>
                                        @L10n["recorded as missed - the Server was not evaluating this schedule then."]
                                        @if (schedule.LastMissedWindowTruncated)
                                        {
                                            <span>@L10n["Only the newest {0} hours are counted; earlier missed due times are not listed.", (int)ScheduleConfiguration.MissWindow.TotalHours]</span>
                                        }
                                    </p>
                                }
                                <div class="bb:mt-3">
                                    <p class="bb:text-xs bb:font-medium bb:text-muted-foreground">@L10n["Last outcomes"]</p>
                                    @if (schedule.RecentOutcomes.Count == 0)
                                    {
                                        <p class="bb:mt-1 bb:text-sm bb:text-muted-foreground">
                                            @L10n["Nothing yet - the first due time has not arrived."]
                                        </p>
                                    }
                                    else
                                    {
                                        <ul id="schedule-outcomes-@schedule.Id" class="bb:mt-1 bb:space-y-1 bb:text-sm">
                                            @foreach (var outcome in schedule.RecentOutcomes)
                                            {
                                                <li class="bb:flex bb:flex-wrap bb:items-baseline bb:gap-2">
                                                    <span class="bb:font-mono bb:text-xs">@outcome.DueAt.ToString("yyyy-MM-dd HH:mm")</span>
                                                    <BbBadge Variant="@OutcomeVariant(outcome.Outcome)">@outcome.Outcome</BbBadge>
                                                    <span>@outcome.Describe(L10n)</span>
                                                </li>
                                            }
                                        </ul>
                                    }
                                </div>
                            </li>
                        }
                    </ul>
                }

                <form id="schedule-create-form"
                      method="post"
                      action="@($"/projects/{_project.Id}/schedules/create")"
                      data-zenkins-antiforgery>
                    <div class="bb:space-y-4">
                        <div class="bb:grid bb:grid-cols-1 bb:gap-4 bb:sm:grid-cols-2">
                            <div>
                                <label for="schedule-cron" class="bb:mb-1 bb:block bb:text-sm bb:font-medium">@L10n["Cron expression"]</label>
                                <input id="schedule-cron"
                                       name="Cron"
                                       required
                                       maxlength="@Zenkins.Server.Schedules.ScheduleCron.MaxLength"
                                       value="@SubmittedCron"
                                       class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:p-2 bb:font-mono bb:text-sm"
                                       placeholder="0 3 * * *" />
                                <p class="bb:mt-1 bb:text-xs bb:text-muted-foreground">
                                    <code>minute hour day-of-month month day-of-week</code>@L10n[". Ranges, lists and steps work"] (<code>*/15 9-17 * * MON-FRI</code>)@L10n["; named macros such as"] <code>@@daily</code> @L10n["and a seconds field are refused."]
                                </p>
                            </div>
                            <div>
                                <label for="schedule-timezone" class="bb:mb-1 bb:block bb:text-sm bb:font-medium">@L10n["Time zone"]</label>
                                <input id="schedule-timezone"
                                       name="TimeZone"
                                       required
                                       maxlength="@ScheduleErrorCodes.MaxTimeZoneLength"
                                       value="@SubmittedTimeZone"
                                       class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:p-2 bb:font-mono bb:text-sm"
                                       placeholder="Europe/Berlin" />
                                <p class="bb:mt-1 bb:text-xs bb:text-muted-foreground">
                                    @L10n["An IANA id"] (<code>Europe/Berlin</code>, <code>America/New_York</code>, <code>Asia/Tokyo</code>, <code>UTC</code>). @L10n["Daylight saving is the zone's own: a clock time the zone skips is recorded, not run."]
                                </p>
                            </div>
                        </div>
                        <div class="bb:space-y-2">
                            <label for="schedule-queue-anyway" class="bb:flex bb:items-center bb:gap-2 bb:text-sm">
                                <input id="schedule-queue-anyway" type="checkbox" name="QueueAnyway" value="true" />
                                <input type="hidden" name="QueueAnyway" value="false" />
                                <span>@L10n["Queue anyway: if a run of this project is still queued or running at a due time, queue another (the project's queue cap still applies)."]</span>
                            </label>
                            <label for="schedule-enabled" class="bb:flex bb:items-center bb:gap-2 bb:text-sm">
                                <input id="schedule-enabled" type="checkbox" name="Enabled" value="true" checked />
                                <input type="hidden" name="Enabled" value="false" />
                                <span>@L10n["Enabled: evaluate this schedule (a disabled one records every due time as skipped)."]</span>
                            </label>
                        </div>
                        <div class="bb:flex bb:flex-wrap bb:gap-2">
                            <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Default">@L10n["Add schedule"]</BbButton>
                            @* One form, two submits: the preview button names itself, so the same field values the
                               save would post answer "when would this run?" without storing anything. *@
                            <button type="submit"
                                    name="Action"
                                    value="preview"
                                    class="bb:h-9 bb:rounded-md bb:border bb:border-input bb:px-4 bb:text-sm bb:font-medium bb:hover:bg-accent">
                                @L10n["Preview next runs"]
                            </button>
                        </div>
                    </div>
                </form>
            </BbCardContent>
        </BbCard>

        @* F-020/F-022: webhooks and git credentials both exist only for a project with a repository
           - a webhook triggers on git pushes and a credential materializes a clone, and a Freestyle
           or inline project has neither. The whole section is hidden, and the endpoints refuse with
           the same shared predicate. *@
        @if (ProjectSources.HasRepository(_project.Kind, _project.PipelineSource))
        {
        @* F-017: the webhook configuration, moved verbatim from the overview. Create and rotate
           answer with a standalone show-once document (the plaintext has to be copied into the git
           host), so no plaintext is ever rendered here. *@
        <BbCard>
            <BbCardHeader>
                <BbCardTitle As="h2">@L10n["Webhooks"]</BbCardTitle>
                <BbCardDescription>
                    @L10n["A signed"] <code>git push</code> @L10n["to a matching branch starts a run for the pushed commit. The secret is shown once, when the webhook is created or rotated: copy it into the git host then, because it cannot be read again."]
                </BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                @if (_webhooks.Count == 0)
                {
                    <p class="bb:mb-4 bb:text-sm bb:text-muted-foreground">@L10n["No webhooks yet."]</p>
                }
                else
                {
                    <ul class="bb:mb-6 bb:space-y-3">
                        @foreach (var webhook in _webhooks)
                        {
                            <li class="bb:rounded-md bb:border bb:border-input bb:p-3" data-webhook-id="@webhook.Id">
                                <div class="bb:flex bb:flex-wrap bb:items-center bb:justify-between bb:gap-2">
                                    <div>
                                        <p class="bb:font-medium">@webhook.Name</p>
                                        <p class="bb:text-xs bb:text-muted-foreground">
                                            @(webhook.Enabled ? L10n["Enabled"] : L10n["Disabled"])
                                        </p>
                                    </div>
                                    <div class="bb:flex bb:flex-wrap bb:gap-2">
                                        <form method="post" action="@($"/projects/{_project.Id}/webhooks/{webhook.Id}/rotate")" data-zenkins-antiforgery>
                                            <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Outline">@L10n["Rotate secret"]</BbButton>
                                        </form>
                                        <form method="post" action="@($"/projects/{_project.Id}/webhooks/{webhook.Id}/{(webhook.Enabled ? "disable" : "enable")}")" data-zenkins-antiforgery>
                                            <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Outline">
                                                @(webhook.Enabled ? L10n["Disable"] : L10n["Enable"])
                                            </BbButton>
                                        </form>
                                        <form method="post" action="@($"/projects/{_project.Id}/webhooks/{webhook.Id}/delete")" data-zenkins-antiforgery>
                                            <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Destructive">@L10n["Delete"]</BbButton>
                                        </form>
                                    </div>
                                </div>
                                <dl class="bb:mt-3 bb:grid bb:grid-cols-1 bb:gap-2 bb:text-sm bb:sm:grid-cols-2">
                                    <div class="bb:sm:col-span-2">
                                        <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">@L10n["Endpoint URL"]</dt>
                                        <dd class="bb:break-all"><code>@EndpointUrl(webhook)</code></dd>
                                    </div>
                                    <div>
                                        <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">@L10n["Branches"]</dt>
                                        <dd>@BranchLabel(webhook)</dd>
                                    </div>
                                    <div>
                                        <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">@L10n["Required tags"]</dt>
                                        <dd>@(string.IsNullOrWhiteSpace(webhook.RequiredTags) ? L10n["Any worker"] : webhook.RequiredTags)</dd>
                                    </div>
                                    <div>
                                        <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">@L10n["Secret"]</dt>
                                        <dd>
                                            @L10n["Configured"]
                                            @if (webhook.SecretRotatedAt is { } rotatedAt)
                                            {
                                                <span>@L10n["(rotated {0} UTC)", rotatedAt.ToString("yyyy-MM-dd HH:mm")]</span>
                                            }
                                        </dd>
                                    </div>
                                    <div>
                                        <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">@L10n["Last delivery"]</dt>
                                        <dd>
                                            @if (webhook.LastDeliveryAt is { } deliveredAt)
                                            {
                                                <span>@deliveredAt.ToString("yyyy-MM-dd HH:mm") UTC · @(webhook.LastDeliveryOutcome ?? "-")</span>
                                            }
                                            else
                                            {
                                                <span class="bb:text-muted-foreground">@L10n["None yet"]</span>
                                            }
                                        </dd>
                                    </div>
                                </dl>
                            </li>
                        }
                    </ul>
                }

                <form method="post" action="@($"/projects/{_project.Id}/webhooks/create")" data-zenkins-antiforgery>
                    <div class="bb:space-y-4">
                        <div>
                            <label for="webhook-name" class="bb:mb-1 bb:block bb:text-sm bb:font-medium">@L10n["Name"]</label>
                            <input id="webhook-name"
                                   name="Name"
                                   required
                                   maxlength="100"
                                   class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:p-2 bb:text-sm"
                                   placeholder="github-main" />
                        </div>
                        <div>
                            <label for="webhook-branch-filter" class="bb:mb-1 bb:block bb:text-sm bb:font-medium">@L10n["Branches (optional)"]</label>
                            <input id="webhook-branch-filter"
                                   name="BranchFilter"
                                   class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:p-2 bb:font-mono bb:text-sm"
                                   placeholder="@_project.DefaultBranch" />
                            <p class="bb:mt-1 bb:text-xs bb:text-muted-foreground">
                                @L10n["Comma-separated names; a trailing"] <code>*</code> @L10n["is the only wildcard"] (<code>main, release/*</code>). @L10n["Leave it blank to follow the project's default branch. Other branches are accepted and ignored."]
                            </p>
                        </div>
                        <div>
                            <label for="webhook-required-tags" class="bb:mb-1 bb:block bb:text-sm bb:font-medium">@L10n["Required tags (optional)"]</label>
                            <input id="webhook-required-tags"
                                   name="RequiredTags"
                                   class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:p-2 bb:text-sm"
                                   placeholder="linux, dotnet" />
                        </div>
                        <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Default">@L10n["Create webhook"]</BbButton>
                    </div>
                </form>
            </BbCardContent>
        </BbCard>

        @* Card F-039: the outbound completion notifications. The card states the one thing an operator has to
           trust - a notification is owed the moment the run ends, and the run never waits for the receiver - and then
           the per-endpoint facts: what it subscribes to, whether it is on, and what happened to the last delivery. *@
        <BbCard>
            <BbCardHeader>
                <BbCardTitle As="h2">@L10n["Notifications"]</BbCardTitle>
                <BbCardDescription>
                    @L10n["When a run ends, this project can POST a signed JSON body to one or more endpoints - on"] <code>failed</code>@L10n[", on"] <code>success</code>@L10n[", and on"] <code>recovered</code> @L10n["(a success whose previous run on the same branch failed). The obligation is written in the same transaction as the run's terminal status and delivered afterwards, so a receiver that is down never delays a build and a Server restart never loses a notification. Every request carries"] <code>X-Zenkins-Signature: sha256=…</code> @L10n["(HMAC-SHA256 over the body, the same scheme inbound webhooks use) and a stable"] <code>X-Zenkins-Delivery</code> @L10n["id for deduplication."]
                </BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                <div id="project-notifications" class="bb:space-y-4">
                    @if (NotificationMessage is { } notificationError)
                    {
                        <div id="notification-error" role="alert"
                             class="bb:rounded-md bb:border bb:border-destructive/40 bb:bg-destructive/10 bb:p-3 bb:text-sm bb:text-destructive">
                            <p>@notificationError</p>
                        </div>
                    }

                    @if (NotificationTestFailure is { } testFailure)
                    {
                        <div id="notification-test-failure" role="alert"
                             class="bb:rounded-md bb:border bb:border-destructive/40 bb:bg-destructive/10 bb:p-3 bb:text-sm bb:text-destructive">
                            <p class="bb:font-medium">@L10n["The test delivery did not arrive."]</p>
                            <p class="bb:break-all">@testFailure</p>
                        </div>
                    }

                    @if (_notificationEndpoints.Count == 0)
                    {
                        <p id="project-notifications-empty" class="bb:text-sm bb:text-muted-foreground">
                            @L10n["No endpoints yet: this project tells nobody when a run ends."]
                        </p>
                    }
                    else
                    {
                        <div class="bb:overflow-x-auto">
                            <table class="bb:w-full bb:text-sm">
                                <thead>
                                    <tr class="bb:border-b bb:text-start bb:text-muted-foreground">
                                        <th class="bb:py-2 bb:pe-4 bb:font-medium">@L10n["Receiver"]</th>
                                        <th class="bb:py-2 bb:pe-4 bb:font-medium">@L10n["Events"]</th>
                                        <th class="bb:py-2 bb:pe-4 bb:font-medium">@L10n["State"]</th>
                                        <th class="bb:py-2 bb:pe-4 bb:font-medium">@L10n["Last delivery"]</th>
                                        <th class="bb:py-2 bb:font-medium">@L10n["Manage"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var endpoint in _notificationEndpoints)
                                    {
                                        <tr class="bb:border-b bb:align-top" data-notification-endpoint="@endpoint.Id">
                                            <td class="bb:max-w-xs bb:py-3 bb:pe-4">
                                                <span class="bb:break-all">@endpoint.Url</span>
                                                @if (endpoint.AllowInsecureHttp)
                                                {
                                                    <p class="bb:mt-1 bb:text-xs bb:text-destructive">
                                                        @L10n["Plain http: the body and the signature travel in the clear."]
                                                    </p>
                                                }
                                            </td>
                                            <td class="bb:py-3 bb:pe-4" data-notification-events="@endpoint.Events">@endpoint.Events</td>
                                            <td class="bb:py-3 bb:pe-4" data-notification-state="@(endpoint.Enabled ? "enabled" : "disabled")">
                                                @(endpoint.Enabled ? L10n["Enabled"] : L10n["Disabled"])
                                            </td>
                                            <td class="bb:py-3 bb:pe-4" data-notification-last="@endpoint.LastOutcome">
                                                @if (endpoint.LastDeliveryAt is { } deliveredAt)
                                                {
                                                    <p>@deliveredAt.ToString("yyyy-MM-dd HH:mm") UTC · @(endpoint.LastOutcome ?? "-")</p>
                                                    @if (!string.IsNullOrWhiteSpace(endpoint.LastError))
                                                    {
                                                        <p class="bb:mt-1 bb:max-w-xs bb:break-all bb:text-xs bb:text-destructive">@endpoint.LastError</p>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="bb:text-muted-foreground">@L10n["Never delivered"]</span>
                                                }
                                            </td>
                                            <td class="bb:py-3">
                                                <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-2">
                                                    <form method="post"
                                                          action="@($"/projects/{_project.Id}/notifications/{endpoint.Id}/{(endpoint.Enabled ? "disable" : "enable")}")"
                                                          data-zenkins-antiforgery>
                                                        <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Outline">
                                                            @(endpoint.Enabled ? L10n["Disable"] : L10n["Enable"])
                                                        </BbButton>
                                                    </form>
                                                    <form method="post"
                                                          action="@($"/projects/{_project.Id}/notifications/{endpoint.Id}/test")"
                                                          data-zenkins-antiforgery>
                                                        <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Outline">@L10n["Send test"]</BbButton>
                                                    </form>
                                                    <form method="post"
                                                          action="@($"/projects/{_project.Id}/notifications/{endpoint.Id}/delete")"
                                                          data-zenkins-antiforgery>
                                                        <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Destructive">@L10n["Delete"]</BbButton>
                                                    </form>
                                                </div>
                                                @* Rotation replaces the secret future deliveries are signed with. A delivery
                                                   already owed keeps the one it was created under, so a receiver that has
                                                   not been updated yet can still verify what is in flight. *@
                                                <form method="post"
                                                      action="@($"/projects/{_project.Id}/notifications/{endpoint.Id}/rotate")"
                                                      data-zenkins-antiforgery
                                                      class="bb:mt-2 bb:flex bb:flex-wrap bb:items-center bb:gap-2">
                                                    <label for="notification-rotate-@endpoint.Id" class="bb:sr-only">@L10n["New secret for {0}", endpoint.Url]</label>
                                                    <input id="notification-rotate-@endpoint.Id"
                                                           name="Secret"
                                                           type="password"
                                                           required
                                                           minlength="@NotificationLimits.MinSecretLength"
                                                           maxlength="@NotificationLimits.MaxSecretLength"
                                                           autocomplete="new-password"
                                                           spellcheck="false"
                                                           class="bb:h-8 bb:w-40 bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-2 bb:py-1 bb:text-xs"
                                                           placeholder="@L10n["New secret"]" />
                                                    <button type="submit"
                                                            class="bb:rounded-md bb:border bb:border-input bb:px-2 bb:py-1 bb:text-xs bb:hover:bg-accent">
                                                        @L10n["Rotate secret"]
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    @if (!_canManageCredentials)
                    {
                        @* The URL is a place the Server will POST to, so pointing it somewhere is an Owner's decision
                           (the same stance as git credentials). A Member can read the list. *@
                        <p class="bb:text-sm bb:text-muted-foreground">
                            @L10n["Notification endpoints are configured by organization Owners; a Member can read the list."]
                        </p>
                    }
                    else
                    {
                        <form id="notification-create-form" method="post"
                              action="@($"/projects/{_project.Id}/notifications/create")" data-zenkins-antiforgery>
                            <div class="bb:space-y-4">
                                <div>
                                    <label for="notification-url" class="bb:mb-1 bb:block bb:text-sm bb:font-medium">@L10n["Receiver URL"]</label>
                                    <input id="notification-url"
                                           name="Url"
                                           type="url"
                                           required
                                           maxlength="@NotificationLimits.MaxUrlLength"
                                           class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:p-2 bb:font-mono bb:text-sm"
                                           placeholder="https://chat.example.test/zenkins" />
                                    <p class="bb:mt-1 bb:text-xs bb:text-muted-foreground">
                                        <code>https</code> @L10n["unless this deployment uses a plain"]<code>-http</code> @L10n["receiver and the opt-in below says so. Redirects are never followed."]
                                    </p>
                                </div>
                                <div>
                                    <label for="notification-secret" class="bb:mb-1 bb:block bb:text-sm bb:font-medium">@L10n["Shared secret"]</label>
                                    <input id="notification-secret"
                                           name="Secret"
                                           type="password"
                                           required
                                           minlength="@NotificationLimits.MinSecretLength"
                                           maxlength="@NotificationLimits.MaxSecretLength"
                                           autocomplete="new-password"
                                           spellcheck="false"
                                           class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:p-2 bb:text-sm"
                                           placeholder="@L10n["the receiver verifies the HMAC with this"]" />
                                    <p class="bb:mt-1 bb:text-xs bb:text-muted-foreground">
                                        @L10n["Stored encrypted and never shown again. The receiver computes"] <code>sha256=HMAC-SHA256(secret, body)</code> @L10n["and compares it with the"] <code>X-Zenkins-Signature</code> @L10n["header."]
                                    </p>
                                </div>
                                <div class="bb:space-y-2">
                                    <p class="bb:text-sm bb:font-medium">@L10n["Events"]</p>
                                    @foreach (var notificationEvent in NotificationEvents.Subscribable)
                                    {
                                        <label for="notification-event-@notificationEvent" class="bb:flex bb:items-center bb:gap-2 bb:text-sm">
                                            <input id="notification-event-@notificationEvent"
                                                   type="checkbox"
                                                   name="Events"
                                                   value="@notificationEvent"
                                                   checked="@(notificationEvent != NotificationEvents.All)" />
                                            <span>
                                                @notificationEvent@(notificationEvent == NotificationEvents.Success
                                                    ? " " + L10n["(includes recovered: a recovery is a success)"]
                                                    : notificationEvent == NotificationEvents.All
                                                        ? " " + L10n["(every event)"]
                                                        : string.Empty)
                                            </span>
                                        </label>
                                    }
                                </div>
                                <div class="bb:space-y-2">
                                    <label for="notification-enabled" class="bb:flex bb:items-center bb:gap-2 bb:text-sm">
                                        <input id="notification-enabled" type="checkbox" name="Enabled" value="true" checked />
                                        <input type="hidden" name="Enabled" value="false" />
                                        <span>@L10n["Enabled: notify this endpoint about new terminal states."]</span>
                                    </label>
                                    <label for="notification-allow-http" class="bb:flex bb:items-center bb:gap-2 bb:text-sm">
                                        <input id="notification-allow-http" type="checkbox" name="AllowInsecureHttp" value="true" />
                                        <input type="hidden" name="AllowInsecureHttp" value="false" />
                                        <span class="bb:text-destructive">
                                            @L10n["Allow plain http: the payload (branch, commit) and the signature travel unencrypted."]
                                        </span>
                                    </label>
                                </div>
                                <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Default">@L10n["Add endpoint"]</BbButton>
                            </div>
                        </form>
                    }
                </div>
            </BbCardContent>
        </BbCard>

        @if (!_canManageCredentials)
        {
            @* Git credentials are managed like secrets (card D-003): Owner-only writes, and a Member
               does not learn which credential names exist. The write endpoints are the enforcement;
               this is the page half of it. *@
            <BbCard>
                <BbCardHeader>
                    <BbCardTitle As="h2">@L10n["Git credentials"]</BbCardTitle>
                    <BbCardDescription>
                        @L10n["Credentials are managed by organization Owners; Members cannot list or change them. Ask an Owner of this organization if this project's repository needs one."]
                    </BbCardDescription>
                </BbCardHeader>
            </BbCard>
        }
        else
        {
            <BbCard>
                <BbCardHeader>
                    <BbCardTitle As="h2">@L10n["Git credentials"]</BbCardTitle>
                    <BbCardDescription>
                        @L10n["The material a worker uses to clone this project's repository. The value is encrypted before it is stored and is never shown again - the list below is names, kinds and timestamps only, and no route returns a value. To change a credential, rotate it; the worker fetches it only while it executes a run of a project that references it."]
                    </BbCardDescription>
                </BbCardHeader>
                <BbCardContent>
                    @* Card F-018: the assignment itself. Until this card the column existed and nothing
                       wrote it, so every project cloned with whatever credential the worker host held.
                       The block states the current assignment (which credential, by whom, when) or that
                       there is none - and "none" is a product statement, not an omission: a run then
                       clones without a credential instead of borrowing the host's. *@
                    <div id="credential-assignment"
                         class="bb:mb-6 bb:rounded-md bb:border bb:border-input bb:p-3">
                        @if (_assignment is { } assignment)
                        {
                            <p class="bb:text-sm bb:font-medium">@L10n["Attached to this project"]</p>
                            <dl id="credential-assignment-current"
                                class="bb:mt-2 bb:grid bb:grid-cols-1 bb:gap-3 bb:text-sm bb:sm:grid-cols-4">
                                <div>
                                    <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">@L10n["Credential"]</dt>
                                    <dd id="credential-assignment-name" class="bb:break-all">@assignment.Name</dd>
                                </div>
                                <div>
                                    <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">@L10n["Kind"]</dt>
                                    <dd>@assignment.Kind</dd>
                                </div>
                                <div>
                                    <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">@L10n["Attached by"]</dt>
                                    <dd id="credential-assignment-by" class="bb:break-all">@(assignment.AssignedBy ?? L10n["Not recorded"])</dd>
                                </div>
                                <div>
                                    <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">@L10n["Attached"]</dt>
                                    <dd id="credential-assignment-at">@FormatAssignedAt(assignment)</dd>
                                </div>
                            </dl>
                            <p class="bb:mt-2 bb:text-xs bb:text-muted-foreground">
                                @L10n["Runs of this project fetch this credential from the server at clone time; the worker never uses a credential stored on its own host."]
                            </p>
                            <form method="post"
                                  action="@($"/projects/{_project.Id}/git-credential/detach")"
                                  data-zenkins-antiforgery
                                  class="bb:mt-3">
                                <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Outline">@L10n["Detach credential"]</BbButton>
                            </form>
                        }
                        else
                        {
                            <p id="credential-assignment-none" class="bb:text-sm">
                                <span class="bb:font-medium">@L10n["No credential is attached to this project."]</span>
                                @L10n["Its runs clone without one and will"] <span class="bb:font-medium">@L10n["not"]</span> @L10n["fall back to a credential stored on the worker host, so a private repository fails until a credential is attached here."]
                            </p>
                            @if (_project.GitCredentialId is not null)
                            {
                                @* The column names a row the organization no longer has. Say so rather
                                   than rendering an empty assignment as if none were configured. *@
                                <p id="credential-assignment-missing" role="alert"
                                   class="bb:mt-2 bb:text-sm bb:text-destructive">
                                    @L10n["This project still points at a credential that no longer exists. Its runs fail until a credential is attached again."]
                                </p>
                            }

                            @if (_credentials.Count == 0)
                            {
                                <p class="bb:mt-3 bb:text-xs bb:text-muted-foreground">
                                    @L10n["Create a credential below first, then attach it here."]
                                </p>
                            }
                            else
                            {
                                <form method="post"
                                      action="@($"/projects/{_project.Id}/git-credential/attach")"
                                      data-zenkins-antiforgery
                                      class="bb:mt-3 bb:flex bb:flex-wrap bb:items-end bb:gap-2">
                                    <div class="bb:flex-1">
                                        <label for="credential-assignment-select"
                                               class="bb:mb-1 bb:block bb:text-sm bb:font-medium">@L10n["Attach a credential"]</label>
                                        <select id="credential-assignment-select"
                                                name="GitCredentialId"
                                                class="bb:flex bb:h-9 bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-3 bb:py-1 bb:text-sm">
                                            @foreach (var credential in _credentials)
                                            {
                                                <option value="@credential.Id">@credential.Name (@credential.Kind)</option>
                                            }
                                        </select>
                                    </div>
                                    <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Default">@L10n["Attach"]</BbButton>
                                </form>
                            }
                        }
                    </div>

                    <form method="post" action="/git-credentials/create" data-zenkins-antiforgery>
                        <div class="bb:space-y-4">
                            <input type="hidden" name="ProjectId" value="@_project.Id" />
                            <div class="bb:grid bb:grid-cols-1 bb:gap-4 bb:sm:grid-cols-2">
                                <div>
                                    <label for="credential-name" class="bb:mb-1 bb:block bb:text-sm bb:font-medium">@L10n["Name"]</label>
                                    <input id="credential-name"
                                           name="Name"
                                           type="text"
                                           required
                                           maxlength="@SecretValidation.MaxNameLength"
                                           pattern="[A-Za-z_][A-Za-z0-9_]*"
                                           value="@SubmittedCredentialName"
                                           class="bb:flex bb:h-9 bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-3 bb:py-1 bb:text-sm"
                                           autocomplete="off"
                                           spellcheck="false"
                                           placeholder="DEPLOY_TOKEN" />
                                </div>
                                <div>
                                    <label for="credential-kind" class="bb:mb-1 bb:block bb:text-sm bb:font-medium">@L10n["Kind"]</label>
                                    <select id="credential-kind"
                                            name="Kind"
                                            class="bb:flex bb:h-9 bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-3 bb:py-1 bb:text-sm">
                                        @* On a validation redirect the submitted kind is echoed back, so
                                           the fix happens in the kind the operator actually chose. *@
                                        <option value="@GitCredentialKindTexts.HttpsToken"
                                                selected="@(SubmittedCredentialKind == GitCredentialKindTexts.HttpsToken)">@L10n["HTTPS token"]</option>
                                        <option value="@GitCredentialKindTexts.SshKey"
                                                selected="@(SubmittedCredentialKind == GitCredentialKindTexts.SshKey)">@L10n["SSH key"]</option>
                                    </select>
                                </div>
                                <div>
                                    <label for="credential-value" class="bb:mb-1 bb:block bb:text-sm bb:font-medium">@L10n["Value"]</label>
                                    <input id="credential-value"
                                           name="Value"
                                           type="password"
                                           required
                                           class="bb:flex bb:h-9 bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-3 bb:py-1 bb:text-sm"
                                           autocomplete="new-password"
                                           spellcheck="false" />
                                </div>
                                <div>
                                    <label for="credential-user-name" class="bb:mb-1 bb:block bb:text-sm bb:font-medium">@L10n["User name (HTTPS tokens, optional)"]</label>
                                    <input id="credential-user-name"
                                           name="UserName"
                                           type="text"
                                           class="bb:flex bb:h-9 bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-3 bb:py-1 bb:text-sm"
                                           autocomplete="off"
                                           spellcheck="false"
                                           placeholder="x-access-token" />
                                </div>
                            </div>
                            <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Default">@L10n["Create credential"]</BbButton>
                        </div>
                    </form>

                    @if (_credentials.Count == 0)
                    {
                        <BbEmpty Title="@L10n["No credentials configured"]"
                                 Description="@L10n["Create a credential above, then reference it from the projects that need it for cloning."]">
                            <Icon>
                                <LucideIcon Name="key-square" Class="bb:h-12 bb:w-12" />
                            </Icon>
                        </BbEmpty>
                    }
                    else
                    {
                        <div class="bb:mt-6 bb:overflow-x-auto">
                            <table class="bb:w-full bb:text-sm">
                                <thead>
                                    <tr class="bb:border-b bb:text-start bb:text-muted-foreground">
                                        <th class="bb:py-2 bb:pe-4 bb:font-medium">@L10n["Name"]</th>
                                        <th class="bb:py-2 bb:pe-4 bb:font-medium">@L10n["Kind"]</th>
                                        <th class="bb:py-2 bb:pe-4 bb:font-medium">@L10n["Created"]</th>
                                        <th class="bb:py-2 bb:pe-4 bb:font-medium">@L10n["Rotated"]</th>
                                        <th class="bb:py-2 bb:pe-4 bb:font-medium">@L10n["Updated"]</th>
                                        <th class="bb:py-2 bb:pe-4 bb:font-medium">@L10n["Used by"]</th>
                                        <th class="bb:py-2 bb:font-medium">@L10n["Manage"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var credential in _credentials)
                                    {
                                        <tr class="bb:border-b bb:align-middle" data-credential-id="@credential.Id">
                                            <td class="bb:py-3 bb:pe-4 bb:font-medium">@credential.Name</td>
                                            <td class="bb:py-3 bb:pe-4">@credential.Kind</td>
                                            <td class="bb:py-3 bb:pe-4">@credential.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC</td>
                                            <td class="bb:py-3 bb:pe-4">
                                                @(credential.RotatedAt is { } rotatedAt
                                                    ? rotatedAt.ToString("yyyy-MM-dd HH:mm") + " UTC"
                                                    : L10n["Never"])
                                            </td>
                                            <td class="bb:py-3 bb:pe-4">@credential.UpdatedAt.ToString("yyyy-MM-dd HH:mm") UTC</td>
                                            <td class="bb:py-3 bb:pe-4" data-credential-used-by="@credential.Id">
                                                @if (UsedBy(credential) is { Count: > 0 } users)
                                                {
                                                    <span class="bb:break-all">@string.Join(", ", users.Select(project => project.Name))</span>
                                                }
                                                else
                                                {
                                                    <span class="bb:text-muted-foreground">@L10n["No project"]</span>
                                                }
                                            </td>
                                            <td class="bb:py-3">
                                                <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-2">
                                                    <form method="post" action="/git-credentials/@credential.Id/rotate" data-zenkins-antiforgery class="bb:flex bb:flex-wrap bb:items-center bb:gap-2">
                                                        <input type="hidden" name="ProjectId" value="@_project.Id" />
                                                        <label for="rotate-kind-@credential.Id" class="bb:sr-only">@L10n["New kind for {0}", credential.Name]</label>
                                                        <select id="rotate-kind-@credential.Id"
                                                                name="Kind"
                                                                class="bb:h-8 bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-2 bb:text-xs">
                                                            <option value="@GitCredentialKindTexts.HttpsToken" selected="@(credential.Kind == GitCredentialKindTexts.HttpsToken)">@L10n["HTTPS token"]</option>
                                                            <option value="@GitCredentialKindTexts.SshKey" selected="@(credential.Kind == GitCredentialKindTexts.SshKey)">@L10n["SSH key"]</option>
                                                        </select>
                                                        <label for="rotate-value-@credential.Id" class="bb:sr-only">@L10n["New value for {0}", credential.Name]</label>
                                                        <input id="rotate-value-@credential.Id"
                                                               name="Value"
                                                               type="password"
                                                               required
                                                               class="bb:h-8 bb:w-40 bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-2 bb:py-1 bb:text-xs"
                                                               autocomplete="new-password"
                                                               spellcheck="false"
                                                               placeholder="@L10n["New value"]" />
                                                        <label for="rotate-user-@credential.Id" class="bb:sr-only">@L10n["New user name for {0}", credential.Name]</label>
                                                        <input id="rotate-user-@credential.Id"
                                                               name="UserName"
                                                               type="text"
                                                               class="bb:h-8 bb:w-28 bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-2 bb:py-1 bb:text-xs"
                                                               autocomplete="off"
                                                               spellcheck="false"
                                                               placeholder="@L10n["User name"]" />
                                                        <button type="submit"
                                                                class="bb:rounded-md bb:border bb:border-input bb:px-2 bb:py-1 bb:text-xs bb:hover:bg-accent">
                                                            @L10n["Rotate"]
                                                        </button>
                                                    </form>

                                                    <details class="bb:inline-block">
                                                        <summary class="bb:cursor-pointer bb:rounded-md bb:border bb:border-destructive/40 bb:px-2 bb:py-1 bb:text-xs bb:text-destructive">
                                                            @L10n["Delete…"]
                                                        </summary>
                                                        <form method="post" action="/git-credentials/@credential.Id/delete" data-zenkins-antiforgery class="bb:mt-2 bb:flex bb:flex-col bb:items-start bb:gap-1">
                                                            <input type="hidden" name="ProjectId" value="@_project.Id" />
                                                            <input type="hidden" name="Name" value="@credential.Name" />
                                                            <input type="hidden" name="ConfirmCredentialId" value="@credential.Id" />
                                                            @* Card F-018, the D-006 shape: a credential projects still
                                                               clone with is not deleted by a plain request. The
                                                               referencing projects are named here, and the delete only
                                                               goes through with the explicit confirmation. *@
                                                            @if (UsedBy(credential) is { Count: > 0 } referencing)
                                                            {
                                                                <span class="bb:text-xs bb:text-destructive">
                                                                    @L10n["Still used by {0}. Deleting it anyway leaves those projects with no credential.", UsedByLabel(referencing)]
                                                                </span>
                                                                <label class="bb:flex bb:items-center bb:gap-1 bb:text-xs">
                                                                    <input type="checkbox" name="ConfirmReferenced" value="true" />
                                                                    @L10n["Delete anyway"]
                                                                </label>
                                                            }
                                                            <span class="bb:text-xs bb:text-muted-foreground">
                                                                @L10n["Delete {0} permanently?", credential.Name]
                                                            </span>
                                                            <button type="submit"
                                                                    class="bb:rounded-md bb:border bb:border-destructive/40 bb:px-2 bb:py-1 bb:text-xs bb:text-destructive bb:hover:bg-destructive/10">
                                                                @L10n["Confirm delete"]
                                                            </button>
                                                        </form>
                                                    </details>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </BbCardContent>
            </BbCard>
        }
        }

        @if (_canDelete)
        {
            <BbCard>
                <BbCardHeader>
                    <BbCardTitle As="h2">@L10n["Danger zone"]</BbCardTitle>
                    <BbCardDescription>
                        @L10n["Deleting removes the project and its runs and webhooks. It requires the confirmation step and cannot be undone."]
                    </BbCardDescription>
                </BbCardHeader>
                <BbCardContent>
                    <BbButton Href="@($"/projects/{_project.Id}/delete/confirm")" Variant="ButtonVariant.Destructive">@L10n["Delete project…"]</BbButton>
                </BbCardContent>
            </BbCard>
        }
    }
</div>

@code {
    [Parameter]
    public Guid ProjectId { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    /// <summary>
    /// Card F-025: a poll outcome in words. Every fixed value has a sentence - a skip names the reason it
    /// skipped, because "nothing was built" is the answer an operator most needs - and a probe's own failure
    /// word falls through as itself (the closed <c>GitProbeOutcomes</c> vocabulary is already readable).
    /// </summary>
    private string? PollingOutcomeText(string? outcome) => outcome switch
    {
        null => null,
        Zenkins.Server.Polling.PollOutcomes.Queued => L10n["queued a run"],
        Zenkins.Server.Polling.PollOutcomes.Duplicate => L10n["already triggered by a webhook or an earlier poll"],
        Zenkins.Server.Polling.PollOutcomes.Unchanged => L10n["nothing moved"],
        Zenkins.Server.Polling.PollOutcomes.FirstSighting => L10n["recorded the current head (nothing queued yet)"],
        Zenkins.Server.Polling.PollOutcomes.SkippedDisabled => L10n["skipped: the project is disabled"],
        Zenkins.Server.Polling.PollOutcomes.SkippedQueueFull => L10n["skipped: the queue is at its cap"],
        Zenkins.Server.Polling.PollOutcomes.SkippedOverlap =>
            L10n["skipped: the concurrency limit is reached"],
        Zenkins.Server.Polling.PollOutcomes.NoRepository => L10n["skipped: no repository to poll"],
        Zenkins.Server.Polling.PollOutcomes.MissingCredential =>
            L10n["failed: the repository needs a credential and none is assigned"],
        _ => outcome,
    };

    private UserSessionInfo? _session;
    private ProjectView? _project;
    private bool _canDelete;
    private bool _canManageCredentials;
    private IReadOnlyList<WebhookView> _webhooks = [];
    private IReadOnlyList<GitCredentialListItem> _credentials = [];

    /// <summary>Card F-039: the project's notification endpoints, as the card lists them (never the secret).</summary>
    private IReadOnlyList<NotificationEndpointView> _notificationEndpoints = [];

    /// <summary>
    /// Card F-038: the saved policy evaluated against the project's current history - the card's counts, and the
    /// number the next sweep would delete. Null only when the project could not be read.
    /// </summary>
    private RetentionEvaluation? _retention;

    /// <summary>Card F-038: the same evaluation under the values the preview button posted (null when none was).</summary>
    private RetentionEvaluation? _retentionPreview;

    /// <summary>Card F-026: every edge that names this project, in either direction.</summary>
    private IReadOnlyList<ProjectLinkView> _links = [];

    /// <summary>Card F-026: the edges where another project's run queues a run of this one.</summary>
    private IReadOnlyList<ProjectLinkView> _upstreamLinks = [];

    /// <summary>Card F-026: the edges where this project's run queues a run of another one.</summary>
    private IReadOnlyList<ProjectLinkView> _downstreamLinks = [];

    /// <summary>Card F-026: the projects this one may be linked to (every other project of the organization).</summary>
    private IReadOnlyList<ProjectView> _chainTargets = [];

    /// <summary>Card F-018: the project's current assignment (which credential, by whom, when), or null.</summary>
    private GitCredentialAssignmentView? _assignment;

    /// <summary>Card F-018: per credential, the projects that clone with it (the delete's reference list).</summary>
    private IReadOnlyDictionary<Guid, IReadOnlyList<GitCredentialReferencingProject>> _usedByProjects =
        new Dictionary<Guid, IReadOnlyList<GitCredentialReferencingProject>>();

    [SupplyParameterFromQuery(Name = "notice")]
    private string? NoticeCode { get; set; }

    [SupplyParameterFromQuery(Name = "webhookError")]
    private string? WebhookErrorCode { get; set; }

    [SupplyParameterFromQuery(Name = "credentialError")]
    private string? CredentialErrorCode { get; set; }

    /// <summary>Cards F-028 + F-029: the stable code a refused disable reason or limits save redirected with.</summary>
    [SupplyParameterFromQuery(Name = "error")]
    private string? SettingsErrorCode { get; set; }

    /// <summary>Card F-024: the project's schedules, with their next due times and their last outcomes.</summary>
    private IReadOnlyList<ScheduleView> _schedules = [];

    /// <summary>Card F-024: the preview computed from the echoed expression and zone (null when none was asked).</summary>
    private SchedulePreview? _schedulePreview;

    /// <summary>Card F-024: the expression and zone the create form echoes back after a preview or a refusal.</summary>
    [SupplyParameterFromQuery(Name = "previewCron")]
    private string? PreviewCron { get; set; }

    [SupplyParameterFromQuery(Name = "previewZone")]
    private string? PreviewZone { get; set; }

    /// <summary>Card F-024: the values the create form shows (a preview keeps the operator's input).</summary>
    private string? SubmittedCron => PreviewCron;

    private string? SubmittedTimeZone => PreviewZone;

    /// <summary>Card F-039: the stable code a refused notification form redirected back with.</summary>
    [SupplyParameterFromQuery(Name = "notifyError")]
    private string? NotificationErrorCode { get; set; }

    /// <summary>Card F-039: <c>failed</c> when a test delivery did not arrive, with the receiver's words beside it.</summary>
    [SupplyParameterFromQuery(Name = "notifyTest")]
    private string? NotificationTestOutcome { get; set; }

    [SupplyParameterFromQuery(Name = "notifyDetail")]
    private string? NotificationTestDetail { get; set; }

    /// <summary>Card F-038: the stable code a refused retention save redirected back with.</summary>
    [SupplyParameterFromQuery(Name = "retentionError")]
    private string? RetentionErrorCode { get; set; }

    /// <summary>Card F-038: the keep count the preview button echoed back (present-but-empty means "not set").</summary>
    [SupplyParameterFromQuery(Name = "retentionPreviewKeep")]
    private string? PreviewKeep { get; set; }

    /// <summary>Card F-038: the day window the preview button echoed back (present-but-empty means "not set").</summary>
    [SupplyParameterFromQuery(Name = "retentionPreviewDays")]
    private string? PreviewDays { get; set; }

    /// <summary>Card F-026: the chain form's outcome code (<c>saved</c>, <c>deleted</c>, a refusal).</summary>
    [SupplyParameterFromQuery(Name = "links")]
    private string? LinkCode { get; set; }

    /// <summary>Card F-026: the service's sentence for a refused edge - the closing path lives here.</summary>
    [SupplyParameterFromQuery(Name = "reason")]
    private string? LinkReason { get; set; }

    [SupplyParameterFromQuery(Name = "credentialName")]
    private string? SubmittedCredentialName { get; set; }

    [SupplyParameterFromQuery(Name = "credentialKind")]
    private string? SubmittedCredentialKind { get; set; }

    /// <summary>Card F-039: the refusal a notification form redirected back with, in words.</summary>
    private string? NotificationMessage => NotificationErrorCodes.MessageFor(NotificationErrorCode, L10n);

    /// <summary>Card F-039: why the last test delivery failed, as the receiver (or the transport) said it.</summary>
    private string? NotificationTestFailure =>
        string.Equals(NotificationTestOutcome, "failed", StringComparison.Ordinal)
            ? NotificationTestDetail ?? L10n["the receiver did not accept it"]
            : null;

    /// <summary>Card F-038: the refusal a retention save redirected back with, in words.</summary>
    private string? RetentionMessage => RetentionErrorCodes.MessageFor(RetentionErrorCode, L10n);

    /// <summary>Card F-038: the keep field's value - the preview echo when there is one, otherwise what is stored.</summary>
    private string SubmittedKeep => PreviewKeep
        ?? _retention?.Policy.Keep?.ToString(CultureInfo.InvariantCulture)
        ?? string.Empty;

    /// <summary>Card F-038: the day field's value, on the same rule as <see cref="SubmittedKeep"/>.</summary>
    private string SubmittedDays => PreviewDays
        ?? _retention?.Policy.Days?.ToString(CultureInfo.InvariantCulture)
        ?? string.Empty;

    /// <summary>
    /// Card F-038: a policy in the words the card uses - "every build (no rule set)", or the union of the two
    /// rules that are set. Not "0 rules": a blank field is a rule that keeps everything, and the card has to say
    /// which rules are actually doing the work.
    /// </summary>
    private string RetentionRuleText(RetentionPolicy policy)
    {
        if (policy.IsUnset)
        {
            return L10n["every build (no rule set)"];
        }

        var rules = new List<string>(2);
        if (policy.Keep is { } keep)
        {
            rules.Add(L10n["the newest {0} build(s) of each branch", keep]);
        }

        if (policy.Days is { } days)
        {
            rules.Add(L10n["builds newer than {0} day(s)", days]);
        }

        return string.Join(" " + L10n["and"] + " ", rules);
    }

    /// <summary>Card F-038: one echoed field as a number, blank as "not set", garbage as "not set" too.</summary>
    private static int? ParseOptionalCount(string? text) =>
        int.TryParse(text, NumberStyles.Integer, CultureInfo.InvariantCulture, out var parsed) && parsed >= 0
            ? parsed
            : null;

    /// <summary>
    /// Card F-026: what the chain form says. A refusal renders the service's own sentence (which carries the
    /// path a cycle would close, or that the pair is already linked), because "not saved" alone leaves the
    /// reader with nothing to change.
    /// </summary>
    private string? ChainMessage => LinkCode switch
    {
        null => null,
        "saved" => null,
        "deleted" => null,
        "target-required" => L10n["Choose the project to link."],
        "refused" => string.IsNullOrWhiteSpace(LinkReason) ? L10n["The link was not accepted."] : LinkReason,
        _ => L10n["The link was not accepted."],
    };

    private string? ChainNotice => LinkCode switch
    {
        "saved" => L10n["The link was saved. Its edges are listed below."],
        "deleted" => L10n["The link was removed; the runs it already queued stay."],
        _ => null,
    };

    private string? Notice => NoticeCode switch
    {
        // F-017's webhook outcomes (the endpoints PRG here since the form moved to this tab).
        "webhook-enabled" => L10n["The webhook is enabled."],
        "webhook-disabled" => L10n["The webhook is disabled; its URL now answers like an unknown one."],
        "webhook-deleted" => L10n["The webhook was deleted."],
        // F-028's trigger brake and F-029's limits.
        "project-disabled" =>
            L10n["The project is disabled: every trigger is refused and the runs that were still waiting were canceled."],
        "project-enabled" =>
            L10n["The project is enabled. Triggers queue runs again; canceled runs stay canceled and nothing was replayed."],
        "limits-saved" => L10n["The project's limits were saved."],
        // F-039's notification endpoints.
        "notification-added" => L10n["The endpoint was added. The next terminal state notifies it."],
        "notification-deleted" => L10n["The endpoint was removed, together with any delivery it still owed."],
        "notification-enabled" => L10n["The endpoint is enabled: new terminal states notify it."],
        "notification-disabled" =>
            L10n["The endpoint is disabled. A delivery it already owed is still attempted; nothing new is created."],
        "notification-rotated" =>
            L10n["The secret was rotated. Deliveries already owed are signed with the secret they were created under, so a receiver that has not been updated yet can still verify them."],
        "notification-test-delivered" =>
            L10n["The test delivery was accepted by the receiver. The endpoint's last-delivery column now says so."],
        // F-038's retention policy.
        "retention-saved" =>
            L10n["The retention policy was saved. The next sweep applies it; nothing was deleted now."],
        // F-031's switch.
        "post-failure-on" =>
            L10n["A failed post step now fails the run. This applies to runs claimed from now on."],
        "post-failure-off" =>
            L10n["A failed post step no longer fails the run: it is recorded as its own failed step and the page explains that the result is unchanged."],
        // F-025's polling card.
        "polling-saved" => L10n["The polling settings were saved."],
        // F-024's schedules.
        ScheduleEndpoints.NoticeCreated =>
            L10n["The schedule was saved. Its first due time is the next one the expression names."],
        ScheduleEndpoints.NoticeDeleted => L10n["The schedule was deleted; the runs it already queued stay."],
        ScheduleEndpoints.NoticeEnabled => L10n["The schedule is enabled again."],
        ScheduleEndpoints.NoticeDisabled =>
            L10n["The schedule is paused: every due time it passes is recorded as skipped, and nothing is queued."],
        ScheduleEndpoints.NoticeQueueAnyway =>
            L10n["The schedule now queues anyway when a run of this project is still in flight (the queue cap still applies)."],
        ScheduleEndpoints.NoticeSkipOverlap =>
            L10n["The schedule skips a due time while a run of this project is still queued or running."],
        // D-003's credential outcomes.
        GitCredentialEndpoints.NoticeCreated => L10n["The Git credential was created."],
        GitCredentialEndpoints.NoticeRotated => L10n["The Git credential was rotated; the previous value is no longer stored."],
        GitCredentialEndpoints.NoticeDeleted => L10n["The Git credential was deleted."],
        // F-018's assignment outcomes.
        GitCredentialEndpoints.NoticeAttached =>
            L10n["The credential is attached. Runs of this project now clone with it, fetched from the server."],
        GitCredentialEndpoints.NoticeDetached =>
            L10n["The credential is detached. Runs of this project now clone without one."],
        _ => null,
    };

    /// <summary>The field-level error the webhook create form redirected back with (F-017).</summary>
    private string? WebhookMessage => WebhookErrorCodes.MessageFor(WebhookErrorCode, L10n);

    /// <summary>
    /// Cards F-028 + F-029: the refusal a disable or limits save redirected back with. The code is the
    /// request's only echo, so an unknown code still says something rather than rendering as a no-op.
    /// </summary>
    private string? SettingsMessage =>
        SettingsErrorCode is null
            ? null
            : ProjectErrorCodes.MessageFor(SettingsErrorCode, L10n)
                ?? ScheduleErrorCodes.MessageFor(SettingsErrorCode, L10n)
                ?? L10n["The change was not accepted."];

    /// <summary>
    /// The field-level error a credential form redirected back with. The value never travels in a
    /// query, so the only echo this page can render is the name and the kind.
    /// </summary>
    private string? CredentialMessage =>
        GitCredentialErrorCodes.MessageFor(CredentialErrorCode, L10n)
        ?? (CredentialErrorCode is null ? null : L10n["The credential was not accepted."]);

    /// <summary>
    /// The delivery URL as the operator has to paste it. Absolute when the request carried a base URI, so
    /// a copy from the page is usable; a relative path if the host could not resolve one.
    /// </summary>
    private string EndpointUrl(WebhookView webhook) =>
        Navigation.BaseUri is { Length: > 0 } baseUri
            ? baseUri.TrimEnd('/') + webhook.EndpointPath
            : webhook.EndpointPath;

    /// <summary>The branch patterns, spelling out the default when the filter is empty.</summary>
    private string BranchLabel(WebhookView webhook) =>
        webhook.BranchPatterns.Count == 0
            ? L10n["project default ({0})", _project?.DefaultBranch ?? "-"]
            : string.Join(", ", webhook.BranchPatterns);

    protected override async Task OnInitializedAsync()
    {
        // Establish the circuit tenant before the tenant-filtered lookup.
        _session = await UserSession.GetAsync();
        _canDelete = _session?.CanManageActiveOrganization == true;
        _canManageCredentials = _canDelete;

        if (_session?.HasOrganization != true)
        {
            return;
        }

        _project = await ProjectsService.GetProjectAsync(ProjectId);
        if (_project is null)
        {
            SetNotFound();
            return;
        }

        // F-026: the chain card. The links are this project's edges in both directions; the targets are
        // every other project of the organization, which is what the add form offers. Both reads go
        // through the tenant filter, so another organization's projects are simply not there.
        _links = await LinkService.GetForProjectAsync(ProjectId);
        _upstreamLinks = [.. _links.Where(link => link.DownstreamProjectId == ProjectId)];
        _downstreamLinks = [.. _links.Where(link => link.UpstreamProjectId == ProjectId)];
        _chainTargets = [.. (await ProjectsService.GetProjectsAsync()).Where(project => project.Id != ProjectId)];

        // F-038: the retention card. The saved policy is evaluated against the current history, so the counts
        // and the "next sweep deletes" number are the sweep's own answer; a preview runs the same evaluation
        // under the values the button posted and stores nothing.
        var retentionPolicy = await RetentionGate.GetPolicyAsync(ProjectId) ?? new RetentionPolicy(null, null);
        _retention = await RetentionGate.EvaluateAsync(ProjectId, retentionPolicy, Clock.GetUtcNow());
        if (PreviewKeep is not null || PreviewDays is not null)
        {
            _retentionPreview = await RetentionGate.EvaluateAsync(
                ProjectId,
                new RetentionPolicy(ParseOptionalCount(PreviewKeep), ParseOptionalCount(PreviewDays)),
                Clock.GetUtcNow());
        }

        // F-039: the notification endpoints (read for every member; writes are Owner-only in the service).
        _notificationEndpoints = await Notifications.ListForProjectAsync(ProjectId) ?? [];

        // F-017: the project's webhooks (any member of the organization may manage them). The
        // service re-checks membership; a failure here just leaves the list empty.
        if (_session is { HasOrganization: true } session)
        {
            var webhooks = await WebhookManagement.GetWebhooksAsync(session.UserId, ProjectId);
            _webhooks = webhooks.Webhooks;
        }

        // F-024: the schedules card. Any member of the organization may read and manage them (like the
        // webhooks above); the preview is computed here from the values a preview/refusal echoed back, so it
        // reads like the save that follows rather than like a client-side guess.
        if (_session is { HasOrganization: true } scheduler)
        {
            var schedules = await ScheduleManagement.ListAsync(scheduler.UserId, ProjectId);
            _schedules = schedules.Schedules;
        }

        if (!string.IsNullOrWhiteSpace(PreviewCron) || !string.IsNullOrWhiteSpace(PreviewZone))
        {
            _schedulePreview = SchedulePreview.Compute(PreviewCron, PreviewZone, Clock.GetUtcNow(), L10n);
        }

        // D-003: credentials are listed only for an Owner. The page gate above is the first half,
        // the service's Owner check the second; a Member's list answer is the Forbidden result and
        // the page renders no names (the same asymmetry stance the secrets page keeps).
        if (_canManageCredentials && _session is { HasOrganization: true } owner)
        {
            var credentials = await CredentialService.ListForProjectAsync(owner.UserId, ProjectId);
            if (credentials.Status == GitCredentialMutationStatus.Success)
            {
                _credentials = credentials.Items;
                _assignment = credentials.Assignment;
                _usedByProjects = credentials.UsedByProjects
                    ?? new Dictionary<Guid, IReadOnlyList<GitCredentialReferencingProject>>();
            }
        }
    }

    /// <summary>Card F-018: the projects that clone with <paramref name="credential"/> (empty when none).</summary>
    private IReadOnlyList<GitCredentialReferencingProject> UsedBy(GitCredentialListItem credential) =>
        _usedByProjects.TryGetValue(credential.Id, out var projects) ? projects : [];

    /// <summary>The referencing projects as prose: names, or "N projects" past a readable handful.</summary>
    private string UsedByLabel(IReadOnlyList<GitCredentialReferencingProject> projects)
    {
        const int shown = 5;
        var names = string.Join(", ", projects.Take(shown).Select(project => project.Name));
        return projects.Count > shown
            ? L10n["{0} and {1} more project(s)", names, projects.Count - shown]
            : names;
    }

    /// <summary>
    /// When the assignment was made, in the page's UTC format - or the honest "not recorded" for an
    /// assignment that predates the attribution columns (a database seeded before F-018).
    /// </summary>
    private string FormatAssignedAt(GitCredentialAssignmentView assignment) =>
        assignment.AssignedAt is { } assignedAt
            ? assignedAt.ToString("yyyy-MM-dd HH:mm") + " UTC"
            : L10n["Not recorded"];

    /// <summary>
    /// Card F-024: one UTC due instant in the schedule's own zone, so an operator can check the expression
    /// against the wall clock they configured it for. An unknown zone (a row written out of band) shows the UTC
    /// time alone rather than inventing a local one.
    /// </summary>
    private string LocalTime(DateTimeOffset utc, string? timeZone) =>
        ScheduleEvaluator.TryResolveZone(timeZone, out var zone)
            ? $"{TimeZoneInfo.ConvertTime(utc, zone):yyyy-MM-dd HH:mm} {timeZone}"
            : L10n["local time unknown"];

    /// <summary>Card F-024: the badge colour an outcome reads with: queued is good, a skip is neutral, a miss warns.</summary>
    private static BadgeVariant OutcomeVariant(string outcome) => outcome switch
    {
        ScheduleOutcomes.Queued => BadgeVariant.Default,
        ScheduleOutcomes.Missed => BadgeVariant.Destructive,
        _ => BadgeVariant.Secondary,
    };

    /// <summary>Card F-026: the flag in words - what a reader needs, not the column name.</summary>
    private string OnlyOnSuccessText(bool onlyOnSuccess) => onlyOnSuccess
        ? L10n["only on success"]
        : L10n["on any terminal state"];

    /// <summary>Card F-026: which branch the downstream builds, in the policy's own words.</summary>
    private string BranchPolicyText(ProjectLinkView link) =>
        link.BranchPolicy == ProjectLinkBranchPolicies.DefaultBranch
            ? L10n["builds {0}'s default branch", link.DownstreamProjectName]
            : L10n["builds the branch {0} built", link.UpstreamProjectName];

    /// <summary>
    /// A real 404 for a foreign or missing id. The status-code-pages middleware must not re-execute
    /// /not-found in this same request: the component renderer already owns the NavigationManager,
    /// and re-execution fails with "already initialized" (F-003 bug B1). The HTTP response is
    /// therefore a bodyless 404; NotFoundPage above covers circuit navigation.
    /// </summary>
    private void SetNotFound()
    {
        if (HttpContext is null)
        {
            return;
        }

        HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
        if (HttpContext.Features.Get<IStatusCodePagesFeature>() is { } statusCodePages)
        {
            statusCodePages.Enabled = false;
        }
    }
}
