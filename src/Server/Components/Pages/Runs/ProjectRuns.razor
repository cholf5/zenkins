@page "/projects/{ProjectId:guid}/runs"
@attribute [Authorize]
@inject UserSession UserSession
@inject ProjectService ProjectsService
@inject RunService RunsService

<PageTitle>@L10n["Runs"] · @(_project?.Name ?? L10n["Project"]) · Zenkins</PageTitle>

<div class="bb:mx-auto bb:w-full bb:max-w-4xl bb:space-y-6">
    @if (_project is null)
    {
        @* Foreign tenant id == missing id: the service reads through the tenant filter and the
           response is a real 404 (same pattern as the project detail page, IStatusCodePagesFeature
           disabled so /not-found is not re-executed into the component request). *@
        <NotFoundPage />
    }
    else
    {
        <div class="bb:flex bb:flex-wrap bb:items-center bb:justify-between bb:gap-3">
            <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-3">
                <BbCardTitle As="h1" tabindex="-1">@L10n["Runs"] · @_project.Name</BbCardTitle>
                @if (BranchFilter is { Length: > 0 } filtered)
                {
                    @* F-023: the branch filter is a real query parameter on this route, so a branch
                       link is a deep link that reloads, shares and goes back/forward. *@
                    <BbBadge Variant="BadgeVariant.Secondary">@L10n["Branch: {0}", filtered]</BbBadge>
                    <a href="@($"/projects/{_project.Id}/runs")"
                       class="bb:text-sm bb:font-medium bb:underline bb:underline-offset-4">@L10n["Show all branches"]</a>
                }
                else
                {
                    <BbBadge Variant="BadgeVariant.Outline">@_project.DefaultBranch</BbBadge>
                }
                @* F-028: the history stays readable while the project is disabled - and the badge says
                   why no new run appeared. *@
                @if (_project.Disabled)
                {
                    <BbBadge Variant="BadgeVariant.Destructive">@L10n["Disabled"]</BbBadge>
                }
            </div>
            <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-2">
                @* D-003: the "Project" button became the Overview tab in the strip below; the Start
                   run affordance stays (the form lives on the Overview tab). *@
                <BbButton Href="@($"/projects/{_project.Id}")" Variant="ButtonVariant.Default">@L10n["Start run"]</BbButton>
            </div>
        </div>

        <ProjectTabs ProjectId="@_project.Id" Active="runs" />

        <BbCard>
            <BbCardHeader>
                <BbCardTitle As="h2">@L10n["Build runs"]</BbCardTitle>
                <BbCardDescription>
                    @L10n["Every execution of this project's pipeline, newest first. Workers pull queued runs through an atomic claim; a claimed run must be accepted inside its lease window."]
                </BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                @if (_runs.Count == 0)
                {
                    <BbEmpty Title="@L10n["No runs yet"]"
                             Description="@L10n["Start a run from the project page; it waits in the queue until an eligible worker claims it."]">
                        <Icon>
                            <LucideIcon Name="play" Class="bb:h-12 bb:w-12" />
                        </Icon>
                    </BbEmpty>
                }
                else
                {
                    @* D-002: one clock instant per render, exactly like the dashboard takes - two
                       rows on this page must never disagree about "now" when showing elapsed time. *@
                    var now = DateTimeOffset.UtcNow;
                    <ul class="bb:divide-y">
                        @foreach (var run in _runs)
                        {
                            <li class="bb:flex bb:flex-wrap bb:items-center bb:justify-between bb:gap-3 bb:py-3">
                                <div class="bb:min-w-0">
                                    <p class="bb:font-medium">
                                        <a href="/projects/@run.ProjectId/runs/@run.Number" class="bb:underline bb:underline-offset-4">@L10n["Run #{0}", run.Number]</a>
                                        <span class="bb:ml-2 bb:font-normal bb:text-muted-foreground">
                                            @* F-014: a run is a pipeline execution on a branch, not a command line.
                                               F-023: the branch itself filters this page, so a branch job's
                                               history is one click away (and only that branch's runs). *@
                                            @if (run.GitBranch.Length > 0)
                                            {
                                                <a href="@($"/projects/{_project.Id}/runs?branch={Uri.EscapeDataString(run.GitBranch)}")"
                                                   class="bb:underline bb:underline-offset-4">@run.GitBranch</a>
                                            }
                                            else
                                            {
                                                <span>@run.GitBranch</span>
                                            }
                                            · @run.PipelinePath
                                            @if (run.PipelineName is { } pipelineName)
                                            {
                                                <span> · @pipelineName</span>
                                            }
                                        </span>
                                    </p>
                                    <p class="bb:text-xs bb:text-muted-foreground">
                                        @(run.TriggerUserEmail ?? run.TriggerType)
                                        @if (run.WorkerName is { } workerName)
                                        {
                                            <span> · @workerName</span>
                                        }
                                    </p>
                                </div>
                                <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-2 bb:text-xs bb:text-muted-foreground">
                                    <RunStatusBadge Status="@run.Status" />
                                    @* D-002: the same duration display the dashboard shows - a finished
                                       run's duration, or live elapsed while it is still running. *@
                                    <span>@RunDisplay.DurationOrElapsed(run.StartedAt, run.EndedAt, now, L10n)</span>
                                    <span>@run.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC</span>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </BbCardContent>
        </BbCard>
    }
</div>

@code {
    [Parameter]
    public Guid ProjectId { get; set; }

    /// <summary>
    /// F-023: show only one branch's runs. Blank means the whole project. The value is a query
    /// parameter, never a route segment, so the unfiltered page's route is unchanged.
    /// </summary>
    [SupplyParameterFromQuery(Name = "branch")]
    private string? BranchFilter { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private UserSessionInfo? _session;
    private ProjectView? _project;
    private IReadOnlyList<RunView> _runs = [];

    protected override async Task OnInitializedAsync()
    {
        // F-003 hazard: resolving the session selects the circuit's tenant before any tenant-owned
        // row is read. Never rely on the layout having done it first.
        _session = await UserSession.GetAsync();
        if (_session?.HasOrganization != true)
        {
            return;
        }

        _project = await ProjectsService.GetProjectAsync(ProjectId);
        if (_project is null)
        {
            SetNotFound();
            return;
        }

        // F-023: project + branch + tenant. The service scopes all three, so a same-named branch in
        // another project of the same organization can never appear here.
        _runs = await RunsService.GetProjectRunsAsync(ProjectId, BranchFilter);
    }

    private void SetNotFound()
    {
        if (HttpContext is null)
        {
            return;
        }

        // A real 404 for a foreign or missing id. The status-code-pages middleware must not
        // re-execute /not-found in this same request: the component renderer already owns the
        // NavigationManager, and re-execution fails with "already initialized" (F-003 bug B1).
        HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
        if (HttpContext.Features.Get<IStatusCodePagesFeature>() is { } statusCodePages)
        {
            statusCodePages.Enabled = false;
        }
    }
}
