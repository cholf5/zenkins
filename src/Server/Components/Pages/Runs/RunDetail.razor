@page "/runs/{RunId:guid}"
@page "/projects/{ProjectId:guid}/runs/{Number:int}"
@attribute [Authorize]
@using Zenkins.Server.Artifacts
@using Zenkins.Shared.Artifacts
@using Zenkins.Shared.Pipelines
@using Zenkins.Shared.Projects
@using Zenkins.Server.Runs
@inject UserSession UserSession
@inject RunService RunsService
@inject RunLogAccess RunLogAccess
@inject ArtifactService ArtifactsService

@* Card F-036: one page, two shapes. `/runs/{guid}` stays exactly as it was (every bookmark, every log
   hub ticket, every PRG target), and `/projects/{id}/runs/{number}` renders the same run under the name
   people actually use. The number route resolves the run inside the project, so a foreign project id is
   the same 404 a missing number is. *@
<PageTitle>@RunHeading · Zenkins</PageTitle>

<div class="bb:mx-auto bb:w-full bb:max-w-3xl bb:space-y-6">
    @if (_run is null)
    {
        @* Foreign tenant id == missing id: the service reads through the tenant filter and the
           response is a real 404 (same pattern as the project detail page). *@
        <NotFoundPage />
    }
    else
    {
        <div class="bb:flex bb:flex-wrap bb:items-center bb:justify-between bb:gap-3">
            <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-3">
                <BbCardTitle As="h1" tabindex="-1">@RunHeading</BbCardTitle>
                <RunStatusBadge Status="@_run.Status" />
                @* F-028: the project's trigger brake, visible from the run that was in flight when it
                   happened - the run itself is untouched. *@
                @if (_run.ProjectDisabled == true)
                {
                    <BbBadge Variant="BadgeVariant.Destructive">Project disabled</BbBadge>
                }
            </div>
            <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-2">
                @* F-009: cancel is offered while the run can still be stopped. A Queued run is
                   canceled atomically; a Running run gets a cancel request the worker acts on.
                   The POST is form-bound (antiforgery), a terminal run answers a friendly no-op
                   notice instead of an error. *@
                @if (_run.Status is BuildRunStatus.Queued or BuildRunStatus.Running)
                {
                    <form method="post" action="@($"/runs/{_run.Id}/cancel")" data-zenkins-antiforgery>
                        <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Destructive">Cancel run</BbButton>
                    </form>
                }

                @* Card F-037: two intents, two buttons - a rebuild keeps the original's inputs (the commit
                   it pinned included) and a replay re-runs the definition text that run carried. Both are
                   forms because both are POSTs (antiforgery), and both are offered only when the service
                   would really accept them (`RunReruns` is the single predicate). *@
                @if (_run.CanRebuild)
                {
                    <form method="post" action="@($"/runs/{_run.Id}/rebuild")" data-zenkins-antiforgery>
                        <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Outline">Rebuild</BbButton>
                    </form>
                }
                @if (_run.CanReplay)
                {
                    <form method="post" action="@($"/runs/{_run.Id}/replay")" data-zenkins-antiforgery>
                        <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Outline">Replay</BbButton>
                    </form>
                }
                else if (_run.IsTerminal)
                {
                    @* The AC's "the button's tooltip says why it is absent": replay only exists where the
                       run's snapshot IS its definition. *@
                    <button type="button" id="run-replay-unavailable" disabled
                            title="Replay re-runs a run's own definition text. This run stores the pipeline spec its worker produced, not the source that produced it, so there is nothing to replay - use Rebuild, which re-runs the commit this run pinned."
                            class="bb:cursor-not-allowed bb:rounded-md bb:border bb:border-input bb:px-3 bb:py-1.5 bb:text-sm bb:text-muted-foreground">
                        Replay
                    </button>
                }
                <BbButton Href="@($"/projects/{_run.ProjectId}/runs")" Variant="ButtonVariant.Outline">All runs</BbButton>
            </div>
        </div>

        @* Card F-036: the run's permanent address. What a person reads is the name they would say out loud
           (`#12`); the href is the permalink it belongs to. The guid route keeps working beside it (F-036's
           AC), so this is the canonical link, not the only one. *@
        <p id="run-permalink" class="bb:text-sm bb:text-muted-foreground">
            Permalink
            <a href="@Permalink" class="bb:underline bb:underline-offset-4">@PermalinkText</a>
        </p>

        @* Card F-037: which run this one came from, linked by number (the guid is the fallback when the
           original's row is gone, which is honest rather than a dead link that looks like ours). *@
        @if (_run.RebuiltFromRunId is { } originId)
        {
            var verb = _run.TriggerType == BuildRunTriggerType.Replay ? "replayed from" : "rebuilt from";
            <p id="run-rebuilt-from" class="bb:text-sm bb:text-muted-foreground">
                This run is @verb
                @if (_run.RebuiltFromNumber is { } originNumber)
                {
                    <a id="run-rebuilt-from-link" href="@($"/projects/{_run.ProjectId}/runs/{originNumber}")"
                       class="bb:font-medium bb:text-primary bb:hover:underline">#@originNumber</a><span>.</span>
                }
                else
                {
                    <span class="bb:font-mono">@originId.ToString("N")[..8]</span>
                    <span>(the original run's row is gone, so its number cannot be resolved).</span>
                }
            </p>
        }

        @if (Notice is { } notice)
        {
            <div role="status" class="bb:rounded-md bb:border bb:border-input bb:bg-muted bb:p-3 bb:text-sm">
                <p>@notice</p>
            </div>
        }

        @* Card F-037: a refused rebuild/replay says why, in the run's own words (the PRG carries only the
           stable code; this map turns it into a sentence). *@
        @if (RerunError is { } rerunError)
        {
            <div id="run-rerun-error" role="alert"
                 class="bb:rounded-md bb:border bb:border-destructive/40 bb:bg-destructive/10 bb:p-3 bb:text-sm">
                <p class="bb:font-medium bb:text-destructive">Nothing was queued.</p>
                <p>@rerunError</p>
            </div>
        }

        @* Card F-037's "Rebuild with parameters…": one form, defaults prefilled from the original, and the
           same validation the trigger form uses (the service resolves the values against today's
           definitions). Rendered only when the run can be rebuilt and really carried parameters. *@
        @if (_run.CanRebuild && _run.Parameters is { Count: > 0 } rebuildParameters)
        {
            <details id="run-rebuild-parameters" class="bb:rounded-md bb:border bb:border-input bb:p-3">
                <summary class="bb:cursor-pointer bb:text-sm bb:font-medium">Rebuild with parameters…</summary>
                <form method="post" action="@($"/runs/{_run.Id}/rebuild")" data-zenkins-antiforgery
                      class="bb:mt-3 bb:space-y-3">
                    <p class="bb:text-xs bb:text-muted-foreground">
                        The values this run was triggered with are prefilled; edit what a rebuild should
                        differ in. Everything else - branch, commit, tags, timeout and the definition -
                        still comes from run #@_run.Number.
                    </p>
                    @foreach (var (name, value) in rebuildParameters.OrderBy(pair => pair.Key, StringComparer.Ordinal))
                    {
                        <div>
                            <label for="@($"rebuild-parameter-{name}")" class="bb:mb-1 bb:block bb:text-sm bb:font-medium">@name</label>
                            @if (IsPasswordParameter(name))
                            {
                                @* F-041: the original's value is sealed, so the form cannot prefill it - and must
                                   not, since prefilling a mask and re-submitting it would set the password to
                                   "***". Empty means "keep the original". *@
                                <input id="@($"rebuild-parameter-{name}")"
                                       name="@($"Parameters[{name}]")"
                                       type="password"
                                       autocomplete="new-password"
                                       class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:p-2 bb:text-sm" />
                                <p class="bb:mt-1 bb:text-xs bb:text-muted-foreground">
                                    Leave empty to rebuild with the same password; type a new one to replace it.
                                </p>
                            }
                            else
                            {
                                <input id="@($"rebuild-parameter-{name}")"
                                       name="@($"Parameters[{name}]")"
                                       value="@value"
                                       class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:p-2 bb:text-sm" />
                            }
                        </div>
                    }
                    <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Default">Rebuild with these parameters</BbButton>
                </form>
            </details>
        }

        @* F-028 / TC-002: a run that was already executing when its project was disabled keeps running
           (stopping work in flight is a separate decision), so the page says why nothing new is queuing
           instead of leaving the operator to guess. *@
        @if (_run.ProjectDisabled == true)
        {
            <div id="run-project-disabled" role="status"
                 class="bb:rounded-md bb:border bb:border-input bb:bg-muted bb:p-3 bb:text-sm">
                <p>
                    This run's project is disabled, so nothing new is queued for it.
                    @if (_run.Status is BuildRunStatus.Queued or BuildRunStatus.Running)
                    {
                        <span>This run keeps running to its own end - disabling a project does not stop work in flight.</span>
                    }
                    else
                    {
                        <span>This run's own history is unchanged.</span>
                    }
                </p>
            </div>
        }

        @* D-004's failure surface: when the run failed, the reason, the exit code and the failing
           step are the first thing on the page - no scrolling, no expanding. A run that failed
           before any step could run says that instead of inventing a step. *@
        @if (_run.Status == BuildRunStatus.Failed)
        {
            <div id="run-failure" role="alert"
                 class="bb:rounded-md bb:border bb:border-destructive/40 bb:bg-destructive/10 bb:p-3 bb:text-sm">
                <p id="run-failure-title" class="bb:font-medium bb:text-destructive">This run failed.</p>
                <dl class="bb:mt-2 bb:space-y-1">
                    <div class="bb:flex bb:gap-2">
                        <dt class="bb:text-muted-foreground">Reason</dt>
                        <dd id="run-failure-reason" class="bb:break-all">@(_run.FailureReason ?? "-")</dd>
                    </div>
                    @* F-018: the code above is the recorded value; this line is what it means. A rejected
                       or missing credential is explained here in words, instead of leaving the operator
                       with a bare git-auth-rejected. *@
                    @if (FailureExplanation is { Length: > 0 } explanation)
                    {
                        <div class="bb:flex bb:gap-2">
                            <dt class="bb:text-muted-foreground">What happened</dt>
                            <dd id="run-failure-explanation">@explanation</dd>
                        </div>
                    }
                    <div class="bb:flex bb:gap-2">
                        <dt class="bb:text-muted-foreground">Exit code</dt>
                        <dd id="run-failure-exit-code">@(_run.ExitCode?.ToString() ?? "-")</dd>
                    </div>
                    <div class="bb:flex bb:gap-2">
                        <dt class="bb:text-muted-foreground">Failing step</dt>
                        <dd id="run-failure-step" class="bb:break-all">@FailingStepText()</dd>
                    </div>
                    @* Card F-037's wording: a rebuild pins a commit, and if the remote no longer has it nothing
                       can be checked out. Saying so is the difference between "git failed" and "this rebuild
                       cannot work until the commit is back" - and it states the deliberate part too: the
                       branch head is NOT built as a fallback. *@
                    @if (RebuildCommitNotice is { } rebuildNotice)
                    {
                        <div class="bb:flex bb:gap-2">
                            <dt class="bb:text-muted-foreground">Rebuild</dt>
                            <dd id="run-rebuild-commit-notice">@rebuildNotice</dd>
                        </div>
                    }
                </dl>
            </div>
        }

        <BbCard>
            <BbCardHeader>
                <BbCardTitle As="h2">Pipeline</BbCardTitle>
                <BbCardDescription>
                    @*F-020*@ A Freestyle run has no branch, pipeline file or commit - the card says
                    what it executed and where its steps came from. A Pipeline run's card is the
                    branch and pipeline file this run executed, the exact commit the worker resolved,
                    and the frozen step list it ran. The steps come from the spec frozen before the
                    first one started, so a later commit never changes what this run shows.
                </BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                <dl class="bb:grid bb:grid-cols-1 bb:gap-4 bb:text-sm bb:sm:grid-cols-3">
                    <div>
                        <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">Source</dt>
                        <dd id="run-branch" class="bb:break-all">
                            @(_run.Pipeline is not null && string.IsNullOrEmpty(_run.GitBranch)
                                ? "Freestyle steps, frozen at trigger time"
                                : _run.GitBranch)
                        </dd>
                    </div>
                    <div>
                        <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">Pipeline path</dt>
                        <dd id="run-pipeline-path" class="bb:break-all">
                            @(_run.PipelinePath.Length == 0 ? "-" : _run.PipelinePath)
                        </dd>
                    </div>
                    <div>
                        <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">Git commit</dt>
                        <dd id="run-git-commit" class="bb:break-all">@(_run.GitCommit ?? "-")</dd>
                    </div>
                    @* F-018: which credential the clone had, never the material. "No credential assigned"
                       is a fact the owner needs (a private repository cannot clone without one, and the
                       worker does not borrow the host's), and it explains the failure above. *@
                    <div>
                        <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">Git credential</dt>
                        <dd id="run-git-credential">
                            @switch (_run.GitCredentialAssigned)
                            {
                                case true:
                                    <span>The project's assigned credential; fetched by the worker for this run.</span>
                                    break;
                                case false:
                                    <span class="bb:text-muted-foreground">
                                        No credential is assigned to this project, so this run cloned without one.
                                    </span>
                                    break;
                                default:
                                    <span class="bb:text-muted-foreground">Unknown (the project could not be read).</span>
                                    break;
                            }
                        </dd>
                    </div>
                </dl>

                @if (_run.Pipeline is { } pipeline)
                {
                    <p class="bb:mt-4 bb:text-sm">
                        <span class="bb:font-medium">Pipeline:</span> <span id="run-pipeline-name">@pipeline.Name</span>
                        <span class="bb:text-muted-foreground">(@pipeline.Steps.Length step(s))</span>
                    </p>
                    @* F-015: every declared step with the state the worker recorded for it, or Pending when
                       it has not been reached - so a page opened mid-run shows completed, current and
                       pending steps (the frozen spec is the list, the step rows are the states). *@
                    <ol id="run-steps" class="bb:mt-2 bb:space-y-3 bb:text-sm">
                        @foreach (var step in _run.StepList)
                        {
                            <li id="@($"run-step-{step.Name}")" class="bb:break-all">
                                <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-2">
                                    <span class="bb:text-xs bb:text-muted-foreground">@step.Index.</span>
                                    <span class="bb:font-medium">@step.Name</span>
                                    <BbBadge Variant="@StepBadgeVariant(step.Status)">@step.Status</BbBadge>
                                    @if (step.ExitCode is { } exitCode)
                                    {
                                        <span class="bb:text-xs bb:text-muted-foreground">exit @exitCode</span>
                                    }
                                    @if (step.Duration is { } duration)
                                    {
                                        <span class="bb:text-xs bb:text-muted-foreground">@RunDisplay.FormatDuration(duration)</span>
                                    }
                                    @* F-032: how many attempts the step made, when it made more than one -
                                       the count lives on the one row the step has, so the page never grows a
                                       second row per attempt (the frozen spec's step identity stays 1:1). *@
                                    @if (step.Attempts > 1)
                                    {
                                        <span id="@($"run-step-attempts-{step.Name}")" class="bb:text-xs bb:text-muted-foreground">attempts @step.Attempts</span>
                                    }
                                    @if (step.FailureReason is { } reason)
                                    {
                                        <span class="bb:text-xs bb:text-muted-foreground">@StepReasonText(reason)</span>
                                    }
                                    @* D-004: selecting a step jumps to the log filtered to that step.
                                       The fragment brings the panel into view; the handler pushes the
                                       step row's id down into the panel's filter (StepId, never text).
                                       data-enhance-nav="none" keeps the jump a native same-document
                                       fragment scroll - enhanced navigation would re-initialize the
                                       page and throw away the panel's pause/search state. A step
                                       without a recorded row has no id to filter on, so it offers no
                                       link. *@
                                    @if (step.Id is { } stepRowId)
                                    {
                                        <a id="@($"run-step-log-{step.Name}")" href="#run-log"
                                           data-enhance-nav="none"
                                           class="bb:text-xs bb:font-medium bb:text-primary bb:hover:underline"
                                           @onclick="@(() => FilterLogToStep(stepRowId))">View log</a>
                                    }
                                </div>
                                @if (step.Index <= pipeline.Steps.Length)
                                {
                                    <code class="bb:text-xs bb:text-muted-foreground">@string.Join(' ', pipeline.Steps[step.Index - 1].Argv)</code>
                                }
                            </li>
                        }
                    </ol>
                }
                else
                {
                    <p id="run-steps-pending" class="bb:mt-4 bb:text-sm bb:text-muted-foreground">
                        No pipeline definition was reported for this run.
                    </p>
                }

                @if (_run.RequiredTags.Length > 0)
                {
                    <p class="bb:mt-3 bb:text-sm bb:text-muted-foreground">
                        Required tags: @string.Join(", ", _run.RequiredTags)
                    </p>
                }
                else
                {
                    <p class="bb:mt-3 bb:text-sm bb:text-muted-foreground">No required tags.</p>
                }

                @* Card F-033: the requirement in the form a person reads (`linux and arm64`), never the stored
                   DNF - and for a queued run nobody can claim, what no known Worker carries. Atom-level
                   wording on purpose: a boolean requirement has no single "missing label". *@
                @if (_run.RequiredRequirementText is { Length: > 0 } requirementText)
                {
                    <p id="run-requirement" class="bb:mt-2 bb:text-sm">
                        Needs a Worker with: @requirementText
                    </p>
                }

                @if (_run.MissingWorkerLabels is { Count: > 0 } missing)
                {
                    <p id="run-requirement-waiting" class="bb:mt-2 bb:text-sm bb:text-muted-foreground">
                        Queued - no known Worker has: @string.Join(", ", missing)
                    </p>
                }
            </BbCardContent>
        </BbCard>

        @* F-021: what this run was triggered with. Values are the run's own snapshot - editing the
           project's definitions now never changes this card - and they are deliberately visible:
           parameters are configuration, not secrets. *@
        @if (_run.Parameters is { Count: > 0 } parameters)
        {
            <BbCard>
                <BbCardHeader>
                    <BbCardTitle As="h2">Build parameters</BbCardTitle>
                    <BbCardDescription>
                        The values this run was triggered with, frozen at trigger time. Every step read
                        them as environment variables under these names.
                    </BbCardDescription>
                </BbCardHeader>
                <BbCardContent>
                    <dl id="run-parameters" class="bb:grid bb:grid-cols-1 bb:gap-3 bb:text-sm bb:sm:grid-cols-2">
                        @foreach (var (name, value) in parameters.OrderBy(pair => pair.Key, StringComparer.Ordinal))
                        {
                            var typed = ParameterDetail(name);
                            <div>
                                <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">
                                    @name
                                    @if (typed is not null)
                                    {
                                        <span class="bb:ml-1 bb:font-normal">(@ParameterTypeLabel(typed.Type))</span>
                                    }
                                </dt>
                                @if (typed is not null && typed.Type == ProjectParameterTypes.Password)
                                {
                                    @* F-041: the stored value is already the mask, so this renders what the row
                                       holds - a second, display-only mask would be one more place to get wrong. *@
                                    <dd id="@($"run-parameter-{name}")" class="bb:font-mono">@(value.Length == 0 ? "(empty)" : value)</dd>
                                }
                                else if (typed is not null && typed.Type == ProjectParameterTypes.Run)
                                {
                                    <dd id="@($"run-parameter-{name}")" class="bb:font-mono">
                                        @if (typed.RunId is { } selectedRunId)
                                        {
                                            <a href="@($"/runs/{selectedRunId}")" class="bb:underline bb:underline-offset-4">#@value</a>
                                        }
                                        else
                                        {
                                            <span>#@value</span>
                                        }
                                        @if (typed.Commit is { Length: >= 7 } commit)
                                        {
                                            <span class="bb:ml-2 bb:text-xs bb:text-muted-foreground">@commit[..7]</span>
                                        }
                                    </dd>
                                }
                                else if (typed is not null && typed.Type == ProjectParameterTypes.File)
                                {
                                    @* F-041: the uploaded file's run-relative location. Deliberately no link: the
                                       bytes live on the worker and the only route that serves them is
                                       worker-authenticated - a file parameter may be a secret. *@
                                    <dd id="@($"run-parameter-{name}")" class="bb:break-all bb:font-mono">
                                        @(value.Length == 0 ? "(no file uploaded)" : value)
                                    </dd>
                                    <p class="bb:mt-1 bb:text-xs bb:text-muted-foreground">
                                        Written on the worker inside this run's own directory; not downloadable.
                                    </p>
                                }
                                else
                                {
                                    <dd id="@($"run-parameter-{name}")" class="bb:whitespace-pre-wrap bb:break-all bb:font-mono">@(value.Length == 0 ? "(empty)" : value)</dd>
                                }
                            </div>
                        }
                    </dl>
                </BbCardContent>
            </BbCard>
        }

        @* F-034: the organization environment this run was queued with. Read from the run's own snapshot,
           so deleting or editing an organization variable never rewrites history - and the values are shown:
           they are configuration, not secrets (which is why this card carries no masking). *@
        @if (_run.Environment is { Count: > 0 } environment)
        {
            <BbCard>
                <BbCardHeader>
                    <BbCardTitle As="h2">Organization environment</BbCardTitle>
                    <BbCardDescription>
                        The organization variables this run was queued with, frozen at trigger time. Editing
                        or deleting one afterwards does not change this run - every step of it read these
                        values.
                    </BbCardDescription>
                </BbCardHeader>
                <BbCardContent>
                    <dl id="run-environment" class="bb:grid bb:grid-cols-1 bb:gap-3 bb:text-sm bb:sm:grid-cols-2">
                        @foreach (var (name, value) in environment.OrderBy(pair => pair.Key, StringComparer.Ordinal))
                        {
                            <div>
                                <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">@name</dt>
                                <dd id="@($"run-environment-{name}")" class="bb:whitespace-pre-wrap bb:break-all bb:font-mono">@value</dd>
                            </div>
                        }
                    </dl>
                </BbCardContent>
            </BbCard>
        }

        <BbCard>
            <BbCardHeader>
                <BbCardTitle As="h2">Execution</BbCardTitle>
                <BbCardDescription>PRD §3.5 run metadata.</BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                <dl id="run-details" class="bb:grid bb:grid-cols-1 bb:gap-4 bb:text-sm bb:sm:grid-cols-3">
                    <div>
                        <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">Worker</dt>
                        <dd id="run-worker">@(_run.WorkerName ?? "-")</dd>
                    </div>
                    <div>
                        <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">Triggered by</dt>
                        <dd id="run-trigger">@(_run.TriggerUserEmail ?? "-") (@_run.TriggerType.ToLowerInvariant())</dd>
                    </div>
                    <div>
                        <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">Exit code</dt>
                        <dd id="run-exit-code">@(_run.ExitCode?.ToString() ?? "-")</dd>
                    </div>
                    <div>
                        <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">Started</dt>
                        <dd id="run-started">@(_run.StartedAt?.ToString("yyyy-MM-dd HH:mm:ss") ?? "-") UTC</dd>
                    </div>
                    <div>
                        <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">Ended</dt>
                        <dd id="run-ended">@(_run.EndedAt?.ToString("yyyy-MM-dd HH:mm:ss") ?? "-") UTC</dd>
                    </div>
                    <div>
                        <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">Duration</dt>
                        @* D-002: the shared display bit - a finished run's duration, live elapsed
                           while it is still running, "-" when it never started. *@
                        <dd id="run-duration">@RunDisplay.DurationOrElapsed(_run.StartedAt, _run.EndedAt, DateTimeOffset.UtcNow)</dd>
                    </div>
                    <div>
                        <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">Queued</dt>
                        <dd>@_run.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss") UTC</dd>
                    </div>
                    <div>
                        <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">Timeout</dt>
                        <dd id="run-timeout">@(FormatTimeout(_run.TimeoutSeconds))</dd>
                    </div>
                    <div>
                        <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">Deadline</dt>
                        <dd id="run-deadline">@(_run.DeadlineAt?.ToString("yyyy-MM-dd HH:mm:ss") ?? "-") UTC</dd>
                    </div>
                    <div>
                        <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">Failure reason</dt>
                        <dd>@(_run.FailureReason ?? "-")</dd>
                    </div>
                    <div>
                        <dt class="bb:text-xs bb:font-medium bb:text-muted-foreground">Run id</dt>
                        <dd class="bb:break-all">@_run.Id</dd>
                    </div>
                </dl>
            </BbCardContent>
        </BbCard>
        @* F-016: what the run published. Only a finalized (Ready) artifact has a download link; a
           Pending/Incomplete one is listed with its state instead, so the page never offers a file that
           is not actually there. *@
        <BbCard>
            <BbCardHeader>
                <BbCardTitle As="h2">Artifacts</BbCardTitle>
                <BbCardDescription>
                    The build products this run published (PRD §3.7). A single file downloads as itself; a
                    directory downloads as a zip that restores the same tree.
                </BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                @if (_artifacts.Count == 0)
                {
                    <p id="run-artifacts-empty" class="bb:text-sm bb:text-muted-foreground">
                        This run published no artifacts.
                    </p>
                }
                else
                {
                    <ul id="run-artifacts" class="bb:space-y-3 bb:text-sm">
                        @foreach (var artifact in _artifacts)
                        {
                            <li id="@($"run-artifact-{artifact.Name}")" class="bb:flex bb:flex-wrap bb:items-center bb:gap-2">
                                <span class="bb:font-medium bb:break-all">@artifact.Name</span>
                                <BbBadge Variant="BadgeVariant.Secondary">@artifact.Kind</BbBadge>
                                @if (artifact.FileCount > 0)
                                {
                                    <span class="bb:text-xs bb:text-muted-foreground">
                                        @artifact.FileCount file(s), @FormatBytes(artifact.TotalBytes)
                                    </span>
                                }
                                @if (artifact.CanDownload)
                                {
                                    <BbButton Href="@($"/runs/{_run.Id}/artifacts/{artifact.Id}/download")"
                                              Variant="ButtonVariant.Outline">Download</BbButton>
                                }
                                else
                                {
                                    <span class="bb:text-xs bb:text-muted-foreground">@artifact.Status</span>
                                }
                            </li>
                        }
                    </ul>
                }
            </BbCardContent>
        </BbCard>

        @* The run's log (F-008): live while the run executes, full history once it is finished.
           The ticket below is minted for this session and lets the panel's server-side
           HubConnection authenticate to the browser hub (a circuit cannot replay the cookie).
           D-004: the step list and the panel share the filter state - this page holds it, the
           step list writes it, the panel reads it and reports its own changes back. *@
        <RunLogPanel RunId="@_run.Id" Ticket="@_accessTicket" Steps="@_run.StepList"
                     RequestedStepId="@_logStepFilter" StepFilterChanged="OnLogStepFilterChanged" />
    }
</div>

@code {
    /// <summary>
    /// Card F-041: one parameter's own type on this run, from the run's record - empty for a run triggered before
    /// the column existed, where every parameter is a plain string.
    /// </summary>
    private RunParameterDetail? ParameterDetail(string name) =>
        _run?.ParameterDetails is { } details && details.TryGetValue(name, out var detail) ? detail : null;

    /// <summary>Whether this run's <paramref name="name"/> parameter is a password (its value is the mask).</summary>
    private bool IsPasswordParameter(string name) =>
        ParameterDetail(name) is { } detail && ProjectParameterTypes.IsMasked(detail.Type);

    /// <summary>The type as a person reads it, in the run page's parameter list.</summary>
    private static string ParameterTypeLabel(string type) => type switch
    {
        ProjectParameterTypes.Password => "password",
        ProjectParameterTypes.Run => "run",
        ProjectParameterTypes.GitRef => "git ref",
        ProjectParameterTypes.File => "file",
        _ => type,
    };

    /// <summary>The guid route (F-003's original, still the PRG target of every trigger).</summary>
    [Parameter]
    public Guid RunId { get; set; }

    /// <summary>
    /// Card F-036: the number route's project id. Set only when the page was reached as
    /// <c>/projects/{id}/runs/{number}</c>; the pair is what resolves the run, so a foreign project id is
    /// the same 404 a missing number is.
    /// </summary>
    [Parameter]
    public Guid? ProjectId { get; set; }

    /// <summary>Card F-036: the build number from the number route.</summary>
    [Parameter]
    public int? Number { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private RunView? _run;

    /// <summary>
    /// The page's heading: <c>Run #N</c> whenever the run has a number (card F-036's "everything
    /// human-facing shows #N"), and the short id only for a row no writer ever numbered.
    /// </summary>
    private string RunHeading => _run is null
        ? "Run"
        : _run.Number is { } number ? $"Run #{number}" : $"Run {_run.Id.ToString("N")[..8]}";

    /// <summary>Card F-036: the run's canonical permalink, relative so the page works on any host.</summary>
    private string Permalink => _run is null
        ? string.Empty
        : _run.Number is { } number
            ? $"/projects/{_run.ProjectId}/runs/{number}"
            : $"/runs/{_run.Id}";

    /// <summary>
    /// What the permalink line shows: the build number (`#12`), because that is the name a person says out
    /// loud - the address is the link, not the label. A row with no number falls back to its path, which is
    /// the only thing that identifies it.
    /// </summary>
    private string PermalinkText => _run?.Number is { } number ? $"#{number}" : Permalink;

    /// <summary>The subscription ticket the log panel presents to the browser hub. Only minted for
    /// a member session after the run itself was readable - the page is the only minter.</summary>
    private string? _accessTicket;

    /// <summary>What the run published (card F-016): every artifact row, with only Ready ones downloadable.</summary>
    private IReadOnlyList<ArtifactView> _artifacts = [];

    /// <summary>
    /// The step the log panel is narrowed to (card D-004): written by the step list's "View log"
    /// links and by the panel's own dropdown (through <see cref="OnLogStepFilterChanged"/>, so
    /// picking the same step twice still applies). The value is the step row's id - the same
    /// StepId the worker stamps on the log lines - never a text match.
    /// </summary>
    private Guid? _logStepFilter;

    [SupplyParameterFromQuery(Name = "notice")]
    private string? NoticeCode { get; set; }

    /// <summary>Card F-037: the stable code a refused rebuild (or replay) redirected back with.</summary>
    [SupplyParameterFromQuery(Name = "rebuildError")]
    private string? RebuildErrorCode { get; set; }

    [SupplyParameterFromQuery(Name = "replayError")]
    private string? ReplayErrorCode { get; set; }

    /// <summary>
    /// Card F-037: the refusal in words. The code is all the redirect can carry, so every code the service
    /// can answer has a sentence here - including the parameter codes, which are the trigger form's own
    /// vocabulary (the re-run re-resolves the original's values against today's definitions).
    /// </summary>
    private string? RerunError => (RebuildErrorCode ?? ReplayErrorCode) switch
    {
        RunErrorCodes.RebuildNotTerminal =>
            "This run had not finished, so there was nothing to rebuild or replay.",
        RunErrorCodes.RebuildNoCommit =>
            "This run recorded no commit, so a rebuild could not pin one and would build whatever the "
            + "branch points at now. Start a fresh run instead.",
        RunErrorCodes.RebuildKindChanged =>
            "The project's kind no longer matches the run's, so this run cannot be re-executed as the "
            + "project is now.",
        RunErrorCodes.RebuildSpecUnavailable =>
            "The definition this run executed is not readable any more, so there is nothing to re-execute.",
        RunErrorCodes.RebuildCredentialMissing =>
            "The Git credential assigned to this project no longer exists. Assign one on the project's "
            + "settings tab, then rebuild.",
        RunErrorCodes.ReplayUnavailable =>
            "This run stores the pipeline spec its worker produced, not the source that produced it, so it "
            + "cannot be replayed as a definition. Use Rebuild instead.",
        RunErrorCodes.ParameterUnknown =>
            "One of the run's parameter names is no longer defined on this project, so it cannot be "
            + "re-executed with the same values.",
        RunErrorCodes.ParameterInvalid =>
            "One of the run's parameter values does not fit its type any more (the definition changed).",
        RunErrorCodes.FieldInvalid =>
            "That request could not be read, so nothing was queued. Try again.",
        ProjectTriggerRefusals.ProjectDisabled =>
            "This project is disabled, so nothing new is queued for it.",
        ProjectTriggerRefusals.QueueFull =>
            "The project's queue is full, so the rebuild waits its turn in the project's settings.",
        _ => null,
    };

    /// <summary>
    /// Card F-037: what a rebuild's git failure means. Only a re-run that pinned a commit can hit it, and the
    /// sentence names the commit and the number it came from instead of leaving the operator to guess why a
    /// build the remote used to serve cannot clone.
    /// </summary>
    private string? RebuildCommitNotice
    {
        get
        {
            if (_run is null || _run.RebuiltFromRunId is null)
            {
                return null;
            }

            if (_run.FailureReason is not { } reason
                || !reason.StartsWith("git-", StringComparison.Ordinal))
            {
                return null;
            }

            if (_run.GitCommit is not { } commit)
            {
                return null;
            }

            var origin = _run.RebuiltFromNumber is { } originNumber
                ? $"#{originNumber}"
                : _run.RebuiltFromRunId.Value.ToString("N")[..8];
            return $"This run pinned commit {commit} - the commit run {origin} built - and the remote could "
                + "not provide it. A rewritten history removes commits; the branch head is deliberately not "
                + "built in its place. Rebuild the newer run instead, or restore the commit.";
        }
    }

    private string? Notice => NoticeCode switch
    {
        // F-009's cancel outcomes (PRG): a cancel that landed, a cancel the worker is acting on,
        // and the friendly no-op for a run that had already finished.
        "canceled" => "The run was canceled.",
        "cancel-requested" => "The worker has been asked to cancel the run; the status updates when the worker reports.",
        "already-finished" => "The run had already finished, so it was not changed.",
        _ => null,
    };

    protected override async Task OnInitializedAsync()
    {
        // F-003 hazard: resolving the session selects the circuit's tenant before any tenant-owned
        // row is read. Never rely on the layout having done it first.
        var session = await UserSession.GetAsync();
        if (session?.HasOrganization != true)
        {
            return;
        }

        _run = await ResolveRunAsync();
        if (_run is null && HttpContext is not null)
        {
            // A real 404 for a foreign or missing id; the /not-found re-execute is disabled for
            // this request (F-003 bug B1: "RemoteNavigationManager already initialized").
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
            if (HttpContext.Features.Get<IStatusCodePagesFeature>() is { } statusCodePages)
            {
                statusCodePages.Enabled = false;
            }
        }

        // A readable run of the active organization: mint the panel's subscription ticket for this
        // session. The hub re-validates membership at join time, so a stale ticket buys nothing.
        if (_run is not null && session.Organization is { } organization)
        {
            _accessTicket = RunLogAccess.MintTicket(session.UserId, organization.OrganizationId);
            _artifacts = await ArtifactsService.GetRunArtifactsAsync(_run.Id);
        }
    }

    /// <summary>
    /// Card F-036: the two routes resolve the same run. The number route looks it up inside its project
    /// (a foreign project id answers null, so no existence oracle), and the guid route keeps doing exactly
    /// what it always did - both then render the same page and act on <see cref="RunView.Id"/>, so the
    /// cancel/rebuild forms and the log panel never depend on which URL was opened.
    /// </summary>
    private Task<RunView?> ResolveRunAsync() =>
        Number is { } number && ProjectId is { } projectId
            ? RunsService.GetRunByNumberAsync(projectId, number)
            : RunsService.GetRunAsync(RunId);

    /// <summary>
    /// F-018: the run's failure reason in words (empty for a reason a page cannot translate). The
    /// credential question is answered from the project's current assignment, so a rejection reads as
    /// "no credential is assigned" when that is the reason a clone could not authenticate.
    /// </summary>
    private string FailureExplanation => _run is null
        ? string.Empty
        : RunDisplay.FailureReasonText(_run.FailureReason, _run.GitCredentialAssigned);

    /// <summary>The per-run timeout display: the override in minutes, or the server default.</summary>
    private static string FormatTimeout(int? timeoutSeconds) => timeoutSeconds is { } seconds
        ? $"{seconds / 60} min (per-run override)"
        : "default";

    /// <summary>D-004: the step list's "View log" link pushes the step row's id into the panel's filter.</summary>
    private void FilterLogToStep(Guid stepId) => _logStepFilter = stepId;

    /// <summary>D-004: the panel reports its own dropdown's changes back, so the page's copy of the
    /// filter and the panel's stay one state (and re-selecting the same step still applies).</summary>
    private Task OnLogStepFilterChanged(Guid? stepId)
    {
        _logStepFilter = stepId;
        return Task.CompletedTask;
    }

    /// <summary>
    /// D-004's failure surface: the failing step by name (with its exit code), or the honest
    /// statement that no step failed - a run can fail in the definition phase, before any step ran.
    /// </summary>
    private string FailingStepText()
    {
        if (_run is null)
        {
            return "-";
        }

        var failing = _run.StepList.FirstOrDefault(step => step.Status == PipelineStepStatus.Failed);
        if (failing is null)
        {
            return "No recorded step failed (the run ended before a step could).";
        }

        return failing.ExitCode is { } exitCode
            ? $"{failing.Index}. {failing.Name} (exit {exitCode})"
            : $"{failing.Index}. {failing.Name}";
    }

    /// <summary>A step's state as a badge (card F-015). Pending is the declared-but-not-reached state.</summary>
    private static BadgeVariant StepBadgeVariant(string status) => status switch
    {
        PipelineStepStatus.Running => BadgeVariant.Default,
        PipelineStepStatus.Success => BadgeVariant.Success,
        PipelineStepStatus.Failed => BadgeVariant.Destructive,
        PipelineStepStatus.Skipped => BadgeVariant.Outline,
        _ => BadgeVariant.Secondary,
    };

    /// <summary>
    /// A step's failure/skip reason in words; the stored value is a closed code (card F-015). Every code the
    /// vocabulary defines has a sentence here - the three cancel-ish values are worded so the page tells them
    /// apart (a step killed by a user cancel, a step that a canceled run never reached, and a step killed by the
    /// run's deadline) - and an unknown code still renders as itself rather than as nothing.
    /// </summary>
    private static string StepReasonText(string reason) => reason switch
    {
        PipelineStepFailureReasons.WhenNotMatched => "its when condition did not match",
        PipelineStepFailureReasons.PreviousStepFailed => "an earlier step failed",
        PipelineStepFailureReasons.RunCanceled => "the run was canceled before this step",
        PipelineStepFailureReasons.Canceled => "the run was canceled by a user",
        PipelineStepFailureReasons.TimedOut => "the run's deadline passed",
        PipelineStepFailureReasons.StepTimeout => "its own timeout passed",
        PipelineStepFailureReasons.NotStarted => "the process could not be started",
        PipelineStepFailureReasons.SecretUnavailable => "a secret could not be resolved",
        PipelineStepFailureReasons.ArtifactPathRejected => "an artifact path was refused",
        PipelineStepFailureReasons.ArtifactFailed => "an artifact could not be published",
        _ => reason,
    };

    /// <summary>A stored size as prose ("1.5 MB"); the row stores bytes, people read units.</summary>
    private static string FormatBytes(long bytes) => ArtifactLimits.FormatBytes(bytes);
}
