@implements IAsyncDisposable
@inject NavigationManager Navigation
@inject ILogger<RunLogPanel> Logger
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.Extensions.Logging
@using Zenkins.Server.LogStreaming
@using Zenkins.Server.Runs
@using Zenkins.Shared.LogStreaming

@* The run's live log (card F-008) with its control surface (card D-004). The page mints a
   subscription ticket for the signed-in session and passes it in; this component connects the
   server-side HubConnection to the browser hub in the same process, joins the run's group, and
   appends lines as they arrive. Stderr lines are visually distinguished by color.
   D-004 adds the client-side controls: pause freezes the VIEWPORT (the stream keeps arriving and
   being persisted; resuming jumps to the tail), literal case-insensitive search with a match count
   and next/previous, a per-step filter keyed on the lines' StepId (never text), and a stated render
   cap - the download link is the way to get everything. All decisions live in RunLogViewModel; this
   component renders the plan and forwards the user's intent. *@
<div id="run-log" class="bb:space-y-3">
    <BbCard>
        <BbCardHeader>
            <div class="bb:flex bb:items-center bb:justify-between bb:gap-3">
                <div>
                    <BbCardTitle As="h2">@L10n["Log"]</BbCardTitle>
                    <BbCardDescription>
                        @L10n["Streamed from the worker while the run executes; stderr is shown in red."]
                    </BbCardDescription>
                </div>
                <a id="run-log-download"
                   class="bb:text-sm bb:font-medium bb:text-primary bb:hover:underline"
                   href="@DownloadUrl">@L10n["Download full log"]</a>
            </div>
        </BbCardHeader>
        <BbCardContent>
            @if (_connectionError is not null)
            {
                <p id="run-log-error" role="alert" class="bb:text-sm bb:text-destructive">
                    @_connectionError
                </p>
            }
            @if (_connectionClosed)
            {
                @* WithAutomaticReconnect gives up after its bounded retry budget; without a
                   manual restart the panel would stay frozen on whatever it had (review fix F6). *@
                <div class="bb:flex bb:items-center bb:gap-3">
                    <BbButton Variant="ButtonVariant.Default" Size="ButtonSize.Small" OnClick="ReconnectAsync">
                        @L10n["Reconnect"]
                    </BbButton>
                    <span class="bb:text-sm bb:text-muted-foreground">@L10n["Reattach the live log stream."]</span>
                </div>
            }
            @* D-004's control surface. Every control below writes into the view model and re-plans;
               none of them reaches the server, so none of them can pause a build. *@
            <div id="run-log-controls" class="bb:flex bb:flex-wrap bb:items-center bb:gap-2">
                <BbButton id="run-log-pause"
                          Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                          OnClick="TogglePauseAsync">
                    @(Plan.IsPaused ? L10n["Resume"] : L10n["Pause"])
                </BbButton>
                <span id="run-log-follow-state" role="status" class="bb:text-xs bb:text-muted-foreground">
                    @Plan.Indicator
                </span>
                <span class="bb:flex bb:items-center bb:gap-1">
                    <input id="run-log-search" type="search" placeholder="@L10n["Search this log"]"
                           class="bb:h-8 bb:w-44 bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-2 bb:text-sm"
                           @bind="_search" @bind:event="oninput" @bind:after="ApplySearchAsync" />
                    <BbButton id="run-log-search-previous"
                              Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                              Disabled="@(Plan.MatchCount == 0)"
                              OnClick="PreviousMatchAsync">
                        @L10n["Previous"]
                    </BbButton>
                    <BbButton id="run-log-search-next"
                              Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                              Disabled="@(Plan.MatchCount == 0)"
                              OnClick="NextMatchAsync">
                        @L10n["Next"]
                    </BbButton>
                </span>
                <span id="run-log-search-summary" role="status" class="bb:text-xs bb:text-muted-foreground">
                    @Plan.SearchSummary
                </span>
                @if (Plan.CurrentMatchIndex > 0)
                {
                    @* Next/Previous left the tail; this is the way back (the same jump Resume does). *@
                    <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" OnClick="JumpToTailAsync">
                        @L10n["Back to latest"]
                    </BbButton>
                }
                <select id="run-log-step-filter"
                        aria-label="@L10n["Filter the log to one step"]"
                        class="bb:h-8 bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-2 bb:text-sm"
                        value="@(Plan.StepFilter?.ToString() ?? "")"
                        @onchange="OnStepFilterSelectedAsync">
                    <option value="">@L10n["All steps"]</option>
                    @foreach (var step in Steps ?? [])
                    {
                        @if (step.Id is { } stepId)
                        {
                            var lines = Plan.StepCounts.GetValueOrDefault(stepId);
                            <option value="@stepId.ToString()">
                                @step.Index. @step.Name · @(lines == 0 ? L10n["no output"] : lines == 1 ? L10n["{0} line", lines] : L10n["{0} lines", lines])
                            </option>
                        }
                        else
                        {
                            @* A step the run has not reached yet: no row, no id, nothing to filter on. *@
                            <option disabled>
                                @step.Index. @step.Name · @L10n["not started"]
                            </option>
                        }
                    }
                </select>
                <BbButton id="run-log-timestamps"
                          Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                          OnClick="ToggleTimestampsAsync"
                          aria-pressed="@(_showTimestamps ? "true" : "false")">
                    @L10n["Timestamps (UTC)"]
                </BbButton>
                <BbButton id="run-log-wrap"
                          Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                          OnClick="ToggleWrapAsync"
                          aria-pressed="@(_wrap ? "true" : "false")">
                    @L10n["Wrap lines"]
                </BbButton>
            </div>
            @if (Plan.IsCapped)
            {
                @* D-004's stated bound: the cap is said out loud, and the download is named as the
                   way to get everything. *@
                <p id="run-log-cap" class="bb:text-xs bb:text-muted-foreground">@Plan.CapNotice</p>
            }
            @if (Plan.RetentionNotice is { } retentionNotice)
            {
                @* F-047's second, independent bound: what the viewer keeps at all. The download is
                   still the complete record. *@
                <p id="run-log-retention" class="bb:text-xs bb:text-muted-foreground">@retentionNotice</p>
            }
            @if (Plan.DroppedWhilePausedNotice is { } droppedWhilePaused)
            {
                <p id="run-log-paused-loss" class="bb:text-xs bb:text-muted-foreground">@droppedWhilePaused</p>
            }
            @if (Plan.TotalLines == 0)
            {
                <p id="run-log-empty" class="bb:text-sm bb:text-muted-foreground">
                    @(_connecting ? L10n["Connecting to the log stream…"] : L10n["No output was captured for this run."])
                </p>
            }
            else if (Plan.EmptyMessage is { } emptyMessage)
            {
                @* A selected step that produced no output, or a search that matched nothing: the
                   panel says so instead of showing silence. *@
                <p id="run-log-filter-empty" class="bb:text-sm bb:text-muted-foreground">
                    @emptyMessage
                </p>
            }
            else
            {
                @* One block per line (F-047): the old <pre> of inline spans rendered every step's
                   output as one wrapped line. RunConsoleLines owns the block/stream/match markup;
                   this panel owns the scroll container and the wrap toggle. *@
                <div id="run-log-scroll" class="zk-console-scroll">
                    <div id="run-log-lines" class="zk-console-body @(_wrap ? "zk-console-wrap" : null)">
                        <RunConsoleLines Entries="Plan.Entries"
                                         ShowTimestamps="_showTimestamps"
                                         CurrentMatchSeq="Plan.CurrentMatchSeq"
                                         StepClicked="FilterToStep" />
                    </div>
                </div>
            }
        </BbCardContent>
    </BbCard>
</div>

@code {
    [Parameter]
    public Guid RunId { get; set; }

    /// <summary>The subscription ticket minted by the page for this session. Null (or stale) means
    /// the panel renders without connecting.</summary>
    [Parameter]
    public string? Ticket { get; set; }

    /// <summary>
    /// The run's steps in declaration order (card F-015), used to turn a line's <c>StepId</c> into the header
    /// that names the step whose segment the line belongs to, and to fill the step filter's options.
    /// </summary>
    [Parameter]
    public IReadOnlyList<RunStepView>? Steps { get; set; }

    /// <summary>
    /// The step the page asked the panel to show (D-004: selecting a step in the run's step list
    /// jumps to the log filtered to that step). Null = all steps. Applied to the view model whenever
    /// it differs from the filter the panel is already on.
    /// </summary>
    [Parameter]
    public Guid? RequestedStepId { get; set; }

    /// <summary>Reports the panel's own filter changes back to the page, so a step the user picked in
    /// the dropdown and a step the page pushed stay one state (picking the same step twice still applies).</summary>
    [Parameter]
    public EventCallback<Guid?> StepFilterChanged { get; set; }

    private readonly RunLogViewModel _viewModel = new();
    private HubConnection? _connection;
    private bool _connecting;
    private bool _connectionClosed;
    private string? _connectionError;

    /// <summary>Everything the panel renders for the current instant, computed by the view model.
    /// <see cref="Replan"/> refreshes it whenever the state behind the controls changes.</summary>
    private RunLogPlan? _plan;

    /// <summary>
    /// The plan the markup renders. It is built on demand rather than assumed to exist: the circuit
    /// renders this panel once while <see cref="OnInitializedAsync"/> is awaiting the log hub - a
    /// render that happens <em>before</em> <see cref="OnParametersSet"/> runs - and a null plan there
    /// failed the whole page (the run page's ErrorBoundary). The view model holds no lines at that
    /// point, which is exactly the empty shell the panel should show; the localizer is already
    /// injected, so the copy is resolved in the same language as the rest of the page.
    /// </summary>
    private RunLogPlan Plan => _plan ??= _viewModel.Plan(BuildStepHeaders(), L10n);

    /// <summary>The search box's text, live-bound; the view model commits it on every keystroke.</summary>
    private string _search = string.Empty;

    /// <summary>Whether the console page's initial <c>?step=</c> filter has been applied.</summary>
    private bool _requestedStepApplied;

    /// <summary>Whether each line carries its UTC time of day (F-047's optional column).</summary>
    private bool _showTimestamps;

    /// <summary>Whether long lines wrap instead of scrolling horizontally (F-047's toggle).</summary>
    private bool _wrap;

    private string DownloadUrl => $"/runs/{RunId}/log/download";

    protected override void OnParametersSet()
    {
        // The console page's `?step=` is an initial filter, applied once. Re-applying it on every
        // parameter set would reset a filter the user changed as soon as the page's status poll
        // re-rendered the parent (F-047).
        if (!_requestedStepApplied)
        {
            _requestedStepApplied = true;
            if (RequestedStepId is { } requested)
            {
                _viewModel.SetStepFilter(requested);
            }
        }

        Replan();
    }

    protected override async Task OnInitializedAsync()
    {
        if (!RendererInfo.IsInteractive)
        {
            // The prerender pass has no circuit: render the shell only, connect in the circuit phase.
            return;
        }

        if (string.IsNullOrEmpty(Ticket))
        {
            _connectionError = L10n["The log stream is not available for this session."];
            return;
        }

        _connecting = true;
        _connection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("hubs/run-logs"), options =>
            {
                options.AccessTokenProvider = () => Task.FromResult<string?>(Ticket);
            })
            .WithAutomaticReconnect()
            .Build();

        _connection.On<IReadOnlyList<LogLineMessage>>(nameof(IRunLogClient.HistoryLines), lines =>
        {
            _viewModel.Add(lines);
            return InvokeAsync(LinesChanged);
        });
        _connection.On<IReadOnlyList<LogLineMessage>>(nameof(IRunLogClient.ReceiveLines), lines =>
        {
            _viewModel.Add(lines);
            return InvokeAsync(LinesChanged);
        });

        _connection.Reconnected += OnReconnectedAsync;
        _connection.Closed += OnClosedAsync;

        try
        {
            await _connection.StartAsync();
            await _connection.InvokeAsync(nameof(RunLogHub.JoinRunAsync), RunId, CancellationToken.None);
        }
        catch (Exception failure)
        {
            _connectionClosed = true;
            _connectionError = L10n["The log stream could not be reached ({0}).", failure.Message];
        }
        finally
        {
            _connecting = false;
            await InvokeAsync(LinesChanged);
        }
    }

    /// <summary>
    /// After an automatic reconnect the run must be joined again (groups are per connection).
    /// The re-join is awaited and its failure is logged and surfaced (review fix F6) - the old
    /// fire-and-forget join could fail silently and leave the panel frozen on a group it is no
    /// longer in. Re-joining re-streams the history; the Seq-deduplicating view model absorbs
    /// the overlap.
    /// </summary>
    private Task OnReconnectedAsync(string? _) => InvokeAsync(async () =>
    {
        try
        {
            await _connection!.InvokeAsync(nameof(RunLogHub.JoinRunAsync), RunId, CancellationToken.None);
        }
        catch (Exception failure)
        {
            Logger.LogError(
                failure, "Re-joining the log group of run {RunId} after a reconnect failed.", RunId);
            _connectionError =
                L10n["The log stream reconnected but the run could not be re-joined ({0}).", failure.Message];
            StateHasChanged();
        }
    });

    /// <summary>
    /// The connection closed for good: WithAutomaticReconnect exhausted its retry budget (or the
    /// server closed it terminally). Show what happened and offer the manual restart instead of
    /// freezing silently (review fix F6).
    /// </summary>
    private Task OnClosedAsync(Exception? error) => InvokeAsync(() =>
    {
        _connectionClosed = true;
        _connectionError = error is null
            ? L10n["The log stream connection was closed."]
            : L10n["The log stream connection closed ({0}).", error.Message];
        StateHasChanged();
        return Task.CompletedTask;
    });

    /// <summary>The manual restart for the closed-connection state: start fresh and re-join.</summary>
    private async Task ReconnectAsync()
    {
        if (_connection is null || _connecting)
        {
            return;
        }

        _connecting = true;
        _connectionClosed = false;
        _connectionError = null;
        StateHasChanged();
        try
        {
            await _connection.StartAsync();
            await _connection.InvokeAsync(nameof(RunLogHub.JoinRunAsync), RunId, CancellationToken.None);
        }
        catch (Exception failure)
        {
            _connectionClosed = true;
            _connectionError = L10n["The log stream could not be reached ({0}).", failure.Message];
        }
        finally
        {
            _connecting = false;
            await InvokeAsync(LinesChanged);
        }
    }

    // ------------------------------------------------------------------
    // D-004 control surface: every handler writes intent into the view model and re-plans.
    // ------------------------------------------------------------------

    /// <summary>Pause freezes the viewport (the stream keeps arriving and being persisted);
    /// resume jumps to the tail. The indicator on the plan says which state the panel is in.</summary>
    private Task TogglePauseAsync()
    {
        if (Plan.IsPaused)
        {
            _viewModel.Resume();
        }
        else
        {
            _viewModel.Pause();
        }

        return ReplanAsync();
    }

    private Task ApplySearchAsync()
    {
        _viewModel.SetSearch(_search);
        return ReplanAsync();
    }

    private Task NextMatchAsync()
    {
        _viewModel.MoveToNextMatch();
        return ReplanAsync();
    }

    private Task PreviousMatchAsync()
    {
        _viewModel.MoveToPreviousMatch();
        return ReplanAsync();
    }

    private Task JumpToTailAsync()
    {
        _viewModel.JumpToTail();
        return ReplanAsync();
    }

    private Task OnStepFilterSelectedAsync(ChangeEventArgs args)
    {
        var value = args?.Value?.ToString();
        Guid? stepId = Guid.TryParse(value, out var parsed) ? parsed : null;
        _viewModel.SetStepFilter(stepId);
        Replan();
        StateHasChanged();
        return StepFilterChanged.InvokeAsync(stepId);
    }

    private Task LinesChanged()
    {
        // New lines arrived (history chunk or live flush): re-plan from the store. While paused the
        // plan keeps the frozen window - the indicator's waiting count is what moves instead.
        Replan();
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void Replan() => _plan = _viewModel.Plan(BuildStepHeaders(), L10n);

    private Task ReplanAsync()
    {
        Replan();
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Dictionary<Guid, string> BuildStepHeaders()
    {
        var headers = new Dictionary<Guid, string>();
        foreach (var step in Steps ?? [])
        {
            if (step.Id is { } id)
            {
                headers[id] = $"{step.Index}. {step.Name}";
            }
        }

        return headers;
    }

    /// <summary>F-047: a step header in the console narrows the view to that step's rows.</summary>
    private Task FilterToStep(Guid stepId)
    {
        _viewModel.SetStepFilter(stepId);
        return ReplanAsync();
    }

    private Task ToggleTimestampsAsync()
    {
        _showTimestamps = !_showTimestamps;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task ToggleWrapAsync()
    {
        _wrap = !_wrap;
        StateHasChanged();
        return Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        if (_connection is not null)
        {
            // Unsubscribe first: disposing raises Closed, and no handler may touch the UI state
            // of a component that is going away.
            _connection.Reconnected -= OnReconnectedAsync;
            _connection.Closed -= OnClosedAsync;
            await _connection.DisposeAsync();
        }
    }
}
