@page "/secrets"

<PageTitle>Secrets · Zenkins</PageTitle>

<div class="bb:mx-auto bb:w-full bb:max-w-4xl bb:space-y-6">
    <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-3">
        <BbCardTitle As="h1">Secrets</BbCardTitle>
        <BbBadge Variant="BadgeVariant.Secondary">Shell preview</BbBadge>
    </div>

    <BbCard>
        <BbCardHeader>
            <BbCardTitle>Tenant secrets</BbCardTitle>
            <BbCardDescription>
                Git credentials and pipeline secrets will be managed here, scoped to the selected organization.
            </BbCardDescription>
        </BbCardHeader>
        <BbCardContent>
            <BbEmpty Title="No secrets configured"
                     Description="Secret management arrives with the organization and authentication cards.">
                <Icon>
                    <LucideIcon Name="key-round" Class="bb:h-12 bb:w-12" />
                </Icon>
            </BbEmpty>
        </BbCardContent>
    </BbCard>
</div>
