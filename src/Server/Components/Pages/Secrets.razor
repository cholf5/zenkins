@page "/secrets"
@attribute [Authorize]
@using Zenkins.Server.Secrets
@using Zenkins.Shared.Secrets
@inject UserSession UserSession
@inject SecretService SecretsService

<PageTitle>@L10n["Secrets"] · Zenkins</PageTitle>

<div class="bb:mx-auto bb:w-full bb:max-w-4xl bb:space-y-6">
    <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-3">
        <BbCardTitle As="h1" tabindex="-1">@L10n["Secrets"]</BbCardTitle>
        @if (_session?.Organization is { } organization)
        {
            <BbBadge Variant="BadgeVariant.Secondary">@organization.Name</BbBadge>
            <BbBadge Variant="BadgeVariant.Outline">@L10n["Your role: {0}", DisplayText.Role(organization.Role, L10n)]</BbBadge>
        }
    </div>

    @if (_session is { HasOrganization: false })
    {
        <NoOrganizationNotice />
    }
    else if (!_canManage)
    {
        @* Owner-only page (PRD §3.8 / §3.1.2). No list is rendered, and the response is a real 403:
           a Member must not even learn which secret names exist. The write endpoints are the
           enforcement; this is the page half of it. *@
        <BbCard>
            <BbCardHeader>
                <BbCardTitle As="h2">@L10n["Owner access required"]</BbCardTitle>
                <BbCardDescription>
                    @L10n["Secrets are managed by organization Owners; Members cannot list or change them. Ask an Owner of this organization if you need a secret created or rotated."]
                </BbCardDescription>
            </BbCardHeader>
        </BbCard>
    }
    else
    {
        @if (Notice is { } notice)
        {
            <div role="status" class="bb:rounded-md bb:border bb:border-input bb:bg-muted bb:p-3 bb:text-sm">
                <p>@notice</p>
            </div>
        }

        @if (Error is { } error)
        {
            <div role="alert" class="bb:rounded-md bb:border bb:border-destructive/40 bb:bg-destructive/10 bb:p-3 bb:text-sm bb:text-destructive">
                <p>@error</p>
            </div>
        }

        <BbCard>
            <BbCardHeader>
                <BbCardTitle As="h2">@L10n["New secret"]</BbCardTitle>
                <BbCardDescription>
                    @L10n["The name is the identity: it cannot be renamed, must be unique in this organization and is usable as an environment variable (letters, digits and underscores). The kind decides how a pipeline reads it, and it cannot be changed afterwards - a different kind is a different secret. The value is encrypted before it is stored and is never shown again; to change it, rotate it."]
                </BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                @* Card F-040: one form, three kinds. The kind selector decides which fields the service
                   reads, so a filled field the chosen kind does not use is ignored rather than smuggled in.
                   Every value input is a password field: a stored value is never rendered back. *@
                <form method="post" action="/secrets/create" data-zenkins-antiforgery class="bb:flex bb:flex-col bb:gap-3">
                    <div class="bb:flex bb:flex-col bb:gap-3 bb:sm:flex-row">
                        <div class="bb:flex-1 bb:space-y-2">
                            <label for="secret-name" class="bb:text-sm bb:font-medium">@L10n["Name"]</label>
                            <input id="secret-name"
                                   name="Name"
                                   type="text"
                                   required
                                   maxlength="@SecretValidation.MaxNameLength"
                                   pattern="[A-Za-z_][A-Za-z0-9_]*"
                                   value="@SubmittedName"
                                   class="bb:flex bb:h-9 bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-3 bb:py-1 bb:text-sm"
                                   autocomplete="off"
                                   spellcheck="false"
                                   placeholder="NUGET_TOKEN" />
                        </div>
                        <div class="bb:flex-1 bb:space-y-2">
                            <label for="secret-kind" class="bb:text-sm bb:font-medium">@L10n["Kind"]</label>
                            <select id="secret-kind"
                                    name="Kind"
                                    class="bb:flex bb:h-9 bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-3 bb:py-1 bb:text-sm">
                                @foreach (var kind in SecretKinds.All)
                                {
                                    <option value="@kind">@KindLabel(kind)</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="bb:flex bb:flex-col bb:gap-3 bb:sm:flex-row">
                        <div class="bb:flex-1 bb:space-y-2">
                            <label for="secret-value" class="bb:text-sm bb:font-medium">
                                @L10n["Value / file content"]
                            </label>
                            <input id="secret-value"
                                   name="Value"
                                   type="password"
                                   class="bb:flex bb:h-9 bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-3 bb:py-1 bb:text-sm"
                                   autocomplete="new-password"
                                   spellcheck="false" />
                            <p class="bb:text-xs bb:text-muted-foreground">
                                @L10n["A text secret's single value, or the whole contents of a file secret (at most {0} KiB). Unused by a username/password secret.", SecretFileLimits.MaxBytes / 1024]
                            </p>
                        </div>
                        <div class="bb:flex-1 bb:space-y-2">
                            <label for="secret-username" class="bb:text-sm bb:font-medium">@L10n["Username"]</label>
                            <input id="secret-username"
                                   name="Username"
                                   type="text"
                                   class="bb:flex bb:h-9 bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-3 bb:py-1 bb:text-sm"
                                   autocomplete="off"
                                   spellcheck="false" />
                            <label for="secret-password" class="bb:text-sm bb:font-medium">@L10n["Password"]</label>
                            <input id="secret-password"
                                   name="Password"
                                   type="password"
                                   class="bb:flex bb:h-9 bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-3 bb:py-1 bb:text-sm"
                                   autocomplete="new-password"
                                   spellcheck="false" />
                            <p class="bb:text-xs bb:text-muted-foreground">
                                @L10n["Both halves of a"] <em>@L10n["username/password"]</em> @L10n["secret. A text or file secret ignores them."]
                            </p>
                        </div>
                    </div>
                    <div>
                        <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Default">@L10n["Create secret"]</BbButton>
                    </div>
                </form>
                <div class="bb:mt-4 bb:rounded-md bb:border bb:border-input bb:p-3 bb:text-xs bb:text-muted-foreground">
                    <p class="bb:font-medium">@L10n["Reading a secret from a step"]</p>
                    <ul class="bb:mt-1 bb:list-disc bb:space-y-1 bb:ps-5">
                        <li><code>text</code> — <code>${secret:NAME}</code>@L10n[", the value itself."]</li>
                        <li>
                            <code>usernamePassword</code> —
                            <code>${secret:NAME.username}</code> / <code>${secret:NAME.password}</code>@L10n[", each half on its own."]
                        </li>
                        <li>
                            <code>file</code> — <code>${secretFile:NAME}</code>@L10n[", a"] <b>@L10n["path"]</b> @L10n["inside the run's own directory; the worker writes the file with owner-only permissions and the run's cleanup removes it."]
                        </li>
                    </ul>
                    <p class="bb:mt-2">
                        @L10n["A password and a file's contents are redacted from the log, the run page and the API responses. The"] <em>@L10n["path"]</em> @L10n["is not: printing it tells you where the file is, not what is in it."]
                    </p>
                </div>
            </BbCardContent>
        </BbCard>

        <BbCard>
            <BbCardHeader>
                <BbCardTitle As="h2">@L10n["Secrets of this organization"]</BbCardTitle>
                <BbCardDescription>
                    @L10n["Names and timestamps only. Values are write-only: no control shows a stored value and no route returns one."]
                </BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                @if (_secrets.Count == 0)
                {
                    <BbEmpty Title="@L10n["No secrets configured"]"
                             Description="@L10n["Create a secret above to make it available to pipelines and Git checkouts."]">
                        <Icon>
                            <LucideIcon Name="key-round" Class="bb:h-12 bb:w-12" />
                        </Icon>
                    </BbEmpty>
                }
                else
                {
                    <div class="bb:overflow-x-auto">
                        <table class="bb:w-full bb:text-sm">
                            <thead>
                                <tr class="bb:border-b bb:text-start bb:text-muted-foreground">
                                    <th class="bb:py-2 bb:pe-4 bb:font-medium">@L10n["Name"]</th>
                                    <th class="bb:py-2 bb:pe-4 bb:font-medium">@L10n["Kind"]</th>
                                    <th class="bb:py-2 bb:pe-4 bb:font-medium">@L10n["Created"]</th>
                                    <th class="bb:py-2 bb:pe-4 bb:font-medium">@L10n["Rotated"]</th>
                                    <th class="bb:py-2 bb:pe-4 bb:font-medium">@L10n["Referenced by"]</th>
                                    <th class="bb:py-2 bb:pe-4 bb:font-medium">@L10n["Updated"]</th>
                                    <th class="bb:py-2 bb:font-medium">@L10n["Manage"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var secret in _secrets)
                                {
                                    <tr class="bb:border-b bb:align-top">
                                        <td class="bb:py-3 bb:pe-4 bb:font-medium">@secret.Name</td>
                                        <td class="bb:py-3 bb:pe-4">
                                            @* F-040: the kind, with the syntax that reads it - the page is where
                                               an author looks up how to reference the secret they stored. *@
                                            <div>@KindLabel(secret.Kind)</div>
                                            <div class="bb:text-xs bb:text-muted-foreground">
                                                <code>@KindSyntax(secret)</code>
                                            </div>
                                        </td>
                                        <td class="bb:py-3 bb:pe-4">
                                            <div>@secret.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC</div>
                                            <div class="bb:text-xs bb:text-muted-foreground">
                                                @L10n["by {0}", CreatorLabel(secret)]
                                            </div>
                                        </td>
                                        <td class="bb:py-3 bb:pe-4">
                                            @if (secret.RotatedAt is { } rotatedAt)
                                            {
                                                <div>@rotatedAt.ToString("yyyy-MM-dd HH:mm") UTC</div>
                                                <div class="bb:text-xs bb:text-muted-foreground">
                                                    @L10n["by {0}", RotatedByLabel(secret)]
                                                </div>
                                            }
                                            else
                                            {
                                                <span>@L10n["Never"]</span>
                                            }
                                        </td>
                                        <td class="bb:py-3 bb:pe-4">
                                            @* D-006: names and run links only - the page never reads the
                                               repository and never shows a value. *@
                                            @switch (secret.Usage.State)
                                            {
                                                case SecretReferenceState.Known:
                                                    <ul class="bb:space-y-1">
                                                        @foreach (var reference in secret.Usage.References.Take(ShownReferences))
                                                        {
                                                            <li class="bb:text-xs">
                                                                <a href="/runs/@reference.RunId"
                                                                   class="bb:underline bb:underline-offset-4">@reference.PipelineName</a>
                                                                <span class="bb:text-muted-foreground">· @reference.ProjectName</span>
                                                            </li>
                                                        }
                                                    </ul>
                                                    @if (secret.Usage.ReferenceCount > ShownReferences)
                                                    {
                                                        <p class="bb:mt-1 bb:text-xs bb:text-muted-foreground">
                                                            @L10n["and {0} more run(s)", secret.Usage.ReferenceCount - ShownReferences]
                                                        </p>
                                                    }
                                                    @if (secret.Usage.UncapturedRuns > 0)
                                                    {
                                                        <p class="bb:mt-1 bb:text-xs bb:text-muted-foreground">
                                                            @L10n["{0} earlier run(s) predate reference capture, so they are unknown.", secret.Usage.UncapturedRuns]
                                                        </p>
                                                    }
                                                    break;

                                                case SecretReferenceState.Unknown:
                                                    <p class="bb:text-xs">@L10n["unknown (recorded before capture)"]</p>
                                                    <p class="bb:mt-1 bb:text-xs bb:text-muted-foreground">
                                                        @L10n["{0} may reference this name.", UncapturedLabel(secret)]
                                                    </p>
                                                    break;

                                                default:
                                                    <p class="bb:text-xs">@L10n["No pipeline references this name."]</p>
                                                    break;
                                            }
                                        </td>
                                        <td class="bb:py-3 bb:pe-4">@secret.UpdatedAt.ToString("yyyy-MM-dd HH:mm") UTC</td>
                                        <td class="bb:py-3">
                                            <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-2">
                                                <form method="post" action="/secrets/@secret.Id/rotate" data-zenkins-antiforgery class="bb:flex bb:flex-wrap bb:items-center bb:gap-2">
                                                    @* F-040: the fields follow the secret's own kind. A rotation
                                                       cannot change the kind, so a pair asks for both halves and
                                                       everything else asks for the one value. *@
                                                    @if (secret.Kind == SecretKinds.UsernamePassword)
                                                    {
                                                        <label for="rotate-user-@secret.Id" class="bb:sr-only">@L10n["New username for {0}", secret.Name]</label>
                                                        <input id="rotate-user-@secret.Id"
                                                               name="Username"
                                                               type="text"
                                                               required
                                                               class="bb:h-8 bb:w-32 bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-2 bb:py-1 bb:text-xs"
                                                               autocomplete="off"
                                                               spellcheck="false"
                                                               placeholder="@L10n["New username"]" />
                                                        <label for="rotate-@secret.Id" class="bb:sr-only">@L10n["New password for {0}", secret.Name]</label>
                                                        <input id="rotate-@secret.Id"
                                                               name="Password"
                                                               type="password"
                                                               required
                                                               class="bb:h-8 bb:w-32 bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-2 bb:py-1 bb:text-xs"
                                                               autocomplete="new-password"
                                                               spellcheck="false"
                                                               placeholder="@L10n["New password"]" />
                                                    }
                                                    else
                                                    {
                                                        var placeholder = secret.Kind == SecretKinds.File ? L10n["New file content"] : L10n["New value"];
                                                        <label for="rotate-@secret.Id" class="bb:sr-only">@L10n["New value for {0}", secret.Name]</label>
                                                        <input id="rotate-@secret.Id"
                                                               name="Value"
                                                               type="password"
                                                               required
                                                               class="bb:h-8 bb:w-40 bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-2 bb:py-1 bb:text-sm"
                                                               autocomplete="new-password"
                                                               spellcheck="false"
                                                               placeholder="@placeholder" />
                                                    }
                                                    <button type="submit"
                                                            class="bb:rounded-md bb:border bb:border-input bb:px-2 bb:py-1 bb:text-xs bb:hover:bg-accent">
                                                        @L10n["Rotate"]
                                                    </button>
                                                </form>

                                                <details class="bb:inline-block">
                                                    <summary class="bb:cursor-pointer bb:rounded-md bb:border bb:border-destructive/40 bb:px-2 bb:py-1 bb:text-xs bb:text-destructive">
                                                        @L10n["Delete"]…
                                                    </summary>
                                                    <form method="post" action="/secrets/@secret.Id/delete" data-zenkins-antiforgery class="bb:mt-2 bb:flex bb:flex-col bb:gap-2">
                                                        <span class="bb:text-xs bb:text-muted-foreground">
                                                            @L10n["Delete {0} permanently?", secret.Name] @DeleteWarning(secret)
                                                        </span>
                                                        <button type="submit"
                                                                class="bb:self-start bb:rounded-md bb:border bb:border-destructive/40 bb:px-2 bb:py-1 bb:text-xs bb:text-destructive bb:hover:bg-destructive/10">
                                                            @L10n["Confirm delete"]
                                                        </button>
                                                    </form>
                                                </details>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </BbCardContent>
        </BbCard>
    }
</div>

@code {
    /// <summary>How many referencing runs one row lists before summarising the rest (card D-006).</summary>
    private const int ShownReferences = 5;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private UserSessionInfo? _session;
    private IReadOnlyList<SecretView> _secrets = [];
    private bool _canManage;

    [SupplyParameterFromQuery(Name = "notice")]
    private string? NoticeCode { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    private string? ErrorCode { get; set; }

    [SupplyParameterFromQuery(Name = "name")]
    private string? SubmittedName { get; set; }

    private string? Notice => NoticeCode switch
    {
        "created" => L10n["The secret was created."],
        "rotated" => L10n["The secret was rotated; the previous value is no longer stored."],
        "deleted" => L10n["The secret was deleted."],
        _ => null,
    };

    private string CreatorLabel(SecretView secret) =>
        PersonLabel(secret.CreatedByDisplay, secret.CreatedByEmail, secret.CreatedByUserId);

    /// <summary>
    /// Who last rotated the secret (card D-006). A rotation recorded before attribution existed is "not
    /// recorded", never a guess - and a secret that was never rotated does not render this line at all.
    /// </summary>
    private string RotatedByLabel(SecretView secret) => secret.RotatedByUserId is null
        ? L10n["not recorded"]
        : PersonLabel(secret.RotatedByDisplay, secret.RotatedByEmail, secret.RotatedByUserId);

    /// <summary>A person's label for an audit id: the display name, with the email when it adds anything,
    /// falling back to the raw id when the account no longer exists.</summary>
    private static string PersonLabel(string? display, string? email, string userId)
    {
        var name = display is { Length: > 0 } ? display : userId;
        return email is { Length: > 0 } && !string.Equals(email, name, StringComparison.Ordinal)
            ? $"{name} ({email})"
            : name;
    }

    /// <summary>The kind as a person reads it (card F-040).</summary>
    private string KindLabel(string kind) => kind switch
    {
        SecretKinds.UsernamePassword => L10n["Username/password"],
        SecretKinds.File => L10n["File"],
        _ => L10n["Text"],
    };

    /// <summary>The reference syntax that reads this secret - what an author copies into a step.</summary>
    private static string KindSyntax(SecretView secret) => secret.Kind switch
    {
        SecretKinds.UsernamePassword => $"${{secret:{secret.Name}.username}} / .password",
        SecretKinds.File => $"${{secretFile:{secret.Name}}}",
        _ => $"${{secret:{secret.Name}}}",
    };

    private string UncapturedLabel(SecretView secret) => secret.Usage.UncapturedRuns == 1
        ? L10n["1 run"]
        : L10n["{0} runs", secret.Usage.UncapturedRuns];

    /// <summary>
    /// The delete confirmation's reference sentence: naming the referencing pipelines is what makes the
    /// decision informed (card D-006, AC 3). "Unknown" is stated instead of a reassuring zero.
    /// </summary>
    private string DeleteWarning(SecretView secret) => secret.Usage.State switch
    {
        SecretReferenceState.Known =>
            FormatReferenceWarning(secret),
        SecretReferenceState.Unknown =>
            L10n["Earlier definitions predate reference capture, so they may reference this name. Deleting it will fail the next run that resolves it."],
        _ => L10n["No recorded pipeline references this name."],
    };

    private string FormatReferenceWarning(SecretView secret)
    {
        var names = string.Join(
            ", ",
            secret.Usage.References
                .Take(ShownReferences)
                .Select(reference => reference.PipelineName)
                .Distinct(StringComparer.Ordinal));

        if (secret.Usage.ReferenceCount > ShownReferences)
        {
            names = L10n["{0} and {1} more run(s)", names, secret.Usage.ReferenceCount - ShownReferences];
        }

        return secret.Usage.UncapturedRuns > 0
            ? L10n["Referenced by {0}. Deleting it will fail the next run that resolves it. {1} earlier run(s) predate capture, so they are unknown.", names, secret.Usage.UncapturedRuns]
            : L10n["Referenced by {0}. Deleting it will fail the next run that resolves it.", names];
    }

    // The value never travels in a query, so the only field-level error this page can echo is the name.
    private string? Error => SecretErrorCodes.MessageFor(ErrorCode, L10n);

    protected override async Task OnInitializedAsync()
    {
        // Resolve the session first: it establishes the circuit tenant (F-003 hazard) before any
        // tenant-filtered row is read.
        _session = await UserSession.GetAsync();
        _canManage = _session?.CanManageActiveOrganization == true;

        if (_session?.HasOrganization != true)
        {
            return;
        }

        if (!_canManage)
        {
            ForbidResponse();
            return;
        }

        // Defence in depth: the session check above is the first gate, the service's Owner check the
        // second. Either one alone would be a single point of failure.
        var list = await SecretsService.GetSecretsAsync(_session.UserId);
        if (list.Status == SecretMutationStatus.Forbidden)
        {
            ForbidResponse();
            return;
        }

        _secrets = list.Secrets;
    }

    /// <summary>
    /// A real 403 with no list, for a Member. The status-code-pages middleware must not re-execute
    /// /not-found in this same request (the component renderer already owns the NavigationManager),
    /// so the feature is disabled here - the same pattern the 404 pages use.
    /// </summary>
    private void ForbidResponse()
    {
        if (HttpContext is null)
        {
            return;
        }

        HttpContext.Response.StatusCode = StatusCodes.Status403Forbidden;
        if (HttpContext.Features.Get<IStatusCodePagesFeature>() is { } statusCodePages)
        {
            statusCodePages.Enabled = false;
        }
    }
}
