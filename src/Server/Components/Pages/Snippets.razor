@page "/snippets"
@attribute [Authorize]
@using Zenkins.Server.Snippets
@using Zenkins.Shared.Snippets
@using Zenkins.Shared.Pipelines
@inject UserSession UserSession
@inject StepSnippetService SnippetsService

@* Card F-035: the organization's snippet library. A snippet is TEXT an editor copies - the page shows the
   body, what the inserted text will look like (for a script step), the secret references it carries (the same
   scanner as a typed step), and the one rule that matters: editing or deleting a snippet never reaches a saved
   project or a run, because nothing references the row. *@
<PageTitle>Snippets · Zenkins</PageTitle>

<div class="bb:mx-auto bb:w-full bb:max-w-4xl bb:space-y-6">
    <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-3">
        <BbCardTitle As="h1" tabindex="-1">Snippets</BbCardTitle>
        @if (_session?.Organization is { } organization)
        {
            <BbBadge Variant="BadgeVariant.Secondary">@organization.Name</BbBadge>
            <BbBadge Variant="BadgeVariant.Outline">Your role: @organization.Role</BbBadge>
        }
    </div>

    @if (_session is { HasOrganization: false })
    {
        <NoOrganizationNotice />
    }
    else
    {
        <BbCard>
            <BbCardHeader>
                <BbCardTitle As="h2">Reusable step snippets</BbCardTitle>
                <BbCardDescription>
                    A snippet is text an editor copies into a project's definition: a script body for a
                    Freestyle step, or a piece of <code>pipeline.lua</code> for a pipeline. <b>Inserting copies
                    the text at that moment.</b> Editing or deleting a snippet never changes a saved project,
                    a frozen spec or a run - nothing references the snippet.
                </BbCardDescription>
            </BbCardHeader>
        </BbCard>

        @if (Notice is { } notice)
        {
            <div role="status" class="bb:rounded-md bb:border bb:border-input bb:bg-muted bb:p-3 bb:text-sm">
                <p>@notice</p>
            </div>
        }

        @if (Error is { } error)
        {
            <div role="alert" class="bb:rounded-md bb:border bb:border-destructive/40 bb:bg-destructive/10 bb:p-3 bb:text-sm bb:text-destructive">
                <p>@error</p>
            </div>
        }

        <BbCard>
            <BbCardHeader>
                <BbCardTitle As="h2">New snippet</BbCardTitle>
                <BbCardDescription>
                    A name is unique in this organization. The kind decides where it is offered and what
                    bounds its body: a script step is bounded like a Freestyle script (32 KiB), a Lua
                    fragment like an inline pipeline script (64 KiB).
                </BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                <form method="post" action="/snippets/create" data-zenkins-antiforgery class="bb:flex bb:flex-col bb:gap-3">
                    <div class="bb:grid bb:gap-3 bb:sm:grid-cols-2">
                        <div>
                            <label for="snippet-name" class="bb:mb-1 bb:block bb:text-sm bb:font-medium">Name</label>
                            <input id="snippet-name"
                                   name="Name"
                                   required
                                   maxlength="@StepSnippetLimits.MaxNameLength"
                                   autocomplete="off"
                                   class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-3 bb:py-1" />
                        </div>
                        <div>
                            <label for="snippet-kind" class="bb:mb-1 bb:block bb:text-sm bb:font-medium">Kind</label>
                            <select id="snippet-kind"
                                    name="Kind"
                                    class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-3 bb:py-1">
                                @foreach (var kind in StepSnippetKinds.All)
                                {
                                    <option value="@kind">@StepSnippetKinds.LabelFor(kind)</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div>
                        <label for="snippet-description" class="bb:mb-1 bb:block bb:text-sm bb:font-medium">
                            Description (optional)
                        </label>
                        <input id="snippet-description"
                               name="Description"
                               maxlength="@StepSnippetLimits.MaxDescriptionLength"
                               autocomplete="off"
                               class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-3 bb:py-1" />
                    </div>
                    <div>
                        <label for="snippet-body" class="bb:mb-1 bb:block bb:text-sm bb:font-medium">Body</label>
                        <textarea id="snippet-body"
                                  name="Body"
                                  rows="8"
                                  required
                                  spellcheck="false"
                                  autocomplete="off"
                                  class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-3 bb:py-2 bb:font-mono bb:text-xs"></textarea>
                        <p class="bb:mt-1 bb:text-xs bb:text-muted-foreground">
                            <code>${secret:NAME}</code> and <code>${env:NAME}</code> references in the body are
                            captured by the same scanner as a typed step when the text is saved into a project.
                        </p>
                    </div>
                    <div>
                        <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Default">Create snippet</BbButton>
                    </div>
                </form>
            </BbCardContent>
        </BbCard>

        @if (_snippets.Count == 0)
        {
            <p id="snippets-empty" class="bb:text-sm bb:text-muted-foreground">
                This organization has no snippets yet.
            </p>
        }
        else
        {
            <div id="snippets-list" class="bb:space-y-4">
                @foreach (var snippet in _snippets)
                {
                    <BbCard>
                        <BbCardHeader>
                            <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-2">
                                <BbCardTitle As="h2">@snippet.Name</BbCardTitle>
                                <BbBadge Variant="BadgeVariant.Outline">@StepSnippetKinds.LabelFor(snippet.Kind)</BbBadge>
                                <span class="bb:text-xs bb:text-muted-foreground">
                                    updated @snippet.UpdatedAt.ToString("yyyy-MM-dd HH:mm") UTC
                                </span>
                            </div>
                            @if (snippet.Description is { Length: > 0 } description)
                            {
                                <BbCardDescription>@description</BbCardDescription>
                            }
                        </BbCardHeader>
                        <BbCardContent>
                            <pre id="@($"snippet-body-{snippet.Id}")"
                                 class="bb:max-h-64 bb:overflow-auto bb:rounded-md bb:border bb:border-input bb:bg-muted bb:p-3 bb:text-xs">@snippet.Body</pre>

                            @if (snippet.Kind == StepSnippetKinds.ScriptStep)
                            {
                                @* The preview AC: what the inserted step will look like, computed from the body and
                                   the snippet's own name - no other project state is guessed at. *@
                                <div id="@($"snippet-preview-{snippet.Id}")" class="bb:mt-3 bb:rounded-md bb:border bb:border-input bb:p-3 bb:text-xs">
                                    <p class="bb:font-medium">Resulting step</p>
                                    <dl class="bb:mt-1 bb:grid bb:grid-cols-1 bb:gap-1 bb:sm:grid-cols-3">
                                        <div>
                                            <dt class="bb:text-muted-foreground">Name</dt>
                                            <dd>@snippet.Name</dd>
                                        </div>
                                        <div>
                                            <dt class="bb:text-muted-foreground">Env</dt>
                                            <dd>none (added on the step after insertion)</dd>
                                        </div>
                                        <div>
                                            <dt class="bb:text-muted-foreground">Artifacts</dt>
                                            <dd>none (added on the step after insertion)</dd>
                                        </div>
                                    </dl>
                                    <p class="bb:mt-2">
                                        <span class="bb:text-muted-foreground">Secret references: </span>
                                        @(SecretReferencesLabel(snippet.Body))
                                    </p>
                                </div>
                            }
                            else
                            {
                                <p id="@($"snippet-fragment-{snippet.Id}")" class="bb:mt-3 bb:text-xs bb:text-muted-foreground">
                                    Pipeline text: insert it into a script; the product never rewrites your
                                    repository file.
                                </p>
                            }

                            <details class="bb:mt-3">
                                <summary class="bb:cursor-pointer bb:text-sm bb:font-medium">Edit</summary>
                                <form method="post" action="@($"/snippets/{snippet.Id}/edit")"
                                      data-zenkins-antiforgery class="bb:mt-3 bb:flex bb:flex-col bb:gap-3">
                                    <div class="bb:grid bb:gap-3 bb:sm:grid-cols-2">
                                        <div>
                                            <label for="@($"snippet-name-{snippet.Id}")" class="bb:mb-1 bb:block bb:text-sm bb:font-medium">Name</label>
                                            <input id="@($"snippet-name-{snippet.Id}")"
                                                   name="Name"
                                                   value="@snippet.Name"
                                                   required
                                                   maxlength="@StepSnippetLimits.MaxNameLength"
                                                   autocomplete="off"
                                                   class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-3 bb:py-1" />
                                        </div>
                                        <div>
                                            <label for="@($"snippet-kind-{snippet.Id}")" class="bb:mb-1 bb:block bb:text-sm bb:font-medium">Kind</label>
                                            <select id="@($"snippet-kind-{snippet.Id}")"
                                                    name="Kind"
                                                    class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-3 bb:py-1">
                                                @foreach (var kind in StepSnippetKinds.All)
                                                {
                                                    <option value="@kind" selected="@(kind == snippet.Kind)">@StepSnippetKinds.LabelFor(kind)</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                    <div>
                                        <label for="@($"snippet-description-{snippet.Id}")" class="bb:mb-1 bb:block bb:text-sm bb:font-medium">Description</label>
                                        <input id="@($"snippet-description-{snippet.Id}")"
                                               name="Description"
                                               value="@snippet.Description"
                                               maxlength="@StepSnippetLimits.MaxDescriptionLength"
                                               autocomplete="off"
                                               class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-3 bb:py-1" />
                                    </div>
                                    <div>
                                        <label for="@($"snippet-body-input-{snippet.Id}")" class="bb:mb-1 bb:block bb:text-sm bb:font-medium">Body</label>
                                        <textarea id="@($"snippet-body-input-{snippet.Id}")"
                                                  name="Body"
                                                  rows="8"
                                                  required
                                                  spellcheck="false"
                                                  class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-3 bb:py-2 bb:font-mono bb:text-xs">@snippet.Body</textarea>
                                    </div>
                                    <div>
                                        <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Outline">Save snippet</BbButton>
                                    </div>
                                </form>
                                <form method="post" action="@($"/snippets/{snippet.Id}/delete")"
                                      data-zenkins-antiforgery class="bb:mt-3">
                                    <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Destructive">Delete snippet</BbButton>
                                    <span class="bb:ml-2 bb:text-xs bb:text-muted-foreground">
                                        Projects that already inserted it keep their copied text.
                                    </span>
                                </form>
                            </details>
                        </BbCardContent>
                    </BbCard>
                }
            </div>
        }
    }
</div>

@code {
    private UserSessionInfo? _session;
    private IReadOnlyList<StepSnippetView> _snippets = [];

    [SupplyParameterFromQuery(Name = "notice")]
    private string? NoticeCode { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    private string? ErrorCode { get; set; }

    private string? Notice => NoticeCode switch
    {
        "created" => "The snippet was created.",
        "updated" => "The snippet was updated. Projects that already inserted its text are unchanged.",
        "deleted" => "The snippet was deleted. Projects that already inserted its text keep it.",
        _ => null,
    };

    private string? Error => SnippetErrorCodes.MessageFor(ErrorCode);

    protected override async Task OnInitializedAsync()
    {
        // The session establishes the circuit tenant before any tenant-filtered row is read (F-003 hazard).
        _session = await UserSession.GetAsync();
        if (_session?.HasOrganization != true)
        {
            return;
        }

        _snippets = await SnippetsService.ListAsync();
    }

    /// <summary>
    /// The secret references the body carries, read by the same scanner the save path uses (card D-006) - the
    /// preview tells the author what the inserted step will record, not a second parser's guess.
    /// </summary>
    private static string SecretReferencesLabel(string body)
    {
        var references = StepReference.ReferencesIn(body);
        return references.Count == 0 ? "none" : string.Join(", ", references);
    }
}
