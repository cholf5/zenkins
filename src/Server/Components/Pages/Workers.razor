@page "/workers"

<PageTitle>Workers · Zenkins</PageTitle>

<div class="bb:mx-auto bb:w-full bb:max-w-4xl bb:space-y-6">
    <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-3">
        <BbCardTitle As="h1">Workers</BbCardTitle>
        <BbBadge Variant="BadgeVariant.Secondary">Shell preview</BbBadge>
    </div>

    <BbCard>
        <BbCardHeader>
            <BbCardTitle>Registered workers</BbCardTitle>
            <BbCardDescription>
                Worker registration, heartbeats and platform tags will be listed here.
            </BbCardDescription>
        </BbCardHeader>
        <BbCardContent>
            <BbEmpty Title="No workers connected"
                     Description="Start a worker and it will register here once the worker runtime lands.">
                <Icon>
                    <LucideIcon Name="server" Class="bb:h-12 bb:w-12" />
                </Icon>
            </BbEmpty>
        </BbCardContent>
    </BbCard>
</div>
