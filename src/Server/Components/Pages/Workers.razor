@page "/workers"
@attribute [Authorize]
@inject UserSession UserSession
@inject WorkerService WorkerService
@inject RunService RunsService

<PageTitle>@L10n["Workers"] · Zenkins</PageTitle>

<div class="bb:mx-auto bb:w-full bb:max-w-4xl bb:space-y-6">
    <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-3">
        <BbCardTitle As="h1" tabindex="-1">@L10n["Workers"]</BbCardTitle>
        @if (_session?.Organization is { } organization)
        {
            <BbBadge Variant="BadgeVariant.Secondary">@organization.Name</BbBadge>
        }
    </div>

    @if (_session is { HasOrganization: false })
    {
        <NoOrganizationNotice />
    }
    else
    {
        @if (Notice is { } notice)
        {
            <div role="status" class="bb:rounded-md bb:border bb:border-input bb:bg-muted bb:p-3 bb:text-sm">
                <p>@notice</p>
            </div>
        }

        @if (Error is { } error)
        {
            <div role="alert" class="bb:rounded-md bb:border bb:border-destructive bb:bg-destructive/10 bb:p-3 bb:text-sm">
                <p>@error</p>
            </div>
        }

        <BbCard>
            <BbCardHeader>
                <BbCardTitle As="h2">@L10n["Registered workers"]</BbCardTitle>
                <BbCardDescription>
                    @L10n["Workers of the active organization. Every worker authenticates with its own token; heartbeats keep it Online (PRD §3.4.3). Each row links to the worker's detail page with its current and recent runs (card D-005)."]
                </BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                @if (_workers.Count == 0)
                {
                    <BbEmpty Title="@L10n["No workers connected"]"
                             Description="@L10n["Mint a registration token, then start a worker with it (ZENKINS_SERVER_URL + ZENKINS_REGISTRATION_TOKEN)."]">
                        <Icon>
                            <LucideIcon Name="server" Class="bb:h-12 bb:w-12" />
                        </Icon>
                    </BbEmpty>
                }
                else
                {
                    <ul class="bb:divide-y">
                        @foreach (var worker in _workers)
                        {
                            <li class="bb:flex bb:flex-wrap bb:items-center bb:justify-between bb:gap-3 bb:py-3">
                                <div class="bb:min-w-0">
                                    @* D-005: the row is the doorway - the name links to the worker's
                                       detail page, where its runs and the Owner controls live. *@
                                    <p class="bb:font-medium">
                                        <a href="/workers/@worker.Id"
                                           class="bb:underline bb:underline-offset-4">@worker.Name</a>
                                        @if (worker.IsDisabled)
                                        {
                                            <BbBadge Variant="BadgeVariant.Destructive">@L10n["Disabled"]</BbBadge>
                                        }
                                    </p>
                                    <p class="bb:truncate bb:text-xs bb:text-muted-foreground">
                                        @worker.Os · @worker.Architecture · v@(worker.Version) · @worker.CpuCount CPUs · max @worker.MaxConcurrency
                                    </p>
                                    @if (!string.IsNullOrEmpty(worker.Tags))
                                    {
                                        <p class="bb:text-xs bb:text-muted-foreground">@L10n["Tags: {0}", worker.Tags]</p>
                                    }
                                </div>
                                <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-2 bb:text-xs bb:text-muted-foreground">
                                    @* D-005: the count next to the roster comes from the same current-runs
                                       query the detail page lists - never from a denormalised column. *@
                                    <span>
                                        @L10n["{0} running", _runCounts.GetValueOrDefault(worker.Id)]
                                    </span>
                                    <BbBadge Variant="BadgeVariant.Outline">@worker.Status</BbBadge>
                                    <span>
                                        @(worker.LastHeartbeatAt?.ToString("yyyy-MM-dd HH:mm") ?? "-") UTC
                                    </span>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </BbCardContent>
        </BbCard>

        @if (_session?.CanManageActiveOrganization == true)
        {
            <BbCard>
                <BbCardHeader>
                    <BbCardTitle As="h2">@L10n["Registration tokens"]</BbCardTitle>
                    <BbCardDescription>
                        @L10n["Single-use tokens for registering a worker. The plaintext is shown once at creation and never stored; revoking a pending token immediately invalidates it."]
                    </BbCardDescription>
                </BbCardHeader>
                <BbCardContent>
                    <form method="post" action="/workers/registration-tokens" data-zenkins-antiforgery>
                        <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Default">@L10n["Create registration token"]</BbButton>
                    </form>

                    @if (_tokens.Count == 0)
                    {
                        <p class="bb:mt-4 bb:text-sm bb:text-muted-foreground">@L10n["No registration tokens yet."]</p>
                    }
                    else
                    {
                        <ul class="bb:mt-4 bb:divide-y">
                            @foreach (var token in _tokens)
                            {
                                <li class="bb:flex bb:flex-wrap bb:items-center bb:justify-between bb:gap-3 bb:py-3">
                                    <div class="bb:min-w-0">
                                        <p class="bb:text-sm">@L10n["Created {0} UTC", token.CreatedAt.ToString("yyyy-MM-dd HH:mm")]</p>
                                        <p class="bb:text-xs bb:text-muted-foreground">
                                            @(token.UsedAt is { } used ? L10n["Used {0} UTC", used.ToString("yyyy-MM-dd HH:mm")]
                                                : token.RevokedAt is { } revoked ? L10n["Revoked {0} UTC", revoked.ToString("yyyy-MM-dd HH:mm")]
                                                : L10n["Pending (unused)"])
                                        </p>
                                    </div>
                                    @if (token.UsedAt is null && token.RevokedAt is null)
                                    {
                                        <form method="post" action="/workers/registration-tokens/@token.Id/revoke" data-zenkins-antiforgery>
                                            <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Outline">@L10n["Revoke"]</BbButton>
                                        </form>
                                    }
                                </li>
                            }
                        </ul>
                    }
                </BbCardContent>
            </BbCard>
        }
    }
</div>

@code {
    private UserSessionInfo? _session;
    private IReadOnlyList<WorkerView> _workers = [];
    private IReadOnlyList<WorkerRegistrationTokenView> _tokens = [];

    /// <summary>D-005: current (Running) runs per worker, from the same query the detail page lists.</summary>
    private IReadOnlyDictionary<Guid, int> _runCounts =
        new Dictionary<Guid, int>();

    [SupplyParameterFromQuery(Name = "notice")]
    private string? NoticeCode { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    private string? ErrorCode { get; set; }

    private string? Notice => NoticeCode switch
    {
        "token-revoked" => L10n["The registration token was revoked."],
        "worker-deleted" => L10n["The worker was deleted."],
        _ => null,
    };

    private string? Error => ErrorCode switch
    {
        WorkerErrorCodes.TokenAlreadyConsumed => L10n["That token was already used to register a worker."],
        WorkerErrorCodes.TokenAlreadyRevoked => L10n["That token is already revoked."],
        _ => null,
    };

    protected override async Task OnInitializedAsync()
    {
        // Same hazard as the projects page: resolving the session selects the circuit's tenant
        // before any tenant-owned row is read.
        _session = await UserSession.GetAsync();
        if (_session?.HasOrganization != true)
        {
            return;
        }

        _workers = await WorkerService.GetWorkersAsync();
        _runCounts = await RunsService.GetCurrentRunCountsAsync();
        if (_session.CanManageActiveOrganization)
        {
            _tokens = await WorkerService.GetRegistrationTokensAsync();
        }
    }
}
