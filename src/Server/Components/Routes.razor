@using Microsoft.AspNetCore.Components.Routing
@using Zenkins.Server.Components.Pages
@implements IDisposable
@inject PersistentComponentState ApplicationState
@inject LanguageContext Language

<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <ErrorBoundary @ref="_errorBoundary">
            <ChildContent>
                @* Pages carry [Authorize]; anonymous requests are sent to /account/login with a
                   ReturnUrl by the fallback below. Account pages carry no [Authorize] and are
                   additionally excluded from interactive routing (see App.razor). *@
                <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
                    <NotAuthorized>
                        <RedirectToLogin />
                    </NotAuthorized>
                </AuthorizeRouteView>
                <FocusOnNavigate RouteData="routeData" Selector="h1" />
            </ChildContent>
            <ErrorContent Context="exception">
                <LayoutView Layout="typeof(MainLayout)">
                    <PageTitle>@L10n["Something went wrong"] · Zenkins</PageTitle>
                    <div class="bb:mx-auto bb:w-full bb:max-w-2xl">
                        <BbCard>
                            <BbCardHeader>
                                <BbCardTitle As="h1" tabindex="-1">@L10n["Something went wrong"]</BbCardTitle>
                                <BbCardDescription>
                                    @L10n["The page failed to render."]
                                </BbCardDescription>
                            </BbCardHeader>
                            <BbCardContent>
                                <BbButton OnClick="Recover" Variant="ButtonVariant.Default">@L10n["Try again"]</BbButton>
                            </BbCardContent>
                        </BbCard>
                    </div>
                </LayoutView>
            </ErrorContent>
        </ErrorBoundary>
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(MainLayout)">
            <NotFoundPage />
        </LayoutView>
    </NotFound>
</Router>

@code {
    private const string LanguageStateKey = "zenkins.language";

    private ErrorBoundary? _errorBoundary;
    private PersistingComponentStateSubscription _persistingLanguage;

    /// <summary>
    /// Establishes the language for this render tree.
    /// <para>
    /// The prerender pass has an <see cref="HttpContext"/> and resolves from the cookie there; it
    /// registers the resolved code to be persisted so the interactive circuit - which has no request
    /// and therefore no cookie - renders the same language. The circuit takes that value here, before
    /// the router renders any page, which is why no page can render one frame of the wrong language.
    /// </para>
    /// </summary>
    protected override void OnInitialized()
    {
        if (ApplicationState.TryTakeFromJson<string>(LanguageStateKey, out var persisted))
        {
            Language.Set(persisted);
            return;
        }

        _persistingLanguage = ApplicationState.RegisterOnPersisting(PersistLanguageAsync);
    }

    private Task PersistLanguageAsync()
    {
        ApplicationState.PersistAsJson(LanguageStateKey, Language.Current);
        return Task.CompletedTask;
    }

    private void Recover() => _errorBoundary?.Recover();

    /// <summary>Ends the persistence subscription with the prerender pass that registered it.</summary>
    public void Dispose() => _persistingLanguage.Dispose();
}
