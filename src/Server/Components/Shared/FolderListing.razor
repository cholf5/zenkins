@using Zenkins.Shared.Projects
@* Card F-042: one listing shape for the projects page and a folder page - breadcrumb, search, the
   subfolders, then the projects with their last run's status. The two pages must not drift: the root
   listing is the same component with a root breadcrumb and no current folder.

   Every form here is a plain HTML form (no EditForm), like the rest of the project surfaces: it posts to
   the real endpoint, is antiforgery-validated by UseAntiforgery and works without a Blazor circuit. *@
<nav aria-label="@L10n["Breadcrumb"]" class="bb:flex bb:flex-wrap bb:items-center bb:gap-2 bb:text-sm">
    @for (var index = 0; index < Listing.Breadcrumbs.Count; index++)
    {
        var crumb = Listing.Breadcrumbs[index];
        var isLast = index == Listing.Breadcrumbs.Count - 1;
        if (index > 0)
        {
            <span aria-hidden="true" class="bb:text-muted-foreground">/</span>
        }

        if (isLast)
        {
            <span aria-current="page" class="bb:font-medium">@crumb.Name</span>
        }
        else
        {
            <a href="@(crumb.Id is { } id ? $"/folders/{id}" : "/projects")"
               class="bb:underline bb:underline-offset-4">@crumb.Name</a>
        }
    }
</nav>

<div data-projects-summary class="bb:flex bb:flex-wrap bb:items-center bb:gap-3 bb:text-xs bb:text-muted-foreground">
    <span>@L10n["{0} folder(s) here", Listing.Folders.Count]</span>
    <span>@L10n["{0} project(s) here", Listing.Projects.Count]</span>
    <span>@L10n["{0} project(s) in this subtree", Listing.SubtreeProjectCount]</span>
    @if (Listing.Everywhere)
    {
        <BbBadge Variant="BadgeVariant.Secondary">@L10n["Searching everywhere"]</BbBadge>
    }
    else if (Listing.Query is { Length: > 0 })
    {
        <BbBadge Variant="BadgeVariant.Outline">@L10n["Searching this subtree"]</BbBadge>
    }
</div>

<form method="get" action="@SearchPath" data-folder-search data-field-row class="bb:flex bb:flex-col bb:gap-2 bb:sm:flex-row">
    @if (Listing.FolderId is { } currentId)
    {
        <input type="hidden" name="folder" value="@currentId" />
    }
    <div class="bb:flex-1 bb:space-y-2">
        <label for="folder-search" class="bb:text-sm bb:font-medium">@L10n["Search projects and folders"]</label>
        <input id="folder-search"
               name="q"
               type="search"
               value="@Listing.Query"
               autocomplete="off"
               spellcheck="false"
               placeholder="@L10n["name contains…"]"
               class="bb:flex bb:h-10 bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-3 bb:py-1 bb:text-sm" />
    </div>
    <div class="bb:space-y-2">
        <label for="folder-search-scope" class="bb:text-sm bb:font-medium">@L10n["Scope"]</label>
        <select id="folder-search-scope"
                name="scope"
                class="bb:flex bb:h-10 bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-3 bb:py-1 bb:text-sm">
            <option value="here" selected="@(!Listing.Everywhere)">@L10n["This folder and everything under it"]</option>
            <option value="all" selected="@(Listing.Everywhere)">@L10n["Everywhere in the organization"]</option>
        </select>
    </div>
    <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Outline">@L10n["Search"]</BbButton>
</form>

@if (Listing.Folders.Count > 0)
{
    <div class="bb:space-y-2">
        <h2 class="bb:text-sm bb:font-medium">@L10n["Folders"]</h2>
        <ul data-folder-list class="bb:divide-y">
            @foreach (var folder in Listing.Folders)
            {
                <li class="bb:flex bb:flex-wrap bb:items-center bb:justify-between bb:gap-3 bb:py-2">
                    <div class="bb:min-w-0">
                        <p class="bb:font-medium">
                            <a href="/folders/@folder.Id" class="bb:underline bb:underline-offset-4">@folder.Name</a>
                        </p>
                        @if (folder.Description is { Length: > 0 } description)
                        {
                            <p class="bb:truncate bb:text-xs bb:text-muted-foreground">@description</p>
                        }
                    </div>
                    <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-2 bb:text-xs bb:text-muted-foreground">
                        <span>@folder.ProjectCount project(s) here</span>
                        <span>@folder.SubtreeProjectCount in the subtree</span>
                        <span>@folder.ChildFolderCount subfolder(s)</span>
                        <span>@L10n["Level {0}", folder.Depth]</span>
                    </div>
                </li>
            }
        </ul>
    </div>
}

@if (Listing.Projects.Count == 0)
{
    <BbEmpty Title="@(Listing.Query is { Length: > 0 } ? L10n["Nothing matches this search"] : L10n["No projects in this folder"])"
             Description="@(Listing.Query is { Length: > 0 }
                 ? L10n["Try the other scope, or clear the search."]
                 : L10n["Create a project here, or open a subfolder."])">
        <Icon>
            <LucideIcon Name="folder-git-2" Class="bb:h-12 bb:w-12" />
        </Icon>
    </BbEmpty>
}
else
{
    <ul data-project-list class="bb:divide-y">
        @foreach (var project in Listing.Projects)
        {
            <li class="bb:flex bb:flex-wrap bb:items-center bb:justify-between bb:gap-3 bb:py-3">
                <div class="bb:min-w-0">
                    <p class="bb:font-medium">
                        @* F-042 AC-4: the project URL stays id-based; a folder never appears in it. *@
                        <a href="/projects/@project.Id" class="bb:underline bb:underline-offset-4">@project.Name</a>
                    </p>
                    <p class="bb:truncate bb:text-xs bb:text-muted-foreground">
                        @(project.RepositoryUrl
                            ?? (project.Kind == ProjectKinds.Freestyle
                                ? L10n["Freestyle project - steps configured on the server"]
                                : L10n["Inline pipeline - script stored on the server"]))
                    </p>
                </div>
                <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-2 bb:text-xs bb:text-muted-foreground">
                    @if (project.Disabled)
                    {
                        <BbBadge Variant="BadgeVariant.Destructive">@L10n["Disabled"]</BbBadge>
                    }
                    @if (project.Kind == ProjectKinds.Freestyle)
                    {
                        <BbBadge Variant="BadgeVariant.Secondary">@L10n["Freestyle"]</BbBadge>
                    }
                    else if (project.PipelineSource == ProjectSources.Inline)
                    {
                        <BbBadge Variant="BadgeVariant.Secondary">@L10n["Inline"]</BbBadge>
                        <span>pipeline.lua</span>
                    }
                    else
                    {
                        @* The kind's own facts stay on the row (F-003's listing showed them): the branch
                           it builds and the pipeline file inside the repository. *@
                        <BbBadge Variant="BadgeVariant.Outline">@project.DefaultBranch</BbBadge>
                        <span>@project.PipelinePath</span>
                    }

                    @* AC-3: the folder page shows each project's last-run status - no run is stated
                       as "never run" instead of a blank that could read as a failure. *@
                    @if (project.LastRunStatus is { } status)
                    {
                        <RunStatusBadge Status="@status" />
                        @if (project.LastRunNumber is { } number)
                        {
                            <a href="/projects/@project.Id/runs/@number" class="bb:underline bb:underline-offset-4">#@number</a>
                        }

                        @if (project.LastRunAt is { } ranAt)
                        {
                            <span>@L10n["ran {0} UTC", ranAt.ToString("yyyy-MM-dd HH:mm")]</span>
                        }
                    }
                    else
                    {
                        <BbBadge Variant="BadgeVariant.Outline">@L10n["never run"]</BbBadge>
                    }

                    @if (FolderOptions.Count > 0)
                    {
                        <form method="post" action="/projects/@project.Id/move" data-zenkins-antiforgery
                              class="bb:flex bb:flex-wrap bb:items-center bb:gap-2">
                            @if (Listing.FolderId is { } fromId)
                            {
                                <input type="hidden" name="FromFolderId" value="@fromId" />
                            }
                            <label for="project-move-@project.Id" class="bb:sr-only">@L10n["Move to folder"]</label>
                            <select id="project-move-@project.Id"
                                    name="FolderId"
                                    class="bb:flex bb:h-8 bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-2 bb:py-1 bb:text-xs">
                                <option value="" selected="@(project.FolderId is null)">@L10n["Root"]</option>
                                @foreach (var option in FolderOptions)
                                {
                                    <option value="@option.Id" selected="@(project.FolderId == option.Id)">@option.Path</option>
                                }
                            </select>
                            <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Outline">@L10n["Move"]</BbButton>
                        </form>
                    }
                </div>
            </li>
        }
    </ul>
}

@code {
    /// <summary>The listing to render (a folder, or the organization's root).</summary>
    [Parameter, EditorRequired]
    public ProjectListing Listing { get; set; } = default!;

    /// <summary>Every folder of the organization, for the per-project move selector.</summary>
    [Parameter]
    public IReadOnlyList<FolderOption> FolderOptions { get; set; } = [];

    /// <summary>The page's own GET path, so the search form submits back to it.</summary>
    [Parameter]
    public string SearchPath { get; set; } = "/projects";
}
