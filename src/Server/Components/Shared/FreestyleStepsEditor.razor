@using Zenkins.Shared.Pipelines
@* Card F-020's Freestyle steps editor, extended by card F-031 with the three post lists. A plain HTML form
   posting to the real endpoint (antiforgery like every other form): the rows below render the saved
   spec's steps, and js/freestyle-steps.js owns the dynamic row lists (add / remove / reorder) and
   serializes each list into its own hidden field on submit. The server - never the browser - builds and
   validates the frozen spec from that payload (FreestyleSteps.BuildSpecJson), so what is stored is
   exactly what a run executes. *@
<form method="post" action="@Action" data-zenkins-antiforgery data-freestyle-steps-form>
    @if (ErrorCode is not null)
    {
        <div role="alert" class="bb:rounded-md bb:border bb:border-destructive/40 bb:bg-destructive/10 bb:p-3 bb:text-sm bb:text-destructive">
            <p>@(ProjectErrorCodes.MessageFor(ErrorCode) ?? "The step list was refused.")</p>
        </div>
    }

    <div class="bb:space-y-8">
        <FreestyleStepsSection ListKey="steps"
                               FieldName="StepsJson"
                               TemplateId="freestyle-step-template"
                               Title="Steps"
                               Description="The main list, run in order. A failure stops the list unless the step says continue on error."
                               Steps="Steps"
                               ShowStage="true" />

        <FreestyleStepsSection ListKey="always"
                               FieldName="AlwaysStepsJson"
                               TemplateId="freestyle-step-template-always"
                               Title="Post steps: always"
                               Description="Runs after the main list whatever happened - cleanup, artifact upload, notification. On a canceled run these steps get a bounded grace window."
                               Steps="PostAlways"
                               StripPostPrefix="true" />

        <FreestyleStepsSection ListKey="success"
                               FieldName="SuccessStepsJson"
                               TemplateId="freestyle-step-template-success"
                               Title="Post steps: on success"
                               Description="Runs after the main list only when it succeeded, before the always steps. Never runs together with the failure set."
                               Steps="PostSuccess"
                               StripPostPrefix="true" />

        <FreestyleStepsSection ListKey="failure"
                               FieldName="FailureStepsJson"
                               TemplateId="freestyle-step-template-failure"
                               Title="Post steps: on failure"
                               Description="Runs after the main list only when it failed, before the always steps. Never runs together with the success set."
                               Steps="PostFailure"
                               StripPostPrefix="true" />
    </div>

    <div class="bb:mt-6 bb:flex bb:flex-wrap bb:items-center bb:gap-3">
        <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Default">Save steps</BbButton>
    </div>
</form>

@code {
    /// <summary>POST target of the form (the project's freestyle/steps endpoint).</summary>
    [Parameter, EditorRequired]
    public string Action { get; set; } = string.Empty;

    /// <summary>The saved spec's main steps, in order; an empty list renders no rows (the template covers
    /// the first "Add step").</summary>
    [Parameter]
    public IReadOnlyList<PipelineStep> Steps { get; set; } = [];

    /// <summary>Card F-031: the saved spec's <c>always</c> post steps (frozen names carry <c>post/</c>).</summary>
    [Parameter]
    public IReadOnlyList<PipelineStep> PostAlways { get; set; } = [];

    /// <summary>Card F-031: the saved spec's <c>success</c> post steps.</summary>
    [Parameter]
    public IReadOnlyList<PipelineStep> PostSuccess { get; set; } = [];

    /// <summary>Card F-031: the saved spec's <c>failure</c> post steps.</summary>
    [Parameter]
    public IReadOnlyList<PipelineStep> PostFailure { get; set; } = [];

    /// <summary>The stable validation code from the redirect query, if any.</summary>
    [Parameter]
    public string? ErrorCode { get; set; }
}
