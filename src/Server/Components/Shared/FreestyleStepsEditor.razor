@using System.Globalization
@using System.Text.RegularExpressions
@using Zenkins.Shared.Pipelines
@using Zenkins.Server.Projects
@* Card F-020's Freestyle steps editor, extended by card F-031 with the three post lists. A plain HTML form
   posting to the real endpoint (antiforgery like every other form): the rows below render the saved
   spec's steps, and js/freestyle-steps.js owns the dynamic row lists (add / remove / reorder) and
   serializes each list into its own hidden field on submit. The server - never the browser - builds and
   validates the frozen spec from that payload (FreestyleSteps.BuildSpecJson), so what is stored is
   exactly what a run executes. *@
<form method="post" action="@Action" data-zenkins-antiforgery data-freestyle-steps-form>
    @if (ErrorCode is not null)
    {
        <div role="alert" class="bb:rounded-md bb:border bb:border-destructive/40 bb:bg-destructive/10 bb:p-3 bb:text-sm bb:text-destructive">
            <p>@(ProjectErrorCodes.MessageFor(ErrorCode, L10n) ?? L10n["The step list was refused."])</p>
            @if (RefusalDetail is not null)
            {
                @* Card B-015: the builder's own sentence, verbatim - the same one a worker's
                   definition error shows. It names the refused field by its spec path, and the list
                   below marks the row that path belongs to. *@
                <p>@L10n["The exact reason:"] <code>@RefusalDetail</code></p>
            }
            @if (RefusedDrafts is not null)
            {
                <p>@L10n["The editor below still holds what you submitted, unchanged - the marked row is the one the reason names."]</p>
            }
        </div>
    }

    @* F-035: insert a `script-step` snippet as a fully formed row. The text is copied into the row and saved
       with the rest of the form - the project never references the snippet. *@
    @if (Snippets.Count > 0)
    {
        <div id="freestyle-snippets" class="bb:mb-6 bb:rounded-md bb:border bb:border-input bb:p-3">
            <label for="freestyle-snippet-select" class="bb:mb-1 bb:block bb:text-sm bb:font-medium">
                @L10n["Insert a snippet step"]
            </label>
            <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-2">
                <select id="freestyle-snippet-select"
                        data-freestyle-snippet-select
                        class="bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-2 bb:py-1 bb:text-sm">
                    @foreach (var snippet in Snippets)
                    {
                        <option value="@snippet.Id">@snippet.Name</option>
                    }
                </select>
                <button type="button" data-freestyle-action="insert-snippet"
                        class="bb:rounded-md bb:border bb:border-input bb:px-3 bb:py-1 bb:text-sm">
                    @L10n["Insert step"]
                </button>
                <span class="bb:text-xs bb:text-muted-foreground">
                    @L10n["Copies the snippet's script into a new step. Later edits to the snippet do not change this project."]
                </span>
            </div>
        </div>
    }

    <div class="bb:space-y-8">
        <FreestyleStepsSection ListKey="steps"
                               FieldName="StepsJson"
                               TemplateId="freestyle-step-template"
                               Title="@L10n["Steps"]"
                               Description="@L10n["The main list, run in order. A failure stops the list unless the step says continue on error."]"
                               Steps="Steps"
                               Drafts="RefusedDrafts?.Steps"
                               ErrorRowIndex="MainErrorIndex"
                               ShowStage="true" />

        <FreestyleStepsSection ListKey="always"
                               FieldName="AlwaysStepsJson"
                               TemplateId="freestyle-step-template-always"
                               Title="@L10n["Post steps: always"]"
                               Description="@L10n["Runs after the main list whatever happened - cleanup, artifact upload, notification. On a canceled run these steps get a bounded grace window."]"
                               Steps="PostAlways"
                               Drafts="RefusedDrafts?.Always"
                               ErrorRowIndex="PostErrorIndex(PipelinePostOutcomes.Always)"
                               StripPostPrefix="true" />

        <FreestyleStepsSection ListKey="success"
                               FieldName="SuccessStepsJson"
                               TemplateId="freestyle-step-template-success"
                               Title="@L10n["Post steps: on success"]"
                               Description="@L10n["Runs after the main list only when it succeeded, before the always steps. Never runs together with the failure set."]"
                               Steps="PostSuccess"
                               Drafts="RefusedDrafts?.Success"
                               ErrorRowIndex="PostErrorIndex(PipelinePostOutcomes.Success)"
                               StripPostPrefix="true" />

        <FreestyleStepsSection ListKey="failure"
                               FieldName="FailureStepsJson"
                               TemplateId="freestyle-step-template-failure"
                               Title="@L10n["Post steps: on failure"]"
                               Description="@L10n["Runs after the main list only when it failed, before the always steps. Never runs together with the success set."]"
                               Steps="PostFailure"
                               Drafts="RefusedDrafts?.Failure"
                               ErrorRowIndex="PostErrorIndex(PipelinePostOutcomes.Failure)"
                               StripPostPrefix="true" />
    </div>

    <div class="bb:mt-6 bb:flex bb:flex-wrap bb:items-center bb:gap-3">
        <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Default">@L10n["Save steps"]</BbButton>
    </div>
</form>

@code {
    /// <summary>POST target of the form (the project's freestyle/steps endpoint).</summary>
    [Parameter, EditorRequired]
    public string Action { get; set; } = string.Empty;

    /// <summary>The saved spec's main steps, in order; an empty list renders no rows (the template covers
    /// the first "Add step").</summary>
    [Parameter]
    public IReadOnlyList<PipelineStep> Steps { get; set; } = [];

    /// <summary>Card F-031: the saved spec's <c>always</c> post steps (frozen names carry <c>post/</c>).</summary>
    [Parameter]
    public IReadOnlyList<PipelineStep> PostAlways { get; set; } = [];

    /// <summary>Card F-031: the saved spec's <c>success</c> post steps.</summary>
    [Parameter]
    public IReadOnlyList<PipelineStep> PostSuccess { get; set; } = [];

    /// <summary>Card F-031: the saved spec's <c>failure</c> post steps.</summary>
    [Parameter]
    public IReadOnlyList<PipelineStep> PostFailure { get; set; } = [];

    /// <summary>
    /// Card F-035: the organization's <c>script-step</c> snippets the picker offers. Their bodies travel in the
    /// page's <c>#snippets-data</c> JSON; this list is only the picker's labels and ids.
    /// </summary>
    [Parameter]
    public IReadOnlyList<Zenkins.Server.Snippets.StepSnippetView> Snippets { get; set; } = [];

    /// <summary>The stable validation code from the redirect query, if any.</summary>
    [Parameter]
    public string? ErrorCode { get; set; }

    /// <summary>
    /// Card B-015: a refused submission's four draft lists, when the page consumed the stash the
    /// refused save left. Each section then renders its list from what was submitted - values
    /// verbatim, valid or not - instead of from the saved spec. Null on every other visit.
    /// </summary>
    [Parameter]
    public FreestyleStepsDrafts? RefusedDrafts { get; set; }

    /// <summary>Card B-015: the builder's own refusal sentence, shown under the stable code.</summary>
    [Parameter]
    public string? RefusalDetail { get; set; }

    private int? MainErrorIndex => StepPathIndex(RefusalDetail, MainStepPath);

    private int? PostErrorIndex(string outcome) => PostStepPathIndex(RefusalDetail, outcome);

    // The refusal reason names the refused field by its spec path, and the paths are 1-based
    // (BuildSpecJson walks i+1): pipeline.steps[2].name is the third row. The first path mention
    // decides; a reason without an index (the whole list was refused) marks no row.
    private static readonly Regex MainStepPath = new(
        @"pipeline\.steps\[(\d+)\]",
        RegexOptions.Compiled | RegexOptions.CultureInvariant);

    private static readonly Regex PostStepPath = new(
        @"pipeline\.post\.(always|success|failure)\[(\d+)\]",
        RegexOptions.Compiled | RegexOptions.CultureInvariant);

    private static int? StepPathIndex(string? detail, Regex pattern)
    {
        if (detail is null)
        {
            return null;
        }

        var match = pattern.Match(detail);
        return match.Success
            && int.TryParse(match.Groups[1].Value, NumberStyles.Integer, CultureInfo.InvariantCulture, out var oneBased)
            && oneBased > 0
                ? oneBased - 1
                : null;
    }

    private static int? PostStepPathIndex(string? detail, string outcome)
    {
        if (detail is null)
        {
            return null;
        }

        var match = PostStepPath.Match(detail);
        return match.Success
            && string.Equals(match.Groups[1].Value, outcome, StringComparison.Ordinal)
            && int.TryParse(match.Groups[2].Value, NumberStyles.Integer, CultureInfo.InvariantCulture, out var oneBased)
            && oneBased > 0
                ? oneBased - 1
                : null;
    }
}
