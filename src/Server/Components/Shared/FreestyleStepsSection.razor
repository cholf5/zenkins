@using System.Globalization
@using Zenkins.Shared.Pipelines
@* One list of Freestyle step rows (card F-030's main list, cards F-031's three post lists). The markup is
   the same for every list on purpose: a post step is a step. The list's key is what keeps element ids and
   the serialized JSON field distinct, so four lists can share one form and one script. *@
<section data-freestyle-list-section data-freestyle-list="@ListKey" class="bb:space-y-3">
    <div>
        <h3 class="bb:text-sm bb:font-medium">@Title</h3>
        <p class="bb:text-xs bb:text-muted-foreground">@Description</p>
    </div>

    <ol data-freestyle-steps-list="@ListKey" class="bb:space-y-4">
        @for (var stepIndex = 0; stepIndex < Steps.Count; stepIndex++)
        {
            var step = Steps[stepIndex];
            <li data-freestyle-step class="bb:rounded-md bb:border bb:border-input bb:p-4">
                <div class="bb:mb-3 bb:flex bb:items-center bb:justify-between bb:gap-3">
                    <span class="bb:text-sm bb:font-medium">
                        Step <span data-freestyle-step-index>@(stepIndex + 1)</span>
                    </span>
                    <div class="bb:flex bb:items-center bb:gap-1">
                        <button type="button" data-freestyle-action="move-up"
                                class="bb:rounded-md bb:border bb:border-input bb:px-2 bb:py-1 bb:text-xs"
                                aria-label="Move step @(stepIndex + 1) up">↑</button>
                        <button type="button" data-freestyle-action="move-down"
                                class="bb:rounded-md bb:border bb:border-input bb:px-2 bb:py-1 bb:text-xs"
                                aria-label="Move step @(stepIndex + 1) down">↓</button>
                        <button type="button" data-freestyle-action="remove"
                                class="bb:rounded-md bb:border bb:border-destructive/40 bb:px-2 bb:py-1 bb:text-xs bb:text-destructive"
                                aria-label="Remove step @(stepIndex + 1)">Remove</button>
                    </div>
                </div>
                <div class="bb:space-y-3 bb:text-sm">
                    <div>
                        <label class="bb:mb-1 bb:block bb:text-xs bb:font-medium" for="@($"{ListKey}-step-name-{stepIndex}")">Name</label>
                        <input data-freestyle-field="name"
                               id="@($"{ListKey}-step-name-{stepIndex}")"
                               value="@DisplayName(step)"
                               maxlength="200"
                               autocomplete="off"
                               spellcheck="false"
                               class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-3 bb:py-1" />
                    </div>
                    @if (ShowStage)
                    {
                        <div>
                            <label class="bb:mb-1 bb:block bb:text-xs bb:font-medium" for="@($"{ListKey}-step-stage-{stepIndex}")">
                                Stage (blank = outside any stage)
                            </label>
                            <input data-freestyle-field="stage"
                                   id="@($"{ListKey}-step-stage-{stepIndex}")"
                                   value="@step.Stage"
                                   maxlength="@MaxStageLength"
                                   placeholder="Build"
                                   autocomplete="off"
                                   spellcheck="false"
                                   class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-3 bb:py-1" />
                        </div>
                    }
                    <div>
                        <label class="bb:mb-1 bb:block bb:text-xs bb:font-medium" for="@($"{ListKey}-step-script-{stepIndex}")">
                            Script
                        </label>
                        <textarea data-freestyle-field="script"
                                  id="@($"{ListKey}-step-script-{stepIndex}")"
                                  rows="6"
                                  spellcheck="false"
                                  class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-3 bb:py-2 bb:font-mono bb:text-xs">@step.Script</textarea>
                        <p class="bb:mt-1 bb:text-xs bb:text-muted-foreground">
                            Runs on the claiming worker (cmd on Windows, sh -e on Unix) in the
                            run's workspace. <code>${secret:NAME}</code> and <code>${env:NAME}</code>
                            references are resolved just before the step starts.
                        </p>
                    </div>
                    <div class="bb:grid bb:gap-3 bb:sm:grid-cols-2">
                        <div>
                            <label class="bb:mb-1 bb:block bb:text-xs bb:font-medium" for="@($"{ListKey}-step-env-{stepIndex}")">
                                Environment (one NAME=value per line)
                            </label>
                            <textarea data-freestyle-field="env-lines"
                                      id="@($"{ListKey}-step-env-{stepIndex}")"
                                      rows="3"
                                      spellcheck="false"
                                      class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-3 bb:py-2 bb:font-mono bb:text-xs">@EnvLinesText(step)</textarea>
                        </div>
                        <div>
                            <label class="bb:mb-1 bb:block bb:text-xs bb:font-medium" for="@($"{ListKey}-step-artifacts-{stepIndex}")">
                                Artifacts (comma-separated paths)
                            </label>
                            <input data-freestyle-field="artifacts-text"
                                   id="@($"{ListKey}-step-artifacts-{stepIndex}")"
                                   value="@string.Join(", ", step.ArtifactPaths)"
                                   autocomplete="off"
                                   spellcheck="false"
                                   class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-3 bb:py-1" />
                        </div>
                    </div>
                    <div class="bb:grid bb:gap-3 bb:sm:grid-cols-2">
                        <div>
                            <label class="bb:mb-1 bb:block bb:text-xs bb:font-medium" for="@($"{ListKey}-step-timeout-{stepIndex}")">
                                Timeout (seconds, blank = no limit)
                            </label>
                            <input data-freestyle-field="timeout-seconds"
                                   id="@($"{ListKey}-step-timeout-{stepIndex}")"
                                   type="number"
                                   min="@MinStepTimeoutSeconds"
                                   max="@MaxStepTimeoutSeconds"
                                   value="@(step.TimeoutSeconds?.ToString(CultureInfo.InvariantCulture))"
                                   autocomplete="off"
                                   class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-3 bb:py-1" />
                        </div>
                        <div>
                            <label class="bb:mb-1 bb:block bb:text-xs bb:font-medium" for="@($"{ListKey}-step-runs-on-{stepIndex}")">
                                Needs a Worker with (blank = any)
                            </label>
                            <input data-freestyle-field="runs-on"
                                   id="@($"{ListKey}-step-runs-on-{stepIndex}")"
                                   type="text"
                                   value="@step.RunsOn"
                                   placeholder="linux &amp;&amp; (arm64 || x64)"
                                   autocomplete="off"
                                   class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-3 bb:py-1" />
                        </div>
                        <div>
                            <label class="bb:mb-1 bb:block bb:text-xs bb:font-medium" for="@($"{ListKey}-step-retry-{stepIndex}")">
                                Attempts (blank = 1)
                            </label>
                            <input data-freestyle-field="retry"
                                   id="@($"{ListKey}-step-retry-{stepIndex}")"
                                   type="number"
                                   min="@MinStepRetry"
                                   max="@MaxStepRetry"
                                   value="@(step.Retry?.ToString(CultureInfo.InvariantCulture))"
                                   autocomplete="off"
                                   class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-3 bb:py-1" />
                        </div>
                    </div>
                    <label class="bb:flex bb:items-center bb:gap-2">
                        <input type="checkbox"
                               data-freestyle-field="continue-on-error"
                               checked="@(step.ContinueOnError)" />
                        <span class="bb:text-xs">Continue on error: a failure here does not stop the run.</span>
                    </label>
                </div>
            </li>
        }
    </ol>

    <template id="@TemplateId">
        <li data-freestyle-step class="bb:rounded-md bb:border bb:border-input bb:p-4">
            <div class="bb:mb-3 bb:flex bb:items-center bb:justify-between bb:gap-3">
                <span class="bb:text-sm bb:font-medium">
                    Step <span data-freestyle-step-index></span>
                </span>
                <div class="bb:flex bb:items-center bb:gap-1">
                    <button type="button" data-freestyle-action="move-up"
                            class="bb:rounded-md bb:border bb:border-input bb:px-2 bb:py-1 bb:text-xs"
                            aria-label="Move step up">↑</button>
                    <button type="button" data-freestyle-action="move-down"
                            class="bb:rounded-md bb:border bb:border-input bb:px-2 bb:py-1 bb:text-xs"
                            aria-label="Move step down">↓</button>
                    <button type="button" data-freestyle-action="remove"
                            class="bb:rounded-md bb:border bb:border-destructive/40 bb:px-2 bb:py-1 bb:text-xs bb:text-destructive"
                            aria-label="Remove step">Remove</button>
                </div>
            </div>
            <div class="bb:space-y-3 bb:text-sm">
                <div>
                    <label class="bb:mb-1 bb:block bb:text-xs bb:font-medium" data-freestyle-for="name">Name</label>
                    <input data-freestyle-field="name"
                           maxlength="200"
                           autocomplete="off"
                           spellcheck="false"
                           class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-3 bb:py-1" />
                </div>
                @if (ShowStage)
                {
                    <div>
                        <label class="bb:mb-1 bb:block bb:text-xs bb:font-medium" data-freestyle-for="stage">
                            Stage (blank = outside any stage)
                        </label>
                        <input data-freestyle-field="stage"
                               maxlength="@MaxStageLength"
                               placeholder="Build"
                               autocomplete="off"
                               spellcheck="false"
                               class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-3 bb:py-1" />
                    </div>
                }
                <div>
                    <label class="bb:mb-1 bb:block bb:text-xs bb:font-medium" data-freestyle-for="script">Script</label>
                    <textarea data-freestyle-field="script"
                              rows="6"
                              spellcheck="false"
                              class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-3 bb:py-2 bb:font-mono bb:text-xs"></textarea>
                </div>
                <div class="bb:grid bb:gap-3 bb:sm:grid-cols-2">
                    <div>
                        <label class="bb:mb-1 bb:block bb:text-xs bb:font-medium" data-freestyle-for="env-lines">
                            Environment (one NAME=value per line)
                        </label>
                        <textarea data-freestyle-field="env-lines"
                                  rows="3"
                                  spellcheck="false"
                                  class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-3 bb:py-2 bb:font-mono bb:text-xs"></textarea>
                    </div>
                    <div>
                        <label class="bb:mb-1 bb:block bb:text-xs bb:font-medium" data-freestyle-for="artifacts-text">
                            Artifacts (comma-separated paths)
                        </label>
                        <input data-freestyle-field="artifacts-text"
                               autocomplete="off"
                               spellcheck="false"
                               class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-3 bb:py-1" />
                    </div>
                </div>
                <div class="bb:grid bb:gap-3 bb:sm:grid-cols-2">
                    <div>
                        <label class="bb:mb-1 bb:block bb:text-xs bb:font-medium" data-freestyle-for="timeout-seconds">
                            Timeout (seconds, blank = no limit)
                        </label>
                        <input data-freestyle-field="timeout-seconds"
                               type="number"
                               min="@MinStepTimeoutSeconds"
                               max="@MaxStepTimeoutSeconds"
                               autocomplete="off"
                               class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-3 bb:py-1" />
                    </div>
                    <div>
                        <label class="bb:mb-1 bb:block bb:text-xs bb:font-medium" data-freestyle-for="runs-on">
                            Needs a Worker with (blank = any)
                        </label>
                        <input data-freestyle-field="runs-on"
                               type="text"
                               placeholder="linux &amp;&amp; (arm64 || x64)"
                               autocomplete="off"
                               class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-3 bb:py-1" />
                    </div>
                    <div>
                        <label class="bb:mb-1 bb:block bb:text-xs bb:font-medium" data-freestyle-for="retry">
                            Attempts (blank = 1)
                        </label>
                        <input data-freestyle-field="retry"
                               type="number"
                               min="@MinStepRetry"
                               max="@MaxStepRetry"
                               autocomplete="off"
                               class="bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-3 bb:py-1" />
                    </div>
                </div>
                <label class="bb:flex bb:items-center bb:gap-2">
                    <input type="checkbox" data-freestyle-field="continue-on-error" />
                    <span class="bb:text-xs">Continue on error: a failure here does not stop the run.</span>
                </label>
            </div>
        </li>
    </template>

    <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-3">
        <button type="button" data-freestyle-action="add"
                class="bb:rounded-md bb:border bb:border-input bb:px-3 bb:py-2 bb:text-sm">
            Add step
        </button>
    </div>

    <input type="hidden" name="@FieldName" id="@($"freestyle-steps-json-{ListKey}")"
           data-freestyle-json-target="@ListKey" />
</section>

@code {
    /// <summary>The list's key (<c>steps</c>, <c>always</c>, <c>success</c>, <c>failure</c>): element ids and
    /// the hidden field's target are derived from it, so four lists never collide.</summary>
    [Parameter, EditorRequired]
    public string ListKey { get; set; } = string.Empty;

    /// <summary>The form field the serialized drafts post as (<c>StepsJson</c>, <c>AlwaysStepsJson</c>, ...).</summary>
    [Parameter, EditorRequired]
    public string FieldName { get; set; } = string.Empty;

    /// <summary>The row template's id - the main list keeps the historical one.</summary>
    [Parameter, EditorRequired]
    public string TemplateId { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Description { get; set; } = string.Empty;

    /// <summary>The rows to render (the saved spec's steps for this list).</summary>
    [Parameter]
    public IReadOnlyList<PipelineStep> Steps { get; set; } = [];

    /// <summary>Whether the rows offer the stage field (card F-030). Post steps render in the post section,
    /// never a stage, so their lists hide it.</summary>
    [Parameter]
    public bool ShowStage { get; set; }

    /// <summary>Whether the rows display the authored name or the frozen one (post names carry
    /// <c>post/</c>; the editor shows what the author wrote and the builder re-adds the prefix).</summary>
    [Parameter]
    public bool StripPostPrefix { get; set; }

    private const int MinStepTimeoutSeconds = PipelineSpecSchema.MinStepTimeoutSeconds;

    private const int MaxStepTimeoutSeconds = PipelineSpecSchema.MaxStepTimeoutSeconds;

    private const int MinStepRetry = PipelineSpecSchema.MinStepRetry;

    private const int MaxStepRetry = PipelineSpecSchema.MaxStepRetry;

    private const int MaxStageLength = PipelineSpecSchema.MaxStageLength;

    private string DisplayName(PipelineStep step) =>
        StripPostPrefix && step.Name.StartsWith(PipelineSpecSchema.PostNamePrefix, StringComparison.Ordinal)
            ? step.Name[PipelineSpecSchema.PostNamePrefix.Length..]
            : step.Name;

    private static string EnvLinesText(PipelineStep step) =>
        step.Env is { } env
            ? string.Join("\n", env.Select(row => $"{row.Key}={row.Value}"))
            : string.Empty;
}
