@using System.Globalization
@using Zenkins.Shared.Pipelines
@using Zenkins.Server.Projects
@* One list of Freestyle step rows (card F-030's main list, cards F-031's three post lists). The markup is
   the same for every list on purpose: a post step is a step. The list's key is what keeps element ids and
   the serialized JSON field distinct, so four lists can share one form and one script.

   The layout is a list + inspector ([data-split-editor], js/split-list.js): the left column is one line per
   step, the right one is the selected step's fields, so ten steps read as ten lines instead of ten forms.
   The fields of every step stay in the DOM - inside its row until selected, moved into the pane after that -
   because js/freestyle-steps.js serializes the nodes, not a model. Below the pane's breakpoint the same
   markup is an accordion, and app.css is the only thing that knows the difference. *@
<section data-freestyle-list-section data-freestyle-list="@ListKey" class="bb:space-y-3">
    <div>
        <h3 class="bb:text-sm bb:font-medium">@Title</h3>
        <p class="bb:text-xs bb:text-muted-foreground">@Description</p>
    </div>

    <div data-split-editor="@ListKey" data-split-labels="@LabelsJson()" class="zk-split">
        <ol data-freestyle-steps-list="@ListKey" class="zk-split-list">
            @for (var stepIndex = 0; stepIndex < RowCount; stepIndex++)
            {
                var step = Drafts is null ? Steps[stepIndex] : null;
                var draft = Drafts is null ? null : Drafts[stepIndex];
                var displayName = draft is not null ? draft.Name ?? string.Empty : DisplayName(step!);
                <li data-freestyle-step data-split-step
                    class="zk-split-row"
                    data-split-error="@(stepIndex == ErrorRowIndex ? "true" : null)">
                    <div class="zk-split-row-head">
                        <span data-split-drag class="zk-drag" draggable="true" aria-hidden="true">⠿</span>
                        @* The whole line is the button that selects the step: one target, and the row
                           itself stays the place the move/remove actions live. *@
                        <button type="button" data-split-select
                                aria-expanded="false"
                                aria-controls="@PaneId"
                                class="zk-split-summary">
                            <span data-freestyle-step-index class="zk-split-index">@(stepIndex + 1)</span>
                            <span data-split-title class="zk-split-title">@displayName</span>
                            <span data-split-chips class="zk-split-chips"></span>
                        </button>
                        <div class="zk-split-actions">
                            <button type="button" data-freestyle-action="move-up"
                                    class="zk-row-action"
                                    aria-label="@L10n["Move step {0} up", stepIndex + 1]">↑</button>
                            <button type="button" data-freestyle-action="move-down"
                                    class="zk-row-action"
                                    aria-label="@L10n["Move step {0} down", stepIndex + 1]">↓</button>
                            <button type="button" data-freestyle-action="remove"
                                    class="zk-row-action zk-row-action-danger"
                                    aria-label="@L10n["Remove step {0}", stepIndex + 1]">@L10n["Remove"]</button>
                        </div>
                    </div>
                    <div data-split-detail-slot class="zk-split-slot">
                        <FreestyleStepFields IdPrefix="@($"{ListKey}-step-{stepIndex}")"
                                             Name="@displayName"
                                             Step="step"
                                             Draft="draft"
                                             ShowStage="ShowStage" />
                    </div>
                </li>
            }
        </ol>

        <div data-split-pane id="@PaneId" class="zk-split-pane" aria-label="@Title">
            <p data-split-empty class="zk-split-empty">@L10n["No steps in this list yet. Add one below."]</p>
        </div>
    </div>

    @* The row "Add step" clones. The element order matters: the <li> is the template's first child, which
       is where B-011 found the browser's parse and Blazor's appendChild disagree - js/freestyle-steps.js
       reads it from either place, and ProjectUiRowTemplateTests pins that. The fields come from the one
       component both halves use, so the template cannot lose a field the saved row has. *@
    <template id="@TemplateId">
        <li data-freestyle-step data-split-step class="zk-split-row">
            <div class="zk-split-row-head">
                <span data-split-drag class="zk-drag" draggable="true" aria-hidden="true">⠿</span>
                <button type="button" data-split-select
                        aria-expanded="false"
                        aria-controls="@PaneId"
                        class="zk-split-summary">
                    <span data-freestyle-step-index class="zk-split-index"></span>
                    <span data-split-title class="zk-split-title">@L10n["New step"]</span>
                    <span data-split-chips class="zk-split-chips"></span>
                </button>
                <div class="zk-split-actions">
                    <button type="button" data-freestyle-action="move-up"
                            class="zk-row-action"
                            aria-label="@L10n["Move step up"]">↑</button>
                    <button type="button" data-freestyle-action="move-down"
                            class="zk-row-action"
                            aria-label="@L10n["Move step down"]">↓</button>
                    <button type="button" data-freestyle-action="remove"
                            class="zk-row-action zk-row-action-danger"
                            aria-label="@L10n["Remove step"]">@L10n["Remove"]</button>
                </div>
            </div>
            <div data-split-detail-slot class="zk-split-slot">
                <FreestyleStepFields ShowStage="ShowStage" />
            </div>
        </li>
    </template>

    <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-3">
        <button type="button" data-freestyle-action="add"
                class="bb:rounded-md bb:border bb:border-input bb:px-3 bb:py-2 bb:text-sm">
            @L10n["Add step"]
        </button>
    </div>

    <input type="hidden" name="@FieldName" id="@($"freestyle-steps-json-{ListKey}")"
           data-freestyle-json-target="@ListKey" />
</section>

@code {
    /// <summary>The list's key (<c>steps</c>, <c>always</c>, <c>success</c>, <c>failure</c>): element ids and
    /// the hidden field's target are derived from it, so four lists never collide. It is also the key
    /// js/split-list.js summarizes this list's rows under.</summary>
    [Parameter, EditorRequired]
    public string ListKey { get; set; } = string.Empty;

    /// <summary>The form field the serialized drafts post as (<c>StepsJson</c>, <c>AlwaysStepsJson</c>, ...).</summary>
    [Parameter, EditorRequired]
    public string FieldName { get; set; } = string.Empty;

    /// <summary>The row template's id - the main list keeps the historical one.</summary>
    [Parameter, EditorRequired]
    public string TemplateId { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Description { get; set; } = string.Empty;

    /// <summary>The rows to render (the saved spec's steps for this list).</summary>
    [Parameter]
    public IReadOnlyList<PipelineStep> Steps { get; set; } = [];

    /// <summary>
    /// Card B-015: a refused submission's drafts for this list, when the page renders what was
    /// submitted instead of the saved spec. Each row then shows its author's own values verbatim
    /// (<see cref="FreestyleStepFields.Draft"/>), so a value the builder refused - an env comment, a
    /// non-numeric timeout - is still on the page for the next save, and a list the submission did
    /// not carry is null here and renders <see cref="Steps"/> as before. An empty list is a real
    /// submission (the browser posts <c>[]</c> for a cleared list) and renders no rows.
    /// </summary>
    [Parameter]
    public IReadOnlyList<FreestyleStepDraft>? Drafts { get; set; }

    /// <summary>
    /// Card B-015: the (0-based) row the refusal reason names, marked <c>data-split-error</c> so the
    /// row is visible before selection and js/split-list.js opens it first. Null marks nothing.
    /// </summary>
    [Parameter]
    public int? ErrorRowIndex { get; set; }

    /// <summary>Whether the rows offer the stage field (card F-030). Post steps render in the post section,
    /// never a stage, so their lists hide it.</summary>
    [Parameter]
    public bool ShowStage { get; set; }

    /// <summary>Whether the rows display the authored name or the frozen one (post names carry
    /// <c>post/</c>; the editor shows what the author wrote and the builder re-adds the prefix).</summary>
    [Parameter]
    public bool StripPostPrefix { get; set; }

    /// <summary>The inspector pane's id, so a row's aria-controls has a target that exists.</summary>
    private string PaneId => $"{ListKey}-step-pane";

    /// <summary>One row per draft when the page renders a refused submission, else one per saved step.</summary>
    private int RowCount => Drafts?.Count ?? Steps.Count;

    private string DisplayName(PipelineStep step) =>
        StripPostPrefix && step.Name.StartsWith(PipelineSpecSchema.PostNamePrefix, StringComparison.Ordinal)
            ? step.Name[PipelineSpecSchema.PostNamePrefix.Length..]
            : step.Name;

    /// <summary>
    /// The words js/split-list.js puts on a row's chips. They travel as data (the same way the snippet
    /// picker's text does) so the summary a browser draws for an edited row is the one this list would have
    /// rendered, in the reader's language - and so no Chinese or English string lives in a .js file.
    /// </summary>
    private string LabelsJson() => System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, string>
    {
        ["stage"] = L10n["Stage"],
        ["env"] = L10n["Environment {0}"],
        ["artifacts"] = L10n["Artifacts {0}"],
        ["timeout"] = L10n["Timeout {0}s"],
        ["attempts"] = L10n["Attempts {0}"],
        ["runsOn"] = L10n["Needs {0}"],
        ["continueOnError"] = L10n["Continue on error"],
        ["unnamed"] = L10n["Unnamed step"],
    });
}
