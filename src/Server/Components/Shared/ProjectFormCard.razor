@using Zenkins.Shared.Projects
@* Card F-003's shared create/edit form (extended by F-020 with the kind selector). A plain HTML form
   (not an EditForm) so it posts to the real endpoint, is antiforgery-validated by UseAntiforgery and
   works without a Blazor circuit - the same shape F-002's organization forms use. Field values are
   supplied by the page, which reads them back from the validation redirect so a failed submit does
   not erase the user's input. js/project-kind.js toggles the repository fields per kind. *@
<form method="post" action="@Action" data-zenkins-antiforgery class="bb:space-y-4">
    <div class="bb:space-y-2">
        <label for="project-name" class="bb:text-sm bb:font-medium">Name</label>
        <input id="project-name"
               name="Name"
               value="@Name"
               required
               maxlength="200"
               autocomplete="off"
               spellcheck="false"
               aria-invalid="@(NameError is null ? null : "true")"
               aria-describedby="@(NameError is null ? null : "project-name-error")"
               class="bb:flex bb:h-9 bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-3 bb:py-1 bb:text-sm" />
        @if (NameError is { } nameError)
        {
            <p id="project-name-error" role="alert" class="bb:text-xs bb:text-destructive">@nameError</p>
        }
    </div>

    @if (KindLocked)
    {
        @* F-020: a project's kind is immutable after create. The edit form shows it as a badge and
           renders no kind input - the service ignores a posted kind on edit anyway, so the two can
           never disagree. *@
        <div class="bb:space-y-2">
            <span class="bb:text-sm bb:font-medium">Kind</span>
            <div>
                <BbBadge Variant="BadgeVariant.Outline">@KindLabel</BbBadge>
            </div>
        </div>
    }
    else
    {
        <div class="bb:space-y-2">
            <span class="bb:text-sm bb:font-medium">Kind</span>
            <div class="bb:grid bb:gap-2 bb:sm:grid-cols-2" id="project-kind" role="radiogroup" aria-label="Project kind">
                <label class="bb:flex bb:cursor-pointer bb:items-start bb:gap-3 bb:rounded-md bb:border bb:border-input bb:p-3 bb:text-sm">
                    <input type="radio"
                           name="Kind"
                           value="@ProjectKinds.Pipeline"
                           checked="@(SelectedKind == ProjectKinds.Pipeline)"
                           data-project-kind-choice
                           class="bb:mt-0.5" />
                    <span>
                        <span class="bb:font-medium">Pipeline</span>
                        <span class="bb:block bb:text-xs bb:text-muted-foreground">
                            A Git repository whose pipeline.lua declares the steps.
                        </span>
                    </span>
                </label>
                <label class="bb:flex bb:cursor-pointer bb:items-start bb:gap-3 bb:rounded-md bb:border bb:border-input bb:p-3 bb:text-sm">
                    <input type="radio"
                           name="Kind"
                           value="@ProjectKinds.Freestyle"
                           checked="@(SelectedKind == ProjectKinds.Freestyle)"
                           data-project-kind-choice
                           class="bb:mt-0.5" />
                    <span>
                        <span class="bb:font-medium">Freestyle</span>
                        <span class="bb:block bb:text-xs bb:text-muted-foreground">
                            No repository. Steps are configured here and run as shell scripts.
                        </span>
                    </span>
                </label>
            </div>
            @if (KindError is { } kindError)
            {
                <p id="project-kind-error" role="alert" class="bb:text-xs bb:text-destructive">@kindError</p>
            }
        </div>
    }

    @if (!KindLocked)
    {
        @* F-022: the create form's definition source, only for the Pipeline kind. The JS hides this
           section for Freestyle and swaps the repository fields for the script editor per selection;
           the service is the authority (ProjectValidation.ValidatePipelineSource). *@
        <div data-project-source-fields class="bb:space-y-2">
            <span class="bb:text-sm bb:font-medium">Definition</span>
            <div class="bb:grid bb:gap-2 bb:sm:grid-cols-2" role="radiogroup" aria-label="Pipeline definition source">
                <label class="bb:flex bb:cursor-pointer bb:items-start bb:gap-3 bb:rounded-md bb:border bb:border-input bb:p-3 bb:text-sm">
                    <input type="radio"
                           name="PipelineSource"
                           value="@ProjectSources.Repository"
                           checked="@(SelectedSource == ProjectSources.Repository)"
                           data-project-source-choice
                           class="bb:mt-0.5" />
                    <span>
                        <span class="bb:font-medium">Pipeline script from SCM</span>
                        <span class="bb:block bb:text-xs bb:text-muted-foreground">
                            The script is a file in a Git repository.
                        </span>
                    </span>
                </label>
                <label class="bb:flex bb:cursor-pointer bb:items-start bb:gap-3 bb:rounded-md bb:border bb:border-input bb:p-3 bb:text-sm">
                    <input type="radio"
                           name="PipelineSource"
                           value="@ProjectSources.Inline"
                           checked="@(SelectedSource == ProjectSources.Inline)"
                           data-project-source-choice
                           class="bb:mt-0.5" />
                    <span>
                        <span class="bb:font-medium">Pipeline script</span>
                        <span class="bb:block bb:text-xs bb:text-muted-foreground">
                            The script lives on the server; no repository is needed.
                        </span>
                    </span>
                </label>
            </div>
            @if (PipelineSourceError is { } sourceError)
            {
                <p id="project-pipeline-source-error" role="alert" class="bb:text-xs bb:text-destructive">@sourceError</p>
            }
        </div>
    }

    @if (ShowInlineFields)
    {
        <div data-project-inline-fields class="bb:space-y-2">
            <label for="project-inline-script" class="bb:text-sm bb:font-medium">Pipeline script</label>
            <textarea id="project-inline-script"
                      name="InlineScript"
                      rows="14"
                      maxlength="65536"
                      spellcheck="false"
                      autocomplete="off"
                      aria-invalid="@(InlineScriptError is null ? null : "true")"
                      aria-describedby="@(InlineScriptError is null ? null : "project-inline-script-error")"
                      class="bb:flex bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-3 bb:py-2 bb:font-mono bb:text-sm">@InlineScript</textarea>
            @if (InlineScriptError is { } scriptError)
            {
                <p id="project-inline-script-error" role="alert" class="bb:text-xs bb:text-destructive">@scriptError</p>
            }
            <p class="bb:text-xs bb:text-muted-foreground">
                A <code>pipeline { ... }</code> body, at most 64 KiB. Saving does not prove it valid -
                the Pipelines tab's Validate action runs the definition phase on a worker.
            </p>
        </div>
    }

    @if (ShowRepositoryFields)
    {
        <div data-project-repository-fields class="bb:space-y-4">
            <div class="bb:space-y-2">
                <label for="project-repository-url" class="bb:text-sm bb:font-medium">Repository URL</label>
            <input id="project-repository-url"
                   name="RepositoryUrl"
                   value="@RepositoryUrl"
                   required
                   maxlength="2048"
                   autocomplete="off"
                   spellcheck="false"
                   placeholder="https://github.com/owner/repo.git or git@github.com:owner/repo.git"
                   aria-invalid="@(RepositoryUrlError is null ? null : "true")"
                   aria-describedby="@(RepositoryUrlError is null ? null : "project-repository-url-error")"
                   class="bb:flex bb:h-9 bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-3 bb:py-1 bb:text-sm" />
            @if (RepositoryUrlError is { } repositoryUrlError)
            {
                <p id="project-repository-url-error" role="alert" class="bb:text-xs bb:text-destructive">@repositoryUrlError</p>
            }
            <p class="bb:text-xs bb:text-muted-foreground">
                HTTPS and SSH only. <code>file://</code>, <code>ext::</code> and other transports that can
                execute commands are rejected on the server.
            </p>
        </div>

        <div class="bb:space-y-2">
            <label for="project-default-branch" class="bb:text-sm bb:font-medium">Default branch</label>
            <input id="project-default-branch"
                   name="DefaultBranch"
                   value="@DefaultBranch"
                   required
                   maxlength="200"
                   autocomplete="off"
                   spellcheck="false"
                   placeholder="main"
                   aria-invalid="@(DefaultBranchError is null ? null : "true")"
                   aria-describedby="@(DefaultBranchError is null ? null : "project-default-branch-error")"
                   class="bb:flex bb:h-9 bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-3 bb:py-1 bb:text-sm" />
            @if (DefaultBranchError is { } defaultBranchError)
            {
                <p id="project-default-branch-error" role="alert" class="bb:text-xs bb:text-destructive">@defaultBranchError</p>
            }
        </div>

        <div class="bb:space-y-2">
            <label for="project-pipeline-path" class="bb:text-sm bb:font-medium">Pipeline path</label>
            <input id="project-pipeline-path"
                   name="PipelinePath"
                   value="@PipelinePath"
                   maxlength="512"
                   autocomplete="off"
                   spellcheck="false"
                   placeholder="pipeline.lua"
                   aria-invalid="@(PipelinePathError is null ? null : "true")"
                   aria-describedby="@(PipelinePathError is null ? null : "project-pipeline-path-error")"
                   class="bb:flex bb:h-9 bb:w-full bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:px-3 bb:py-1 bb:text-sm" />
            @if (PipelinePathError is { } pipelinePathError)
            {
                <p id="project-pipeline-path-error" role="alert" class="bb:text-xs bb:text-destructive">@pipelinePathError</p>
            }
            <p class="bb:text-xs bb:text-muted-foreground">
                Repository-relative and defaults to <code>pipeline.lua</code>. Absolute paths and
                <code>..</code> are rejected.
            </p>
        </div>
    </div>
    }

    <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-3">
        <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Default">@SubmitLabel</BbButton>
        @if (CancelHref is not null)
        {
            <BbButton Href="@CancelHref" Variant="ButtonVariant.Outline">Cancel</BbButton>
        }
    </div>
</form>

@code {
    /// <summary>POST target of the form.</summary>
    [Parameter]
    public string Action { get; set; } = string.Empty;

    [Parameter]
    public string SubmitLabel { get; set; } = "Save project";

    [Parameter]
    public string? CancelHref { get; set; }

    [Parameter]
    public string? Name { get; set; }

    /// <summary>The kind the form selects (F-020): the radio's checked state. Blank means Pipeline -
    /// the historical default a form without the selector keeps.</summary>
    [Parameter]
    public string? Kind { get; set; }

    /// <summary>Whether the kind selector is rendered at all. The edit form locks the kind (it is
    /// immutable after create) and shows a badge instead.</summary>
    [Parameter]
    public bool KindLocked { get; set; }

    [Parameter]
    public string? RepositoryUrl { get; set; }

    [Parameter]
    public string? DefaultBranch { get; set; } = "main";

    [Parameter]
    public string? PipelinePath { get; set; } = ProjectValidation.DefaultPipelinePath;

    /// <summary>The stable validation code from the redirect query, if any.</summary>
    [Parameter]
    public string? ErrorCode { get; set; }

    /// <summary>F-022: the create form's definition source (ignored by a kind-locked edit).</summary>
    [Parameter]
    public string? PipelineSource { get; set; }

    /// <summary>F-022: the inline Lua body on the create form.</summary>
    [Parameter]
    public string? InlineScript { get; set; }

    private string SelectedKind => Kind == ProjectKinds.Freestyle ? ProjectKinds.Freestyle : ProjectKinds.Pipeline;

    private string KindLabel => SelectedKind == ProjectKinds.Freestyle ? "Freestyle" : "Pipeline";

    /// <summary>Whether the repository fields render at all: unlocked (the create form - the JS then
    /// toggles them per selection) or locked onto the Pipeline kind. A kind-locked Freestyle edit
    /// form renders none - the fields do not exist for that kind, and the service keeps them null.</summary>
    private bool ShowRepositoryFields => SelectedKind == ProjectKinds.Pipeline && SelectedSource == ProjectSources.Repository;

    private bool ShowInlineFields => !KindLocked && SelectedKind == ProjectKinds.Pipeline && SelectedSource == ProjectSources.Inline;

    /// <summary>F-022: the definition source the create form starts on (the historical repository default).</summary>
    private string SelectedSource => PipelineSource == ProjectSources.Inline
        ? ProjectSources.Inline
        : ProjectSources.Repository;

    private string? PipelineSourceError => ErrorFor(ProjectFields.PipelineSource);

    private string? InlineScriptError => ErrorFor(ProjectFields.InlineScript);

    private string? NameError => ErrorFor(ProjectFields.Name);

    private string? KindError => ErrorFor(ProjectFields.Kind);

    private string? RepositoryUrlError => ErrorFor(ProjectFields.RepositoryUrl);

    private string? DefaultBranchError => ErrorFor(ProjectFields.DefaultBranch);

    private string? PipelinePathError => ErrorFor(ProjectFields.PipelinePath);

    private string? ErrorFor(string field) =>
        ProjectErrorCodes.FieldFor(ErrorCode) == field
            ? ProjectErrorCodes.MessageFor(ErrorCode)
            : null;
}
