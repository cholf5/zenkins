@using Zenkins.Shared.Projects
@* Card F-021's parameters editor, in the list + inspector shape card F-045 gave it: one line per parameter
   on the left (its number, its name, its type), the selected parameter's fields in the pane on the right.
   The frame is js/split-list.js - the same one the steps editor uses - and js/parameter-rows.js owns the
   dynamic rows (add / remove) and serializes them into the one hidden ParametersJson field.

   The fields of a row stay in the DOM and are MOVED into the pane, never re-rendered: the serializer reads
   the nodes, so a re-created input would save empty and say nothing. Below the pane's breakpoint the same
   markup is an accordion.

   The form is plain HTML posting to the real endpoint (antiforgery, no circuit needed), and the server -
   never the browser - validates every rule (names, types, choices, bounds) and stores the definitions the
   trigger form renders. *@
<form method="post" action="@Action" data-zenkins-antiforgery data-parameter-rows-form>
    <input type="hidden" name="ParametersJson" id="parameters-json" />

    @if (ErrorCode is not null)
    {
        <div role="alert" class="bb:rounded-md bb:border bb:border-destructive/40 bb:bg-destructive/10 bb:p-3 bb:text-sm bb:text-destructive">
            <p>@(ProjectErrorCodes.MessageFor(ErrorCode, L10n) ?? L10n["The parameter list was refused."])</p>
        </div>
    }

    <div data-split-editor="parameters" data-split-labels="@LabelsJson()" class="zk-split">
        <ol data-parameter-rows-list class="zk-split-list">
            @for (var parameterIndex = 0; parameterIndex < Parameters.Count; parameterIndex++)
            {
                var parameter = Parameters[parameterIndex];
                <li data-parameter-row data-split-step class="zk-split-row">
                    <div class="zk-split-row-head">
                        @* The whole line selects the parameter; the row stays where the remove action lives. *@
                        <button type="button" data-split-select
                                aria-expanded="false"
                                aria-controls="@PaneId"
                                class="zk-split-summary">
                            <span data-parameter-row-index class="zk-split-index">@(parameterIndex + 1)</span>
                            <span data-split-title class="zk-split-title">@Title(parameter)</span>
                            <span data-split-chips class="zk-split-chips"></span>
                        </button>
                        <div class="zk-split-actions">
                            <button type="button" data-parameter-action="remove"
                                    class="zk-row-action zk-row-action-danger"
                                    aria-label="@L10n["Remove parameter {0}", parameterIndex + 1]">@L10n["Remove"]</button>
                        </div>
                    </div>
                    <div data-split-detail-slot class="zk-split-slot">
                        <ProjectParameterFields IdPrefix="@($"param-{parameterIndex}")" Parameter="@parameter" />
                    </div>
                </li>
            }
        </ol>

        <div data-split-pane id="@PaneId" class="zk-split-pane" aria-label="@L10n["Parameters"]">
            <p data-split-empty class="zk-split-empty">@L10n["No parameters yet. Add one below."]</p>
        </div>
    </div>

    @* The row "Add parameter" clones. The element order matters: the <li> is the template's first child,
       which is where B-011 found the browser's parse and Blazor's appendChild disagree - the script reads it
       from either place, and ProjectUiRowTemplateTests pins that. The fields come from the one component both
       halves use, so the template cannot lose a field the saved row has. *@
    <template id="parameter-row-template"><li data-parameter-row data-split-step class="zk-split-row">
        <div class="zk-split-row-head">
            <button type="button" data-split-select
                    aria-expanded="false"
                    aria-controls="@PaneId"
                    class="zk-split-summary">
                <span data-parameter-row-index class="zk-split-index"></span>
                <span data-split-title class="zk-split-title">@L10n["Unnamed parameter"]</span>
                <span data-split-chips class="zk-split-chips"></span>
            </button>
            <div class="zk-split-actions">
                <button type="button" data-parameter-action="remove"
                        class="zk-row-action zk-row-action-danger"
                        aria-label="@L10n["Remove parameter"]">@L10n["Remove"]</button>
            </div>
        </div>
        <div data-split-detail-slot class="zk-split-slot">
            <ProjectParameterFields />
        </div>
    </li></template>

    <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-3">
        <button type="button" data-parameter-action="add"
                class="bb:rounded-md bb:border bb:border-input bb:px-3 bb:py-2 bb:text-sm">
            @L10n["Add parameter"]
        </button>
        <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Default">@L10n["Save parameters"]</BbButton>
    </div>
</form>

@code {
    /// <summary>POST target of the form (the project's parameters endpoint).</summary>
    [Parameter, EditorRequired]
    public string Action { get; set; } = string.Empty;

    /// <summary>The saved definitions, in order; an empty list renders no rows.</summary>
    [Parameter]
    public IReadOnlyList<ProjectParameter> Parameters { get; set; } = [];

    /// <summary>The stable validation code from the redirect query, if any.</summary>
    [Parameter]
    public string? ErrorCode { get; set; }

    /// <summary>The inspector pane's id, so a row's aria-controls has a target that exists.</summary>
    private string PaneId => "parameters-pane";

    /// <summary>The line's own text: the name, or the list's word for a parameter that has none yet.</summary>
    private string Title(ProjectParameter parameter) =>
        string.IsNullOrWhiteSpace(parameter.Name) ? L10n["Unnamed parameter"] : parameter.Name;

    /// <summary>
    /// The words js/split-list.js puts on a row's line. They travel as data (the same way the steps editor's
    /// do) so the summary a browser draws for an edited row is the one this list would have rendered, in the
    /// reader's language - and so no Chinese or English string lives in a .js file.
    /// </summary>
    private string LabelsJson() => System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, string>
    {
        ["unnamed"] = L10n["Unnamed parameter"],
    });
}
