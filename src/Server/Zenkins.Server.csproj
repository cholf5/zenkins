<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Zenkins.Server</RootNamespace>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- Design-time EF tooling reads user secrets from this project's assembly. -->
    <UserSecretsId>zenkins-server</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Zenkins.Tests" />
  </ItemGroup>

  <!-- The UI's translations ship inside the assembly: a missing catalogue must fail the build, not
       turn a deployment silently monolingual. WithCulture=false keeps the locale suffix in the file
       name from being read as a satellite culture (which would strip it and compile a resources.dll
       instead of embedding the catalogue), and LogicalName pins the name the loader asks for. -->
  <ItemGroup>
    <Content Remove="Localization/*.json" />
    <EmbeddedResource Include="Localization/Translations.zh-Hans.json"
                      WithCulture="false"
                      LogicalName="Zenkins.Server.Localization.Translations.zh-Hans.json" />
    <EmbeddedResource Include="Localization/Translations.framework.zh-Hans.json"
                      WithCulture="false"
                      LogicalName="Zenkins.Server.Localization.Translations.framework.zh-Hans.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BlazorBlueprint.Components" />
    <PackageReference Include="BlazorBlueprint.Icons.Lucide" />
    <PackageReference Include="BlazorBlueprint.Primitives" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <!-- I-003: service lifetimes through the hosting layer (see Directory.Packages.props). -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- Design-time only: migrations, `dotnet ef` tooling. Never copied into the published app. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Shared/Zenkins.Shared.csproj" />
  </ItemGroup>

</Project>
