{
  "Database": {
    "Provider": "Sqlite"
  },
  "Artifacts": {
    "RootPath": "App_Data/artifacts",
    "MaxFileBytes": 536870912,
    "MaxArtifactBytes": 2147483648,
    "MaxFiles": 20000,
    "SweepIntervalSeconds": 60,
    "PendingTimeoutMinutes": 30
  },
  "Webhooks": {
    "MaxBodyBytes": 1048576,
    "RateLimitPerMinute": 60,
    "DeliveryIdTtlDays": 7,
    "BodyHashWindowMinutes": 10,
    "MaxRateLimitBuckets": 100000,
    "SweepIntervalSeconds": 3600
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
