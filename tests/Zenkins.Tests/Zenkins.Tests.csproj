<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <!-- Used directly by the I-002 tenancy tests (temp SQLite databases through ZenkinsDbContext). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <!-- Q-001: WebApplicationFactory<Program> serves the test-only probe endpoint over a real pipeline. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Shared/Zenkins.Shared.csproj" />
    <ProjectReference Include="../../src/Server/Zenkins.Server.csproj" />
    <!-- Build-order only: the AC7 guard reads Zenkins.Worker's runtimeconfig.json, so the
         Worker must exist next to this build. No assembly is referenced. -->
    <ProjectReference Include="../../src/Worker/Zenkins.Worker.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
