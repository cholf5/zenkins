<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <!-- Used directly by the I-002 tenancy tests (temp SQLite databases through ZenkinsDbContext). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <!-- Q-001: WebApplicationFactory<Program> serves the test-only probe endpoint over a real pipeline. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <!-- The TestAssets folder owns its own projects (ArgvEcho, F-007); without this exclusion the
       default Compile glob would pull their sources and generated obj files into this assembly. -->
  <ItemGroup>
    <Compile Remove="TestAssets/**" />
    <Content Remove="TestAssets/**" />
    <EmbeddedResource Remove="TestAssets/**" />
    <None Remove="TestAssets/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Shared/Zenkins.Shared.csproj" />
    <ProjectReference Include="../../src/Server/Zenkins.Server.csproj" />
    <!-- F-005 unit tests use the Worker's config/store/backoff types directly, and the process-level
         E2E spawns the Worker from this build output. Referencing the assembly also copies the
         apphost, deps and runtimeconfig.json here, which the WorkerRuntimeConfigTests guard reads. -->
    <ProjectReference Include="../../src/Worker/Zenkins.Worker.csproj" />
    <!-- F-007: the ArgvEcho test asset is built with the tests but never loaded into the test
         process - the WorkerRuntime tests locate its DLL and run it through `dotnet exec`. -->
    <ProjectReference Include="TestAssets/ArgvEcho/ArgvEcho.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
